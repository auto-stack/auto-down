// app.at — the demo root widget, single-sourced for BOTH render targets
// (plan 040): the same file drives `auto run` (vue — the generated SFC IS the
// demo app, regen via gen/regen.sh deploys it to demo/src/App.vue) and
// `auto run -r vm` (iced native desktop — cosmic-text editor shell +
// autodown-core parse_blocks renderer).
//
// PLAN-046: the two panels are a core-layout `row` of two `col`s (each
// flex-1 equal width) — replacing the web-semantic div.panels/section.panel
// pair whose flex layout only existed in the vue-only style block (the VM
// track stacked vertically, the README "Layout note" v1 divergence). The
// structural classes are Tailwind-native and consumed on the VM track
// through auto-lang's tailwind parser; the demo build has no Tailwind
// runtime, so the style block keeps scoped definitions of exactly those
// utilities as the vue-side fallback (plus the :deep enhancements).
// Platform divergences live in demo/auto/PARITY.md.
//
// AutoUI dual-track tags carry both panels (ext component imports retired):
//
// - `autodown_editor` — vue: @autodown/engine AutoDownEditor; VM: block
//   editor shell (View::AutodownEditor). content lives in the widget model;
//   edits flow back via `oninput: .Edit` (vue: @update:modelValue carries the
//   md payload; VM: edit signal, text auto-bound through the INPUT_TEXT
//   channel — same convention as code_editor).
// - `autodown` — vue: @autodown/engine StreamingRenderer (superset composing
//   MarkdownRender); VM: autodown-core parse_blocks → View tree. Of the
//   streaming-family props, `scroll_sync` is CONSUMED on VM since PLAN-043
//   (pane gets a View::Scrollable wrapper: `scroll_top` binding = write arm,
//   `onscroll` event = read arm — top/height/client ride the message back to
//   the handler); `placeholder_block_id`/`placeholder_height` (ghost) are
//   CONSUMED on VM since PLAN-044 (focused-block ghost box before the hit
//   block); `table_col_widths`/`oncolresize` (column resize) are CONSUMED on
//   VM since PLAN-045 (header-edge drag → per-table widths state; vue arm
//   ignores — engine tables resize via the bridge's useTableColumnResize);
//   `streaming` remains contract-only (VM stays final — see
//   demo/auto/README.md「VM 桌面跑法」).
//
// What stays hand-written (vue-only enhancements; VM degrades to ext stubs,
// stub warnings are expected and registered):
//
// - demo/src/content.ts — the initial markdown document (the DSL has no
//   multi-line template literals); reaches the widget through the ext fn
//   `initial_content()`. Both tracks start from this same document since
//   PLAN-047: vue reads it from app_ext.ts; the VM resolves the top-level
//   `use.web.fn` through the adapter chain to app_ext.vm.at — GENERATED
//   from content.ts by scripts/gen-vm-content.mjs (single source, no
//   drift).
// - demo/src/app.css — the global html/body/#app styles (the DSL only emits
//   <style scoped>); imported by main.ts.
// - utils/app_ext.ts — the useDemoAppBridge composable (owns the three
//   template refs, useSyncedScroll and useTableColumnResize; the DSL's
//   composable imports are called with zero arguments at setup top level,
//   before template refs exist, so the refs live in the bridge and .Init
//   assigns the mounted values into the bag) and the console log handlers.
// - CustomScrollbar is a sibling widget of this project (custom_scrollbar.at)
//   and is referenced as a sub-widget directly.
//
// Interface notes vs the pre-040 App.vue (behaviorally identical on vue):
//
// - content moved from the bridge bag into the widget model (single source
//   for both panels; the bridge bag keeps only refs + scroll measurements).
// - `hovering_splitter` still drives `visible` (CustomScrollbar tracks its
//   own hover internally).
// - `editingBlock` stayed in the bridge — PLAN-044 T5 activates it (the
//   editor's @focusblock emit writes the focused {id,height}|null through
//   .OnEditorFocus; VM reads the placeholder state instead, csb_* style).
// - Handlers emit noise events on the root component (nobody listens).

// PLAN-043 T10: 顶层 use 装载兄弟件 CustomScrollbar——VM 轨经 PR-3b
// （child WidgetDecl 收编 → handler 编入单一 VM flash）获得拖拽发射面
// 的真实 handler；缺此前 widget 视图/handler 均不入 flash（D2 复审
// "renders empty container" 的加载面根因）。vue 轨 codegen 忽略顶层
// 模块 use，SFC 输出不变。
use custom_scrollbar

// PLAN-047 T2: VM seed — top-level `use.web.fn` feeds the Plan 442 A3 ext
// adapter chain on the VM target: app_ext.at resolves to its sibling
// app_ext.vm.at (GENERATED from content.ts by scripts/gen-vm-content.mjs —
// the document's single source), so initial_content() links to a real symbol
// instead of the platform stub and the VM starts with the same document as
// the vue track. AUTO_VM_EXT_STUBS=0 keeps working (real symbol, not a
// stub). vue face: the SFC emits this as a second import from the SAME
// extension-stripped specifier the widget block uses (symbols disjoint, no
// duplicate), so the deployed app still calls the real app_ext.ts
// initial_content — behaviorally identical.
use.web.fn initial_content from "src/front/utils/app_ext.at"

widget App {
    use {
        // PLAN-047 T2: initial_content moved OUT of this block — it is now
        // imported by the top-level `use.web.fn` above (VM: resolves through
        // the app_ext.at → app_ext.vm.at adapter chain to the generated seed;
        // vue: same-module import of the real app_ext.ts, symbols disjoint so
        // no duplicate identifier).
        fn: logSave, logCancel, is_vue from "src/front/utils/app_ext.ts"
        composable: useDemoAppBridge from "src/front/utils/app_ext.ts"
    }

    msg Msg { Init, handleSave(str), handleCancel, Edit(str), SetScrollTop(f64), SplitterHover(int),
              OnLeftScroll(f64, f64, f64), OnRightScroll(f64, f64, f64), ToggleDetails(str),
              // PLAN-044 T5：编辑壳块聚焦（ghost 占位单源）。VM 轨消息
              // args=[Int block, Float height]（rust 直写快道消费，本
              // handler 不触发）；vue 轨 $event 对象 {id,height}|null 绑
              // 首参（写 bridge，computed vue 臂读取）——单参形态
              //（@focusblock="OnEditorFocus($event)" 一一对应）。
              OnEditorFocus(int),
              // PLAN-045 T6：表格列宽拖拽落定。VM 轨消息 args=[Str 表键,
              // Int col, Float width]（update 层 rust 直写快道消费——引擎
              // handler 对 float 实参/map 索引写入腐坏，本 handler 不触发，
              // 保留为 vue 契约面）；vue 轨 StreamingRenderer 无 colresize
              // 发射（列宽走 bridge useTableColumnResize），永不触发。
              OnColResize(str, int, f64) }

    model {
        // The document body — single source for editor input and renderer
        // output on both tracks. Seeded in .Init via the ext fn
        // (vue = content.ts; VM stub = "").
        var content str = ""
        var hovering_splitter int = 0
        // PLAN-044 T5: ghost 占位 VM 单源（rust 直写快道：OnEditorFocus 拦截
        // 写入/清空；空串 = 无 ghost）。vue 轨数据走 demoAppBridge.editingBlock
        //（@focusblock handler 写入），与 043 scroll state 同模式。名字取
        // ghost_* 与 computed placeholder_* 错开（生成层同名冲突）。
        var ghost_id str = ""
        var ghost_height f64 = 0
        // PLAN-043 T3: VM 轨滚动三测量（左右栏各一份；vue 轨数据仍走
        // demoAppBridge——CustomScrollbar 绑定经 is_vue 分派，见 computed）。
        var left_top f64 = 0
        var left_height f64 = 0
        var left_client f64 = 0
        var right_top f64 = 0
        var right_height f64 = 0
        var right_client f64 = 0
        // PLAN-045 T6: 表格列宽状态 VM 单源（rust 直写快道：OnColResize
        // 拦截按表键写 map——"t{blockHash}" 键，他键保留；重渲染/打字/流式
        // 后列宽保持，比 vue 的重渲染即丢更强）。autodown element 的
        // table_col_widths 绑定回传消费。vue 轨列宽走 bridge
        // useTableColumnResize（重渲染即丢），本 state 不参与。
        var table_widths Map<str, List<f64>> = {}
        // PLAN-047 T1 (PARITY #5): VM track theme. `dark_mode` is the
        // renderer-recognized name — a declared var is read every view
        // update and pushed into iced_adapter::set_dark_mode (auto-lang
        // Plan 370 D-GAP sync, renderer.rs read_state("dark_mode") arm), so
        // the `false` initial value runs the VM window on the light
        // palette from frame one. vue track never consumes it (inert ref —
        // e2e 73 is the zero-regression gate). Runtime switching entry
        // (settings surface) is out of scope — registered as wontfix.
        var dark_mode bool = false
    }

    computed {
        // PLAN-044 T5: ghost 占位按轨分派（csb_* 同模式）——vue 轨 bridge ref
        //（@focusblock → OnEditorFocus 写 editingBlock，044 起真点亮）；VM 轨
        // placeholder state（rust 直写快道；空串 → null 不出 ghost）。
        placeholder_id => is_vue() != None ? (.demoAppBridge.editingBlock != null ? .demoAppBridge.editingBlock.id : null) : (.ghost_id != "" ? .ghost_id : null)
        placeholder_height => is_vue() != None ? (.demoAppBridge.editingBlock != null ? .demoAppBridge.editingBlock.height : null) : (.ghost_id != "" ? .ghost_height : null)
        // PLAN-043 T3: CustomScrollbar 数据按轨分派——vue 轨 bridge ref
        //（useSyncedScroll 写，零变化）；VM 轨 scroll state（OnScroll
        // handler 写；is_vue 在 VM 为 None 走 state 臂）。
        csb_top => is_vue() != None ? .demoAppBridge.scrollTop : .left_top
        csb_height => is_vue() != None ? .demoAppBridge.scrollHeight : .left_height
        csb_client => is_vue() != None ? .demoAppBridge.clientHeight : .left_client
    }

    view {
        div {
            class: "app",
            header {
                class: "toolbar",
                text "AutoDown v0.1"
            }
            main {
                ref: "workspaceRef",
                class: "workspace",
                // PLAN-046 T1: 两栏收编——web 语义标签（div.panels +
                // section.panel.left/right）换核心布局标签 row/col（各
                // flex-1 等宽）。VM 轨：row→convert_row、col→convert_column、
                // flex-1→Flex1→width=Fill 两 col 天然平分；vue 轨：tag→
                // tailwind（flex flex-row / flex flex-col）+ class 直传，
                // 工具类真 CSS 由本文件 style 块的 scoped 兜底定义提供
                // （demo 构建无 Tailwind 运行时）。
                row {
                    class: "h-full w-full",
                    col {
                        // left/right：e2e 选择器钩（15 个 spec 文件 300+ 处
                        // .left/.right 定位）——计划「只被 vue-only style 块
                        // 消费」前提对 e2e 面不成立，故保留为锚（VM 轨未知
                        // token 零效果），登记 plan 待澄清④。
                        class: "flex-1 min-w-0 overflow-hidden border-r left",
                        autodown_editor {
                            ref: "editorRef",
                            content: .content,
                            placeholder: "Start typing...",
                            class: "flex-1 min-h-0 overflow-hidden",
                            // PLAN-043 T3: VM 轨滚动同步双臂（编辑壳全内容
                            // 高、外滚；vue 轨这些 props 不达组件根，惰性）。
                            scroll_sync: true,
                            scroll_top: .left_top,
                            onscroll: .OnLeftScroll,
                            // PLAN-044 T5: 块聚焦读出——vue @focusblock（EngineEditor
                            // emit，载荷 {id,height}|null）；VM onfocus 消息
                            //（FocusMetrics → rust 直写快道）。
                            onfocusblock: .OnEditorFocus($event),
                            oninput: .Edit,
                            onsave: .handleSave($event),
                            oncancel: .handleCancel
                        }
                    }
                    col {
                        class: "flex-1 min-w-0 overflow-hidden right",
                        autodown {
                            ref: "rendererRef",
                            content: .content,
                            streaming: false,
                            placeholder_block_id: .placeholder_id,
                            placeholder_height: .placeholder_height,
                            scroll_sync: true,
                            scroll_top: .right_top,
                            onscroll: .OnRightScroll,
                            // PLAN-043 T4: Details 折叠回路——summary 点击
                            // → 消息（键 = 块结构键）→ handler 翻转 content
                            // 内 open attr → 重渲染（vue 轨 @detailsclick 不
                            // 触发，惰性）。
                            ondetailsclick: .ToggleDetails,
                            // PLAN-045 T6: 列宽回路——表头边界拖拽松手 →
                            // 消息（表键, col, width）→ rust 直写快道写
                            // table_widths state → 绑定回传重渲染（列宽
                            // 保持）。vue 轨无 colresize 发射（bridge 自理），
                            // 两臂惰性。
                            table_col_widths: .table_widths,
                            oncolresize: .OnColResize,
                            class: "flex-1 min-h-0 overflow-hidden py-4 px-5"
                        }
                    }
                }
                div {
                    class: "splitter-hover-zone",
                    onmouseenter: .SplitterHover(1),
                    onmouseleave: .SplitterHover(0)
                }
                CustomScrollbar {
                    scrollTop: .csb_top,
                    scrollHeight: .csb_height,
                    clientHeight: .csb_client,
                    visible: .hovering_splitter == 1,
                    is_vm: is_vue() == None,
                    on "update:scrollTop": .SetScrollTop($event)
                }
            }
        }
    }

    on {
        // Seed the document first (vue: the real initial markdown; VM: "").
        // The bridge feeding is vue-only and guarded by the track probe —
        // the VM state has no template-ref fields, so an unguarded write is
        // the handler_App_Init crash form documented in plan 040's analysis
        // (is_vue(): vue = true; VM ext stub = None).
        .Init -> {
            .content = initial_content()
            if is_vue() != None {
                .demoAppBridge.workspaceRef = .workspaceRef
                .demoAppBridge.editorRef = .editorRef
                .demoAppBridge.rendererRef = .rendererRef
            }
        }
        .SplitterHover(v) -> {
            .hovering_splitter = v
        }
        .SetScrollTop(v) -> {
            if is_vue() != None {
                .demoAppBridge.setScrollTop(v)
            } else {
                // PLAN-043 T3: VM 轨直写左栏 state——offset 绑定拉动编辑栏，
                // 滚动事件回灌三测量并对右栏比例级联。
                .left_top = v
            }
        }
        // PLAN-043 T3/T6: VM 轨两栏比例联动。参数序 (h, c, sy) =
        // (scrollHeight, clientHeight, scrollTop)——VM 三参 handler 首参
        // 绑定损坏（首参读到垃圾、二三参正常，DEBTS 登记），scrollTop
        // 放第三位绕道。级联回授环由 rust 侧 pending 队列 0.5px 去抖
        // 几何收敛终结。vue 轨 @scroll 不达组件根（滚动发生在内层
        // wrapper），两 handler 永不触发，bridge 路径零变化。
        .OnLeftScroll(h, c, sy) -> {
            // 契约面（vue 生成侧）——VM 轨由 update 层 rust 直写快道
            // 执行（引擎 handler 浮点写入腐坏，见 renderer.rs T6 注）。
            .left_top = sy
            .left_height = h
            .left_client = c
        }
        .OnRightScroll(h, c, sy) -> {
            .right_top = sy
            .right_height = h
            .right_client = c
        }
        // PLAN-044 T5: 块聚焦 → ghost 占位。vue 轨：$event = {id,height}|null
        // 写 bridge（computed vue 臂读取，editingBlock 自本计划真点亮）；
        // VM 轨：本 handler 不触发——update 层 rust 直写快道拦截
        // OnEditorFocus 消息写 placeholder state（引擎 float 实参腐坏
        // 规避，043 T6 同信任路径），handler 保留为 vue 契约面。
        .OnEditorFocus(blk) -> {
            if is_vue() != None {
                .demoAppBridge.editingBlock = blk
            }
        }
        // PLAN-043 T4: Details 折叠翻转——VM render 是 content 的纯函数，
        // open 状态以 content 内 open attr 为单源：展开 = 在 $details 的
        // IAL 尾（") {" 前）追加 ", open:true"；收起 = 移除之。双 attr
        // 形态（summary 在前 + open 在后）parser 顺序无关已测
        //（renders_details_summary_then_open_order）。v1 单 details 块场景
        //（VM indexOf 单参无 from 形态——首处 ") {" 以 > d 序守卫）；多块
        // map 化留 EDITOR-CONTRACT scroll 节注记。
        .ToggleDetails(key) -> {
            let d = .content.indexOf("$details(")
            if d >= 0 {
                let close = .content.indexOf(") {")
                if close >= 0 && close > d {
                    if .content.contains("open:true") {
                        .content = .content.replace(", open:true", "")
                    } else {
                        let head = .content.substring(0, close)
                        let tail = .content.substring(close)
                        .content = head + ", open:true" + tail
                    }
                }
            }
        }
        .Edit(md) -> {
            .content = md
        }
        // PLAN-045 T6: 列宽落定——契约面（vue 生成侧签名对齐）。VM 轨本
        // handler 不触发：update 层 rust 直写快道拦截 OnColResize 消息直写
        // table_widths state（引擎 float 实参/map 索引写入腐坏规避，043
        // scroll/044 ghost 同信任路径）；vue 轨 StreamingRenderer 无
        // colresize 发射（bridge useTableColumnResize 自理），同样不触发。
        .OnColResize(tbl, col, w) -> {
        }
        .handleSave(md) -> {
            logSave(md)
        }
        .handleCancel -> {
            logCancel()
        }
    }

    style {
        .app {
            display: flex;
            flex-direction: column;
            height: 100vh;
            font-family: system-ui, -apple-system, sans-serif;
            color: #111827;
        }

        .toolbar {
            flex-shrink: 0;
            height: 48px;
            display: flex;
            align-items: center;
            padding: 0 1.25rem;
            border-bottom: 1px solid #e5e7eb;
            background: #fff;
            font-weight: 600;
            font-size: 1rem;
        }

        .workspace {
            position: relative;
            flex: 1;
            min-height: 0;
            overflow: hidden;
        }

        .flex {
            display: flex;
        }

        .flex-row {
            flex-direction: row;
        }

        .flex-col {
            flex-direction: column;
        }

        .flex-1 {
            flex: 1 1 0%;
        }

        .h-full {
            height: 100%;
        }

        .w-full {
            width: 100%;
        }

        .min-w-0 {
            min-width: 0;
        }

        .min-h-0 {
            min-height: 0;
        }

        .overflow-hidden {
            overflow: hidden;
        }

        .border-r {
            border-right: 1px solid #e5e7eb;
        }

        .py-4 {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }

        .px-5 {
            padding-left: 1.25rem;
            padding-right: 1.25rem;
        }

        :deep(.autodown-editor) {
            border: none;
            border-radius: 0;
        }

        :deep(.autodown-editor-content-wrapper) {
            height: 100%;
            overflow-y: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        :deep(.autodown-editor-content-wrapper)::-webkit-scrollbar {
            display: none;
        }

        :deep(.streaming-document) {
            height: 100%;
            overflow-y: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
            /* Create a block formatting context so child margins do not collapse
               through the top padding of the scrolling container. */
            display: flow-root;
        }

        :deep(.streaming-document)::-webkit-scrollbar {
            display: none;
        }

        .splitter-hover-zone {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 50%;
            width: 16px;
            transform: translateX(-50%);
            z-index: 11;
            cursor: default;
            background: transparent;
            pointer-events: auto;
        }

        .splitter-hover-zone::after {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            left: 50%;
            width: 1px;
            background: rgba(0, 0, 0, 0.12);
            opacity: 0;
            transition: opacity 0.15s ease;
        }

        .splitter-hover-zone:hover::after {
            opacity: 1;
        }
    }
}
