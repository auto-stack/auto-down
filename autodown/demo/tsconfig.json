{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    // noUnusedLocals off: App.vue/CustomScrollbar.vue are auto-lang emitted and
    // discard widget-method results via `let _ =` (bare statement calls emit
    // broken TS — auto-lang emitter gap, see DEBTS.md plan 015).
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "auto/src/**/*.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
