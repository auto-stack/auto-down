{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    // lib ES2021 + paths：plan 051 gen 树引入 replaceAll（ES2021）与
    // `@/components/...` 别名导入——vite.config 有 alias 而 tsconfig 没有，
    // vue-tsc -b 在 master 曾红两项（051 验收走 e2e/vite dev 未触发）。
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    // noUnusedLocals off: App.vue/CustomScrollbar.vue are auto-lang emitted and
    // discard widget-method results via `let _ =` (bare statement calls emit
    // broken TS — auto-lang emitter gap, see DEBTS.md plan 015).
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "auto/src/**/*.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
