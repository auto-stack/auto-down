// auto_down_editor.at — AutoDownEditorInner widget: Auto widget DSL port of
// the original hand-written src/core/AutoDownEditor.vue assembly component
// (the original is kept as src/core/AutoDownEditor.vue.bak). The generated
// SFC is copied to src/core/AutoDownEditorInner.vue (see src/auto/README.md)
// and wrapped by a THIN hand-written shell (src/core/AutoDownEditor.vue)
// that keeps the package's public contract: the lowercase/hyphenated emit
// names (DSL component events are PascalCase-only), defineExpose (the DSL
// has no expose support; demo/jade-garden consume getBlockMap/$el) and the
// save-label/cancel-label slots (the DSL has no slot support — the shell
// passes functional components rendered via `dyn` instead).
//
// What lives here in the DSL: the whole assembly structure (EditorContent +
// the four menus gated on the editor instance + the Save/Cancel action
// buttons), the conditional rendering and class map, the content/canEdit
// prop watches that re-sync the tiptap editor, and the view-originated
// component events (SaveRequest/Cancel). What stays in the hand-written
// extension utils/auto_down_editor_ext.ts:
//
// 1. useAutoDownEditorBridge — the editor-creating composable. The DSL's
//    `composable:` imports are called with ZERO arguments at setup top
//    level, so the options object (props + emit-bridging callbacks) cannot
//    be assembled in the DSL; the bridge reads the component instance's
//    props via getCurrentInstance() and forwards tiptap's lifecycle
//    callbacks to callback PROPS passed by the shell (bridge-originated
//    component events would be undeclared — the codegen only declares
//    events for view-referenced handlers — and would fall through as
//    native DOM listeners on the root element). Returns the slash items
//    for the view's SlashMenu binding. useAutoDownEditor.ts itself is
//    untouched.
// 2. getSlashItems — the 30-item static slash command manifest. The items
//    carry lucide icon components as data (same gap as bubbleIcon) and
//    several commands are block-body closures with window.prompt /
//    navigator.clipboard / DOM walking (getCurrentBlockId uses
//    Node.TEXT_NODE + instanceof HTMLElement + closest — none expressible
//    in the DSL).
// 3. normalizeAnchors — the DSL has no regex literals (same gap as the
//    WikiLink [[title#blockId]] parser in node_view_ext).
// 4. EditorContent / the four menu components — re-exported through the
//    dual-resolution shim (a `use` path cannot leave src/; the gen project
//    has no @tiptap dependency and gets stub mirrors). The katex CSS
//    side-effect import lives in src/composables/tiptapEditorContent.ts
//    (editor tree only — the gen project has no katex dependency).
// 5. editorCheckIcon / editorXIcon — lucide re-exports for the `dyn`
//    render trick (same as codeBlockCheckIcon).
//
// Prop types are deliberately wide: `Array<str>` maps to TS `any`,
// `[]str` to `any[]` (bare `any` is rejected by the DSL name checker).
// All original props are declared so nothing falls through as attrs onto
// the root element. Runtime defaults are applied by the SHELL's
// withDefaults and arrive resolved via v-bind="$props" (generated prop
// defaults are not applied at runtime), so the DSL-side defaults below
// only affect optionality.
//
// The editor INSTANCE arrives as the `editor` prop: the bridge composable
// creates the editor inside this component (useEditor registers its
// onMounted/onBeforeUnmount at setup, as required) and reports the
// instance through the shell's editorReadyCb; the shell passes it back
// down. That keeps every view binding a plain prop/model reference — the
// composable local is only referenced once (`.autoDownEditorBridge` for
// the SlashMenu items, emitted verbatim by the codegen's dot-strip rule).

widget AutoDownEditorInner(content: str, placeholder: str = "", canEdit: bool = false, autofocus: bool = false, showActions: bool = false, saveLabel: str = "", cancelLabel: str = "", imageUrlPrompt: str = "", linkUrlPrompt: str = "", pageTitle: str = "", onOpenWikiLink: Array<str> = null, loadBlock: Array<str> = null, extraSlashItems: []str = null, onAssetUpload: Array<str> = null, taskWorkflow: str = "", runQuery: Array<str> = null, editor: Array<str> = null, focused: bool = false, saveLabelRender: Array<str> = null, cancelLabelRender: Array<str> = null, updateCb: Array<str> = null, blurCb: Array<str> = null, focusCb: Array<str> = null, linkClickCb: Array<str> = null, openWikiLinkCb: Array<str> = null, editorReadyCb: Array<str> = null) {
    use {
        fn: normalizeAnchors, editorCheckIcon, editorXIcon from "src/front/utils/auto_down_editor_ext.ts"
        component: EditorContent, BubbleMenu, SlashMenu, TableMenu, CodeBlockMenu from "src/front/utils/auto_down_editor_ext.ts"
        composable: useAutoDownEditorBridge from "src/front/utils/auto_down_editor_ext.ts"
    }

    msg Msg { SaveRequest, Cancel }

    model {
    }

    computed {
        // Lucide icons for the action buttons, rendered via dyn (the
        // codeBlockCheckIcon trick — PascalCase components inside the view
        // would get an auto-generated :key; dyn renders a plain
        // <component :is>).
        check_icon => editorCheckIcon()
        x_icon => editorXIcon()
    }

    view {
        div {
            class: "autodown-editor",
            style: { "is-focused": .focused },

            EditorContent {
                editor: .editor,
                class: "autodown-editor-content-wrapper"
            }
            // The original gates each menu on `v-if="editor"` with its own
            // directive; one shared `if` renders the identical DOM (the
            // template wrapper is transparent).
            if .editor {
                BubbleMenu {
                    editor: .editor,
                    linkPrompt: .linkUrlPrompt
                }
                SlashMenu {
                    editor: .editor,
                    items: .autoDownEditorBridge
                }
                TableMenu {
                    editor: .editor
                }
                CodeBlockMenu {
                    editor: .editor
                }
            }
            if .showActions {
                div {
                    class: "autodown-editor-actions",
                    button {
                        class: "autodown-save-btn",
                        onclick: .SaveRequest,
                        dyn (.check_icon) { size: 13 }
                        // The save-label slot fallback text: the shell
                        // passes a functional component that renders the
                        // slot content when given, the saveLabel text
                        // otherwise.
                        dyn (.saveLabelRender)
                    }
                    button {
                        class: "autodown-cancel-btn",
                        onclick: .Cancel,
                        dyn (.x_icon) { size: 13 }
                        dyn (.cancelLabelRender)
                    }
                }
            }
        }
    }

    watch {
        // Sync external content changes into the editor (the original's
        // watch on props.content with the anchor-normalized comparison).
        // The watch body reads props.content directly — by the time the
        // watcher fires it IS the new value. `{ emitUpdate: false, ... }`
        // is an inline object-literal argument (the scrollIntoView
        // precedent).
        .content -> {
            if .editor != null {
                let current = .editor.getMarkdown()
                if normalizeAnchors(current) != normalizeAnchors(.content) {
                    .editor.commands.setContent(.content, { emitUpdate: false, contentType: "markdown" })
                }
            }
        }
        // Plan 360: react to canEdit changes so a single editor instance
        // can toggle between read-only and editable without remounting.
        // The shell's withDefaults guarantees a defined boolean.
        .canEdit -> {
            if .editor != null {
                .editor.setEditable(.canEdit)
            }
        }
    }

    on {
        // Pure-emit handlers: the actual work lives in the shell (it owns
        // the editor instance and the public emit names). The bodies only
        // exist because an empty handler block does not parse.
        .SaveRequest -> {
            let noop_save = 0
        }
        .Cancel -> {
            let noop_cancel = 0
        }
    }
}
