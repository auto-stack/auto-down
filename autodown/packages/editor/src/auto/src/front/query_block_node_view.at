// query_block_node_view.at — QueryBlockNodeView widget: Auto widget DSL
// port of the original hand-written src/node-views/QueryBlockNodeView.vue.
// The generated SFC replaces it (see src/auto/README.md). All of the
// original logic lives here in the DSL — including the async load, written
// as a two-callback promise .then (the DSL has no async/await/try/finally;
// the finally's loading=false is duplicated into both callbacks, and the
// catch branch is the second .then argument). The shared hand-written
// extension utils/node_view_ext.ts keeps the tiptap NodeViewWrapper
// re-export (dual-resolution shim — the gen project has no @tiptap/*
// dependency), normalizeQueryResults (precomputes result.source =
// `title || page_path` and result.priority_label = `[#${priority}]` —
// per-item template fallbacks/interpolations are not expressible in the
// view: Call expressions emit null in bindings and an object-literal-
// returning map closure is ambiguous with a block-body closure) and strOr
// (a standalone `a || b` computed is mis-typed computed<boolean>).
//
// Prop types are deliberately wide: `Array<str>` maps to TS `any`, `[]str`
// to `any[]`. All eight NodeViewProps fields are declared (the original
// used defineProps<NodeViewProps>()) so nothing falls through as attrs.
//
// Idioms forced by real (probe-verified) codegen gaps — see
// details_node_view.at / wiki_link_node_view.at for the full list:
// - The original's error ref (string | null) becomes the "" sentinel
//   (model vars have one type); falsy either way, so the v-else-if chain
//   behaves identically.
// - The v-if / v-else-if / v-else state chain becomes four exclusive
//   named-boolean computeds (same rendered branch in every state).
// - `as: "div"` in PAREN form (as/type are keyword tokens and mis-parse in
//   the brace prop form).
// - The bare `data-query-block` attribute binds the empty string (renders
//   data-query-block="" — identical DOM to the original's valueless attr).
// - load() runs on mount via .Init and on query attr changes via watch —
//   the original's watch(..., { immediate: true }) (the DSL watch has no
//   immediate option; Init-on-mount + watch is equivalent).

widget QueryBlockNodeView(node: Array<str>, editor: Array<str>, updateAttributes: Array<str>, selected: bool, extension: Array<str>, getPos: Array<str>, deleteNode: Array<str>, decorations: []str) {
    use {
        component: NodeViewWrapper from "src/front/utils/node_view_ext.ts"
        fn: normalizeQueryResults, strOr from "src/front/utils/node_view_ext.ts"
    }

    msg Msg { Init }

    model {
        var results []str = []
        var loading bool = false
        var error_text str = ""
    }

    computed {
        query_text => strOr(.node.attrs.query, "")
        // Native tags the DSL maps to div (code/ul/li are not in its
        // element table) are rendered via dyn with a string tag —
        // <component :is="'code'"> renders a real <code> element.
        code_tag => "code"
        ul_tag => "ul"
        li_tag => "li"
        // The four mutually exclusive view states (the original's
        // v-if / v-else-if / v-else-if / v-else chain). Model vars are
        // AUTO-UNWRAPPED in computeds (`.loading` emits loading.value) —
        // unlike computed refs, which need the explicit `.value` form.
        show_loading => .loading
        show_error => !.loading && .error_text != ""
        show_results => !.loading && .error_text == "" && .results.length > 0
        show_empty => !.loading && .error_text == "" && .results.length == 0
    }

    view {
        NodeViewWrapper (as: "div") {
            class: "autodown-query-block",
            data-query-block: "",

            div {
                class: "query-header",
                span { class: "query-label", text "Query" }
                dyn (.code_tag) { class: "query-code", text .query_text }
            }
            if .show_loading {
                div { class: "query-state", text "Loading query…" }
            }
            if .show_error {
                div { class: "query-state query-error", text .error_text }
            }
            if .show_results {
                dyn (.ul_tag) {
                    class: "query-results",
                    for idx, result in .results {
                        dyn (.li_tag) {
                            class: "query-result",
                            span { class: "result-marker", text result.marker }
                            if result.priority {
                                span { class: "result-priority", text result.priority_label }
                            }
                            span { class: "result-content", text result.content }
                            span { class: "result-source", text result.source }
                        }
                    }
                }
            }
            if .show_empty {
                div { class: "query-state", text "No results" }
            }
        }
    }

    watch {
        // The original's watch(() => query.value, load) — the immediate
        // run happens in .Init (the DSL watch has no immediate option).
        // The load body is DUPLICATED here and in .Init: a msg handler
        // that no view event references is not emitted (`.Load()` would
        // call an undefined function), so a shared Load handler is not
        // viable — same constraint as SlashMenu's duplicated positioning
        // block.
        .query_text -> {
            let run = null
            let opts = .extension.options
            if opts != null {
                run = opts.runQuery
            }
            // Original: if (!run || !query.value) — sets the error and
            // returns (loading/results untouched).
            if run == null || .query_text.value == "" {
                .error_text = "No query runner configured"
            }
            if run != null && .query_text.value != "" {
                .loading = true
                .error_text = ""
                let p = run(.query_text.value)
                // try/catch/finally as a two-callback .then: resolve branch
                // = try, reject branch = catch, loading=false (finally) is
                // duplicated into both.
                p.then(res => {
                    .results = normalizeQueryResults(res)
                    .loading = false
                }, err => {
                    .error_text = err.message || String(err)
                    .results = []
                    .loading = false
                })
            }
        }
    }

    on {
        .Init -> {
            // load() — duplicated in the watch above (see the comment
            // there).
            let run = null
            let opts = .extension.options
            if opts != null {
                run = opts.runQuery
            }
            if run == null || .query_text.value == "" {
                .error_text = "No query runner configured"
            }
            if run != null && .query_text.value != "" {
                .loading = true
                .error_text = ""
                let p = run(.query_text.value)
                p.then(res => {
                    .results = normalizeQueryResults(res)
                    .loading = false
                }, err => {
                    .error_text = err.message || String(err)
                    .results = []
                    .loading = false
                })
            }
        }
    }

    style {
        .autodown-query-block {
          border: 1px solid hsl(var(--border, 220 13% 91%));
          border-radius: 0.375rem;
          background: hsl(var(--card, 0 0% 100%));
          padding: 0.75rem;
          margin: 0.5rem 0;
        }
        .query-header {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          margin-bottom: 0.5rem;
        }
        .query-label {
          font-size: 0.65rem;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          color: hsl(var(--primary, 238 55% 58%));
        }
        .query-code {
          font-size: 0.75rem;
          color: hsl(var(--muted-foreground, 220 9% 46%));
          background: hsl(var(--muted, 210 20% 96%));
          padding: 0.125rem 0.375rem;
          border-radius: 0.25rem;
        }
        .query-state {
          font-size: 0.75rem;
          color: hsl(var(--muted-foreground, 220 9% 46%));
        }
        .query-error {
          color: hsl(var(--destructive, 0 72% 51%));
        }
        .query-results {
          list-style: none;
          padding: 0;
          margin: 0;
          display: flex;
          flex-direction: column;
          gap: 0.25rem;
        }
        .query-result {
          font-size: 0.8rem;
          display: flex;
          align-items: baseline;
          gap: 0.35rem;
        }
        .result-marker {
          font-weight: 600;
          color: hsl(var(--primary, 238 55% 58%));
        }
        .result-priority {
          font-weight: 600;
          color: hsl(var(--amber-600, 45 93% 47%));
        }
        .result-content {
          flex: 1;
          color: hsl(var(--foreground, 224 64% 33%));
        }
        .result-source {
          font-size: 0.7rem;
          color: hsl(var(--muted-foreground, 220 9% 46%));
        }
    }
}
