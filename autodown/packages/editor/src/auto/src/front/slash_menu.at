// slash_menu.at — SlashMenu widget: Auto widget DSL port of the original
// hand-written src/menus/SlashMenu.vue. The generated SFC replaces it
// (see src/auto/README.md). Nearly all of the original logic lives here in
// the DSL; the hand-written extension utils/slash_menu_ext.ts only keeps the
// computeMenuPosition re-export (a `use` path cannot leave src/, so the real
// composables/useMenuBounds.ts is re-exported there — single source of
// truth) and the tiny noResultsOr helper (`??` is not supported in computed
// expressions, and a `||` computed would be mis-typed `computed<boolean>`).
//
// Prop types are deliberately wide: `Array<str>` is a generic instance,
// which the Vue backend maps to TS `any` (bare `any` is rejected by the
// name checker), and `[]str` (slice) maps to `any[]`. The DSL prop type
// system cannot express Tiptap's Editor or the SlashItem[] shape;
// behaviour is unaffected. `items` is `[]str` (not `Array<str>`) so the
// generated `props.items.filter((item) => ...)` gets a contextual type for
// the closure param — with a plain `any` prop vue-tsc strict reports
// TS7006 (implicit any).
//
// Idioms forced by real (probe-verified) codegen gaps:
// - `[a, b].concat(c).join(" ")` instead of `(a + " " + b).toLowerCase()`:
//   expression parentheses are dropped by the transpiler, so method calls
//   cannot be chained onto a concatenation; an array literal receiver needs
//   no parens and preserves the original join-then-match semantics.
// - `.filtered` in handlers/computeds: computed refs are not
//   auto-unwrapped outside the template (`.filtered` emits the raw
//   ComputedRef); the explicit `.value` field access emits correctly.
// - `.editor["view"]` bracket access: a field literally named `view` (a DSL
//   keyword) after a dot-chain is swallowed by the parser/codegen.
// - Intermediate locals for `(x + 1) % len`: parens are dropped, so the
//   wrap-around arithmetic is split to keep precedence.
// - The two-phase positioning block is duplicated in OnOpen/OnUpdate:
//   a statement starting with `.` glues onto the previous line's
//   expression, and a msg handler that no view event references is not
//   emitted — so a shared `.ApplyPosition()` helper handler is not viable.

widget SlashMenu(editor: Array<str>, items: []str, noResultsText: str = "No results") {
    use {
        fn: nextTick from "vue"
        fn: computeMenuPosition, noResultsOr from "src/front/utils/slash_menu_ext.ts"
    }

    msg Msg { OnOpen, OnUpdate, OnClose, OnKeydown, SelectItem, HoverItem }

    model {
        var visible bool = false
        var query str = ""
        var range Array<str> = null
        var selected_index int = 0
        var pos_top str = ""
        var pos_left str = ""
        var pos_visibility str = ""
    }

    computed {
        // filteredItems: lowercase substring match over the joined
        // title/description/searchTerms. Empty query matches everything
        // (''.includes('') === true), same as the original early return.
        filtered => .items.filter(item => [item.title, item.description].concat(item.searchTerms).join(" ").toLowerCase().contains(.query.toLowerCase()))
        // The template codegen mangles `.filtered.length` in a view `if`
        // (renders `filtered.lengthgth`), so emptiness is a named computed.
        is_empty => .filtered.length == 0
        empty_text => noResultsOr(.noResultsText)
    }

    view {
        if .visible {
            div {
                ref: "menuEl",
                class: "autodown-slash-menu",
                style_obj: { top: .pos_top, left: .pos_left, visibility: .pos_visibility },
                // document-level CustomEvent listeners (registered in
                // onMounted/onUnmounted regardless of the v-if above).
                on "autodown:slash-open".document: .OnOpen($event),
                on "autodown:slash-update".document: .OnUpdate($event),
                on "autodown:slash-close".document: .OnClose,
                on "autodown:slash-keydown".document: .OnKeydown($event)

                div {
                    class: "autodown-slash-menu-items",
                    for i, item in .filtered {
                        button {
                            class: "autodown-slash-menu-item",
                            style: { active: i == .selected_index },
                            onclick: .SelectItem(i),
                            onmouseenter: .HoverItem(i),
                            dyn (.item.icon) { size: 16, class: "autodown-slash-menu-icon" }
                            div {
                                class: "autodown-slash-menu-info",
                                div { class: "autodown-slash-menu-title", text item.title }
                                div { class: "autodown-slash-menu-desc", text item.description }
                            }
                        }
                    }
                    if .is_empty {
                        div { class: "autodown-slash-menu-empty", text .empty_text }
                    }
                }
            }
        }
    }

    watch {
        // Reset selection whenever the filtered list changes.
        .filtered -> { .selected_index = 0 }
    }

    on {
        .OnOpen(e) -> {
            .query = e.detail.query
            .range = e.detail.range
            .visible = true
            .selected_index = 0
            // Two-phase positioning (the original nextTick(updatePosition) +
            // useMenuBounds applyPosition): render hidden at the preferred
            // position, measure the real menu box on the next tick, then
            // flip/clamp into bounds and reveal. Duplicated in OnUpdate —
            // see the header comment.
            nextTick(() => {
                if .range != null && .editor["view"] {
                    let coords = .editor["view"].coordsAtPos(.range.from)
                    let editorEl = .editor["view"].dom.closest(".autodown-editor")
                    if editorEl != null {
                        let rect = editorEl.getBoundingClientRect()
                        let trigger = { top: coords.top - rect.top, left: coords.left - rect.left, bottom: coords.bottom - rect.top, right: coords.right - rect.left, width: coords.right - coords.left, height: coords.bottom - coords.top }
                        let container = { width: rect.width, height: rect.height }
                        let initial = computeMenuPosition(trigger, 0, 0, container, "bottom", 8, "left")
                        .pos_top = initial.top + "px"
                        .pos_left = initial.left + "px"
                        .pos_visibility = "hidden"
                        nextTick(() => {
                            // The template ref is null at open time (the menu
                            // has not mounted yet), so locate the menu inside
                            // the owning .autodown-editor — the same element
                            // menuEl would hold.
                            let menu = editorEl.querySelector(".autodown-slash-menu")
                            if menu != null {
                                let menuRect = menu.getBoundingClientRect()
                                let pos_final = computeMenuPosition(trigger, menuRect.width, menuRect.height, container, "bottom", 8, "left")
                                .pos_top = pos_final.top + "px"
                                .pos_left = pos_final.left + "px"
                                .pos_visibility = "visible"
                            }
                        })
                    }
                }
            })
        }

        .OnUpdate(e) -> {
            .query = e.detail.query
            .range = e.detail.range
            nextTick(() => {
                if .range != null && .editor["view"] {
                    let coords = .editor["view"].coordsAtPos(.range.from)
                    let editorEl = .editor["view"].dom.closest(".autodown-editor")
                    if editorEl != null {
                        let rect = editorEl.getBoundingClientRect()
                        let trigger = { top: coords.top - rect.top, left: coords.left - rect.left, bottom: coords.bottom - rect.top, right: coords.right - rect.left, width: coords.right - coords.left, height: coords.bottom - coords.top }
                        let container = { width: rect.width, height: rect.height }
                        let initial = computeMenuPosition(trigger, 0, 0, container, "bottom", 8, "left")
                        .pos_top = initial.top + "px"
                        .pos_left = initial.left + "px"
                        .pos_visibility = "hidden"
                        nextTick(() => {
                            let menu = editorEl.querySelector(".autodown-slash-menu")
                            if menu != null {
                                let menuRect = menu.getBoundingClientRect()
                                let pos_final = computeMenuPosition(trigger, menuRect.width, menuRect.height, container, "bottom", 8, "left")
                                .pos_top = pos_final.top + "px"
                                .pos_left = pos_final.left + "px"
                                .pos_visibility = "visible"
                            }
                        })
                    }
                }
            })
        }

        .OnClose -> {
            .visible = false
            .query = ""
            .range = null
            .selected_index = 0
        }

        .OnKeydown(e) -> {
            if .visible {
                if e.detail.event.key == "ArrowDown" {
                    e.detail.event.preventDefault()
                    // Intermediate locals: the transpiler drops expression
                    // parentheses, so `(x + 1) % len` would mis-emit as
                    // `x + 1 % len` (wrong precedence).
                    let next = .selected_index + 1
                    .selected_index = next % .filtered.length
                    // scrollActiveIntoView: keep the active item visible
                    // inside the scrollable list after keyboard navigation.
                    nextTick(() => {
                        if .menuEl {
                            let active = .menuEl.querySelector(".autodown-slash-menu-item.active")
                            if active != null {
                                active.scrollIntoView({ block: "nearest", behavior: "auto" })
                            }
                        }
                    })
                    // markHandled: tell the slash-command extension the key
                    // event was consumed.
                    if .editor.storage["slash-command"] != null {
                        .editor.storage["slash-command"].handled = true
                    }
                }
                if e.detail.event.key == "ArrowUp" {
                    e.detail.event.preventDefault()
                    let prev = .selected_index - 1 + .filtered.length
                    .selected_index = prev % .filtered.length
                    nextTick(() => {
                        if .menuEl {
                            let active = .menuEl.querySelector(".autodown-slash-menu-item.active")
                            if active != null {
                                active.scrollIntoView({ block: "nearest", behavior: "auto" })
                            }
                        }
                    })
                    if .editor.storage["slash-command"] != null {
                        .editor.storage["slash-command"].handled = true
                    }
                }
                if e.detail.event.key == "Enter" || e.detail.event.key == "NumpadEnter" {
                    e.detail.event.preventDefault()
                    // selectItem(selectedIndex): run the item command, close
                    // only when both the item and the range exist (the
                    // original's early return).
                    let item = .filtered[.selected_index]
                    if item != null && .range != null {
                        item.command({ editor: .editor, range: .range })
                        .visible = false
                        .query = ""
                        .range = null
                        .selected_index = 0
                    }
                    if .editor.storage["slash-command"] != null {
                        .editor.storage["slash-command"].handled = true
                    }
                }
                if e.detail.event.key == "Escape" {
                    e.detail.event.preventDefault()
                    .visible = false
                    .query = ""
                    .range = null
                    .selected_index = 0
                    if .editor.storage["slash-command"] != null {
                        .editor.storage["slash-command"].handled = true
                    }
                }
            }
        }

        .SelectItem(i) -> {
            let item = .filtered[i]
            if item != null && .range != null {
                item.command({ editor: .editor, range: .range })
                .visible = false
                .query = ""
                .range = null
                .selected_index = 0
            }
        }

        .HoverItem(i) -> {
            .selected_index = i
        }
    }
}
