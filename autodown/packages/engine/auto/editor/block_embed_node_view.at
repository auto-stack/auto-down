// block_embed_node_view.at — BlockEmbedNodeView widget: Auto widget DSL
// port of the original hand-written src/node-views/BlockEmbedNodeView.vue.
// The generated SFC replaces it (see auto/editor/README.plan013.md). All of the
// original logic lives here in the DSL — including the async load, written
// with real async/await + try/catch/finally (compiler >= plan 013 probe 07
// level; the old two-callback .then workaround is retired). The shared hand-written
// extension utils/node_view_ext.ts keeps the tiptap NodeViewWrapper
// re-export (dual-resolution shim — the gen project has no @tiptap/*
// dependency). strOr / orNull are retired: standalone || computeds now
// infer the operand type (plan 013 follow-up, probe 14 fix).
//
// Prop types are deliberately wide: `Array<str>` maps to TS `any`, `[]str`
// to `any[]`. All eight NodeViewProps fields are declared (the original
// used defineProps<NodeViewProps>()) so nothing falls through as attrs.
//
// Idioms forced by real (probe-verified) codegen gaps — see
// details_node_view.at / wiki_link_node_view.at /
// query_block_node_view.at for the full list:
// - The original's error ref (string | null) becomes the "" sentinel
//   (model vars have one type); falsy either way.
// - The v-if / v-else-if / v-else-if chain becomes three exclusive
//   named-boolean computeds. The original has NO else branch (nothing
//   renders while idle with no block) — neither does this port.
// - `as: "div"` in PAREN form (as/type are keyword tokens and mis-parse in
//   the brace prop form).
// - The original's `typeof loader !== 'function'` guard becomes `== null`
//   (the DSL has no typeof); differs only when loadBlock is configured to
//   a non-function truthy value, which never happens.
// - load() runs on mount via .Init and on blockId attr changes via watch —
//   the original's watch(..., { immediate: true }). The body is DUPLICATED
//   in both places: a msg handler that no view event references is not
//   emitted, so a shared handler is not viable (same constraint as
//   SlashMenu's duplicated positioning block).
// - loading_text / block_content are component-level computeds (per-item
//   template interpolation is not expressible in the view).

widget BlockEmbedNodeView(node: Array<str>, editor: Array<str>, updateAttributes: Array<str>, selected: bool, extension: Array<str>, getPos: Array<str>, deleteNode: Array<str>, decorations: []str) {
    use {
        component: NodeViewWrapper from "ext/node_view_ext.ts"
        fn: errorMessage from "ext/node_view_ext.ts"
    }

    msg Msg { Init }

    model {
        var block Array<str> = null
        var loading bool = false
        var error_text str = ""
    }

    computed {
        // The original's attrs computed as three scalars (an object literal
        // as a computed body emits invalid JS — see wiki_link_node_view.at).
        attr_raw => .node.attrs.raw || "![[Untitled]]"
        attr_title => .node.attrs.title || "Untitled"
        attr_block_id => .node.attrs.blockId || null
        // blockId ? `${title}#${blockId}` : title as a native ternary.
        display_label => .attr_block_id ? .attr_title + "#" + .attr_block_id : .attr_title
        // `Loading {{ displayLabel }}…` as a component-level computed.
        loading_text => "Loading " + .display_label + "…" || "Loading…"
        // block.content, guarded (block is null until loaded). `.block`
        // auto-unwraps to block.value in computeds.
        block_content => .block && .block.content || ""
        // The three mutually exclusive view states (the original's
        // v-if / v-else-if / v-else-if, no else). show_block uses bare
        // truthiness, NOT `.block != null` — the computed codegen emits
        // `!== undefined` for `!= null`, which is TRUE for a null block
        // (the error branch sets block = null), wrongly revealing the
        // header/content alongside the error.
        show_loading => .loading
        show_error => !.loading && .error_text != ""
        show_block => !.loading && .error_text == "" && .block
    }

    view {
        NodeViewWrapper (as: "div") {
            class: "autodown-block-embed",
            data-title: .attr_title,
            // attr_block_id is null when missing — Vue removes the
            // attribute for a null binding, same as the original's
            // `|| undefined`.
            data-block-id: .attr_block_id,

            if .show_loading {
                div { class: "embed-state", text .loading_text }
            }
            if .show_error {
                div { class: "embed-state embed-error", text .error_text }
            }
            if .show_block {
                div {
                    class: "embed-header",
                    span { class: "embed-title", text .display_label }
                }
            }
            if .show_block {
                div { class: "embed-content", text .block_content }
            }
        }
    }

    watch {
        // The original's watch(() => attrs.value.blockId, load) — the
        // immediate run happens in .Init (the DSL watch has no immediate
        // option). The load body is DUPLICATED here and in .Init (a msg
        // handler that no view event references is not emitted — see the
        // header comment).
        .attr_block_id -> {
            let id = .attr_block_id
            // Original: if (!id) return — no loader work without a blockId.
            if id != null {
                let loader = null
                let opts = .extension.options
                if opts != null {
                    loader = opts.loadBlock
                }
                if loader == null {
                    .error_text = "No block loader configured"
                }
                if loader != null {
                    .loading = true
                    .error_text = ""
                    // id.startsWith("^") ? id.slice(1) : id
                    let clean_id = id
                    if id.startsWith("^") {
                        clean_id = id.slice(1)
                    }
                    // Real async/await + try/catch/finally (plan 013;
                    // the two-callback .then is retired).
                    try {
                        var result = loader(clean_id).await
                        .block = result
                        if !result {
                            .error_text = "Block not found"
                        }
                    } catch (e) {
                        .error_text = errorMessage(e)
                        .block = null
                    } finally {
                        .loading = false
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            // load() — duplicated in the watch above (see the comment
            // there).
            let id = .attr_block_id
            if id != null {
                let loader = null
                let opts = .extension.options
                if opts != null {
                    loader = opts.loadBlock
                }
                if loader == null {
                    .error_text = "No block loader configured"
                }
                if loader != null {
                    .loading = true
                    .error_text = ""
                    let clean_id = id
                    if id.startsWith("^") {
                        clean_id = id.slice(1)
                    }
                    // Real async/await + try/catch/finally (plan 013;
                    // the two-callback .then is retired).
                    try {
                        var result = loader(clean_id).await
                        .block = result
                        if !result {
                            .error_text = "Block not found"
                        }
                    } catch (e) {
                        .error_text = errorMessage(e)
                        .block = null
                    } finally {
                        .loading = false
                    }
                }
            }
        }
    }

    style {
        .autodown-block-embed {
          border: 1px solid hsl(var(--border, 220 13% 91%));
          border-radius: 0.375rem;
          background: hsl(var(--muted, 210 20% 96%));
          padding: 0.75rem;
          margin: 0.5rem 0;
        }
        .embed-header {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          margin-bottom: 0.5rem;
        }
        .embed-title {
          font-size: 0.75rem;
          font-weight: 600;
          color: hsl(var(--primary, 238 55% 58%));
        }
        .embed-content {
          font-size: 0.875rem;
          color: hsl(var(--foreground, 224 64% 33%));
          white-space: pre-wrap;
        }
        .embed-state {
          font-size: 0.75rem;
          color: hsl(var(--muted-foreground, 220 9% 46%));
        }
        .embed-error {
          color: hsl(var(--destructive, 0 72% 51%));
        }
    }
}
