// code_editor_block.at — CodeEditorBlock widget (plan 023 P1T7).
//
// The code block's typed editing face: language title bar (code-block-header
// DOM contract, display-only in v1 — language changes stay on the code-block
// menu's IAL channel) over a multiline auto-resizing textarea with a syntax
// highlight overlay (plan 024 P4T1): an aria-hidden pre.code-editor-highlight
// carries the highlight-bridge HTML UNDER a transparent-text textarea (the
// classic overlay — caret and selection stay the textarea's). Host protocol
// preserved: while focused the textarea owns its text; blur commits the
// whole code back through the CodeEditorController the EngineEditor edit
// slot passes in (one undo step, engine kernel — see
// src/editor/engine/code-editor-controller.ts).
//
// Props are FLAT chrome primitives: the VM object (controller) arrives as a
// prop typed Array<str> (Vue backend emits `any`), the same idiom the
// DetailsNodeView widget uses for tiptap's node. Str/bool props stay real.
//
// Idioms (see details_node_view.at for the shared list):
// - `text .code` inside the textarea renders the initial/committed code —
//   the Vue SFC compiler turns textarea child interpolation into the value
//   binding, so SSR shows the code and repaints after blur-commit are
//   consistent with the model.
// - focus/resize DOM helpers come from the ext bridge (no element casts in
//   the DSL); .Init runs them on mount (BlockHost focus parity, skipped
//   when readonly).
// - `spellcheck` is not a keyword token — brace form is fine.

widget CodeEditorBlock(controller: Array<str>, blockId: str, language: str, code: str, readonly: bool) {
    use {
        fn: focusCodeArea, resizeCodeArea, renderCodeHighlight, syncCodeHighlight from "ext/code_editor_block_ext.ts"
    }

    msg Msg { Init, AreaInput, AreaScroll, Blur }

    model {
        // prop-initialized since the auto-lang TDZ fix (b4b74fd09):
        // defineProps now precedes the state refs, so the initializer is
        // safe again — SSR renders the committed code, no .Init backfill.
        var code_draft str = .code
    }

    computed {
        // highlight overlay HTML; degrades to escaped plain text so the
        // transparent-text textarea always has something under it
        highlight_html => renderCodeHighlight(.code_draft, .language)
    }

    view {
        div {
            class: "autodown-code-editor",
            style: { "is-readonly": .readonly },
            data-block-id: .blockId,
            data-node-type: "Fence",

            if .readonly {
                div {
                    class: "autodown-stream-banner",
                    text "流式生成中"
                }
            }
            div {
                class: "code-block-header flex justify-between items-center",
                div {
                    class: "code-header-main",
                    div {
                        class: "code-header-copy",
                        div {
                            class: "code-header-title",
                            text .language
                        }
                    }
                }
                div {
                    class: "flex items-center gap-0.5"
                }
            }
            div {
                class: "code-editor-stack",
                pre {
                    ref: "hl",
                    class: "code-editor-highlight",
                    aria-hidden: "true",
                    html: .highlight_html
                },
                textarea (spellcheck: "false") {
                    ref: "area",
                    class: "code-editor-textarea",
                    // v-model fold: value + oninput → v-model (the span-wrapping
                    // `text` is invalid inside a textarea — its content is raw
                    // text; compiler-ssr renders the v-model var as the content).
                    value: .code_draft,
                    oninput: .AreaInput($event),
                    onscroll: .AreaScroll($event),
                    disabled: .readonly,
                    onblur: .Blur($event)
                }
            }
        }
    }

    on {
        .Init -> {
            focusCodeArea(.area, .readonly)
            syncCodeHighlight(.area, .hl)
        }

        .AreaInput(e) -> {
            resizeCodeArea(e.target)
            syncCodeHighlight(e.target, .hl)
        }

        .AreaScroll(e) -> {
            syncCodeHighlight(e.target, .hl)
        }

        .Blur(e) -> {
            if !.readonly {
                let c = .controller
                c.commit(e.target.value)
            }
        }
    }

    style {
        .autodown-code-editor {
          border: 1px solid #e5e7eb;
          border-radius: 8px;
          background: #f8f9fa;
          overflow: hidden;
        }
        .autodown-code-editor.is-readonly {
          opacity: 0.75;
        }
        .autodown-stream-banner {
          padding: 0.3rem 0.75rem;
          font-size: 0.8rem;
          font-weight: 500;
          color: #92400e;
          background: #fef3c7;
          border-bottom: 1px solid #fcd34d;
          user-select: none;
        }
        .code-editor-stack {
          position: relative;
        }
        .code-editor-highlight {
          position: absolute;
          inset: 0;
          margin: 0;
          box-sizing: border-box;
          padding: 0.6rem 0.75rem;
          border: none;
          overflow: hidden;
          pointer-events: none;
          background: transparent;
          color: #111827;
          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 0.88rem;
          line-height: 1.5;
          white-space: pre-wrap;
          word-break: break-word;
        }
        .code-editor-textarea {
          display: block;
          width: 100%;
          box-sizing: border-box;
          min-height: 3rem;
          padding: 0.6rem 0.75rem;
          border: none;
          outline: none;
          resize: none;
          overflow: hidden;
          background: transparent;
          /* overlay plan 024 P4T1: the highlight pre below shows the text;
             the caret stays visible via caret-color */
          color: transparent;
          caret-color: #111827;
          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 0.88rem;
          line-height: 1.5;
          white-space: pre-wrap;
          word-break: break-word;
        }
        .code-editor-textarea:disabled {
          cursor: not-allowed;
        }
    }
}
