// mermaid_block_widget.at — MermaidBlockWidget (plan 033 T4): the mermaid
// family's three-mode widget, same shape as math_block_widget.at. ONE
// chrome source for view / stream / edit — merges:
//
// - view/stream: the MermaidNodeView contract (autodown-mermaid-block +
//   data-mermaid-block marker, svg preview / error banner, source pre >
//   code slot) with the artifact final-put riding the render bridge;
// - edit: the MermaidEditBlock contract (031): source textarea + debounced
//   async live preview tri-state (loading → svg / error), blur commits the
//   whole source through the CodeEditorController.
//
// Preview tri-state (async — mermaid.render initializes the whole library
// on first call, ~100ms class):
//   loading  -> div.mermaid-editor-loading "渲染中…" (covers the debounce
//               window too: the handler sets .loading before scheduling)
//   error    -> .autodown-mermaid-error banner, preview drops
//   svg      -> .autodown-mermaid-preview with native v-html
//
// The DSL has no timer primitives — the 300ms debounce + stale-version
// discard live in the ext bridge (scheduleMermaidRender); the widget's
// callback closure carries the { svg, error, loading } state back into the
// model. The view face's async render resolves via a single .then
// (renderMermaidPreview never rejects). See math_block_widget.at for the
// shared family idioms (single root, undefined-omission attrs, stream =
// view body per the 031 tri-state ruling).

widget MermaidBlockWidget(mode: str, node: Array<str>, ctx: Array<str>, final: bool) {
    use {
        fn: renderMermaidPreview, scheduleMermaidRender, focusCodeArea, textareaRows, nodeText, ctxReadonly, ctxBlockId, codeController, editOnlyAttr, viewMarker from "ext/mermaid_block_widget_ext.ts"
    }

    msg Msg { Init, AreaInput, Blur }

    model {
        // view face state ("" sentinel — the node-view idiom)
        var view_svg str = ""
        var view_error str = ""
        // edit face tri-state + draft + controller (031 MermaidEditBlock)
        var draft str = nodeText(.node)
        var svg str = ""
        var error_text str = ""
        var loading bool = false
        var controller Array<str> = codeController(.ctx)
    }

    computed {
        is_edit => .mode == "edit"
        source => nodeText(.node)
        readonly => ctxReadonly(.ctx)
        root_class => .is_edit ? (.readonly ? "autodown-mermaid-editor is-readonly" : "autodown-mermaid-editor") : "autodown-mermaid-block"
        root_mermaid_marker => viewMarker(.mode)
        root_block_id => editOnlyAttr(.mode, ctxBlockId(.ctx))
        root_node_type => editOnlyAttr(.mode, "Mermaid")
        // edit face tri-state (031 contract)
        show_edit_preview => .loading == false && .error_text == "" && .svg != ""
        show_edit_error => .loading == false && .error_text != ""
        rows_value => textareaRows(.draft)
        // view face (node-view contract: svg when present, error otherwise;
        // empty source renders neither)
        show_view_preview => .view_svg != ""
        show_view_error => .view_svg == "" && .view_error != ""
        code_tag => "code"
    }

    view {
        div {
            class: .root_class,
            data-mermaid-block: .root_mermaid_marker,
            data-block-id: .root_block_id,
            data-node-type: .root_node_type,

            if .is_edit {
                if .readonly {
                    div {
                        class: "autodown-stream-banner",
                        text "流式生成中"
                    }
                }
                div {
                    class: "mermaid-editor-stack",
                    if .show_edit_preview {
                        div {
                            class: "autodown-mermaid-preview",
                            html: .svg
                        }
                    }
                    if .show_edit_error {
                        div {
                            class: "autodown-mermaid-error",
                            title: "Mermaid render error",
                            text .error_text
                        }
                    }
                    if .loading {
                        div {
                            class: "mermaid-editor-loading",
                            text "渲染中…"
                        }
                    }
                    textarea (spellcheck: "false") {
                        ref: "area",
                        class: "mermaid-editor-textarea",
                        value: .draft,
                        rows: .rows_value,
                        oninput: .AreaInput($event),
                        disabled: .readonly,
                        onblur: .Blur($event)
                    }
                }
            }
            if !.is_edit {
                if .show_view_preview {
                    div {
                        class: "autodown-mermaid-preview",
                        html: .view_svg
                    }
                }
                if .show_view_error {
                    div {
                        class: "autodown-mermaid-error",
                        title: "Mermaid render error",
                        text .view_error
                    }
                }
                pre {
                    class: "mermaid-source",
                    dyn (.code_tag) {}
                }
            }
        }
    }

    watch {
        // The node view's watch(source) — view-face re-render on external
        // model changes; .Init duplicates the body (no immediate option).
        .source -> {
            if !.is_edit {
                if .source.trim() == "" {
                    .view_svg = ""
                    .view_error = ""
                }
                if .source.trim() != "" {
                    let p = renderMermaidPreview(.source)
                    p.then(res => {
                        .view_svg = res.svg
                        .view_error = res.error
                    })
                }
            }
        }
    }

    on {
        .Init -> {
            if .is_edit {
                focusCodeArea(.area, .readonly)
                .loading = true
                scheduleMermaidRender(.source, res => {
                    .svg = res.svg
                    .error_text = res.error
                    .loading = res.loading
                })
            }
            if !.is_edit {
                // render() — duplicated in the watch above.
                if .source.trim() == "" {
                    .view_svg = ""
                    .view_error = ""
                }
                if .source.trim() != "" {
                    let p = renderMermaidPreview(.source)
                    p.then(res => {
                        .view_svg = res.svg
                        .view_error = res.error
                    })
                }
            }
        }

        .AreaInput(e) -> {
            .draft = e.target.value
            .loading = true
            scheduleMermaidRender(.draft, res => {
                .svg = res.svg
                .error_text = res.error
                .loading = res.loading
            })
        }

        .Blur(e) -> {
            if !.readonly {
                let c = .controller
                c.commit(e.target.value)
            }
        }
    }

    style {
        .autodown-mermaid-block {
          border: 1px solid hsl(var(--border, 220 13% 91%));
          border-radius: 0.375rem;
          background: hsl(var(--card, 0 0% 100%));
          overflow: hidden;
        }
        .autodown-mermaid-preview {
          padding: 0.75rem 1rem;
          overflow-x: auto;
        }
        .autodown-mermaid-preview :deep(svg) {
          margin: 0 auto;
          display: block;
        }
        .autodown-mermaid-error {
          padding: 0.5rem 1rem;
          font-size: 0.75rem;
          color: hsl(var(--destructive, 0 72% 51%));
          background: hsl(var(--destructive/10, 0 72% 51% / 0.1));
        }
        .mermaid-source {
          margin: 0;
          border-top: 1px solid hsl(var(--border, 220 13% 91%));
          border-radius: 0;
          background: hsl(var(--muted, 210 20% 96%));
          padding: 0.5rem 0.75rem;
          font-size: 0.75rem;
          color: hsl(var(--muted-foreground, 220 9% 46%));
          /* the hole stays EMPTY by design (preview carries the content);
             normal collapses the generated template's indentation
             whitespace — the old NodeViewContent component rendered no
             text nodes, pre-wrap would bill two phantom lines (~40px) */
          white-space: normal;
        }
        /* family container chrome (plan 033 T7): ONE set of values for the
           container in every mode — the view face's document-card chrome is
           the family canon (the 031 edit face's gray #f8f9fa card is
           retired; parity suite pins border/radius/background equality). */
        .autodown-mermaid-editor {
          border: 1px solid hsl(var(--border, 220 13% 91%));
          border-radius: 0.375rem;
          background: hsl(var(--card, 0 0% 100%));
          overflow: hidden;
        }
        .autodown-mermaid-editor.is-readonly {
          opacity: 0.75;
        }
        .autodown-stream-banner {
          padding: 0.3rem 0.75rem;
          font-size: 0.8rem;
          font-weight: 500;
          color: #92400e;
          background: #fef3c7;
          border-bottom: 1px solid #fcd34d;
          user-select: none;
        }
        .mermaid-editor-stack {
          display: flex;
          flex-direction: column;
        }
        .mermaid-editor-stack .autodown-mermaid-preview {
          border-bottom: 1px solid #e5e7eb;
          background: #ffffff;
        }
        .mermaid-editor-stack .autodown-mermaid-preview :deep(svg) {
          max-width: 100%;
        }
        .mermaid-editor-stack .autodown-mermaid-error {
          border-bottom: 1px solid #e5e7eb;
        }
        .mermaid-editor-loading {
          padding: 0.5rem 1rem;
          font-size: 0.75rem;
          color: hsl(var(--muted-foreground, 220 9% 46%));
          background: hsl(var(--muted, 210 20% 96%));
          border-bottom: 1px solid #e5e7eb;
          user-select: none;
        }
        .mermaid-editor-textarea {
          display: block;
          width: 100%;
          box-sizing: border-box;
          min-height: 3rem;
          max-height: 24rem;
          padding: 0.6rem 0.75rem;
          border: none;
          outline: none;
          resize: none;
          overflow: auto;
          background: transparent;
          color: #111827;
          caret-color: #111827;
          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 0.88rem;
          line-height: 1.5;
          white-space: pre-wrap;
          word-break: break-word;
        }
        .mermaid-editor-textarea:disabled {
          cursor: not-allowed;
        }
    }
}
