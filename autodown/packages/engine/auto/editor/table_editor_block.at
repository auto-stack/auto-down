// table_editor_block.at — TableEditorBlock widget (plan 023 P1T8; toolbar
// absorbed the TableMenu verbs, plan 026 adjudication #1 — single entry).
//
// The table's typed editing face: a command toolbar (seven row/column/table
// verbs through the TableEditorController — commands.ts chain, ONE undo step each)
// over the table-node DOM contract (thead/th + tbody/td). Cell text follows
// the BlockHost protocol: the focused cell's DOM owns its text; blur
// commits via the ext bridge → controller.commitCell (diffToOp).
//
// Props are FLAT chrome data — the adapter in EngineEditor's plain script
// builds them from the BlockNode on every render (header_cells / body_rows as
// plain {id, text, cls} objects; blockText/attrGetStr are TS-side). Same
// boundary as code_editor_block.at (P1T7): model/logic in TS, chrome here.
//
// Idioms (see details_node_view.at / code_editor_block.at for the shared
// list): `type:` in PAREN form (keyword token); VM props typed Array<str>
// (emits `any`); button labels / cell text are `text` nodes (span-wrapped
// by the compiler — accepted DOM delta, inert for the table CSS).

widget TableEditorBlock(controller: Array<str>, blockId: str, readonly: bool, header_cells: Array<str>, body_rows: Array<str>) {
    use {
        fn: commitTableCell from "ext/table_editor_block_ext.ts"
    }

    msg Msg { AddRowAbove, AddRow, DeleteRow, AddColumnBefore, AddColumn, DeleteColumn, DeleteTable, CellBlur }

    view {
        div {
            class: "autodown-table-editor",
            style: { "is-readonly": .readonly },
            data-block-id: .blockId,
            data-node-type: "Table",

            if .readonly {
                div {
                    class: "autodown-stream-banner",
                    text "流式生成中"
                }
            }
            div {
                class: "te-toolbar",
                role: "toolbar",
                aria-label: "表格工具栏",
                button (type: "button") {
                    class: "te-btn",
                    data-te-action: "add-row-above",
                    title: "在上方插入一行",
                    disabled: .readonly,
                    onclick: .AddRowAbove,
                    text "行↑"
                }
                button (type: "button") {
                    class: "te-btn",
                    data-te-action: "add-row",
                    title: "在末尾后插入一行",
                    disabled: .readonly,
                    onclick: .AddRow,
                    text "行↓"
                }
                button (type: "button") {
                    class: "te-btn",
                    data-te-action: "delete-row",
                    title: "删除最后一行",
                    disabled: .readonly,
                    onclick: .DeleteRow,
                    text "删行"
                }
                button (type: "button") {
                    class: "te-btn",
                    data-te-action: "add-col-before",
                    title: "在左侧插入一列",
                    disabled: .readonly,
                    onclick: .AddColumnBefore,
                    text "列←"
                }
                button (type: "button") {
                    class: "te-btn",
                    data-te-action: "add-col",
                    title: "追加一列",
                    disabled: .readonly,
                    onclick: .AddColumn,
                    text "列→"
                }
                button (type: "button") {
                    class: "te-btn",
                    data-te-action: "delete-col",
                    title: "删除最后一列",
                    disabled: .readonly,
                    onclick: .DeleteColumn,
                    text "删列"
                }
                button (type: "button") {
                    class: "te-btn te-btn-danger",
                    data-te-action: "delete-table",
                    title: "删除整个表格",
                    disabled: .readonly,
                    onclick: .DeleteTable,
                    text "删表"
                }
            }
            table {
                class: "table-node",
                aria-busy: "false",
                thead {
                    tr {
                        for h_i, cell in .header_cells {
                            th {
                                key: cell.id,
                                dir: "auto",
                                class: cell.cls,
                                data-cell-id: cell.id,
                                contenteditable: .readonly == false,
                                spellcheck: "false",
                                onblur: .CellBlur($event),
                                text cell.text
                            }
                        }
                    }
                }
                tbody {
                    for r_i, row in .body_rows {
                        tr {
                            key: row.id,
                            for c_i, cell in row.cells {
                                td {
                                    key: cell.id,
                                    dir: "auto",
                                    class: cell.cls,
                                    data-cell-id: cell.id,
                                    contenteditable: .readonly == false,
                                    spellcheck: "false",
                                    onblur: .CellBlur($event),
                                    text cell.text
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .AddRowAbove -> {
            let c = .controller
            c.addRowAbove()
        }

        .AddRow -> {
            let c = .controller
            c.addRow()
        }

        .DeleteRow -> {
            let c = .controller
            c.deleteRow()
        }

        .AddColumn -> {
            let c = .controller
            c.addColumn()
        }

        .DeleteColumn -> {
            let c = .controller
            c.deleteColumn()
        }

        .DeleteTable -> {
            let c = .controller
            c.deleteTable()
        }

        .CellBlur(e) -> {
            if !.readonly {
                let c = .controller
                commitTableCell(c, e)
            }
        }
    }

    style {
        .autodown-table-editor {
          border: 1px solid #e5e7eb;
          border-radius: 8px;
          background: #ffffff;
          overflow: hidden;
        }
        .autodown-table-editor.is-readonly {
          opacity: 0.75;
        }
        .autodown-stream-banner {
          padding: 0.3rem 0.75rem;
          font-size: 0.8rem;
          font-weight: 500;
          color: #92400e;
          background: #fef3c7;
          border-bottom: 1px solid #fcd34d;
          user-select: none;
        }
        .te-toolbar {
          display: flex;
          gap: 0.25rem;
          padding: 0.35rem 0.5rem;
          background: hsl(220 9% 46% / 0.06);
          border-bottom: 1px solid #e5e7eb;
        }
        .te-btn {
          padding: 0.15rem 0.5rem;
          border: 1px solid #e5e7eb;
          border-radius: 4px;
          background: #ffffff;
          color: #374151;
          font-size: 0.8rem;
          line-height: 1.4;
          cursor: pointer;
        }
        .te-btn:hover:not(:disabled) {
          background: hsl(220 9% 46% / 0.1);
        }
        .te-btn:disabled {
          cursor: not-allowed;
          opacity: 0.6;
        }
        .te-btn.te-btn-danger {
          color: #b91c1c;
        }
        .te-btn.te-btn-danger:hover:not(:disabled) {
          background: hsl(0 74% 56% / 0.1);
        }
        .autodown-table-editor td[contenteditable='true'],
        .autodown-table-editor th[contenteditable='true'] {
          outline: none;
          cursor: text;
        }
        .autodown-table-editor td[contenteditable='true']:focus,
        .autodown-table-editor th[contenteditable='true']:focus {
          box-shadow: inset 0 0 0 1.5px #6366f1;
          border-radius: 2px;
        }
    }
}
