/* PLAN-087: autodown-reading/1. Byte-preserving Markdown projection and a
 * chapter-scoped index layered on the ordinary parser's block scan. */
use block_model: BlockNode
use markdown_parser: scanBlockRows, extractAnchorBlock, parse_projection_blocks, plainInlineText

pub type BookTarget {
    id str
    kind str
    line int
    start int
    end int
    paragraphId str
}

pub type BookCard {
    id str
    title str
    line int
    firstId str
    lastId str
    start int
    end int
}

pub type BookDiagnostic {
    code str
    chapterId str
    line int
    targetId str
}

pub type BookBlock {
    kind str
    start int
    end int
    id str
}

pub type BookChapter {
    id str
    source str
    markdown str
    blocks List<BookBlock>
    targets List<BookTarget>
    cards List<BookCard>
    diagnostics List<BookDiagnostic>
}

pub type BookProjection {
    cardId str
    title str
    start int
    end int
    markdown str
}

pub type BookSelection {
    chapterId str
    cardId str
    paragraphId str
    targetId str
    text str
    before str
    after str
}

type BookSpan {
    id str
    opening int
    closing int
    after int
}

fn bookIdChar(c int) bool {
    if c >= 65 && c <= 90 { return true }
    if c >= 97 && c <= 122 { return true }
    if c >= 48 && c <= 57 { return true }
    return c == 45 || c == 95
}

fn bookId(value str) bool {
    if value == "" { return false }
    for i in 0..value.length.to(int) {
        if !bookIdChar(value.char_at(i)) { return false }
    }
    return true
}

fn bookAdvanceSpace(text str, start int) int {
    var i = start
    while i < text.length.to(int) {
        let ch = text.char_at(i)
        if ch != 32 && ch != 9 { break }
        i += 1
    }
    return i
}

fn bookWordEnd(text str, start int) int {
    var i = start
    while i < text.length.to(int) {
        let ch = text.char_at(i)
        if ch == 32 || ch == 9 { break }
        i += 1
    }
    return i
}

fn isBookCardLine(line str) bool {
    if line.slice(0, 6) != "::card" { return false }
    if line.length.to(int) == 6 { return true }
    let next = line.char_at(6)
    return next == 32 || next == 9
}

fn readBookCard(row str, line int) BookCard {
    let start = bookAdvanceSpace(row, 6)
    let end = bookWordEnd(row, start)
    let key = row.slice(start, end)
    var titleStart = bookAdvanceSpace(row, end)
    var id = key
    var firstId = ""
    var lastId = ""
    if key.slice(0, 1) == "^" {
        id = key.slice(1)
        let rangeEnd = bookWordEnd(row, titleStart)
        let range = row.slice(titleStart, rangeEnd)
        let parts = range.split("..")
        if parts.length.to(int) <= 2 {
            let first = parts[0]
            let last = parts[parts.length.to(int) - 1]
            if first.slice(0, 1) == "^" && last.slice(0, 1) == "^" {
                firstId = first.slice(1)
                lastId = last.slice(1)
            }
        }
        if !bookId(firstId) || !bookId(lastId) {
            return BookCard(id, "", line, "", "", -1, -1)
        }
        titleStart = bookAdvanceSpace(row, rangeEnd)
    }
    let title = row.slice(titleStart).trim()
    return BookCard(id, title, line, firstId, lastId, -1, -1)
}

fn readBookSpan(text str, opening int, closing int) BookSpan {
    if closing <= opening + 1 || text.slice(closing + 1, closing + 3) != "{^" {
        return BookSpan("", opening, closing, closing + 1)
    }
    var end = closing + 3
    while end < text.length.to(int) {
        if !bookIdChar(text.char_at(end)) { break }
        end += 1
    }
    if end == closing + 3 || text.slice(end, end + 1) != "}" {
        return BookSpan("", opening, closing, closing + 1)
    }
    return BookSpan(text.slice(closing + 3, end), opening, closing, end + 1)
}

fn skipBookCode(text str, start int) int {
    var width = 1
    while text.char_at(start + width) == 96 { width += 1 }
    var i = start + width
    while i < text.length.to(int) {
        if text.char_at(i) != 96 {
            i += 1
            continue
        }
        var run = 1
        while text.char_at(i + run) == 96 { run += 1 }
        if run == width { return i + run }
        i += run
    }
    return start + width
}

type BookInline {
    spans List<BookSpan>
    containers List<BookSpan>
}

fn bookCloseLink(text str, start int, closing int) int {
    var i = start + 1
    var depth = 1
    let len = text.length.to(int)
    while i < len {
        let ch = text.char_at(i)
        if ch == 92 {
            i += 2
            continue
        }
        if ch == closing {
            depth -= 1
            if depth == 0 { return i }
        } else {
            if ch == text.char_at(start) { depth += 1 }
        }
        i += 1
    }
    return -1
}

fn bookWhite(c int) bool {
    return c == 32 || c == 9 || c == 10 || c == 13
}

fn bookCharCodes(text str) List<int> {
    var codes List<int> = []
    for i in 0..text.length.to(int) { codes.push(text.char_at(i)) }
    return codes
}

fn bookSpans(text str) BookInline {
    var spans List<BookSpan> = []
    var containers List<BookSpan> = []
    var brackets List<int> = []
    if text.split("[").length.to(int) < 2 { return BookInline(spans, containers) }
    let codes = bookCharCodes(text)
    var delimiters List<BookSpan> = []
    var i = 0
    let length = codes.length.to(int)
    while i < length {
        let ch = codes[i]
        if ch == 92 {
            i += 2
            continue
        }
        if ch == 96 {
            i = skipBookCode(text, i)
            continue
        }
        if ch == 42 || ch == 95 || ch == 126 {
            var end = i + 1
            while end < length && codes[end] == ch { end += 1 }
            let token = text.slice(i, end)
            var open = end < length && !bookWhite(codes[end])
            var close = i > 0 && !bookWhite(codes[i - 1])
            if ch == 95 && i > 0 && end < length {
                if bookIdChar(codes[i - 1]) && bookIdChar(codes[end]) {
                    open = false
                    close = false
                }
            }
            if ch != 126 || end - i == 2 {
                var paired = false
                let n = delimiters.length.to(int)
                if close && n > 0 {
                    let previous = delimiters[n - 1]
                    if previous.id == token {
                        containers.push(BookSpan("", previous.opening, i, end))
                        delimiters.pop()
                        paired = true
                    }
                }
                if open && !paired { delimiters.push(BookSpan(token, i, end, end)) }
            }
            i = end
            continue
        }
        if ch == 91 { brackets.push(i) }
        if ch == 93 && brackets.length.to(int) > 0 {
            let start = brackets[brackets.length.to(int) - 1]
            brackets.pop()
            let anchored = readBookSpan(text, start, i)
            if anchored.id != "" {
                spans.push(anchored)
                i = anchored.after
                continue
            }
            if i + 1 < length {
                let next = codes[i + 1]
                var closing = 0
                if next == 40 { closing = 41 }
                if next == 91 { closing = 93 }
                if closing != 0 {
                    let end = bookCloseLink(text, i + 1, closing)
                    if end >= 0 {
                        containers.push(BookSpan("", start, i, end + 1))
                        i = end + 1
                        continue
                    }
                }
            }
        }
        i += 1
    }
    return BookInline(spans, containers)
}

fn invalidBookSpan(item BookSpan, all BookInline) bool {
    for other in all.spans {
        if item.opening != other.opening && item.opening < other.after && other.opening < item.after {
            return true
        }
    }
    for container in all.containers {
        if item.opening < container.after && container.opening < item.after {
            let enclosed = item.opening < container.opening && container.after <= item.closing
            if !enclosed {
                return true
            }
        }
    }
    return false
}

fn bookTextUnits(text str) int {
    // Auto/JS uses code units. A native scalar above U+FFFF contributes two.
    var units = text.length.to(int)
    for i in 0..text.length.to(int) {
        if text.char_at(i) > 65535 { units += 1 }
    }
    return units
}

fn bookNativeIndex(text str, offset int) int {
    var units = 0
    var i = 0
    while units < offset && i < text.length.to(int) {
        units += 1
        if text.char_at(i) > 65535 { units += 1 }
        i += 1
    }
    return i
}

pub fn sliceBookText(text str, start int, end int) str {
    return text.slice(bookNativeIndex(text, start), bookNativeIndex(text, end))
}

fn bookLineOf(text str, index int, startLine int) int {
    return startLine + text.slice(0, index).split("\n").length.to(int) - 1
}

fn findBookTarget(targets List<BookTarget>, id str) BookTarget? {
    for target in targets {
        if target.id == id { return Some(target) }
    }
    return None
}

pub fn locateBookTarget(chapter BookChapter, id str) BookTarget? {
    var match BookTarget? = None
    for target in chapter.targets {
        if target.id == id {
            if match != None { return None }
            match = Some(target)
        }
    }
    if match == None { return None }
    for diagnostic in chapter.diagnostics {
        if diagnostic.code == "duplicate-id" && diagnostic.targetId == id { return None }
    }
    return match
}

pub fn projectBookChapter(chapter BookChapter, cardId str) BookProjection? {
    if cardId == "" {
        return Some(BookProjection("", "", 0, bookTextUnits(chapter.markdown), chapter.markdown))
    }
    for card in chapter.cards {
        if card.id == cardId && card.start >= 0 {
            let text = sliceBookText(chapter.markdown, card.start, card.end)
            return Some(BookProjection(card.id, card.title, card.start, card.end, text))
        }
    }
    return None
}

// Selection bounds are UTF-16 offsets in the displayed text of the visible
// portion of a single top-level paragraph. Context comes from the whole
// paragraph, including text outside the selected card.
pub fn locateBookSelection(chapter BookChapter, projection BookProjection, block BookBlock, start int, end int) BookSelection? {
    if block.kind != "paragraph" || start < 0 || end <= start { return None }
    var visibleStart = projection.start
    var visibleEnd = projection.end
    if visibleStart < block.start { visibleStart = block.start }
    if visibleEnd > block.end { visibleEnd = block.end }
    if visibleEnd <= visibleStart { return None }
    let visible = sliceBookText(chapter.markdown, visibleStart, visibleEnd)
    let plain = plainInlineText(visible)
    if end > bookTextUnits(plain) { return None }
    let prefix = sliceBookText(chapter.markdown, block.start, visibleStart)
    let context = plainInlineText(sliceBookText(chapter.markdown, block.start, block.end))
    let base = bookTextUnits(plainInlineText(prefix))
    let absoluteStart = base + start
    let absoluteEnd = base + end
    let contextEnd = bookTextUnits(context)
    if absoluteEnd > contextEnd { return None }
    var targetId = block.id.slice(0)
    if locateBookTarget(chapter, targetId) == None { targetId = "" }
    for target in chapter.targets {
        if target.kind == "span" && target.start >= block.start && target.end <= block.end {
            let beforeSpan = sliceBookText(chapter.markdown, block.start, target.start)
            let throughSpan = sliceBookText(chapter.markdown, block.start, target.end)
            let left = bookTextUnits(plainInlineText(beforeSpan))
            let right = bookTextUnits(plainInlineText(throughSpan))
            if absoluteStart >= left && absoluteEnd <= right {
                if locateBookTarget(chapter, target.id) != None { targetId = target.id.slice(0) }
                break
            }
        }
    }
    if targetId == "" { return None }
    return Some(BookSelection(chapter.id, projection.cardId, block.id, targetId,
        sliceBookText(context, absoluteStart, absoluteEnd),
        sliceBookText(context, 0, absoluteStart),
        sliceBookText(context, absoluteEnd, contextEnd)))
}

pub fn bookChapterTree(chapter BookChapter, isFinal bool) BlockNode {
    return parse_projection_blocks(chapter.markdown, isFinal)
}

pub fn serializeBookChapter(chapter BookChapter) str {
    return chapter.source
}

pub fn parseBookChapter(source str, chapterId str, isFinal bool) BookChapter {
    let normalized = source.split("\r\n").join("\n").split("\r").join("\n")
    let lines = normalized.split("\n")
    let rows = scanBlockRows(lines)
    var chapter = chapterId
    var markdown = ""
    var units = 0
    var cursor = 0
    var afterCard = false
    var active = -1
    var blocks List<BookBlock> = []
    var targets List<BookTarget> = []
    var cards List<BookCard> = []
    var diagnostics List<BookDiagnostic> = []
    var ids List<str> = []
    for block in rows {
        while cursor < block.first {
            let gap = lines[cursor]
            if !afterCard || gap != "" {
                markdown += gap + "\n"
                units += bookTextUnits(gap) + 1
            }
            cursor += 1
        }
        afterCard = false
        let first = lines[block.first]
        if block.kind == "paragraph" && isBookCardLine(first) {
            for row in block.first..block.end {
                active = -1
                let declaration = readBookCard(lines[row], row + 1)
                if !isBookCardLine(lines[row]) || !bookId(declaration.id) || declaration.title == "" {
                    diagnostics.push(BookDiagnostic("invalid-card", chapter, row + 1, declaration.id))
                    continue
                }
                ids.push(declaration.id.slice(0))
                if declaration.firstId == "" { active = cards.length.to(int) }
                cards.push(declaration)
            }
            cursor = block.end
            afterCard = true
            continue
        }
        if block.kind == "heading" { active = -1 }
        var pieces List<str> = []
        for row in block.first..block.end { pieces.push(lines[row]) }
        let raw = pieces.join("\n")
        var body = raw.slice(0)
        var id = ""
        let indent = bookAdvanceSpace(first, 0)
        let indentText = first.slice(0, indent)
        let literalBlock = indent >= 4 || indentText.split("\t").length.to(int) > 1
        if !literalBlock && (block.kind == "paragraph" || block.kind == "heading") {
            let candidate = extractAnchorBlock(raw)
            // Reading v1 consumes the exact final token, without normalizing
            // a trailing code span, spaces or escape sequences.
            if candidate != "" {
                let tail = " ^" + candidate
                let cut = raw.length.to(int) - tail.length.to(int)
                if raw.slice(cut) == tail {
                    id = candidate
                    body = raw.slice(0, cut)
                }
            }
        }
        if chapter == "" && block.kind == "heading" && id != "" { chapter = id }
        let blockStart = units
        if block.kind == "paragraph" && !literalBlock {
            let inline = bookSpans(body)
            var previous = 0
            for item in inline.spans {
                let line = bookLineOf(body, item.opening, block.first + 1)
                if invalidBookSpan(item, inline) {
                    diagnostics.push(BookDiagnostic("invalid-span-nesting", chapter, line, item.id))
                    continue
                }
                let before = body.slice(previous, item.opening)
                let content = body.slice(item.opening + 1, item.closing)
                markdown += before + content
                units += bookTextUnits(before)
                let end = units + bookTextUnits(content)
                targets.push(BookTarget(item.id, "span", line, units, end, id))
                ids.push(item.id.slice(0))
                units = end
                previous = item.after
            }
            body = body.slice(previous)
        }
        markdown += body + ""
        units += bookTextUnits(body)
        if id != "" {
            targets.push(BookTarget(id, block.kind, block.end, blockStart, units, id))
            ids.push(id)
        }
        blocks.push(BookBlock(block.kind, blockStart, units, id))
        if active >= 0 {
            var current = cards[active]
            if current.start < 0 { current.start = blockStart }
            current.end = units
            cards[active] = current
        }
        if block.end < lines.length.to(int) {
            markdown += "\n"
            units += 1
        }
        cursor = block.end
    }
    while cursor < lines.length.to(int) {
        let tail = lines[cursor]
        if !afterCard || tail != "" {
            markdown += tail
            if cursor + 1 < lines.length.to(int) { markdown += "\n" }
        }
        cursor += 1
    }
    if afterCard {
        while markdown.length.to(int) >= 2 {
            let end = markdown.length.to(int)
            if markdown.slice(end - 2) != "\n\n" { break }
            markdown = markdown.slice(0, end - 1)
        }
    }
    for i in 0..diagnostics.length.to(int) {
        var diagnostic = diagnostics[i]
        diagnostic.chapterId = chapter.slice(0)
        diagnostics[i] = diagnostic
    }
    // Diagnose every ambiguous declaration and keep it out of resolution.
    var duplicates List<str> = []
    for i in 0..ids.length.to(int) {
        let key = ids[i]
        for j in 0..i {
            if ids[j] == key {
                duplicates.push(key)
                break
            }
        }
    }
    for target in targets {
        for key in duplicates {
            if target.id == key {
                diagnostics.push(BookDiagnostic("duplicate-id", chapter, target.line, key))
                break
            }
        }
    }
    for i in 0..cards.length.to(int) {
        var card = cards[i]
        var bad = false
        for key in duplicates {
            if key == card.id || key == card.firstId || key == card.lastId { bad = true }
        }
        if bad {
            diagnostics.push(BookDiagnostic("duplicate-id", chapter, card.line, card.id))
            card.start = -1
        } else {
            if card.firstId != "" {
                let first = findBookTarget(targets, card.firstId)
                let last = findBookTarget(targets, card.lastId)
                if first == None || last == None {
                    if isFinal {
                        var missing = card.lastId.slice(0)
                        if first == None { missing = card.firstId.slice(0) }
                        diagnostics.push(BookDiagnostic("unknown-target", chapter, card.line, missing))
                    }
                } else {
                    let a = first ?? BookTarget("", "", 0, 0, 0, "")
                    let b = last ?? BookTarget("", "", 0, 0, 0, "")
                    if a.id != b.id && a.end > b.start {
                        diagnostics.push(BookDiagnostic("reversed-or-overlapping-range", chapter, card.line, card.id))
                    } else {
                        card.start = a.start
                        card.end = b.end
                    }
                }
            } else {
                if isFinal && card.start < 0 {
                    diagnostics.push(BookDiagnostic("empty-card", chapter, card.line, card.id))
                }
            }
        }
        cards[i] = card
    }
    return BookChapter(chapter, source, markdown, blocks, targets, cards, diagnostics)
}
