// AutoDown Core — IAL (Inline Attribute List) utilities, written in Auto.
//
// Transpile to TypeScript:
//   auto trans --path auto/ial.at ts
// (or run `pnpm gen`, which also applies the documented post-fixes — see auto/README.md)
//
// Dual-portable discipline (plan 019 Phase 1): no RegExp, no `any`, no
// lambdas/map/some, no parseInt/isNaN — the table+IAL extraction regex of the
// a2ts-only era is re-expressed as line scans so a2r can emit this file into
// the autodown-core rust crate. String ops stay within the proven subset
// (.slice/.length/.split/.join/==/+ with char_at code tests).
//
// Divergence note (registered in plan 019): the line scan requires table rows
// to start at column 0; the old regex could latch onto a mid-line `|`. Real
// documents always satisfy the stricter form.

pub type TableAttr {
    cols List<int?>
    rows List<int?>
}

pub type PreDoc {
    md str
    tableAttrs List<TableAttr>
}

// ------------------------------------------------------------- str helpers
// The dual-portable string vocabulary: everything the scanner needs on top
// of .slice/.length/.split/.join, expressed once so both targets share it.

pub fn startsWithStr(s str, prefix str) bool {
    if s.length.to(int) < prefix.length.to(int) { return false }
    return s.slice(0, prefix.length.to(int)) == prefix
}

pub fn startsWithAt(s str, prefix str, at int) bool {
    if at < 0 { return false }
    if at + prefix.length.to(int) > s.length.to(int) { return false }
    return s.slice(at, at + prefix.length.to(int)) == prefix
}

pub fn endsWithStr(s str, suffix str) bool {
    if s.length.to(int) < suffix.length.to(int) { return false }
    return s.slice(s.length.to(int) - suffix.length.to(int), s.length.to(int)) == suffix
}

pub fn trimStartStr(s str) str {
    var p int = 0
    while p < s.length.to(int) {
        let c = s.char_at(p)
        if c == 32 {
            p += 1
        } else {
            if c == 9 {
                p += 1
            } else {
                break
            }
        }
    }
    if p == 0 { return s }
    return s.slice(p)
}

pub fn trimEndStr(s str) str {
    var end int = s.length.to(int)
    while end > 0 {
        let c = s.char_at(end - 1)
        if c == 32 {
            end -= 1
        } else {
            if c == 9 {
                end -= 1
            } else {
                if c == 10 {
                    end -= 1
                } else {
                    if c == 13 {
                        end -= 1
                    } else {
                        break
                    }
                }
            }
        }
    }
    if end == s.length.to(int) { return s }
    return s.slice(0, end)
}

pub fn hasChar(s str, code int) bool {
    var i int = 0
    while i < s.length.to(int) {
        if s.char_at(i) == code { return true }
        i += 1
    }
    return false
}

pub fn findStr(s str, needle str) int {
    if needle.length.to(int) == 0 { return 0 }
    if s.length.to(int) < needle.length.to(int) { return -1 }
    var i int = 0
    while i + needle.length.to(int) <= s.length.to(int) {
        if s.slice(i, i + needle.length.to(int)) == needle { return i }
        i += 1
    }
    return -1
}

pub fn findStrFrom(s str, needle str, from int) int {
    if needle.length.to(int) == 0 {
        if from <= s.length.to(int) { return from }
        return -1
    }
    var i int = from
    if i < 0 { i = 0 }
    while i + needle.length.to(int) <= s.length.to(int) {
        if s.slice(i, i + needle.length.to(int)) == needle { return i }
        i += 1
    }
    return -1
}

pub fn rfindChar(s str, code int) int {
    var i int = s.length.to(int) - 1
    while i >= 0 {
        if s.char_at(i) == code { return i }
        i -= 1
    }
    return -1
}

// ---------------------------------------------------------------- scanners

// Leading digits of s as int (parseInt(s, 10) prefix semantics); None when
// no digits at all (the isNaN case).
pub fn scanIntPrefix(s str) int? {
    var i int = 0
    var neg bool = false
    if s.length.to(int) > 0 {
        if s.char_at(0) == 45 {
            neg = true
            i = 1
        } else {
            if s.char_at(0) == 43 {
                i = 1
            }
        }
    }
    var val int = 0
    var digits int = 0
    while i < s.length.to(int) {
        let c = s.char_at(i)
        if c >= 48 {
            if c <= 57 {
                val = val * 10 + (c - 48)
                digits += 1
                i += 1
            } else {
                break
            }
        } else {
            break
        }
    }
    if digits == 0 { return None }
    if neg { val = -val }
    return Some(val)
}

// Strip one leading and one trailing quote char (' or "), independently —
// replaces RegExp("^[\"']|[\"']$", "g") on the trimmed input.
fn stripQuotes(s str) str {
    let t = s.trim()
    if t.length.to(int) == 0 { return t }
    var start int = 0
    var end int = t.length.to(int)
    let c0 = t.char_at(0)
    if c0 == 34 {
        start = 1
    } else {
        if c0 == 39 {
            start = 1
        }
    }
    if end > start {
        let cl = t.char_at(end - 1)
        if cl == 34 {
            end = end - 1
        } else {
            if cl == 39 {
                end = end - 1
            }
        }
    }
    return t.slice(start, end)
}

fn parseValue(s str) int? {
    let trimmed = stripQuotes(s)
    if trimmed == "auto" { return None }
    return scanIntPrefix(trimmed)
}

fn parseArray(s str) List<int?> {
    let parts = s.split(",")
    var out List<int?> = []
    var i int = 0
    while i < parts.length.to(int) {
        let p = parts[i]
        out.push(parseValue(p))
        i += 1
    }
    return out
}

fn parseRows(s str?) List<int?> {
    let sv = s ?? ""
    if sv == "" { return [] }
    return parseArray(sv)
}

fn formatValue(v int?) str {
    if v == None { return "\"auto\"" }
    return (v ?? 0).to(str)
}

fn formatArray(arr List<int?>) str {
    var parts List<str> = []
    for v in arr {
        parts.push(formatValue(v))
    }
    return parts.join(",")
}

fn hasAnyValue(arr List<int?>) bool {
    var i int = 0
    while i < arr.length.to(int) {
        let v = arr[i]
        if v != None { return true }
        i += 1
    }
    return false
}

// -------------------------------------------------- table+IAL line scans

// Is `line` a table row line: starts with |, ends with | (trailing
// spaces/tabs ignored).
fn isPipeRow(line str) bool {
    var end int = line.length.to(int)
    while end > 0 {
        let c = line.char_at(end - 1)
        if c == 32 {
            end -= 1
        } else {
            if c == 9 {
                end -= 1
            } else {
                break
            }
        }
    }
    if end < 2 { return false }
    if line.char_at(0) != 124 { return false }
    if line.char_at(end - 1) != 124 { return false }
    return true
}

// Is `line` a delimiter row: | + [-:| \t]+ + | (trailing blanks stripped).
fn isDelimRow(line str) bool {
    var end int = line.length.to(int)
    while end > 0 {
        let c = line.char_at(end - 1)
        if c == 32 {
            end -= 1
        } else {
            if c == 9 {
                end -= 1
            } else {
                break
            }
        }
    }
    if end < 3 { return false }
    if line.char_at(0) != 124 { return false }
    if line.char_at(end - 1) != 124 { return false }
    var i int = 1
    while i < end - 1 {
        let c = line.char_at(i)
        var ok bool = false
        if c == 45 {
            ok = true
        } else {
            if c == 58 {
                ok = true
            } else {
                if c == 124 {
                    ok = true
                } else {
                    if c == 32 {
                        ok = true
                    } else {
                        if c == 9 {
                            ok = true
                        }
                    }
                }
            }
        }
        if !ok { return false }
        i += 1
    }
    return true
}

// Try to parse `line` as an IAL line {cols:[..](, rows:[..])?} (trailing
// blanks stripped). Lazy-bracket semantics: the FIRST ] closes each list,
// mirroring the (.*?) groups of the retired regex.
fn parseIalLine(line str) TableAttr? {
    var end int = line.length.to(int)
    while end > 0 {
        let c = line.char_at(end - 1)
        if c == 32 {
            end -= 1
        } else {
            if c == 9 {
                end -= 1
            } else {
                break
            }
        }
    }
    if end < 9 { return None }
    let s = line.slice(0, end)
    if !startsWithStr(s, "{cols:[") { return None }
    if !endsWithStr(s, "}") { return None }
    let bodyEnd int = s.length.to(int) - 1
    var c1 int = -1
    var i int = 7
    while i < bodyEnd {
        if s.char_at(i) == 93 {
            c1 = i
            break
        }
        i += 1
    }
    if c1 == -1 { return None }
    let cols = parseArray(s.slice(7, c1))
    var rows List<int?> = []
    let rest = s.slice(c1 + 1, bodyEnd)
    if rest != "" {
        if !startsWithStr(rest, ",") { return None }
        var r = rest.slice(1)
        var advancing bool = true
        while advancing {
            advancing = false
            if r.length.to(int) > 0 {
                let c = r.char_at(0)
                if c == 32 {
                    r = r.slice(1)
                    advancing = true
                } else {
                    if c == 9 {
                        r = r.slice(1)
                        advancing = true
                    } else {
                        if c == 10 {
                            r = r.slice(1)
                            advancing = true
                        } else {
                            if c == 13 {
                                r = r.slice(1)
                                advancing = true
                            }
                        }
                    }
                }
            }
        }
        if !startsWithStr(r, "rows:[") { return None }
        let r2 = r.slice(6)
        var c2 int = -1
        var k int = 0
        while k < r2.length.to(int) {
            if r2.char_at(k) == 93 {
                c2 = k
                break
            }
            k += 1
        }
        if c2 == -1 { return None }
        if c2 + 1 != r2.length.to(int) { return None }
        rows = parseArray(r2.slice(0, c2))
    }
    return Some(TableAttr(cols, rows))
}

// Pre-step for the strong parse path: extract {cols/rows} IAL lines that
// directly follow a table (header + delimiter + >=1 data rows) and strip
// them from the markdown; the extracted attrs attach to top-level tables in
// document order (see markdown_parser.at attachIAL).
pub fn preprocessMarkdown(md str) PreDoc {
    let lines = md.split("\n")
    var attrs List<TableAttr> = []
    var out List<str> = []
    var i int = 0
    while i < lines.length.to(int) {
        var matched bool = false
        if i + 1 < lines.length.to(int) {
            if isPipeRow(lines[i]) {
                if isDelimRow(lines[i + 1]) {
                    var j int = i + 2
                    var dataCount int = 0
                    var scanning bool = true
                    while scanning {
                        scanning = false
                        if j < lines.length.to(int) {
                            if isPipeRow(lines[j]) {
                                j += 1
                                dataCount += 1
                                scanning = true
                            }
                        }
                    }
                    if dataCount >= 1 {
                        if j < lines.length.to(int) {
                            let ial = parseIalLine(lines[j])
                            if ial != None {
                                attrs.push(ial ?? TableAttr([], []))
                                var k int = i
                                while k < j {
                                    out.push(lines[k])
                                    k += 1
                                }
                                i = j + 1
                                matched = true
                            }
                        }
                    }
                }
            }
        }
        if !matched {
            out.push(lines[i])
            i += 1
        }
    }
    return PreDoc(out.join("\n"), attrs)
}

pub fn buildIAL(colwidth List<int?>, rowheight List<int?>) str? {
    let hasCols = hasAnyValue(colwidth)
    let hasRows = hasAnyValue(rowheight)
    if !hasCols {
        if !hasRows { return None }
    }
    var parts List<str> = []
    if hasCols {
        parts.push("cols:[" + formatArray(colwidth) + "]")
    }
    if hasRows {
        parts.push("rows:[" + formatArray(rowheight) + "]")
    }
    return Some("{" + parts.join(", ") + "}\n")
}
