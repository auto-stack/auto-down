// @autodown/vue — StreamingTable prop normalization, written in Auto
// (plan 008, Phase 1).
//
// Transpiled to src/streaming-table.generated.ts by auto/gen.mjs (`pnpm gen`
// from packages/vue). Mirrors the `props.columns ?? []` / `props.rows ?? []`
// nullish defaults of the previous hand-written StreamingTable.vue script.

fn normalizeTableProps(columns any, rows any) (List<str>, List<any>) {
    var cols = columns
    if cols == nil { cols = [] }
    var data = rows
    if data == nil { data = [] }
    return (cols, data)
}
