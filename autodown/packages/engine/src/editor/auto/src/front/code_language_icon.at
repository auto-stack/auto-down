// code_language_icon.at — CodeLanguageIcon widget (Auto language source).
//
// Auto-generated replacement for the hand-written
// src/components/CodeLanguageIcon.vue. Regenerate with:
//
//   cd autodown/packages/editor/src/auto
//   AUTO=D:/autostack/auto-lang/.worktree/auto-down/target/debug/auto.exe bash gen/regen.sh
//
// The language -> icon URL mapping is imported from the real
// src/utils/codeBlockLanguage.ts via the utils/code_language_icon_ext.ts
// re-export (a `use` path cannot leave src/ — see README). `url` is a
// plain computed, matching the original's reactivity to `language` prop
// changes.

widget CodeLanguageIcon(language: str) {
    use {
        fn: getLanguageIconUrl from "src/front/utils/code_language_icon_ext.ts"
    }

    view {
        img {
            class: "code-language-icon",
            src: .url,
            alt: .language,
            width: 16,
            height: 16
        }
    }

    computed {
        url => getLanguageIconUrl(.language)
    }
}
