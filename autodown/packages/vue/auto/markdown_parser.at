// @autodown/vue -- incremental markdown parser (plan 008, Phase 2).
//
// Transpiled to src/markdown-parser.generated.ts by auto/gen.mjs (`pnpm gen`
// from packages/vue). Semantic subset aligned with stream-markdown-parser
// 0.0.95 (markdown-it default preset + streaming behavior); parity is
// asserted by src/__tests__/markdown-parity.test.ts against the real package
// under a documented semantic projection (noise fields raw/center/text/diff/
// maybeCheckbox/startLine/endLine/attrs are dropped).
//
// Subset (fixtures-driven): blocks heading(ATX+setext)/paragraph/fence/
// blockquote/list(ul+ol+start+nested+lazy+empty item)/thematic_break/table;
// inline text/strong/emphasis/inline_code/link/image/strikethrough/hardbreak.
// Out of subset (whitelisted): math, footnotes, mark/sub/sup/insert, :::
// containers, html blocks, typographer substitutions, linkify, escapes-as-
// emphasis quirk, indented code (treated as paragraph, matching the
// reference's fixIndentedCodeBlock behavior).
//
// a2ts workarounds (see auto/README.md): no ternaries (var + if/else), no
// destructuring, parentheses dropped around nested binaries (intermediate
// variables), RegExp("...") instead of literals, == nil as nullish check.

// ---------------------------------------------------------------- helpers

fn normalizeNewlines(src str) str {
    let s = src.replace(RegExp("\r\n", "g"), "\n")
    return s.replace(RegExp("\r", "g"), "\n")
}

// Streaming pre-parse: drop a dangling list/quote marker at the very end of
// the document so a half-typed "- " / "> " / "3. " does not flash an empty
// block (reference: safeMarkdown's strip of hanging stream-tail markers).
fn stripDanglingTail(src str, final bool) str {
    if final { return src }
    var s = src
    var changed bool = true
    while changed {
        changed = false
        let stripped = s.replace(RegExp("\n {0,3}([-*+]|\\d{1,9}[.)]) *$", ""), "")
        if stripped != s {
            s = stripped
            changed = true
        }
        let strippedQuote = s.replace(RegExp("\n {0,3}> *$", ""), "")
        if strippedQuote != s {
            s = strippedQuote
            changed = true
        }
    }
    return s
}

fn isBlank(line str) bool {
    return line.trim() == ""
}

fn indentOf(line str) int {
    var n int = 0
    while n < line.length {
        let ch = line[n]
        if ch == " " {
            n += 1
        } else {
            break
        }
    }
    return n
}

fn indentWidth(s str) int {
    var n int = 0
    var i int = 0
    while i < s.length {
        let ch = s[i]
        if ch == " " {
            n += 1
        } else {
            if ch == "\t" {
                n += 4
            } else {
                break
            }
        }
        i += 1
    }
    return n
}

// ---------------------------------------------------------------- blocks

fn parseDocument(src str, final bool) List<any> {
    let normalized = normalizeNewlines(src)
    let safe = stripDanglingTail(normalized, final)
    let lines = safe.split("\n")
    return parseBlocks(lines, final)
}

// Check whether a line opens a fence: returns marker char, or "" when not a
// fence. fenceOpenChar/ fenceOpenInfo/fenceContentStart are separate probes
// because Auto has no tuples-in-conditions.
fn fenceMarker(line str) str {
    if indentWidth(line) >= 4 { return "" }
    let t = line.trim()
    if t.startsWith("```") { return "`" }
    if t.startsWith("~~~") { return "~" }
    return ""
}

fn fenceMarkerRun(line str) str {
    let t = line.trim()
    var run str = ""
    var i int = 0
    let first = t[0]
    if first != "`" {
        if first != "~" { return "" }
    }
    while i < t.length {
        let ch = t[i]
        if ch == first {
            run = run + ch
            i += 1
        } else {
            break
        }
    }
    return run
}

fn isCloseFence(line str, marker str, run str) bool {
    if indentWidth(line) >= 4 { return false }
    let t = line.trim()
    if t.length != run.length { return false }
    var i int = 0
    while i < t.length {
        if t[i] != marker { return false }
        i += 1
    }
    return true
}

// ATX heading level (1..6), or 0 when the line is not a heading.
fn headingLevel(line str) int {
    if indentWidth(line) >= 4 { return 0 }
    let t = line.trim()
    var level int = 0
    while level < t.length {
        if t[level] == "#" {
            level += 1
        } else {
            break
        }
    }
    if level == 0 { return 0 }
    if level > 6 { return 0 }
    if level == t.length { return level }
    let after = t[level]
    if after != " " { return 0 }
    return level
}

// Strip trailing " ###" sequences from ATX heading content.
fn stripTrailingHashes(t str) str {
    let trimmed = t.trim()
    let m = trimmed.match(RegExp("^(.*?)( #{1,})#*$"))
    if m == nil { return trimmed }
    let body = m[1]
    return body.trimEnd()
}

// Ordered list marker: returns the number, or -1 when not an ordered marker.
fn olMarkerNum(line str) int {
    if indentWidth(line) >= 4 { return -1 }
    let m = line.match(RegExp("^ {0,3}(\\d{1,9})[.)] |^ {0,3}(\\d{1,9})[.)]$"))
    if m == nil { return -1 }
    if m[1] != nil { return parseInt(m[1], 10) }
    return parseInt(m[2], 10)
}

// Bullet list marker char, or "" when not a bullet item start.
fn bulletMarker(line str) str {
    if indentWidth(line) >= 4 { return "" }
    let m = line.match(RegExp("^ {0,3}([-*+]) "))
    if m == nil { return "" }
    return m[1]
}

// marker line forms like "- " alone at end also match via the $ branch
fn bulletMarkerBare(line str) bool {
    if indentWidth(line) >= 4 { return false }
    let m = line.match(RegExp("^ {0,3}[-*+]$"))
    if m == nil { return false }
    return true
}

fn isThematicBreak(line str) bool {
    if indentWidth(line) >= 4 { return false }
    let t = line.trim()
    if t.length < 3 { return false }
    let first = t[0]
    if first != "-" {
        if first != "*" {
            if first != "_" { return false }
        }
    }
    var count int = 0
    var i int = 0
    while i < t.length {
        let ch = t[i]
        if ch == first {
            count += 1
        } else {
            if ch != " " { return false }
        }
        i += 1
    }
    return count >= 3
}

fn isSetextUnderline(line str) int {
    // returns 1 for =+, 2 for -+, 0 otherwise
    if indentWidth(line) >= 4 { return 0 }
    let t = line.trim()
    if t.length == 0 { return 0 }
    let first = t[0]
    if first != "=" {
        if first != "-" { return 0 }
    }
    var i int = 0
    while i < t.length {
        if t[i] != first { return 0 }
        i += 1
    }
    if first == "=" { return 1 }
    return 2
}

fn startsBlockquote(line str) bool {
    if indentWidth(line) >= 4 { return false }
    return line.trimStart().startsWith(">")
}

fn quoteBody(line str) str {
    let t = line.trimStart()
    let rest = t.slice(1)
    if rest.startsWith(" ") { return rest.slice(1) }
    return rest
}

// GFM table: does `line` look like a row (contains a pipe, not blank)?
fn isTableRow(line str) bool {
    if isBlank(line) { return false }
    return line.includes("|")
}

fn isTableDelimiter(line str) bool {
    if isBlank(line) { return false }
    if !line.includes("-") { return false }
    // every cell must be :--/-/:--: style; a partial row being typed
    // ("| -", "| ---") is NOT a delimiter yet
    let cells = splitRowCells(line)
    if cells.length == 0 { return false }
    for c in cells {
        let t = c.trim()
        let m = t.match(RegExp("^:?-+:?$"))
        if m == nil { return false }
    }
    return true
}

// Split "| a | b |" -> ["a", "b"] (leading/trailing pipes optional).
fn splitRowCells(line str) List<str> {
    var t = line.trim()
    if t.startsWith("|") { t = t.slice(1) }
    if t.endsWith("|") { t = t.slice(0, t.length - 1) }
    return t.split("|")
}

fn delimiterAlign(cell str) str {
    let t = cell.trim()
    let left = t.startsWith(":")
    let right = t.endsWith(":")
    if left {
        if right { return "center" }
        return "left"
    }
    if right { return "right" }
    return "left"
}

// Core block-level scan over a line range (0-based, end exclusive).
fn parseBlocks(lines List<str>, final bool) List<any> {
    var nodes List<any> = []
    var i int = 0
    while i < lines.length {
        let line = lines[i]
        if isBlank(line) {
            i += 1
            continue
        }

        // --- fenced code ---
        let mk = fenceMarker(line)
        if mk != "" {
            let run = fenceMarkerRun(line)
            let info = line.trim().slice(run.length)
            let language = info.trim()
            var body List<str> = []
            var j = i + 1
            var closed bool = false
            while j < lines.length {
                if isCloseFence(lines[j], mk, run) {
                    closed = true
                    break
                }
                body.push(lines[j])
                j += 1
            }
            var code = body.join("\n")
            if closed {
                if body.length > 0 {
                    code = code + "\n"
                } else {
                    code = ""
                }
                nodes.push({type: "code_block", language: language, code: code, loading: false})
            } else {
                // a trailing partial close-fence line (only ` or ~ chars)
                // belongs to the fence being typed, not to the code body
                while body.length > 0 {
                    let tailLine = body[body.length - 1].trim()
                    if tailLine == "" {
                        break
                    }
                    let fenceTail = tailLine.match(RegExp("^[`~]+$"))
                    if fenceTail == nil {
                        break
                    }
                    body.pop()
                }
                var openCode = body.join("\n")
                // trailing spaces on the (empty) last line of an unclosed
                // fence are dropped; a partial content line keeps them
                openCode = openCode.replace(RegExp("\n +$"), "\n")
                nodes.push({type: "code_block", language: language, code: openCode, loading: !final})
            }
            i = j + 1
            continue
        }

        // --- ATX heading ---
        let hlevel = headingLevel(line)
        if hlevel > 0 {
            let t = line.trim()
            let content = t.slice(hlevel).trim()
            let clean = stripTrailingHashes(content)
            var children = parseInline(clean, final)
            if clean == "" {
                children = []
            }
            nodes.push({type: "heading", level: hlevel, children: children})
            i += 1
            continue
        }

        // --- thematic break ---
        if isThematicBreak(line) {
            nodes.push({type: "thematic_break"})
            i += 1
            continue
        }

        // --- blockquote ---
        if startsBlockquote(line) {
            var qlines List<str> = []
            var j = i
            while j < lines.length {
                if startsBlockquote(lines[j]) {
                    qlines.push(quoteBody(lines[j]))
                    j += 1
                } else {
                    if isBlank(lines[j]) { break }
                    // lazy continuation: paragraph line without > extends quote
                    if isParagraphStart(lines[j]) {
                        qlines.push(lines[j])
                        j += 1
                    } else {
                        break
                    }
                }
            }
            let inner = parseBlocks(qlines, final)
            nodes.push({type: "blockquote", children: inner})
            i = j
            continue
        }

        // --- table ---
        if isTableRow(line) {
            if i + 1 < lines.length {
                if isTableDelimiter(lines[i + 1]) {
                    // the delimiter row must have as many cells as the
                    // header — a partially-typed row falls through to the
                    // streaming pre-parse path
                    let headCount = splitRowCells(line).length
                    let delimCount = splitRowCells(lines[i + 1]).length
                    if headCount == delimCount {
                        var tableEnd = tableConsume(lines, i, nodes, final)
                        i = tableEnd
                        continue
                    }
                }
            }
        }

        // --- lists ---
        let bnum = olMarkerNum(line)
        let bmark = bulletMarker(line)
        if bnum >= 0 {
            var listEnd = parseList(lines, i, true, bnum, nodes, final)
            i = listEnd
            continue
        }
        if bmark != "" {
            var listEnd2 = parseList(lines, i, false, 0, nodes, final)
            i = listEnd2
            continue
        }
        if bulletMarkerBare(line) {
            // "-" alone: a bullet item with empty content
            var bareEnd = parseList(lines, i, false, 0, nodes, final)
            i = bareEnd
            continue
        }

        // --- paragraph (with setext heading lookahead) ---
        var para List<str> = []
        var j = i
        var setextLevel = 0
        while j < lines.length {
            let cur = lines[j]
            if isBlank(cur) { break }
            if para.length > 0 {
                let su = isSetextUnderline(cur)
                if su > 0 {
                    setextLevel = su
                    j += 1
                    break
                }
            }
            if paraBreaks(cur, lines, j) { break }
            para.push(cur.replace(RegExp("^ {0,4}"), ""))
            j += 1
        }
        if setextLevel > 0 {
            let content = para.join("\n")
            let children = parseInline(content, final)
            nodes.push({type: "heading", level: setextLevel, children: children})
            i = j
            continue
        }
        if para.length > 0 {
            // streaming: a "| a | b |" header line followed by more content
            // pre-parses as a loading table while the delimiter row is still
            // being typed
            if !final {
                var preOk bool = false
                if para.length >= 2 {
                    preOk = true
                }
                if j < lines.length {
                    preOk = true
                }
                if preOk {
                    let head = para[0]
                    if isTableRow(head) {
                        if head.trim().endsWith("|") {
                            let preCells = splitRowCells(head)
                            if preCells.length >= 2 {
                                var allPipes bool = true
                                var pi int = 0
                                while pi < para.length {
                                    let pl = para[pi].trim()
                                    if !pl.startsWith("|") {
                                        allPipes = false
                                    }
                                    pi += 1
                                }
                                if allPipes {
                                    var preRow List<any> = []
                                    for pc in preCells {
                                        let pt = pc.trim()
                                        let pChildren = parseInline(pt, final)
                                        preRow.push({type: "table_cell", header: true, children: pChildren, align: "left"})
                                    }
                                    let preHeader = {type: "table_row", cells: preRow}
                                    nodes.push({type: "table", header: preHeader, rows: [], loading: true})
                                    i = j
                                    continue
                                }
                            }
                        }
                    }
                }
            }
            let content = para.join("\n")
            let children = parseInline(content, final)
            nodes.push({type: "paragraph", children: children})
            i = j
            continue
        }
        i += 1
    }
    return nodes
}

// Would a paragraph starting/continuing at `idx` be broken by this line?
fn paraBreaks(cur str, lines List<str>, idx int) bool {
    if idx == 0 { return false }
    if fenceMarker(cur) != "" { return true }
    if headingLevel(cur) > 0 { return true }
    if isThematicBreak(cur) { return true }
    if startsBlockquote(cur) { return true }
    if bulletMarker(cur) != "" { return true }
    if bulletMarkerBare(cur) { return true }
    if olMarkerNum(cur) >= 0 { return true }
    return false
}

// Whether a standalone line can start a plain paragraph (used for quote lazy
// continuation).
fn isParagraphStart(line str) bool {
    if paraBreaks(line, [], 0) { return false }
    return true
}

// Parse a list starting at lines[start]; ordered per `ordered`/`firstNum`.
// Appends one list node; returns index after the list.
fn parseList(lines List<str>, start int, ordered bool, firstNum int, nodes List<any>, final bool) int {
    var items List<any> = []
    var i = start
    var startAttr any = nil
    if ordered {
        if firstNum != 1 {
            startAttr = firstNum
        }
    }
    while i < lines.length {
        let line = lines[i]
        if isBlank(line) {
            // blank: list continues only if a next item follows after it
            var k = i + 1
            while k < lines.length {
                if isBlank(lines[k]) {
                    k += 1
                } else {
                    break
                }
            }
            if k < lines.length {
                if bulletMarker(lines[k]) != "" {
                    i = k
                    continue
                }
                if bulletMarkerBare(lines[k]) {
                    i = k
                    continue
                }
                if olMarkerNum(lines[k]) >= 0 {
                    i = k
                    continue
                }
            }
            break
        }

        var markerIndent int = 0
        var contentStart int = 0
        var isItem bool = false
        var orderedHere bool = false
        let bm = bulletMarker(line)
        let om = olMarkerNum(line)
        if bm != "" {
            markerIndent = indentOf(line)
            let t = line.trimStart()
            contentStart = 2 + indentOf(line)
            isItem = true
            orderedHere = false
        } else {
            if bulletMarkerBare(line) {
                markerIndent = indentOf(line)
                contentStart = 1 + indentOf(line)
                isItem = true
                orderedHere = false
            } else {
                if om >= 0 {
                    markerIndent = indentOf(line)
                    let t = line.trimStart()
                    let m = t.match(RegExp("^(\\d{1,9}[.)])( *)"))
                    if m != nil {
                        let markerWidth = m[1].length
                        var spaces = m[2].length
                        if spaces > 4 { spaces = 1 }
                        if spaces < 1 { spaces = 1 }
                        contentStart = markerIndent + markerWidth + spaces
                        isItem = true
                        orderedHere = true
                    }
                }
            }
        }

        if !isItem { break }
        if orderedHere != ordered { break }
        if !ordered {
            // same bullet char required to continue the list
            let t = line.trimStart()
            let firstChar = t[0]
            let firstItem = lines[start].trimStart()
            let listChar = firstItem[0]
            if firstChar != listChar { break }
        }

        // collect this item's lines
        var itemLines List<str> = []
        var firstText = line.slice(contentStart)
        itemLines.push(firstText)
        i += 1
        while i < lines.length {
            let cur = lines[i]
            if isBlank(cur) {
                // lookahead: blank followed by more indented content stays
                var k = i + 1
                while k < lines.length {
                    if isBlank(lines[k]) {
                        k += 1
                    } else {
                        break
                    }
                }
                if k < lines.length {
                    if indentWidth(lines[k]) >= contentStart {
                        if paraBreaks(lines[k], lines, k) {
                            // indented block start inside item
                        } else {
                            // continuation paragraph
                        }
                        var bi = i
                        while bi < k {
                            itemLines.push("")
                            bi += 1
                        }
                        i = k
                        continue
                    }
                }
                break
            }
            if indentWidth(cur) >= contentStart {
                var dedent = cur.slice(contentStart)
                itemLines.push(dedent)
                i += 1
                continue
            }
            // lazy continuation: plain paragraph text continues the item
            if !paraBreaks(cur, lines, i) {
                itemLines.push(cur)
                i += 1
                continue
            }
            break
        }
        let itemNodes = parseBlocks(itemLines, final)
        items.push({type: "list_item", children: itemNodes})
    }
    if ordered {
        if startAttr != nil {
            nodes.push({type: "list", ordered: true, start: startAttr, items: items})
        } else {
            nodes.push({type: "list", ordered: true, items: items})
        }
    } else {
        nodes.push({type: "list", ordered: false, items: items})
    }
    return i
}

// Consume a table starting at lines[start] (header row). Appends the table
// node; returns index after the table.
fn tableConsume(lines List<str>, start int, nodes List<any>, final bool) int {
    let headerCells = splitRowCells(lines[start])
    let aligns List<str> = []
    let delimCells = splitRowCells(lines[start + 1])
    for c in delimCells {
        aligns.push(delimiterAlign(c))
    }
    var rows List<any> = []
    var i = start + 2
    while i < lines.length {
        if !isTableRow(lines[i]) { break }
        let cells = splitRowCells(lines[i])
        var rowCells List<any> = []
        var ci = 0
        while ci < headerCells.length {
            var cellText = ""
            if ci < cells.length {
                cellText = cells[ci].trim()
            }
            var align = "left"
            if ci < aligns.length {
                align = aligns[ci]
            }
            var children = parseInline(cellText, final)
            if cellText == "" {
                children = []
            }
            rowCells.push({type: "table_cell", header: false, children: children, align: align})
            ci += 1
        }
        rows.push({type: "table_row", cells: rowCells})
        i += 1
    }
    var headerRowCells List<any> = []
    var ci = 0
    while ci < headerCells.length {
        let cellText = headerCells[ci].trim()
        var align = "left"
        if ci < aligns.length {
            align = aligns[ci]
        }
        let children = parseInline(cellText, final)
        headerRowCells.push({type: "table_cell", header: true, children: children, align: align})
        ci += 1
    }
    let header = {type: "table_row", cells: headerRowCells}
    nodes.push({type: "table", header: header, rows: rows, loading: false})
    return i
}

// ---------------------------------------------------------------- inline

fn parseInline(text str, final bool) List<any> {
    if text == "" { return [] }
    return parseInlineLine(text, final)
}

fn parseInlineLine(line str, final bool) List<any> {
    var nodes List<any> = []
    var buf str = ""
    var i int = 0
    var seenCode bool = false
    while i < line.length {
        let ch = line[i]

        // newline: >=2 trailing spaces = hardbreak, else soft merge
        if ch == "\n" {
            var sp int = 0
            while sp < buf.length {
                let bch = buf[buf.length - 1 - sp]
                if bch == " " {
                    sp += 1
                } else {
                    break
                }
            }
            if sp >= 2 {
                let kept = buf.slice(0, buf.length - sp)
                if kept != "" {
                    nodes.push(textNode(kept))
                }
                nodes.push({type: "hardbreak"})
                buf = ""
            } else {
                if sp > 0 {
                    buf = buf.slice(0, buf.length - sp)
                }
                buf = buf + "\n"
            }
            i += 1
            continue
        }

        // strong / emphasis / strikethrough delimiters
        if ch == "*" {
            if line.startsWith("**", i) {
                var after = scanDelim(line, i, "**", true, final)
                if after != nil {
                    if buf != "" {
                        nodes.push(textNode(buf))
                        buf = ""
                    }
                    nodes.push({type: "strong", children: parseInlineLine(after[1], final)})
                    i = after[0]
                    continue
                }
            }
            var afterEm = scanDelim(line, i, "*", false, final)
            if afterEm != nil {
                if buf != "" {
                    nodes.push(textNode(buf))
                    buf = ""
                }
                nodes.push({type: "emphasis", children: parseInlineLine(afterEm[1], final)})
                i = afterEm[0]
                continue
            }
            buf = buf + ch
            i += 1
            continue
        }
        if ch == "_" {
            var afterU = scanDelim(line, i, "_", false, final)
            if afterU != nil {
                if buf != "" {
                    nodes.push(textNode(buf))
                    buf = ""
                }
                nodes.push({type: "emphasis", children: parseInlineLine(afterU[1], final)})
                i = afterU[0]
                continue
            }
            buf = buf + ch
            i += 1
            continue
        }
        if ch == "~" {
            if line.startsWith("~~", i) {
                var afterS = scanDelim(line, i, "~~", false, final)
                if afterS != nil {
                    if buf != "" {
                        nodes.push(textNode(buf))
                        buf = ""
                    }
                    nodes.push({type: "strikethrough", children: parseInlineLine(afterS[1], final)})
                    i = afterS[0]
                    continue
                }
            }
            buf = buf + ch
            i += 1
            continue
        }

        // inline code
        if ch == "`" {
            var run int = 0
            while line.startsWith("`", i + run) {
                run += 1
            }
            var close = findBacktickRun(line, i + run, run)
            if close != -1 {
                var inner = line.slice(i + run, close)
                let trimmedL = inner.replace(RegExp("^ "), "")
                let trimmedBoth = trimmedL.replace(RegExp(" $"), "")
                if inner.startsWith(" ") {
                    if inner.endsWith(" ") {
                        if inner.trim() != "" {
                            inner = trimmedBoth
                        }
                    }
                }
                if buf != "" {
                    nodes.push(textNode(buf))
                    buf = ""
                }
                nodes.push({type: "inline_code", code: inner})
                seenCode = true
                i = close + run
                continue
            }
            // streaming: a lone SINGLE backtick at the start of the line with
            // nothing after it is dropped entirely (a bare "``" stays literal)
            if !final {
                if run == 1 {
                    let restAll = line.slice(i + run)
                    if restAll.trim() == "" {
                        if buf == "" {
                            i = line.length
                            continue
                        }
                    }
                }
            }
            if run == 1 {
                if !final {
                    // streaming: an unclosed single backtick renders the rest
                    // as an (empty-or-partial) inline code span
                    let rest = line.slice(i + 1)
                    if buf != "" {
                        nodes.push(textNode(buf))
                        buf = ""
                    }
                    nodes.push({type: "inline_code", code: rest})
                    seenCode = true
                    i = line.length
                    continue
                }
            }
            // unclosed multi-backtick run (or any run in final mode): the
            // whole run goes into the text buffer verbatim
            buf = buf + line.slice(i, i + run)
            i = i + run
            continue
        }

        // image ![alt](src)
        if ch == "!" {
            if line.startsWith("![", i) {
                var imgAfter = scanLink(line, i + 1, final, seenCode)
                if imgAfter != nil {
                    if buf != "" {
                        nodes.push(textNode(buf))
                        buf = ""
                    }
                    nodes.push({type: "image", src: imgAfter[2], alt: imgAfter[1], title: nil, loading: false})
                    i = imgAfter[0]
                    continue
                }
            }
            buf = buf + ch
            i += 1
            continue
        }

        // link [text](href)
        if ch == "[" {
            var after = scanLink(line, i, final, seenCode)
            if after != nil {
                if buf != "" {
                    nodes.push(textNode(buf))
                    buf = ""
                }
                if after[3] {
                    // loading (streaming) link with the extracted href
                    nodes.push({type: "link", href: after[2], title: after[4], text: after[1], children: parseInlineLine(after[1], final), loading: true})
                    if after[5] != "" {
                        nodes.push(textNode(after[5]))
                    }
                } else {
                    nodes.push({type: "link", loading: false, href: after[2], title: after[4], text: after[1], children: parseInlineLine(after[1], final)})
                }
                i = after[0]
                continue
            }
            buf = buf + ch
            i += 1
            continue
        }

        // backslash escape: emit the escaped char literally; quotes arrive
        // as sentinels so smartQuotes() leaves them alone
        if ch == "\\" {
            if i + 1 < line.length {
                let nxt = line[i + 1]
                if isPunctuation(nxt) {
                    if nxt == "\"" {
                        buf = buf + String.fromCharCode(1)
                    } else {
                        if nxt == "'" {
                            buf = buf + String.fromCharCode(2)
                        } else {
                            buf = buf + nxt
                        }
                    }
                    i += 2
                    continue
                }
            }
        }

        buf = buf + ch
        i += 1
    }
    if buf != "" {
        nodes.push(textNode(buf))
    }
    if !final {
        trimStreamingTail(nodes)
    }
    return nodes
}

// Streaming tail fragments on the LAST text node: dangling link parens
// "((", an unclosed html-like "<tag ..." tail, a trailing "*" / "* " run
// are stripped first; only when nothing was stripped is the plain trailing
// whitespace removed (reference behavior observed via prefix scans).
fn trimStreamingTail(nodes List<any>) {
    if nodes.length > 0 {
        let last = nodes[nodes.length - 1]
        if last["type"] == "text" {
            trimLastTextNode(last, nodes)
        }
    }
}

fn trimLastTextNode(last any, nodes List<any>) {
    var c = last["content"]
    var stripped bool = false
    var c2 = c.replace(RegExp(" ?<[/!a-zA-Z][^>]*$"), "")
    if c2 == c {
        c2 = c.replace(RegExp("<$"), "")
    }
    if c2 != c {
        stripped = true
    }
    c = c2
    var c3 = c.replace(RegExp("\\(+\\s*$"), "")
    if c3 != c {
        stripped = true
    }
    c = c3
    var c4 = c.replace(RegExp("\\* +$"), "")
    if c4 == c {
        if c.endsWith("*") {
            if !c.endsWith("**") {
                c4 = c.slice(0, c.length - 1)
            }
        }
    }
    if c4 != c {
        stripped = true
    }
    c = c4
    if !stripped {
        c = c.replace(RegExp(" +$"), "")
    }
    if c.trim() == "|" {
        // a lone dangling table pipe flashes an empty paragraph
        c = ""
    }
    if c == "" {
        nodes.pop()
    } else {
        last["content"] = c
    }
}

fn textNode(content str) any {
    var s = smartQuotes(content)
    // escaped quotes arrived as sentinels; restore them literally
    s = s.split(String.fromCharCode(1)).join("\"")
    s = s.split(String.fromCharCode(2)).join("'")
    return {type: "text", content: s}
}

fn isWordChar(ch str) bool {
    let re = RegExp("\\w", "u")
    return re.test(ch)
}

// closing punctuation for the smart-quote close context (an opening bracket
// like ( or the fullwidth ( does NOT make a close-quote context)
fn isClosePunctuation(ch str) bool {
    let re = RegExp("[\\)\\]},.;:!?\\u2026\"'\\uff09\\uff0c\\uff0e\\u3002\\uff1b\\uff1a\\uff01\\uff1f\\u300d\\u300f\\u3009\\u300b]")
    return re.test(ch)
}

// typographer smart quotes: open " when preceded by whitespace/line start/
// opening bracket; close " when preceded by non-whitespace AND followed by
// whitespace/line end/punctuation; otherwise the straight quote stays
// (markdown-it typographer:true behavior -- e.g. a close-bracket followed
// by a straight quote before a word keeps straight quotes)
// curly-quote constants: Auto string literals cannot contain these
// characters (the lexer rejects them), so they are built from char codes
var CURLY_LDQUO str = String.fromCharCode(8220)
var CURLY_RDQUO str = String.fromCharCode(8221)
var CURLY_LSQUO str = String.fromCharCode(8216)
var CURLY_RSQUO str = String.fromCharCode(8217)

fn smartQuotes(s str) str {
    var out = ""
    var i int = 0
    while i < s.length {
        let ch = s[i]
        if ch == "\"" {
            var prevIsOpenCtx bool = false
            if out == "" {
                prevIsOpenCtx = true
            } else {
                let prev = out.charAt(out.length - 1)
                if prev == " " { prevIsOpenCtx = true }
                if prev == "\n" { prevIsOpenCtx = true }
                if prev == "(" { prevIsOpenCtx = true }
                if prev == "[" { prevIsOpenCtx = true }
                if prev == "{" { prevIsOpenCtx = true }
            }
            if prevIsOpenCtx {
                out = out + CURLY_LDQUO
                i += 1
                continue
            }
            // close context: next is whitespace / end / closing punctuation
            if i + 1 >= s.length {
                out = out + CURLY_RDQUO
                i += 1
                continue
            }
            let nxt = s[i + 1]
            if nxt == " " {
                out = out + CURLY_RDQUO
            } else {
                if nxt == "\n" {
                    out = out + CURLY_RDQUO
                } else {
                    if isClosePunctuation(nxt) {
                        out = out + CURLY_RDQUO
                    } else {
                        out = out + ch
                    }
                }
            }
            i += 1
            continue
        }
        if ch == "'" {
            var apostrophe bool = false
            if i > 0 {
                if i + 1 < s.length {
                    let p = s[i - 1]
                    let n = s[i + 1]
                    let pWord = isWordChar(p)
                    let nWord = isWordChar(n)
                    if pWord {
                        if nWord { apostrophe = true }
                    }
                }
            }
            if apostrophe {
                out = out + CURLY_RSQUO
            } else {
                var openS bool = false
                if out == "" {
                    openS = true
                } else {
                    let prev2 = out.charAt(out.length - 1)
                    if prev2 == " " { openS = true }
                    if prev2 == "\n" { openS = true }
                    if prev2 == "(" { openS = true }
                    if prev2 == "[" { openS = true }
                }
                if openS {
                    out = out + CURLY_LSQUO
                } else {
                    out = out + CURLY_RSQUO
                }
            }
            i += 1
            continue
        }
        out = out + ch
        i += 1
    }
    return out
}

fn isPunctuation(ch str) bool {
    // Unicode punctuation class \p{P} plus ASCII symbols (markdown-it's
    // punctuation definition includes both; the u flag enables the property
    // escape, passed through verbatim by a2ts)
    let re = RegExp("\\p{P}|[-+/=@$^`|~]", "u")
    return re.test(ch)
}

// Starting at i where line.substr(i) == delim: find a closing delimiter.
// Returns [indexAfter, innerText] or nil. Opener flanking: the char before
// the delimiter must be whitespace/punctuation/start (a*b stays literal).
// Unclosed strong auto-closes even when final (reference applyFixStrongTokens);
// unclosed emphasis/strikethrough auto-close only in streaming mode.
fn scanDelim(line str, i int, delim str, autoCloseWhenFinal bool, final bool) any {
    // underscore intraword restriction: "_word_" only opens at word edges
    // (snake_case_word stays literal); "*" has no left-side restriction
    if delim == "_" {
        if i > 0 {
            let prev = line[i - 1]
            if isWordChar(prev) { return nil }
        }
    }
    let afterStart = i + delim.length
    let inner = line.slice(afterStart)
    var close = inner.indexOf(delim)
    var innerText = inner
    if close != -1 {
        innerText = inner.slice(0, close)
    }
    if innerText == "" {
        // empty emphasis/strong content ("**" at line end) stays literal
        return nil
    }
    let lead = innerText[0]
    if isPunctuation(lead) {
        // e.g. "auto-plan-*: text" -- a delimiter whose content starts
        // with punctuation stays literal (markdown-it flanking); applies
        // to both a real close and the streaming auto-close
        return nil
    }
    if close != -1 {
        var next = afterStart + close + delim.length
        return [next, innerText]
    }
    if !autoCloseWhenFinal {
        if final { return nil }
    }
    // auto-close at end of line
    if inner == "" { return nil }
    if inner.startsWith(" ") { return nil }
    return [line.length, inner]
}

// Find a run of exactly `count` backticks starting at or after `from`.
fn findBacktickRun(line str, from int, count int) int {
    var i = from
    while i < line.length {
        if line[i] != "`" {
            i += 1
            continue
        }
        var run int = 0
        while line.startsWith("`", i + run) {
            run += 1
        }
        if run == count {
            return i
        }
        i = i + run
    }
    return -1
}

// Starting at i where line[i] == "[": parse [text](href "title").
// Returns [indexAfter, text, href, loading, title] or nil. Once "(" follows
// the closing "]", an unclosed link renders as a loading link (streaming and
// final alike, matching the reference).
fn scanLink(line str, i int, final bool, seenCode bool) any {
    var close = line.indexOf("]", i)
    if close == -1 { return nil }
    let text = line.slice(i + 1, close)
    var after = close + 1
    if !line.startsWith("(", after) { return nil }
    var end = line.indexOf(")", after)
    if end == -1 {
        // loading link: "[text](href-without-close" -- url-like prefixes keep
        // their href (trailing punctuation is excluded from the url and
        // becomes trailing text), bare domains get http:// prepended
        let frag = line.slice(after + 1)
        let urlMatch = frag.match(RegExp("^https?:\\/\\/.+"))
        if urlMatch != nil {
            var urlHref = frag.replace(RegExp("[.,:;!?)]+$"), "")
            var tailText = frag.slice(urlHref.length)
            var urlTitle any = ""
            if seenCode {
                urlTitle = nil
            }
            return [line.length, text, urlHref, true, urlTitle, tailText]
        }
        let m = frag.match(RegExp("^[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"))
        if m != nil {
            return [line.length, text, "http://" + frag, true, nil, ""]
        }
        return [line.length, text, "", true, nil, ""]
    }
    var inner = line.slice(after + 1, end)
    var href = inner
    var title any = nil
    let sp = inner.indexOf(" \"")
    if sp != -1 {
        href = inner.slice(0, sp)
        let titlePart = inner.slice(sp + 2)
        if titlePart.endsWith("\"") {
            title = titlePart.slice(0, titlePart.length - 1)
        }
    } else {
        // reference quirks around a missing title: title:"" normally, but
        // title:null when the link ends the line OR an inline code span
        // appeared earlier on the line (the code span alters the token attrs
        // the reference builds the node from)
        var lineTail = end + 1 >= line.length
        if !lineTail {
            if !seenCode {
                title = ""
            }
        }
    }
    return [end + 1, text, href, false, title, ""]
}
