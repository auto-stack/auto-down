{
  "name": "@autodown/vue",
  "version": "0.1.1",
  "description": "AutoDown Vue renderer — streaming and static document rendering for AutoDown",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "gen": "node auto/gen.mjs"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@autodown/core": "workspace:*",
