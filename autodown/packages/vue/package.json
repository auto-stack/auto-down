    "lowlight": "^3.3.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@types/hast": "^3.0.4",
    "@vitejs/plugin-vue": "^5.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.8",
    "@types/node": "^22.0.0",
    "stream-markdown-parser": "0.0.95",
    "@vue/server-renderer": "^3.5.35",
    "vue": "^3.5.35"
  }
