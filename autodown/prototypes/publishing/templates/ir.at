// PLAN-083 — Publication IR v1（publication-ir-v1）in plain Auto.
//
// 本模块是原型的文档/模板边界（082 的 v0 升级，PLAN-083 迁移）：
//   * Doc        —正文模型（engine parser → doc-wire v1 传入，与 082 相同）
//   * PubBlock   —内容块（NodeId 与来源）
//   * Publication—版本化出版 IR v1：页面配置 + 内容 + 样式规则/计算结果/呈现
//
// v1 变化（相对 publication-ir-v0）：
//   * 删除扁平 StyleConfig——样式成为规则系统（style.at）：内置/主题/模板/文档规则/
//     节点显式逐属性合成（computed），呈现由 render.at 生成 presentation；
//   * 新增 styles.rules / match_log / computed / explicit / render_rules /
//     presentation / render_diags；document/page/outline/content 保持。
//
// 语言边界与 VM 缺陷规避见 style.at 头注（整数 milli、无 bool.to(str)、
// 校验类函数不跨 file 导入使用）。

use style: jstr, char_width
use style: StyleRule, ExplicitStyle, MatchLog, Computed, RenderRule
use style: jrules, jexplicit_all, jmatch, jcomputed_all, jrender_rules

// ---------------------------------------------------------------------------
// 正文模型（doc-wire v1，与 082 相同）
// ---------------------------------------------------------------------------

type DocBlock {
    id str
    kind str
    level int
    ordered int
    items []str
    cols int
    rows List<List<str>>
    callout_type str
    title str
    body []str
    text str
}

type DocMeta {
    title str
    authors []str
    abstract str
    lang str
    source str
}

type Doc {
    meta DocMeta
    blocks []DocBlock
}

// 解析结果（不用全局变量跨模块传递错误）
type DocParse {
    ok int
    code str
    message str
    doc Doc
}

// ---------------------------------------------------------------------------
// 出版 IR v1
// ---------------------------------------------------------------------------

type PageConfig {
    paper str
    margin_top str
    margin_bottom str
    margin_left str
    margin_right str
    columns int
    font_size str
    font_family []str
    header_text str
    page_numbers int
}

type PubBlock {
    id str
    kind str
    origin str
    level int
    ordered int
    items []str
    cols int
    rows List<List<str>>
    callout_type str
    title str
    body []str
    text str
}

// 呈现条目：一个语义 occurrence 经呈现规则（或默认呈现）产生的可见块序列。
// semantic_id 指回内容块；rule 为命中规则名（""=默认）；decor 块不进入 outline
//（outline 永远由语义内容块生成）；guard=1 表示该 occurrence 触发过递归保护。
type PresEntry {
    semantic_id str
    role str
    rule str
    guard int
    blocks []PubBlock
}

// 呈现层诊断（如 W_RENDER_RECURSION_GUARD）
type RenderDiag {
    code str
    rule str
    node str
    detail str
}

type OutlineEntry {
    id str
    level int
    title str
}

type Publication {
    template str
    meta DocMeta
    page PageConfig
    outline_depth int
    outline_title str
    content []PubBlock
    outline []OutlineEntry
    rules []StyleRule
    explicit []ExplicitStyle
    match_log []MatchLog
    computed []Computed
    render_rules []RenderRule
    presentation []PresEntry
    render_diags []RenderDiag
}

// ---------------------------------------------------------------------------
// 模板参数（与 082 相同）
// ---------------------------------------------------------------------------

type Options {
    template str
    font_size str
    columns int
    paper str
    margin str
    header_text str
    font_family []str
    margin_explicit int
    columns_explicit int
}

type OptionsParse {
    ok int
    code str
    message str
    options Options
}

// ---------------------------------------------------------------------------
// 小工具
// ---------------------------------------------------------------------------

fn dp_err(code str, message str) DocParse {
    return DocParse(0, code, message, Doc(DocMeta("", [], "", "zh", ""), []))
}

fn dp_ok(doc Doc) DocParse {
    return DocParse(1, "", "", doc)
}

fn op_err(code str, message str) OptionsParse {
    return OptionsParse(0, code, message, Options("", "", 0, "", "", "", [], 0, 0))
}

fn op_ok(options Options) OptionsParse {
    return OptionsParse(1, "", "", options)
}

fn is_digits(value str) bool {
    let s = value.to(str)
    if s.len() == 0 {
        return false
    }
    var ok = true
    var i = 0
    while i < s.len() {
        let c = s.char_at(i)
        if c < 48 || c > 57 {
            ok = false
        }
        i = i + 1
    }
    return ok
}

// `\t` `\n` `\r` `\\` 由宿主在字段内转义；其余控制字符宿主已归一为空格。
// 注：VM 的 split() 产物是 DStr，先 .to(str) 归一，否则 sub() 可能返回 None（2026-11-14 实测）。
fn unescape(value str) str {
    let s = value.to(str)
    var out = ""
    var i = 0
    let n = s.len()
    while i < n {
        let c = s.char_at(i)
        if c == 92 {
            if i + 1 < n {
                let d = s.char_at(i + 1)
                if d == 110 {
                    out = out + "\n"
                } else if d == 116 {
                    out = out + "\t"
                } else if d == 114 {
                    out = out + "\r"
                } else if d == 92 {
                    out = out + "\\"
                } else {
                    out = out + s.sub(i + 1, i + 1 + char_width(d))
                }
                i = i + 1 + char_width(d)
            } else {
                out = out + "\\"
                i = i + 1
            }
        } else {
            let w = char_width(c)
            out = out + s.sub(i, i + w)
            i = i + w
        }
    }
    return out
}

fn unescaped_fields(line str) []str {
    let raw = line.to(str).split("\t")
    var out []str = []
    for f in raw {
        out.push(unescape(f))
    }
    return out
}

fn index_or(xs []str, i int, fallback str) str {
    if i < xs.len() {
        return xs[i]
    }
    return fallback
}

// ---------------------------------------------------------------------------
// doc-wire v1 解析（与 082 相同）
// ---------------------------------------------------------------------------

fn parse_doc(wire str) DocParse {
    let lines = wire.split("\n")
    if lines.len() < 2 {
        return dp_err("E_DOC_WIRE_LINE", "document wire is empty")
    }
    if lines[0] != "DOCWIRE 1" {
        return dp_err("E_DOC_WIRE_VERSION", "unsupported document wire header: " + lines[0])
    }

    var title = ""
    var authors []str = []
    var abstract = ""
    var lang = "zh"
    var source = ""
    var blocks []DocBlock = []

    var i = 1
    let n = lines.len()
    while i < n {
        let line = lines[i].to(str)
        i = i + 1
        if line != "" {
            let f = unescaped_fields(line)
            let tag = index_or(f, 0, "")
            let sub = index_or(f, 1, "")
            if tag == "meta" {
                let key = sub
                let value = index_or(f, 2, "")
                if key == "title" {
                    title = value
                } else if key == "author" {
                    authors.push(value)
                } else if key == "abstract" {
                    abstract = value
                } else if key == "lang" {
                    lang = value
                } else if key == "source" {
                    source = value
                } else {
                    return dp_err("E_DOC_WIRE_LINE", "unknown meta key: " + key)
                }
            } else if tag == "end" {
                // 终止标记：宿主已完成全部块
            } else if tag == "block" {
                let kind = sub
                let id = index_or(f, 2, "")
                if id == "" {
                    return dp_err("E_DOC_WIRE_LINE", "block without node id")
                }
                if kind == "heading" {
                    if f.len() < 5 {
                        return dp_err("E_DOC_WIRE_LINE", "heading block needs level+text: " + id)
                    }
                    let level = f[3].to(int)
                    blocks.push(DocBlock(id, "heading", level, 0, [], 0, [], "", "", [], f[4]))
                } else if kind == "paragraph" {
                    if f.len() < 4 {
                        return dp_err("E_DOC_WIRE_LINE", "paragraph block needs text: " + id)
                    }
                    blocks.push(DocBlock(id, "paragraph", 0, 0, [], 0, [], "", "", [], f[3]))
                } else if kind == "thematic_break" {
                    blocks.push(DocBlock(id, "thematic_break", 0, 0, [], 0, [], "", "", [], ""))
                } else if kind == "list" {
                    if f.len() < 5 {
                        return dp_err("E_DOC_WIRE_LINE", "list block needs ordered+count: " + id)
                    }
                    let ordered = f[3].to(int)
                    let count = f[4].to(int)
                    var items []str = []
                    var k = 0
                    while k < count {
                        if i < n {
                            let g = unescaped_fields(lines[i])
                            if index_or(g, 0, "") != "block" {
                                return dp_err("E_DOC_WIRE_COUNT", "list item line missing: " + id)
                            }
                            if index_or(g, 1, "") != "list_item" {
                                return dp_err("E_DOC_WIRE_COUNT", "expected list_item: " + id)
                            }
                            if index_or(g, 2, "") != id {
                                return dp_err("E_DOC_WIRE_COUNT", "list item belongs to another list: " + id)
                            }
                            items.push(index_or(g, 4, ""))
                            i = i + 1
                        }
                        k = k + 1
                    }
                    if items.len() != count {
                        return dp_err("E_DOC_WIRE_COUNT", "list item count mismatch: " + id)
                    }
                    blocks.push(DocBlock(id, "list", 0, ordered, items, 0, [], "", "", [], ""))
                } else if kind == "table" {
                    if f.len() < 5 {
                        return dp_err("E_DOC_WIRE_LINE", "table block needs cols+rows: " + id)
                    }
                    let cols = f[3].to(int)
                    let row_count = f[4].to(int)
                    var rows List<List<str>> = []
                    var k = 0
                    while k < row_count {
                        if i < n {
                            let g = unescaped_fields(lines[i])
                            if index_or(g, 1, "") != "table_row" || index_or(g, 2, "") != id {
                                return dp_err("E_DOC_WIRE_COUNT", "expected table_row of " + id)
                            }
                            var cells []str = []
                            var j = 4
                            while j < g.len() {
                                cells.push(g[j])
                                j = j + 1
                            }
                            if cells.len() != cols {
                                return dp_err("E_DOC_WIRE_COUNT", "table row width mismatch: " + id + "#" + k.to(str))
                            }
                            rows.push(cells)
                            i = i + 1
                        }
                        k = k + 1
                    }
                    if rows.len() != row_count {
                        return dp_err("E_DOC_WIRE_COUNT", "table row count mismatch: " + id)
                    }
                    blocks.push(DocBlock(id, "table", 0, 0, [], cols, rows, "", "", [], ""))
                } else if kind == "callout" {
                    if f.len() < 6 {
                        return dp_err("E_DOC_WIRE_LINE", "callout block needs type+title+count: " + id)
                    }
                    let ctype = f[3]
                    let ctitle = f[4]
                    let count = f[5].to(int)
                    var body []str = []
                    var k = 0
                    while k < count {
                        if i < n {
                            let g = unescaped_fields(lines[i])
                            if index_or(g, 1, "") != "callout_paragraph" || index_or(g, 2, "") != id {
                                return dp_err("E_DOC_WIRE_COUNT", "expected callout_paragraph of " + id)
                            }
                            body.push(index_or(g, 4, ""))
                            i = i + 1
                        }
                        k = k + 1
                    }
                    if body.len() != count {
                        return dp_err("E_DOC_WIRE_COUNT", "callout paragraph count mismatch: " + id)
                    }
                    blocks.push(DocBlock(id, "callout", 0, 0, [], 0, [], ctype, ctitle, body, ""))
                } else {
                    return dp_err("E_NODE_UNSUPPORTED", "unsupported block kind in document wire: " + kind)
                }
            } else {
                return dp_err("E_DOC_WIRE_LINE", "unknown wire line tag: " + tag)
            }
        }
    }
    return dp_ok(Doc(DocMeta(title, authors, abstract, lang, source), blocks))
}

// ---------------------------------------------------------------------------
// request.txt（key=value，宿主写入；与 082 相同）
// ---------------------------------------------------------------------------

fn default_options(template str) Options {
    if template == "office_book" {
        return Options("office_book", "11pt", 1, "a4", "2.6cm", "", ["Noto Serif SC", "Noto Sans SC"], 0, 0)
    }
    return Options("academic", "10pt", 2, "a4", "2.2cm", "", ["Noto Serif SC", "Noto Sans SC"], 0, 0)
}

fn has_setting(settings []str, key str) bool {
    for line in settings {
        let parts = line.to(str).split("=")
        if parts.len() > 1 {
            if parts[0].to(str) == key {
                return true
            }
        }
    }
    return false
}

fn setting_value(settings []str, key str, fallback str) str {
    for line in settings {
        let parts = line.to(str).split("=")
        if parts.len() > 0 {
            let name = parts[0].to(str)
            if name == key {
                var value = ""
                var i = 1
                while i < parts.len() {
                    if i > 1 {
                        value = value + "="
                    }
                    value = value + parts[i].to(str)
                    i = i + 1
                }
                return value
            }
        }
    }
    return fallback
}

fn parse_options(request str) OptionsParse {
    let settings = request.split("\n")
    let template = setting_value(settings, "template", "academic")
    if template == "" {
        return op_err("E_OPTION_VALUE", "template is empty")
    }
    let base = default_options(template)
    let font_size = setting_value(settings, "font_size", base.font_size)
    let paper = setting_value(settings, "paper", base.paper)
    let margin = setting_value(settings, "margin", base.margin)
    let header_text = setting_value(settings, "header_text", base.header_text)
    let columns_raw = setting_value(settings, "columns", base.columns.to(str))
    if !is_digits(columns_raw) {
        return op_err("E_OPTION_VALUE", "columns must be a positive integer: " + columns_raw)
    }
    let columns = columns_raw.to(int)
    if columns < 1 || columns > 3 {
        return op_err("E_OPTION_VALUE", "columns out of prototype range 1..3: " + columns_raw)
    }
    var margin_explicit = 0
    if has_setting(settings, "margin") {
        margin_explicit = 1
    }
    var columns_explicit = 0
    if has_setting(settings, "columns") {
        columns_explicit = 1
    }
    return op_ok(Options(template, font_size, columns, paper, margin, header_text, base.font_family, margin_explicit, columns_explicit))
}

// ---------------------------------------------------------------------------
// 投影工具
// ---------------------------------------------------------------------------

fn to_pub(b DocBlock) PubBlock {
    return PubBlock(b.id, b.kind, "source", b.level, b.ordered, b.items, b.cols, b.rows, b.callout_type, b.title, b.body, b.text)
}

fn outline_of(blocks []PubBlock, depth int) []OutlineEntry {
    var out []OutlineEntry = []
    for b in blocks {
        if b.kind == "heading" {
            if b.level <= depth {
                out.push(OutlineEntry(b.id, b.level, b.text))
            }
        }
    }
    return out
}

// ---------------------------------------------------------------------------
// JSON 序列化（v1；字符串转义复用 style.at 的 jstr/char_width）
// ---------------------------------------------------------------------------

fn jstrs(xs []str) str {
    var out = "["
    var i = 0
    for x in xs {
        if i > 0 {
            out = out + ","
        }
        out = out + jstr(x)
        i = i + 1
    }
    return out + "]"
}

fn jrows(rows List<List<str>>) str {
    var out = "["
    var i = 0
    for row in rows {
        if i > 0 {
            out = out + ","
        }
        out = out + jstrs(row)
        i = i + 1
    }
    return out + "]"
}

fn jbool(v int) str {
    if v == 1 {
        return "true"
    }
    return "false"
}

fn jblock(b PubBlock) str {
    var s = "{\"id\":" + jstr(b.id) + ",\"kind\":" + jstr(b.kind) + ",\"origin\":" + jstr(b.origin)
    if b.kind == "heading" {
        s = s + ",\"level\":" + b.level.to(str) + ",\"text\":" + jstr(b.text)
    } else if b.kind == "paragraph" {
        s = s + ",\"text\":" + jstr(b.text)
    } else if b.kind == "list" {
        s = s + ",\"ordered\":" + jbool(b.ordered) + ",\"items\":" + jstrs(b.items)
    } else if b.kind == "table" {
        s = s + ",\"cols\":" + b.cols.to(str) + ",\"rows\":" + jrows(b.rows)
    } else if b.kind == "callout" {
        s = s + ",\"callout_type\":" + jstr(b.callout_type) + ",\"title\":" + jstr(b.title) + ",\"body\":" + jstrs(b.body)
    }
    return s + "}"
}

fn jblocks(blocks []PubBlock) str {
    var out = "["
    var i = 0
    for b in blocks {
        if i > 0 {
            out = out + ","
        }
        out = out + jblock(b)
        i = i + 1
    }
    return out + "]"
}

fn jpres_entry(e PresEntry) str {
    var s = "{\"semantic_id\":" + jstr(e.semantic_id)
    s = s + ",\"role\":" + jstr(e.role)
    s = s + ",\"rule\":" + jstr(e.rule)
    s = s + ",\"guard\":" + e.guard.to(str)
    s = s + ",\"blocks\":" + jblocks(e.blocks)
    return s + "}"
}

fn jpresentation(entries []PresEntry) str {
    var out = "["
    var i = 0
    for e in entries {
        if i > 0 {
            out = out + ","
        }
        out = out + jpres_entry(e)
        i = i + 1
    }
    return out + "]"
}

fn jdiags(diags []RenderDiag) str {
    var out = "["
    var i = 0
    for d in diags {
        if i > 0 {
            out = out + ","
        }
        out = out + "{\"code\":" + jstr(d.code) + ",\"rule\":" + jstr(d.rule) + ",\"node\":" + jstr(d.node) + ",\"detail\":" + jstr(d.detail) + "}"
        i = i + 1
    }
    return out + "]"
}

fn joutline(entries []OutlineEntry) str {
    var out = "["
    var i = 0
    for e in entries {
        if i > 0 {
            out = out + ","
        }
        out = out + "{\"id\":" + jstr(e.id) + ",\"level\":" + e.level.to(str) + ",\"title\":" + jstr(e.title) + "}"
        i = i + 1
    }
    return out + "]"
}

fn json_publication(p Publication) str {
    var s = "{\"ok\":true,\"publication\":{"
    s = s + "\"schema_version\":\"publication-ir-v1\""
    s = s + ",\"template\":" + jstr(p.template)
    s = s + ",\"document\":{\"title\":" + jstr(p.meta.title)
    s = s + ",\"authors\":" + jstrs(p.meta.authors)
    s = s + ",\"abstract\":" + jstr(p.meta.abstract)
    s = s + ",\"lang\":" + jstr(p.meta.lang)
    s = s + ",\"source\":" + jstr(p.meta.source) + "}"
    s = s + ",\"page\":{\"paper\":" + jstr(p.page.paper)
    s = s + ",\"margin\":{\"top\":" + jstr(p.page.margin_top)
    s = s + ",\"bottom\":" + jstr(p.page.margin_bottom)
    s = s + ",\"left\":" + jstr(p.page.margin_left)
    s = s + ",\"right\":" + jstr(p.page.margin_right) + "}"
    s = s + ",\"columns\":" + p.page.columns.to(str)
    s = s + ",\"font_size\":" + jstr(p.page.font_size)
    s = s + ",\"font_family\":" + jstrs(p.page.font_family)
    s = s + ",\"header_text\":" + jstr(p.page.header_text)
    s = s + ",\"page_numbers\":" + jbool(p.page.page_numbers) + "}"
    s = s + ",\"styles\":{\"rules\":" + jrules(p.rules)
    s = s + ",\"explicit\":" + jexplicit_all(p.explicit)
    s = s + ",\"match_log\":" + jmatch(p.match_log)
    s = s + ",\"render_rules\":" + jrender_rules(p.render_rules) + "}"
    s = s + ",\"computed\":" + jcomputed_all(p.computed)
    s = s + ",\"outline\":{\"depth\":" + p.outline_depth.to(str)
    s = s + ",\"title\":" + jstr(p.outline_title)
    s = s + ",\"entries\":" + joutline(p.outline) + "}"
    s = s + ",\"content\":" + jblocks(p.content)
    s = s + ",\"presentation\":" + jpresentation(p.presentation)
    s = s + ",\"render_diags\":" + jdiags(p.render_diags)
    s = s + "}}"
    return s
}

fn json_error(code str, message str) str {
    return "{\"ok\":false,\"error\":{\"code\":" + jstr(code) + ",\"message\":" + jstr(message) + "}}"
}
