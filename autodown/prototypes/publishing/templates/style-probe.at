// PLAN-083 — 样式系统探针（AC-01/02/03 的 Auto 侧证据；结果 JSON 打印到 stdout）
//
// 覆盖：普通函数按参数产生 Style（emphasis）、非法值可定位拒绝（check_*）、
// hex 颜色解析、逐属性合成与作用域（覆盖/恢复/显式最高）、来源链、选择器
// 匹配日志（type/attr/id/role/and/or）、STYLEWIRE 解析（正例+三个负例）、
// JSON 序列化。验证经由 jtext/jcomputed_all 序列化与同模块标量读取
//（跨模块字段直读在本机构建有 VM 缺陷，见 style.at 头注）。
// 运行：auto templates/style-probe.at → {"ok_count":17,"total":17,"all_pass":true}

// PLAN-083 — style.at 冒烟验证（T-01/T-02/T-03 核心行为）
//
// 结构约定（VM 规避）：每个检查一个小函数返回 0/1；主流程短语句累加；
// 结果 JSON 用增量 var 拼接——避免“长链拼接 + 多字段 .to(str)”单表达式
//（本机 auto 构建存在结构敏感的寄存器分配缺陷，见 cap-probe 记录）。
use style: pt, em, rgb, emphasis, jtext, jcomputed_all, comp_size_milli, comp_indent_milli, comp_color_r, comp_by_id, check_text, check_length, parse_hex_color, sel_type, sel_attr, sel_id, sel_role, sel_and, sel_or, node_view, style_rule, builtin_rules, theme_print, compose_styles, match_log_of, validate_rules, parse_styles_wire, jcomputed_all, empty_text, empty_para, empty_doc, unset_length, unset_color, TextStyle, ParagraphStyle, DocStyle, StyLength, Color, ExplicitStyle, Computed, MatchLog, StyleNode, StyleRule

// ---- 检查辅助 ----

fn sized_text(v int) TextStyle {
    return TextStyle(pt(v, 0), -1, unset_color(), -1, [])
}

fn ind_para(v int) ParagraphStyle {
    return ParagraphStyle(-1, em(v, 0), em(0, 0), em(0, 0), em(0, 0))
}

fn bad_weight_text() TextStyle {
    return TextStyle(pt(10, 0), 50, unset_color(), -1, [])
}

fn bad_unit_len() StyLength {
    return StyLength(1000, "qx")
}

fn explicit_size(id str, v int) ExplicitStyle {
    return ExplicitStyle(id, sized_text(v), empty_para(), empty_doc())
}

fn at(cs []Computed, id str) Computed {
    for c in cs {
        if c.id == id {
            return c
        }
    }
    return Computed("", empty_text(), empty_para(), empty_doc(), [])
}

fn count_hits(log []MatchLog, rule str) int {
    var n = 0
    for m in log {
        if m.rule == rule {
            if m.matched == 1 {
                n = n + 1
            }
        }
    }
    return n
}

fn hit_of(log []MatchLog, rule str, node str) int {
    for m in log {
        if m.rule == rule {
            if m.node == node {
                return m.matched
            }
        }
    }
    return 0
}

// ---- 文档节点（0 h1 / 1 p / 2 h2 / 3 p / 4 h2 / 5 p / 6 callout theorem / 7 h1 / 8 p） ----

fn demo_nodes() []StyleNode {
    var nodes []StyleNode = []
    nodes.push(node_view(0, "block-1", "heading", 1, ""))
    nodes.push(node_view(1, "block-2", "paragraph", 0, ""))
    nodes.push(node_view(2, "block-3", "heading", 2, ""))
    nodes.push(node_view(3, "block-4", "paragraph", 0, ""))
    nodes.push(node_view(4, "block-5", "heading", 2, ""))
    nodes.push(node_view(5, "block-6", "paragraph", 0, ""))
    nodes.push(node_view(6, "block-7", "callout", 0, "theorem"))
    nodes.push(node_view(7, "block-8", "heading", 1, ""))
    nodes.push(node_view(8, "block-9", "paragraph", 0, ""))
    return nodes
}

fn demo_rules() []StyleRule {
    var rules = builtin_rules()
    var theme = theme_print()
    for t in theme {
        rules.push(t)
    }
    rules.push(style_rule("tpl-body", "template", "", 0, sel_type("paragraph"), sized_text(11), ind_para(2), empty_doc()))
    rules.push(style_rule("doc-sub-emph", "document", "block-5", 1, sel_type("paragraph"), sized_text(13), empty_para(), empty_doc()))
    rules.push(style_rule("doc-h1", "document", "", 2, sel_attr("level", "1"), sized_text(16), empty_para(), empty_doc()))
    return rules
}

// ---- 各检查（返回 0/1） ----

fn check_t1a() int {
    // emphasis 按参数产生 Style：两个参数产生不同字号，经 jtext 序列化验证
    //（jtext 在 use file 下实测正确；直接比较字段的校验函数受 VM 缺陷影响，已删）
    let a = jtext(emphasis(pt(11, 0), 1500))
    let b = jtext(emphasis(pt(11, 0), 3000))
    var ok = 0
    if a.contains("\"value\":12.5") {
        if a.contains("\"unit\":\"pt\"") {
            if a.contains("\"weight\":700") {
                if b.contains("\"value\":14") {
                    ok = 1
                }
            }
        }
    }
    return ok
}

fn check_t1b() int {
    let t2 = emphasis(pt(11, 0), 3000)
    if t2.size.milli == 14000 {
        return 1
    }
    return 0
}

fn check_t1c() int {
    let c = check_text("rule:demo", bad_weight_text())
    if c.ok == 0 {
        if c.code == "E_STYLE_VALUE" {
            if c.message.contains("rule:demo") {
                if c.message.contains("text.weight") {
                    return 1
                }
            }
        }
    }
    return 0
}

fn check_t1d() int {
    let c = check_length("rule:demo", "text.size", bad_unit_len())
    if c.ok == 0 {
        if c.message.contains("unknown unit") {
            return 1
        }
    }
    return 0
}

fn check_t1e() int {
    // hex 颜色解析（3/6 位）
    let a = parse_hex_color("#1f2328")
    let b = parse_hex_color("#333")
    let bad = parse_hex_color("#zz")
    var ok = 0
    if a.ok == 1 {
        if a.color.r == 31 {
            if a.color.g == 35 {
                if a.color.b == 40 {
                    if b.color.r == 51 {
                        if b.color.g == 51 {
                            if bad.ok == 0 {
                                ok = 1
                            }
                        }
                    }
                }
            }
        }
    }
    return ok
}

fn check_t2a(nodes []StyleNode, rules []StyleRule) int {
    let cs = compose_styles(nodes, rules, [])
    let c2 = comp_by_id(cs, "block-2")
    var ok = 0
    if comp_size_milli(c2) == 11000 {
        if comp_indent_milli(c2) == 2000 {
            ok = 1
        }
    }
    return ok
}

fn check_t2b(nodes []StyleNode, rules []StyleRule) int {
    // block-5 子树内：文档规则 size 13 覆盖模板 11；缩进未被该规则设置 → 保持模板 2em（逐属性）
    let cs = compose_styles(nodes, rules, [])
    let c6 = comp_by_id(cs, "block-6")
    var ok = 0
    if comp_size_milli(c6) == 13000 {
        if comp_indent_milli(c6) == 2000 {
            ok = 1
        }
    }
    return ok
}

fn check_t2c(nodes []StyleNode, rules []StyleRule) int {
    // 离开 block-5 子树即恢复：block-9 回到模板 11pt
    let cs = compose_styles(nodes, rules, [])
    let c9 = comp_by_id(cs, "block-9")
    if comp_size_milli(c9) == 11000 {
        return 1
    }
    return 0
}

fn check_t2d(nodes []StyleNode, rules []StyleRule) int {
    // 主题层生效：段落颜色来自 theme-print-ink；标题未设置颜色
    let cs = compose_styles(nodes, rules, [])
    let c2 = comp_by_id(cs, "block-2")
    let c1 = comp_by_id(cs, "block-1")
    var ok = 0
    if comp_color_r(c2) == 31 {
        if comp_color_r(c1) == -1 {
            ok = 1
        }
    }
    return ok
}

fn check_t2e(nodes []StyleNode, rules []StyleRule) int {
    // 来源链：block-6 text.size 链 = builtin-body → tpl-body → doc-sub-emph（末位生效）；
    // 经 jcomputed_all 序列化验证（sources 链在 JSON 中逐条可见）
    let cs = compose_styles(nodes, rules, [])
    let json = jcomputed_all(cs)
    let marker = "\"prop\":\"text.size\",\"layer\":3,\"origin\":\"document\",\"rule\":\"doc-sub-emph\""
    var n = 0
    var ok = 0
    if json.contains(marker) {
        ok = 1
    }
    // 链中同属性来源按层升序：模板来源在文档来源之前
    let tpl_marker = "\"prop\":\"text.size\",\"layer\":2,\"origin\":\"template\",\"rule\":\"tpl-body\""
    let doc_pos = find_pos(json, marker)
    let tpl_pos = find_pos(json, tpl_marker)
    if ok == 1 {
        if doc_pos >= 0 {
            if tpl_pos >= 0 {
                if tpl_pos < doc_pos {
                    n = 1
                }
            }
        }
    }
    return n
}

fn find_pos(hay str, needle str) int {
    // 简单子串查找（无 index_of 内建时的逐字节滑窗）
    let hs = hay.to(str)
    let n = hs.len()
    let m = needle.len()
    if m == 0 || m > n {
        return -1
    }
    var i = 0
    while i + m <= n {
        var j = 0
        var hit = 1
        while j < m {
            if hs.char_at(i + j) != needle.char_at(j) {
                hit = 0
                j = m
            }
            j = j + 1
        }
        if hit == 1 {
            return i
        }
        i = i + 1
    }
    return -1
}

fn check_t2f(nodes []StyleNode, rules []StyleRule) int {
    // 节点显式属性最高：block-4 显式 15pt 覆盖文档/模板；其余属性仍来自模板（未提前固化）
    var explicit = []
    explicit.push(explicit_size("block-4", 15))
    let cs = compose_styles(nodes, rules, explicit)
    let c4 = comp_by_id(cs, "block-4")
    var ok = 0
    if comp_size_milli(c4) == 15000 {
        if comp_indent_milli(c4) == 2000 {
            ok = 1
        }
    }
    return ok
}

fn check_t3_sel(nodes []StyleNode) int {
    // id / role / and / or / attr 组合选择器的可观察匹配
    var rules = []
    rules.push(style_rule("sel-id", "document", "", 0, sel_id("block-7"), empty_text(), empty_para(), empty_doc()))
    rules.push(style_rule("sel-role", "document", "", 1, sel_role("theorem"), empty_text(), empty_para(), empty_doc()))
    rules.push(style_rule("sel-and", "document", "", 2, sel_and([sel_type("heading"), sel_attr("level", "2")]), empty_text(), empty_para(), empty_doc()))
    rules.push(style_rule("sel-or", "document", "", 3, sel_or([sel_attr("callout_type", "tip"), sel_id("block-8")]), empty_text(), empty_para(), empty_doc()))
    let log = match_log_of(nodes, rules)
    var ok = 0
    if count_hits(log, "sel-id") == 1 {
        if hit_of(log, "sel-id", "block-7") == 1 {
            if count_hits(log, "sel-role") == 1 {
                if hit_of(log, "sel-role", "block-2") == 0 {
                    if count_hits(log, "sel-and") == 2 {
                        if hit_of(log, "sel-and", "block-1") == 0 {
                            if hit_of(log, "sel-and", "block-3") == 1 {
                                if count_hits(log, "sel-or") == 1 {
                                    if hit_of(log, "sel-or", "block-8") == 1 {
                                        ok = 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return ok
}

fn check_t4_wire_ok() int {
    var wire = "STYLEWIRE 1\n"
    wire = wire + "rule\twire-sub\tdocument\tblock-5\t1\n"
    wire = wire + "sel\ttype\tparagraph\t\t\t\n"
    wire = wire + "prop\ttext.size\t13\tpt\n"
    wire = wire + "xstyle\tblock-4\n"
    wire = wire + "prop\ttext.size\t15\tpt\n"
    wire = wire + "end\n"
    let parsed = parse_styles_wire(wire)
    var ok = 0
    if parsed.ok == 1 {
        if parsed.rules.len() == 1 {
            if parsed.explicit.len() == 1 {
                if parsed.rules[0].text.size.milli == 13000 {
                    if parsed.explicit[0].text.size.milli == 15000 {
                        ok = 1
                    }
                }
            }
        }
    }
    return ok
}

fn check_t4_wire_unknown() int {
    var wire = "STYLEWIRE 1\n"
    wire = wire + "rule\tw1\tdocument\t\t0\n"
    wire = wire + "prop\ttext.kern\t1\n"
    wire = wire + "end\n"
    let bad = parse_styles_wire(wire)
    if bad.ok == 0 {
        if bad.code == "E_STYLE_PROP_UNKNOWN" {
            return 1
        }
    }
    return 0
}

fn check_t4_wire_negative() int {
    var wire = "STYLEWIRE 1\n"
    wire = wire + "rule\tw2\tdocument\t\t0\n"
    wire = wire + "prop\ttext.size\t-3\tpt\n"
    wire = wire + "end\n"
    let bad = parse_styles_wire(wire)
    if bad.ok == 0 {
        if bad.code == "E_STYLE_VALUE" {
            if bad.message.contains("negative") {
                return 1
            }
        }
    }
    return 0
}

fn check_t4_wire_badscope() int {
    var wire = "STYLEWIRE 1\n"
    wire = wire + "rule\tw3\tdocument\tblock-99\t0\n"
    wire = wire + "prop\ttext.size\t13\tpt\n"
    wire = wire + "end\n"
    let nodes = demo_nodes()
    let parsed = parse_styles_wire(wire)
    if parsed.ok == 1 {
        let chk = validate_rules(parsed.rules, nodes)
        if chk.ok == 0 {
            if chk.code == "E_STYLE_SCOPE" {
                return 1
            }
        }
    }
    return 0
}

fn check_t5_json() int {
    let nodes = demo_nodes()
    let rules = demo_rules()
    let cs = compose_styles(nodes, rules, [])
    let json = jcomputed_all(cs)
    var ok = 0
    if json.contains("\"id\":\"block-6\"") {
        if json.contains("\"rule\":\"doc-sub-emph\"") {
            if json.contains("\"value\":13") {
                ok = 1
            }
        }
    }
    return ok
}

fn main() {
    var ok = 0
    var total = 0

    total = total + 1
    let r1 = check_t1a()
    ok = ok + r1
    print("t1a=" + r1.to(str))
    total = total + 1
    let r2 = check_t1b()
    ok = ok + r2
    print("t1b=" + r2.to(str))
    total = total + 1
    let r3 = check_t1c()
    ok = ok + r3
    print("t1c=" + r3.to(str))
    total = total + 1
    let r4 = check_t1d()
    ok = ok + r4
    print("t1d=" + r4.to(str))
    total = total + 1
    let r5 = check_t1e()
    ok = ok + r5
    print("t1e=" + r5.to(str))

    let nodes = demo_nodes()
    let rules = demo_rules()
    total = total + 1
    let r6 = check_t2a(nodes, rules)
    ok = ok + r6
    print("t2a=" + r6.to(str))
    total = total + 1
    let r7 = check_t2b(nodes, rules)
    ok = ok + r7
    print("t2b=" + r7.to(str))
    total = total + 1
    let r8 = check_t2c(nodes, rules)
    ok = ok + r8
    print("t2c=" + r8.to(str))
    total = total + 1
    let r9 = check_t2d(nodes, rules)
    ok = ok + r9
    print("t2d=" + r9.to(str))
    total = total + 1
    let r10 = check_t2e(nodes, rules)
    ok = ok + r10
    print("t2e=" + r10.to(str))
    total = total + 1
    let r11 = check_t2f(nodes, rules)
    ok = ok + r11
    print("t2f=" + r11.to(str))

    total = total + 1
    let r12 = check_t3_sel(nodes)
    ok = ok + r12
    print("t3sel=" + r12.to(str))

    total = total + 1
    let r13 = check_t4_wire_ok()
    ok = ok + r13
    print("wire_ok=" + r13.to(str))
    total = total + 1
    let r14 = check_t4_wire_unknown()
    ok = ok + r14
    print("wire_unknown=" + r14.to(str))
    total = total + 1
    let r15 = check_t4_wire_negative()
    ok = ok + r15
    print("wire_negative=" + r15.to(str))
    total = total + 1
    let r16 = check_t4_wire_badscope()
    ok = ok + r16
    print("wire_badscope=" + r16.to(str))

    total = total + 1
    let r17 = check_t5_json()
    ok = ok + r17
    print("t5json=" + r17.to(str))

    // 结果（增量拼接）
    var result = "{\"ok_count\":" + ok.to(str)
    result = result + ",\"total\":" + total.to(str)
    result = result + ",\"all_pass\":"
    if ok == total {
        result = result + "true}"
    } else {
        result = result + "false}"
    }
    print(result)
}
