// app.at — PLAN-059 three-mode showcase root widget (demo app.at precedent,
// plan 040 contract flow). File name is the auto CLI's hardcoded entry
// (src/front/app.at), hence the demo-shared name despite the showcase app.
//
// Three-mode layout (T3): toolbar with edit/view/stream toggles (any
// combination, all on by default) over a row of conditional cols —
// edit = autodown_editor (content single source, oninput writes .content),
// view = autodown streaming:false (live mirror), stream = autodown
// streaming:true on .stream_text (feed window, T5 fills the state machine).
//
// Regenerate + deploy: bash gen/regen.sh (from showcase/auto).
// VM track: D:/autostack/auto-lang/target/debug/auto.exe run -r vm.

// PLAN-059 T7(修正): VM 轨子件注册——顶层 `use <模块>` 把兄弟 .at widget
// 登记进运行时 WidgetRegistry(lib.rs register_transitive_widgets 只沿 use
// 语句链收集;demo app.at L73/L78 同款)。缺此行则 ⚙ 弹层在 VM 永不渲染
// (vue 轨不受影响——vue gen 扫描 front 目录自行 import)。
use settings_popover

use.web.fn initial_content from "src/front/utils/showcase_ext.at"

widget App {
    use {
        // PLAN-059 T6: vue 轨 timer 桥（demo useDemoAppBridge 先例——零参
        // composable 在 setup 顶层调用，reactive bag 经 .showcaseBridge 消费）。
        // use 块条目间不带尾逗号（解析器硬约束，060 记录于计划待澄清）。
        fn: log_ready, is_vue from "src/front/utils/showcase_ext.ts"
        composable: useShowcaseBridge from "src/front/utils/showcase_ext.ts"
    }

    msg Msg { Init, Edit(str), ToggleEdit, ToggleView, ToggleStream,
              // PLAN-059 T5: feed 状态机——重播快照/步进/播放暂停/三档速度。
              FeedStep, FeedReset, FeedPlayPause, FeedSetSpeed(int),
              // PLAN-059 T7: settings 回路（051 demo 同名契约）——⚙ 开、✕ 关、
              // 主题/accent 由 SettingsPopover 子件消息冒泡（on "SetTheme"/
              // "SetAccent" 监听）。
              OpenSettings, CloseSettings, SetTheme(str), SetAccent(str) }

    model {
        // The document body — single source (edit writes, view mirrors).
        var content str = ""
        // Stream feed window (T5 state machine); empty until a replay.
        var stream_text str = ""
        // Pane visibility toggles — any combination, all on by default.
        var show_edit bool = true
        var show_view bool = true
        var show_stream bool = true
        // PLAN-059 T5 feed 状态机：feed_source = 重播开始时的 content 快照
        //（播放期间继续编辑不影响本次重播，再播取新快照）；playing 仅 vue
        // 轨真驱动（T6 timer），VM 轨步进代用（DEBTS 059 豁免行）；speed =
        // 字符/步三档（24|96|384 × 90ms tick）。
        var feed_source str = ""
        var playing bool = false
        var speed int = 96
        // PLAN-059 T7: 主题（051 语义）——dark_mode 是 renderer 认可名
        //（VM 经 D-GAP 全局翻转，PLAN-047 链路）；accent 盘名经引擎
        // darkMode/accent props 三栏贯通（vue 轨 .is-dark + data-accent）。
        var dark_mode bool = false
        var accent_color str = "indigo"
        var settings_open bool = false
    }

    computed {
        // PLAN-059 T6: feed 窗口三态按轨分派（demo csb_* 先例）——vue 轨
        // 读 showcaseBridge（timer 在 ext 桥驱动），VM 轨读 widget state
        //（T5 状态机驱动）。stream 栏绑定 feed_text。
        // 分支序（复审修正）：VM 臂放 then——VM 上 vue 臂的 .showcaseBridge
        // 不可解析，放 else 时 054 分支回退未兜住（stream 栏起屏误染全
        // 文档）；cond 取 == None 反转后两轨各走可解析臂。
        feed_text => is_vue() == None ? .stream_text : .showcaseBridge.streamText
        feed_source_text => is_vue() == None ? .feed_source : .showcaseBridge.feedSource
        feed_playing => is_vue() == None ? .playing : .showcaseBridge.playing
        // feed 进度/落定态（栏头状态行同源）。表达式面：str.len()/substr/
        // str() 数字转串/三元链——aura_view_builder 9392+ 内建面 + jade
        // tabs_store.at 的 handler 内 len()/Math.min 双轨先例。
        stream_len => .feed_text.len()
        source_len => .feed_source_text.len()
        settled => .source_len > 0 && .feed_text == .feed_source_text
        stream_pct => .source_len == 0 ? 100 : (.stream_len * 100 / .source_len)
        stream_status => .settled ? "已落定" : (.feed_playing ? ("流式中 " + .stream_pct.str() + "%") : (.source_len > 0 ? "已暂停" : "未开始"))
    }

    view {
        div {
            // PLAN-059 T7: app 级 chrome 深浅条件类——vue 轨 .app-dark 兜底
            // 规则在 style 块（051 demo 同款，值=Design 22 §7.1 深档）；
            // VM 轨 class 惰性，chrome 由 dark_mode 状态经 D-GAP 全局翻转。
            class: if .dark_mode { "app app-dark" } else { "app" },
            header {
                class: "toolbar",
                row {
                    class: "toolbar-inner",
                    text "AutoDown Showcase"
                    row {
                        class: "toggles",
                        // Pane toggles — the e2e anchors are the class names
                        // (toggle-edit/toggle-view/toggle-stream); showcase
                        // owns its own anchors, the demo .left/.right set is
                        // untouched (PLAN-059 冻结锚零扰动).
                        native_button "edit" {
                            onclick: .ToggleEdit,
                            class: if .show_edit { "toggle toggle-on toggle-edit" } else { "toggle toggle-edit" }
                        }
                        native_button "view" {
                            onclick: .ToggleView,
                            class: if .show_view { "toggle toggle-on toggle-view" } else { "toggle toggle-view" }
                        }
                        native_button "stream" {
                            onclick: .ToggleStream,
                            class: if .show_stream { "toggle toggle-on toggle-stream" } else { "toggle toggle-stream" }
                        }
                    }
                    // PLAN-059 T5: stream 控制组——重播/步进/速度三档；▶
                    // 仅 vue 轨（timer 走 ext 逃生舱，VM 无 tick 原语，DEBTS
                    // 059 豁免行；VM 轨 ⏭ 步进代用）。
                    row {
                        class: "stream-controls",
                        if is_vue() != None {
                            native_button "▶" {
                                onclick: .FeedPlayPause,
                                class: if .feed_playing { "ctrl-btn ctrl-on btn-play" } else { "ctrl-btn btn-play" }
                            }
                        }
                        native_button "⏭" {
                            onclick: .FeedStep,
                            class: "ctrl-btn btn-step"
                        }
                        native_button "↻" {
                            onclick: .FeedReset,
                            class: "ctrl-btn btn-replay"
                        }
                        row {
                            class: "speed-select",
                            native_button "慢" {
                                onclick: .FeedSetSpeed(24),
                                class: if .speed == 24 { "ctrl-btn speed-btn-on speed-lo" } else { "ctrl-btn speed-lo" }
                            }
                            native_button "中" {
                                onclick: .FeedSetSpeed(96),
                                class: if .speed == 96 { "ctrl-btn speed-btn-on speed-mid" } else { "ctrl-btn speed-mid" }
                            }
                            native_button "快" {
                                onclick: .FeedSetSpeed(384),
                                class: if .speed == 384 { "ctrl-btn speed-btn-on speed-hi" } else { "ctrl-btn speed-hi" }
                            }
                        }
                    }
                    // PLAN-059 T7: ⚙ 钮开 settings 弹层（native_button=显式
                    // 原生逃生名，051 demo 先例——vue 侧避开 button→shadcn
                    // Button 映射，零新 npm 依赖）。
                    native_button "⚙" {
                        onclick: .OpenSettings,
                        class: "settings-trigger w-7 h-7 flex items-center justify-center rounded text-sm text-gray-500 hover:text-gray-900 bg-transparent border-none cursor-pointer"
                    }
                }
            }
            // PLAN-059 T7: settings 弹层（settings_popover.at 兄弟件，051
            // demo 原样复制）——open=false 时零渲染，默认布局不变。
            SettingsPopover {
                open: .settings_open,
                dark_mode: .dark_mode,
                accent_color: .accent_color,
                on "Close": .CloseSettings,
                on "SetTheme": .SetTheme($event),
                on "SetAccent": .SetAccent($event)
            }
            main {
                class: "workspace",
                row {
                    class: "h-full w-full",
                    if .show_edit {
                        col {
                            class: "flex-1 min-w-0 overflow-hidden col-edit",
                            row {
                                class: "pane-header",
                                text "edit"
                            }
                            autodown_editor {
                                content: .content,
                                placeholder: "Start typing...",
                                class: "flex-1 min-h-0 overflow-hidden",
                                // PLAN-059 T7: 主题声明入口（051 引擎 props——
                                // 组件根 .is-dark + data-accent；VM 臂 prop 惰性，
                                // dark_mode 经 D-GAP 全局链路自达）。
                                dark_mode: .dark_mode,
                                accent: .accent_color,
                                oninput: .Edit
                            }
                        }
                    }
                    if .show_view {
                        col {
                            class: "flex-1 min-w-0 overflow-hidden col-view",
                            row {
                                class: "pane-header",
                                text "view"
                            }
                            autodown {
                                content: .content,
                                streaming: false,
                                class: "flex-1 min-h-0 overflow-hidden py-4 px-5",
                                dark_mode: .dark_mode,
                                accent: .accent_color
                            }
                        }
                    }
                    if .show_stream {
                        col {
                            class: "flex-1 min-w-0 overflow-hidden col-stream",
                            row {
                                class: "pane-header",
                                text "stream"
                                span { class: "pane-status", text .stream_status }
                            }
                            autodown {
                                content: .feed_text,
                                streaming: true,
                                class: "flex-1 min-h-0 overflow-hidden py-4 px-5",
                                dark_mode: .dark_mode,
                                accent: .accent_color
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            .content = initial_content()
            if is_vue() != None {
                log_ready("init")
            }
        }
        .Edit(md) -> {
            .content = md
        }
        .ToggleEdit -> {
            .show_edit = !.show_edit
        }
        .ToggleView -> {
            .show_view = !.show_view
        }
        .ToggleStream -> {
            .show_stream = !.show_stream
        }
        // PLAN-059 T5 feed 状态机。FeedReset：快照 content → feed_source、
        // 清空 stream 窗口（再次重播取新快照）。FeedStep：前缀切片步进
        //（str.len()/substr/Math.min 双轨内建面），到头自动熄播放旗。
        // FeedPlayPause：从未开始或已落定态起播都取新快照；暂停/续播走
        // 原快照（播放期间编辑 content 不干扰本次重播）。
        .FeedReset -> {
            if is_vue() != None {
                .showcaseBridge.reset(.content)
            } else {
                .feed_source = .content
                .stream_text = ""
                .playing = false
            }
        }
        .FeedStep -> {
            if is_vue() != None {
                .showcaseBridge.step()
            } else {
                if .feed_source.len() > 0 && .stream_text.len() < .feed_source.len() {
                    .stream_text = .feed_source.substr(0, Math.min(.feed_source.len(), .stream_text.len() + .speed))
                } else {
                    .playing = false
                }
            }
        }
        .FeedPlayPause -> {
            if is_vue() != None {
                if .showcaseBridge.feedSource == "" || .showcaseBridge.streamText == .showcaseBridge.feedSource {
                    .showcaseBridge.reset(.content)
                }
                .showcaseBridge.playing = !.showcaseBridge.playing
                if .showcaseBridge.playing {
                    .showcaseBridge.play()
                } else {
                    .showcaseBridge.stop()
                }
            } else {
                if .feed_source == "" || .stream_text == .feed_source {
                    .feed_source = .content
                    .stream_text = ""
                }
                .playing = !.playing
            }
        }
        .FeedSetSpeed(v) -> {
            .speed = v
            if is_vue() != None {
                .showcaseBridge.speed = v
            }
        }
        // PLAN-059 T7: settings 回路（051 demo 同名契约逐字对齐）。
        .OpenSettings -> {
            .settings_open = true
        }
        .CloseSettings -> {
            .settings_open = false
        }
        .SetTheme(t) -> {
            .dark_mode = t == "dark"
        }
        .SetAccent(a) -> {
            .accent_color = a
        }
    }

    style {
        .app {
            display: flex;
            flex-direction: column;
            height: 100vh;
            font-family: system-ui, -apple-system, sans-serif;
            color: #111827;
        }

        .toolbar {
            flex-shrink: 0;
            height: 48px;
            display: flex;
            align-items: center;
            padding: 0 1.25rem;
            border-bottom: 1px solid #e5e7eb;
            background: #fff;
            font-weight: 600;
            font-size: 1rem;
        }

        .toolbar-inner {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .toggles {
            display: flex;
            gap: 8px;
        }

        .toggle {
            padding: 4px 12px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            background: #fff;
            color: #374151;
            font-size: 13px;
            cursor: pointer;
        }

        .toggle-on {
            background: #6366f1;
            border-color: #6366f1;
            color: #fff;
        }

        .workspace {
            position: relative;
            flex: 1;
            min-height: 0;
            overflow: hidden;
        }

        .stream-controls {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .ctrl-btn {
            padding: 4px 10px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            background: #fff;
            color: #374151;
            font-size: 12px;
            cursor: pointer;
        }

        .ctrl-on {
            background: #10b981;
            border-color: #10b981;
            color: #fff;
        }

        .speed-select {
            display: flex;
            gap: 4px;
            margin-left: 4px;
        }

        .speed-btn-on {
            background: #6366f1;
            border-color: #6366f1;
            color: #fff;
        }

        .pane-header {
            flex-shrink: 0;
            height: 32px;
            display: flex;
            align-items: center;
            padding: 0 12px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #6b7280;
            background: #f3f4f6;
            border-bottom: 1px solid #e5e7eb;
        }

        /* PLAN-059 T7: 深档 chrome（051 demo .app-dark 同款 + showcase
         * 控件组的 zinc 深档覆写，值=Design 22 §7.1 深列）。 */
        .app-dark {
            color: #f4f4f5;
            background: #09090b;
        }

        .app-dark .toolbar {
            border-bottom-color: #27272a;
            background: #18181b;
        }

        .app-dark .pane-header {
            color: #a1a1aa;
            background: #18181b;
            border-bottom-color: #27272a;
        }

        .app-dark .toggle,
        .app-dark .ctrl-btn {
            background: #27272a;
            border-color: #3f3f46;
            color: #d4d4d8;
        }

        .app-dark .toggle-on,
        .app-dark .ctrl-on,
        .app-dark .speed-btn-on {
            background: #6366f1;
            border-color: #6366f1;
            color: #fff;
        }

        .settings-trigger {
            border: none;
            background: transparent;
            cursor: pointer;
        }

        .pane-status {
            margin-left: auto;
            font-weight: 400;
            text-transform: none;
            letter-spacing: 0;
            font-size: 11px;
            color: #6b7280;
        }

        /* Utility classes (vue track: the DSL maps row/col/flex-1 to real
         * CSS via these scoped rules — demo app.at precedent; VM track
         * consumes row/col/flex-1 natively, unknown tokens zero-effect). */
        .flex {
            display: flex;
        }

        .flex-row {
            flex-direction: row;
        }

        .flex-col {
            flex-direction: column;
        }

        .flex-1 {
            flex: 1 1 0%;
        }

        .h-full {
            height: 100%;
        }

        .w-full {
            width: 100%;
        }

        .min-w-0 {
            min-width: 0;
        }

        .min-h-0 {
            min-height: 0;
        }

        .overflow-hidden {
            overflow: hidden;
        }

        .px-5 {
            padding-left: 1.25rem;
            padding-right: 1.25rem;
        }

        .py-4 {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }

        :deep(.autodown-editor) {
            border: none;
            border-radius: 0;
        }

        :deep(.autodown-editor-content-wrapper) {
            height: 100%;
            overflow-y: auto;
        }
    }
}
