// settings_popover.at — SettingsPopover widget (Auto language source).
//
// PLAN-059 T7: copied verbatim from demo/auto/src/front/settings_popover.at
// (PLAN-051 T6) — the popover was designed as a self-contained reusable
// sibling widget (props open/dark_mode/accent_color, msgs Close/SetTheme/
// SetAccent). Only this header differs from the demo original.
// PLAN-051 T6: demo 双轨 settings 弹层（参照 auto-lang
// examples/ui/common/settings/settings_popover.at 适配）。适配差异：
//
// - shadcn token 类（bg-card/border-border/text-foreground/bg-primary/
//   hover:bg-accent/ring-offset-card…）全部改写为具体值类——demo 构建无
//   tailwind/shadcn 运行时，vue 轨只能落地具体值；VM 轨 StyleClass 原生
//   消费同名类。两轨同串同值（规约锚：auto-lang Design 22 §7.1 中性板）。
// - vue 侧观感由本文件 style{} 块兜底定义（编译进组件 SFC 的 scoped
//   style，plan 046「scoped 工具类兜底」原则；app.at 的 style 块不用动）。
// - 深浅条件类串：面板/文字/按钮 token 按 .dark_mode 切换（zinc 深档=
//   Design 22 §7.1 深列，与 app 级 .app-dark / 引擎 .is-dark 同源）。
// - 布局用自管 div + flex 类串（不用 row/col——它们注入 flex flex-col
//   gap-4 与本件 gap-3 冲突，README gotcha 7）。
// - 交互从简：无点击外侧关闭/Esc（plan 待澄清 5 裁定不做，✕ 钮即关）。
//
// Props in / msgs out —— 父级（app.at）挂载监听：
//   on "Close": …, on "SetTheme": …($event), on "SetAccent": …($event)

widget SettingsPopover(open: bool = false, dark_mode: bool = false, accent_color: str = "indigo") {
    msg Msg { Close, SetTheme(str), SetAccent(str) }

    view {
        if .open {
            div {
                class: if .dark_mode {
                    "settings-popover flex flex-col gap-3 mt-4 p-3.5 w-64 bg-zinc-900 border border-zinc-700 rounded-xl shadow-lg"
                } else {
                    "settings-popover flex flex-col gap-3 mt-4 p-3.5 w-64 bg-white border border-gray-200 rounded-xl shadow-lg"
                },
                div {
                    class: "flex items-center justify-between",
                    text "Settings" {
                        class: if .dark_mode {
                            "text-xs font-semibold text-zinc-400 uppercase tracking-wider"
                        } else {
                            "text-xs font-semibold text-gray-500 uppercase tracking-wider"
                        }
                    }
                    native_button "✕" {
                        onclick: .Close,
                        class: if .dark_mode {
                            "settings-btn flex items-center justify-center w-5 h-5 rounded text-xs text-zinc-400 hover:text-zinc-100 bg-transparent border-none"
                        } else {
                            "settings-btn flex items-center justify-center w-5 h-5 rounded text-xs text-gray-500 hover:text-gray-900 bg-transparent border-none"
                        }
                    }
                }
                div {
                    class: "flex flex-col gap-1.5",
                    text "Theme" {
                        class: if .dark_mode {
                            "text-xs text-zinc-400 font-medium"
                        } else {
                            "text-xs text-gray-500 font-medium"
                        }
                    }
                    div {
                        class: "flex gap-2",
                        native_button "🌙 Dark" {
                            onclick: .SetTheme("dark"),
                            class: if .dark_mode {
                                "settings-btn flex-1 py-1 px-2 text-xs font-medium rounded-md bg-indigo-600 text-white border-none"
                            } else {
                                "settings-btn flex-1 py-1 px-2 text-xs font-medium rounded-md text-gray-500 bg-transparent border border-gray-200"
                            }
                        }
                        native_button "☀ Light" {
                            onclick: .SetTheme("light"),
                            class: if .dark_mode {
                                "settings-btn flex-1 py-1 px-2 text-xs font-medium rounded-md text-zinc-400 bg-transparent border border-zinc-700"
                            } else {
                                "settings-btn flex-1 py-1 px-2 text-xs font-medium rounded-md bg-indigo-600 text-white border-none"
                            }
                        }
                    }
                }
                div {
                    class: "flex flex-col gap-1.5",
                    text "Accent" {
                        class: if .dark_mode {
                            "text-xs text-zinc-400 font-medium"
                        } else {
                            "text-xs text-gray-500 font-medium"
                        }
                    }
                    div {
                        class: "flex items-center gap-3 py-1",
                        native_button "" {
                            onclick: .SetAccent("indigo"),
                            class: if .accent_color == "indigo" {
                                "settings-btn w-6 h-6 p-0 rounded-full bg-indigo-500 border-2 border-gray-700"
                            } else {
                                "settings-btn w-6 h-6 p-0 rounded-full bg-indigo-500 opacity-50 border-none"
                            }
                        }
                        native_button "" {
                            onclick: .SetAccent("coral"),
                            class: if .accent_color == "coral" {
                                "settings-btn w-6 h-6 p-0 rounded-full bg-rose-500 border-2 border-gray-700"
                            } else {
                                "settings-btn w-6 h-6 p-0 rounded-full bg-rose-500 opacity-50 border-none"
                            }
                        }
                        native_button "" {
                            onclick: .SetAccent("ocean"),
                            class: if .accent_color == "ocean" {
                                "settings-btn w-6 h-6 p-0 rounded-full bg-sky-500 border-2 border-gray-700"
                            } else {
                                "settings-btn w-6 h-6 p-0 rounded-full bg-sky-500 opacity-50 border-none"
                            }
                        }
                        native_button "" {
                            onclick: .SetAccent("sage"),
                            class: if .accent_color == "sage" {
                                "settings-btn w-6 h-6 p-0 rounded-full bg-emerald-500 border-2 border-gray-700"
                            } else {
                                "settings-btn w-6 h-6 p-0 rounded-full bg-emerald-500 opacity-50 border-none"
                            }
                        }
                        native_button "" {
                            onclick: .SetAccent("amber"),
                            class: if .accent_color == "amber" {
                                "settings-btn w-6 h-6 p-0 rounded-full bg-amber-500 border-2 border-gray-700"
                            } else {
                                "settings-btn w-6 h-6 p-0 rounded-full bg-amber-500 opacity-50 border-none"
                            }
                        }
                    }
                }
            }
        }
    }

    style {
        /* vue 兜底：demo 无 tailwind 运行时，本件用到的工具类在此 scoped
           定义（VM 轨经 auto-lang tailwind 解析器原生消费同名类，值同源
           Design 22 §7.1）。先 button 基座重置，再布局/色值。 */
        .settings-popover button {
            border: none;
            background: transparent;
            cursor: pointer;
            font-family: inherit;
            line-height: 1;
        }

        .flex {
            display: flex;
        }

        .flex-col {
            flex-direction: column;
        }

        .items-center {
            align-items: center;
        }

        .justify-between {
            justify-content: space-between;
        }

        .flex-1 {
            flex: 1 1 0%;
        }

        .gap-3 {
            gap: 0.75rem;
        }

        .gap-2 {
            gap: 0.5rem;
        }

        .gap-1\.5 {
            gap: 0.375rem;
        }

        .mt-4 {
            margin-top: 1rem;
        }

        .p-3\.5 {
            padding: 0.875rem;
        }

        .py-1 {
            padding-top: 0.25rem;
            padding-bottom: 0.25rem;
        }

        .px-2 {
            padding-left: 0.5rem;
            padding-right: 0.5rem;
        }

        .p-0 {
            padding: 0;
        }

        .w-64 {
            width: 16rem;
        }

        .w-5 {
            width: 1.25rem;
        }

        .w-6 {
            width: 1.5rem;
        }

        .h-5 {
            height: 1.25rem;
        }

        .h-6 {
            height: 1.5rem;
        }

        .rounded {
            border-radius: 0.25rem;
        }

        .rounded-md {
            border-radius: 0.375rem;
        }

        .rounded-full {
            border-radius: 9999px;
        }

        .border {
            border-width: 1px;
            border-style: solid;
        }

        .border-none {
            border: none;
        }

        .rounded-xl {
            border-radius: 0.75rem;
        }

        .shadow-lg {
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
        }

        .text-xs {
            font-size: 0.75rem;
        }

        .font-medium {
            font-weight: 500;
        }

        .font-semibold {
            font-weight: 600;
        }

        .uppercase {
            text-transform: uppercase;
        }

        .tracking-wider {
            letter-spacing: 0.05em;
        }

        .bg-white {
            background: #ffffff;
        }

        .bg-zinc-900 {
            background: #18181b;
        }

        .bg-transparent {
            background: transparent;
        }

        /* PLAN-051 复审 F2 修正：swatch 色类挂 .settings-popover 作用域——
           裸类 (0,2,0 scoped) 输给按钮重置 .settings-popover button
           (0,2,1 scoped)，五色 swatch 曾全透明（vue-051-accent-coral.png
           判读发现）。作用域版 (0,3,0) 必胜；主题钮 active 底同升。 */
        .settings-popover .bg-indigo-500 {
            background: #6366f1;
        }

        .settings-popover .bg-indigo-600 {
            background: #4f46e5;
        }

        .settings-popover .bg-rose-500 {
            background: #f43f5e;
        }

        .settings-popover .bg-sky-500 {
            background: #0ea5e9;
        }

        .settings-popover .bg-emerald-500 {
            background: #10b981;
        }

        .settings-popover .bg-amber-500 {
            background: #f59e0b;
        }

        .text-white {
            color: #ffffff;
        }

        .text-gray-500 {
            color: #6b7280;
        }

        .text-gray-900 {
            color: #111827;
        }

        .text-zinc-400 {
            color: #a1a1aa;
        }

        .text-zinc-100 {
            color: #f4f4f5;
        }

        .border-gray-200 {
            border-color: #e5e7eb;
        }

        .border-zinc-700 {
            border-color: #3f3f46;
        }

        .border-2 {
            border-width: 2px;
            border-style: solid;
        }

        .border-gray-700 {
            border-color: #374151;
        }

        .opacity-50 {
            opacity: 0.5;
        }

        .hover\:text-gray-900:hover {
            color: #111827;
        }

        .hover\:text-zinc-100:hover {
            color: #f4f4f5;
        }
    }
}
