// jade-garden API contract — single source for the /api/* wire shapes.
//
// Plan 022 Phase 1 (api.at contract revival from legacy-autoui seed):
// every live route's request/response shape is declared here and emitted
// to TS via a2ts (gen.mjs → gen-ts/api_gen.ts, deployed copy at
// front/src/lib/api_gen.ts). The hand-written fetch layer lives in
// front/src/lib/api.ts and re-exports these types; it must not declare
// competing shapes.
//
// The legacy-autoui `#[api]` route-codegen annotations were NOT revived
// in Phase 1 (old AutoUI toolchain, plan 011 stays archived) — the route
// mapping is documented per section and machine-read from the
// `// ROUTE:` markers below (tests/api-contract-routes.mjs asserts they
// cover every route in back/server/src/main.rs).
//
// Phase 4 slice 2 (2026-08-29): the `#[api]` fn layer RETURNS in its
// modern Plan 312/340 form — VM 渲染模式的前台调用据此改写（split=
// HTTP / merged=进程内），服务桌面形态（auto-musk 同款模式）。规则：
//   - 每个 JSON 路由一个 stub fn（体 `return None`，仅声明性元数据），
//     与 ROUTE 注释双登记，门检对拍两侧一致；
//   - multipart/二进制路由（assets/upload、export/import markdown）无
//     #[api] fn（不过 VM 信封，Phase 3 D4），门检豁免清单显式列出；
//   - gen.mjs 剥离 TS 发射中的 fn 块——TS 客户端面仍由手写 fetch 层
//     独占（Phase 1 设计不变）。
//
// Contract change process (plan 022 Phase 1 acceptance):
//   1. change the backend handler DTO first (it owns the wire),
//   2. mirror the shape here (type + ROUTE section comment + #[api] fn),
//   3. `node gen.mjs` regenerates gen-ts/api_gen.ts and the deployed
//      front/src/lib/api_gen.ts copy,
//   4. api.ts fetchers follow the new shape; `pnpm build` (vue-tsc)
//      fails on any client drift,
//   5. tests/api-contract-routes.mjs fails if a route exists without a
//      contract section (add the ROUTE marker when adding routes) and
//      if the #[api] fn layer and the ROUTE markers disagree.
// The backend serde DTOs remain the runtime authority; e2e (23 specs)
// is the behavioral parity gate.
//
// Error face (all routes): non-2xx responses carry JSON
// `{"error": string}` (ApiError, error.rs); plain-text bodies are a
// legacy fallback the client tolerates.

// ------------------------------------------------------ errors

// ROUTE: (all routes)  non-2xx response body
pub type ApiError {
    error str
}

// ------------------------------------------------------ marker type
// Open JSON object (arbitrary keys) — the Auto DSL has no map type that
// a2ts emits usefully, so gen.mjs post-fixes `JsonAny` to TS
// `Record<string, any>`. Used ONLY for frontmatter/properties-style
// bags; never for values with known keys.

pub type JsonAny {
}

// ------------------------------------------------------ workspace

// ROUTE: GET /api/workspace
pub type WorkspaceInfo {
    root str?
    wiki_dir str?
}

// ROUTE: POST /api/workspace/open  (body: WorkspaceOpenRequest)
pub type WorkspaceOpenRequest {
    root str
}

// #[api] fn 层（plan-022 Phase 4 slice 2）：VM 渲染模式下前台的 api 调用
// 经 Plan 340 改写（split=HTTP / merged=进程内）；stub 体仅占位（auto-musk
// 同款），TS 发射被 gen.mjs 剥离——TS 客户端面仍由手写 fetch 层独占
// （Phase 1 设计）。与上方 ROUTE 注释的对应关系由
// tests/api-contract-routes.mjs 双登记门检对拍。
#[api(method = "GET", path = "/api/workspace")]
pub fn get_workspace() WorkspaceInfo {
    return None
}

#[api(method = "POST", path = "/api/workspace/open")]
pub fn open_workspace(req WorkspaceOpenRequest) WorkspaceInfo {
    return None
}

// ------------------------------------------------------ files

pub type FileNode {
    name str
    path str
    is_dir bool
    // always present on the wire (empty for files) — backend Vec<FileNode>
    children List<FileNode>
}

// ROUTE: GET /api/files  (query: path, recursive)
// ROUTE: POST /api/files/create  (body: FileCreateRequest → FileNode)
pub type FileCreateRequest {
    path str
    is_dir bool
}

// ROUTE: POST /api/files/rename  (body: FileRenameRequest → empty)
pub type FileRenameRequest {
    old_path str
    new_path str
}

// ROUTE: POST /api/files/delete  (body: FileDeleteRequest → empty)
pub type FileDeleteRequest {
    path str
}

#[api(method = "GET", path = "/api/files")]
pub fn list_files(path str, recursive bool) List<FileNode> {
    return None
}

#[api(method = "POST", path = "/api/files/create")]
pub fn create_file(req FileCreateRequest) FileNode {
    return None
}

#[api(method = "POST", path = "/api/files/rename")]
pub fn rename_file(req FileRenameRequest) {
    return None
}

#[api(method = "POST", path = "/api/files/delete")]
pub fn delete_file(req FileDeleteRequest) {
    return None
}

// ------------------------------------------------------ assets

// ROUTE: POST /api/assets/upload  (multipart: file → UploadAssetResponse)
// 无 #[api] fn——multipart 不过 VM 信封（Phase 3 D4 登记偏差），门检豁免。
pub type UploadAssetResponse {
    path str
}

// ------------------------------------------------------ wiki docs

// ROUTE: GET /api/wiki/{*path}
// ROUTE: POST /api/wiki/{*path}  (body: WikiDoc → WikiDoc)
pub type WikiDoc {
    // arbitrary frontmatter bag (serde_json::Value on the backend)
    frontmatter JsonAny
    body str
}

#[api(method = "GET", path = "/api/wiki/{*path}")]
pub fn read_wiki(path str) WikiDoc {
    return None
}

#[api(method = "POST", path = "/api/wiki/{*path}")]
pub fn write_wiki(path str, doc WikiDoc) WikiDoc {
    return None
}

// ------------------------------------------------------ links

pub type Backlink {
    source_title str
    source_path str
    context str
}

pub type Outlink {
    target_title str
    target_path str?
    exists bool
    block_id str?
}

// ROUTE: GET /api/backlinks/{title}  → { title, links: Backlink[] }
// ROUTE: GET /api/outlinks/{title}  → { title, links: Outlink[] }
// The links envelope is generic on the client (LinksResponse<T> in
// api.ts) — both routes share the { title str, links List<T> } shape.
// slice 2: 具体化信封类型（wire 真实形状）供 #[api] fn 层引用。
pub type BacklinkList {
    title str
    links List<Backlink>
}

pub type OutlinkList {
    title str
    links List<Outlink>
}

#[api(method = "GET", path = "/api/backlinks/{title}")]
pub fn get_backlinks(title str) BacklinkList {
    return None
}

#[api(method = "GET", path = "/api/outlinks/{title}")]
pub fn get_outlinks(title str) OutlinkList {
    return None
}

// ------------------------------------------------------ graph

pub type GraphNode {
    id str
    label str
    path str
    exists bool
    degree int
}

pub type GraphEdge {
    source str
    target str
    block_id str?
}

// ROUTE: GET /api/graph
pub type GraphData {
    nodes List<GraphNode>
    edges List<GraphEdge>
}

#[api(method = "GET", path = "/api/graph")]
pub fn get_graph() GraphData {
    return None
}

// ------------------------------------------------------ search
// One result type flattened over the backend's tagged enum
// (serde(tag = "type")): `type` is "Page" (path/title/snippet set) or
// "Block" (uuid/page_path/block_id/content/snippet set); other fields
// are absent on the wire for a given variant.

pub type SearchResult {
    type str
    path str?
    title str?
    uuid str?
    page_path str?
    block_id str?
    content str?
    // \u0001-wrapped match highlights for <mark> rendering, null = none
    snippet str?
}

// ROUTE: GET /api/search  (query: q, limit)
// ROUTE: GET /api/search/pages  (query: q, limit)
// ROUTE: GET /api/search/blocks  (query: q, limit)
pub type SearchResponse {
    query str
    results List<SearchResult>
}

#[api(method = "GET", path = "/api/search")]
pub fn search(q str, limit int) SearchResponse {
    return None
}

#[api(method = "GET", path = "/api/search/pages")]
pub fn search_pages(q str, limit int) SearchResponse {
    return None
}

#[api(method = "GET", path = "/api/search/blocks")]
pub fn search_blocks(q str, limit int) SearchResponse {
    return None
}

