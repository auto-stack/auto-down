pub type TaskItem {
    page_path str
    title str
    line int
    raw str
    marker str
    priority str?
    content str
    // normalized "YYYY-MM-DD" or absent
    scheduled str?
    deadline str?
}

// ROUTE: GET /api/tasks
pub type TasksResponse {
    tasks List<TaskItem>
}

#[api(method = "GET", path = "/api/tasks")]
pub fn get_tasks() TasksResponse {
    return None
}

pub type AgendaGroup {
    date str
    tasks List<TaskItem>
}

// ROUTE: GET /api/agenda  (query: days)
pub type AgendaResponse {
    groups List<AgendaGroup>
}

#[api(method = "GET", path = "/api/agenda")]
pub fn get_agenda(days int) AgendaResponse {
    return None
}

// ROUTE: GET /api/query  (query: q)
pub type QueryResponse {
    results List<TaskItem>
}

#[api(method = "GET", path = "/api/query")]
pub fn query(q str) QueryResponse {
    return None
}

