// jade-garden C0-A：`GET /api/workspace` 的可执行 AV 业务源（PLAN-983 首例）。
//
// 与 `back/auto/api.at` 的契约桩 `get_workspace()` 对应：契约/Wire 类型仍由
// api.at（a2ts，ts-only）拥有；本文件是**ACE AV 可执行实现**，由 auto-web 的
// AV 服务引擎（`http_server::serve_av` + `av_service::AvServiceEngine`，文件
// 通道）加载：
//   - 宿主按 `#[api]` 声明抽取路由；每请求把真实 HTTP 请求 staged 到
//     `{scratch}/p983-req.txt`（本程序不需要读它——路由已在宿主侧匹配）；
//   - 本程序读生产配置 `JADE_GARDEN_DEFAULT_WORKSPACE`（`env_get_w16`，UTF-16LE
//     面），把响应写 `{scratch}/p983-resp.txt`；
//   - 语义对齐 `back/server/src/workspace.rs::get_workspace_impl`：
//       root   = 配置值（未配置 ⇒ null）；
//       wiki_dir = root.join("wiki")——root 不以分隔符结尾时按 Windows
//       `MAIN_SEPARATOR` 追加 `\` 再拼 `wiki`（与 Rust `PathBuf::join` 实测一致）；
//     JSON 字符串按 serde_json 语义转义（`"`、`\`、控制字符 < 0x20）；
//   - 只读：不写工作区、不建/改配置文件；每请求文件句柄关闭（平台台账
//     「每调用强制关句柄」）。
//
// 平台面：file/env/mem 内在函数（`auto.platform.*`）。宿主 grants：
// `platform.file`、`platform.mem`、`platform.env`。
//
// 具名边界：路径已按 UTF-16 → UTF-8 编码（含代理对）；孤立代理按 `?`
// 替换；空 env 值等同未配置（Win32 `SetEnvironmentVariableW(name,"")` 即删除）。

#[api(method = "GET", path = "/api/workspace")]
fn api_workspace() int {
    return 0
}

// ------------------------------------------------------ 小工具

fn digit_of(d int) Str {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

fn int_to_str(v int) Str {
    if v == 0 { return "0" }
    var n = v
    var out Str = ""
    for n > 0 {
        let d = n - (n / 10) * 10
        out = digit_of(d) + out
        n = n / 10
    }
    return out
}

// ASCII 文本逐码点写入内存（UTF-16 文件名/头部/JSON 骨架都是 ASCII）。
fn stage_ascii_w16(text Str, region int) int {
    let n = text.len()
    var i = 0
    for i < n {
        let cp = text.char_at(i).to_codepoint()
        let _a = mem_write_u8(region, i * 2, cp % 256)
        let _b = mem_write_u8(region, i * 2 + 1, cp / 256)
        i = i + 1
    }
    return n
}

fn write_ascii(region int, at int, text Str) int {
    let n = text.len()
    var i = 0
    var p = at
    for i < n {
        let cp = text.char_at(i).to_codepoint()
        let _w = mem_write_u8(region, p, cp)
        i = i + 1
        p = p + 1
    }
    return p
}

fn hex_digit(v int) int {
    if v < 10 { return 48 + v }
    return 87 + v
}

// JSON 字符串字节转义（serde_json 语义：`"`、`\`、< 0x20 的控制字符）。
fn write_json_byte(region int, at int, b int) int {
    if b == 34 {
        let _a = mem_write_u8(region, at, 92)
        let _b = mem_write_u8(region, at + 1, 34)
        return at + 2
    }
    if b == 92 {
        let _a = mem_write_u8(region, at, 92)
        let _b = mem_write_u8(region, at + 1, 92)
        return at + 2
    }
    if b < 32 {
        let _a = mem_write_u8(region, at, 92)
        let _b = mem_write_u8(region, at + 1, 117)
        let _c = mem_write_u8(region, at + 2, 48)
        let _d = mem_write_u8(region, at + 3, 48)
        let _e = mem_write_u8(region, at + 4, hex_digit(b / 16))
        let _f = mem_write_u8(region, at + 5, hex_digit(b % 16))
        return at + 6
    }
    let _g = mem_write_u8(region, at, b)
    return at + 1
}

fn unit_at(region int, i int) int {
    let lo = mem_read_u8(region, i * 2)
    let hi = mem_read_u8(region, i * 2 + 1)
    return lo + hi * 256
}

// UTF-16LE units → JSON 转义后的 UTF-8 字节（写入 body region，返回新偏移）。
fn write_utf16_json(in_region int, units int, out_region int, at int) int {
    var p = at
    var i = 0
    for i < units {
        let u = unit_at(in_region, i)
        if u < 128 {
            p = write_json_byte(out_region, p, u)
        } else {
            if u < 2048 {
                p = write_json_byte(out_region, p, 192 + u / 64)
                p = write_json_byte(out_region, p, 128 + u % 64)
            } else {
                if u >= 55296 {
                    if u < 56320 {
                        if i + 1 < units {
                            let lo = unit_at(in_region, i + 1)
                            if lo >= 56320 {
                                if lo < 57344 {
                                    let cp = 65536 + (u - 55296) * 1024 + (lo - 56320)
                                    p = write_json_byte(out_region, p, 240 + cp / 262144)
                                    p = write_json_byte(out_region, p, 128 + (cp / 4096) % 64)
                                    p = write_json_byte(out_region, p, 128 + (cp / 64) % 64)
                                    p = write_json_byte(out_region, p, 128 + cp % 64)
                                    i = i + 1
                                } else {
                                    p = write_json_byte(out_region, p, 63)
                                }
                            } else {
                                p = write_json_byte(out_region, p, 63)
                            }
                        } else {
                            p = write_json_byte(out_region, p, 63)
                        }
                    } else {
                        p = write_json_byte(out_region, p, 63)
                    }
                } else {
                    p = write_json_byte(out_region, p, 224 + u / 4096)
                    p = write_json_byte(out_region, p, 128 + (u / 64) % 64)
                    p = write_json_byte(out_region, p, 128 + u % 64)
                }
            }
        }
        i = i + 1
    }
    return p
}

// Rust `PathBuf::join("wiki")` 的分隔符事实：root 已以 `/` 或 `\` 结尾则直接
// 追加；否则 Windows `MAIN_SEPARATOR`（`\`）先补一个。
fn last_unit_is_sep(in_region int, units int) int {
    if units <= 0 { return 0 }
    let u = unit_at(in_region, units - 1)
    if u == 47 { return 1 }
    if u == 92 { return 1 }
    return 0
}

fn write_header(region int, body_len int) int {
    let head Str = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: "
    let tail Str = "\r\nConnection: close\r\n\r\n"
    let text Str = head + int_to_str(body_len) + tail
    return write_ascii(region, 0, text)
}

fn write_response(header_region int, hn int, body_region int, bn int) int {
    let pr = mem_alloc(256)
    let units = stage_ascii_w16("{scratch}/p983-resp.txt", pr)
    let h = file_open_w16(pr, 0, units, 14)
    let _f = mem_free(pr)
    if h <= 0 { return h }
    let _w1 = file_write_some(h, header_region, 0, hn)
    let _w2 = file_write_some(h, body_region, 0, bn)
    let _c = file_close(h)
    return 0
}

fn main() int {
    let out = mem_alloc(2048)
    let body = mem_alloc(4096)
    let header = mem_alloc(256)
    let name = mem_alloc(64)
    let name_units = stage_ascii_w16("JADE_GARDEN_DEFAULT_WORKSPACE", name)
    let units = env_get_w16(name, 0, name_units, out, 1024)
    let _f1 = mem_free(name)
    var n = 0
    if units <= 0 {
        n = write_ascii(body, 0, "{\"root\":null,\"wiki_dir\":null}")
    } else {
        n = write_ascii(body, 0, "{\"root\":\"")
        n = write_utf16_json(out, units, body, n)
        n = write_ascii(body, n, "\",\"wiki_dir\":\"")
        n = write_utf16_json(out, units, body, n)
        if last_unit_is_sep(out, units) == 0 {
            n = write_json_byte(body, n, 92)
        }
        n = write_ascii(body, n, "wiki\"}")
    }
    let hn = write_header(header, n)
    let rc = write_response(header, hn, body, n)
    let _f2 = mem_free(out)
    let _f3 = mem_free(body)
    let _f4 = mem_free(header)
    return rc
}
