// jade-garden back parser — block segmentation for `.ad` pages.
//
// Plan 021 Phase 2 slice 1: single-source port of the retired hand-written
// back/server/src/parser.rs, written in the a2r-clean subset (same discipline
// as engine auto/parser/*: no RegExp, no `any`, no lambdas, string ops within
// .slice/.length/.split/.join/==/+ plus char_at code tests).
//
// Dual emission (see ../gen.mjs):
//   a2ts -> back/auto/gen-ts/parser_gen.ts   (parity golden, node twin test)
//   a2r  -> back/server/src/parser_gen.rs    (wired via the parser.rs shell)
//
// Behavior contract: byte-compatible with parser.rs @ 6c907e8 —
// - kind strings: heading/paragraph/bullet/ordered/task/code/blockquote/
//   callout/details/hr (shell maps them onto the BlockKind enum)
// - blockId == "" means "no ^anchor" (shell maps to Option::None)
// - ordered-list detection intentionally mirrors parser.rs's naive form:
//   `parse_list_item` only fires for "1. "/"0. " prefixes (any N. prefix
//   falls through to paragraph), while `is_block_start` accepts any
//   digit-prefixed "N. " line. Reproduced verbatim — do not "fix" here.
// - uuid generation is NOT part of the pure layer; the shell stamps it.

pub type PBlock {
    kind str
    content str
    blockId str
    lineStart int
    lineEnd int
}

// ------------------------------------------------------------ str vocabulary

pub fn startsWithStr(s str, prefix str) bool {
    if s.length.to(int) < prefix.length.to(int) { return false }
    return s.slice(0, prefix.length.to(int)) == prefix
}

pub fn endsWithStr(s str, suffix str) bool {
    if s.length.to(int) < suffix.length.to(int) { return false }
    return s.slice(s.length.to(int) - suffix.length.to(int), s.length.to(int)) == suffix
}

fn isWhitespaceCode(c int) bool {
    if c == 32 { return true }
    if c == 9 { return true }
    if c == 10 { return true }
    if c == 13 { return true }
    if c == 11 { return true }
    if c == 12 { return true }
    return false
}

pub fn trimStartStr(s str) str {
    var p int = 0
    while p < s.length.to(int) {
        if !isWhitespaceCode(s.char_at(p)) { break }
        p += 1
    }
    if p == 0 { return s }
    return s.slice(p)
}

pub fn trimEndStr(s str) str {
    var end int = s.length.to(int)
    while end > 0 {
        if !isWhitespaceCode(s.char_at(end - 1)) { break }
        end -= 1
    }
    if end == s.length.to(int) { return s }
    return s.slice(0, end)
}

pub fn trimStr(s str) str {
    return trimStartStr(trimEndStr(s))
}

pub fn findStr(s str, needle str) int {
    let nLen int = needle.length.to(int)
    let sLen int = s.length.to(int)
    if nLen == 0 { return 0 }
    if sLen < nLen { return -1 }
    var i int = 0
    while i + nLen <= sLen {
        if s.slice(i, i + nLen) == needle { return i }
        i += 1
    }
    return -1
}

fn joinLines(lines List<str>, start int, end int) str {
    var out str = ""
    var i int = start
    while i < end {
        if i > start { out = out + "\n" }
        out = out + lines[i]
        i += 1
    }
    return out
}

// ------------------------------------------------------------ anchor split

pub type AnchorSplit {
    content str
    id str
}

fn isAnchorIdChar(c int) bool {
    if c >= 48 && c <= 57 { return true }
    if c >= 65 && c <= 90 { return true }
    if c >= 97 && c <= 122 { return true }
    if c == 45 { return true }
    if c == 95 { return true }
    return false
}

fn isAnchorId(id str) bool {
    let n = id.length.to(int)
    if n == 0 { return false }
    var i int = 0
    while i < n {
        if !isAnchorIdChar(id.char_at(i)) { return false }
        i += 1
    }
    return true
}

/// Mirror of parser.rs extract_anchor: trailing "\s+^token" (whitespace-run
/// before ^ required) becomes the block id; the remainder is the content.
pub fn extractAnchor(content str) AnchorSplit {
    let t = trimEndStr(content)
    let n = t.length.to(int)
    var s int = n
    while s > 0 {
        let c = t.char_at(s - 1)
        if c == 32 || c == 9 { break }
        s -= 1
    }
    if s <= 0 { return AnchorSplit(t, "") }
    if t.char_at(s) != 94 { return AnchorSplit(t, "") }
    let id = t.slice(s + 1, n)
    if !isAnchorId(id) { return AnchorSplit(t, "") }
    let stripped = trimEndStr(t.slice(0, s - 1))
    return AnchorSplit(stripped, id)
}

// ------------------------------------------------------------ line scanners

fn isHrLine(line str) bool {
    let t = trimStr(line)
    if t == "---" { return true }
    if t == "***" { return true }
    if t == "___" { return true }
    return false
}

fn headingLevelOf(trimmed str) int {
    var level int = 0
    while level < trimmed.length.to(int) {
        if trimmed.char_at(level) == 35 {
            level += 1
        } else {
            break
        }
    }
    if level == 0 { return 0 }
    if level > 6 { return 0 }
    if level == trimmed.length.to(int) { return 0 }
    if trimmed.char_at(level) != 32 { return 0 }
    return level
}

fn orderedPrefixLen(trimmed str) int {
    // Deliberate deviation from parser.rs (registered in the plan): any
    // digit-run + ". " counts as ordered. parser.rs only accepted
    // "1. "/"0. " here while is_block_start accepted any N. — the gap sent
    // "12. x" lines into an empty-paragraph infinite loop. This matches the
    // front twin / ORDERED_RE instead.
    var d int = 0
    while d < trimmed.length.to(int) {
        let c = trimmed.char_at(d)
        if c >= 48 && c <= 57 {
            d += 1
        } else {
            break
        }
    }
    if d == 0 { return -1 }
    if startsWithStr(trimmed.slice(d), ". ") { return d + 2 }
    return -1
}

pub fn parseHeadingLine(line str, idx int) PBlock {
    let trimmed = trimStartStr(line)
    let level = headingLevelOf(trimmed)
    let content = trimStr(trimmed.slice(level + 1))
    let split = extractAnchor(content)
    return PBlock("heading", split.content, split.id, idx, idx + 1)
}

pub fn parseListItemLine(line str, idx int) PBlock {
    let trimmed = trimStartStr(line)
    var kind str = ""
    var prefixLen int = 0
    if startsWithStr(trimmed, "- [ ] ") || startsWithStr(trimmed, "- [x] ") || startsWithStr(trimmed, "- [X] ") {
        kind = "task"
        prefixLen = 6
    } else {
        if startsWithStr(trimmed, "- ") {
            kind = "bullet"
            prefixLen = 2
        } else {
            let oLen = orderedPrefixLen(trimmed)
            if oLen > 0 {
                kind = "ordered"
                prefixLen = findStr(trimmed, ". ") + 2
            }
        }
    }
    let content = trimStr(trimmed.slice(prefixLen))
    let split = extractAnchor(content)
    return PBlock(kind, split.content, split.id, idx, idx + 1)
}

pub fn isBlockStartLine(line str) bool {
    let t = trimStartStr(line)
    if startsWithStr(t, "#") { return true }
    if startsWithStr(t, "- ") { return true }
    if startsWithStr(t, "- [") { return true }
    if startsWithStr(t, ">") { return true }
    if startsWithStr(t, "```") { return true }
    if startsWithStr(t, ":::") { return true }
    if startsWithStr(t, "---") { return true }
    if startsWithStr(t, "***") { return true }
    if startsWithStr(t, "___") { return true }
    return orderedPrefixLen(t) > 0
}

// ------------------------------------------------------------ body parse

pub fn parseBody(body str) List<PBlock> {
    let lines = body.split("\n")
    var blocks List<PBlock> = []
    var i int = 0
    // Rust str::lines() semantics: a trailing newline does not produce a
    // final empty line — drop it so line ranges match the shell exactly.
    var count int = lines.length.to(int)
    if count > 0 {
        if lines[count - 1] == "" {
            count -= 1
        }
    }
    while i < count {
        let line = lines[i]
        if startsWithStr(line, "```") {
            let end = scanFenceEnd(lines, count, i, "```")
            blocks.push(PBlock("code", joinLines(lines, i, end), "", i, end))
            i = end
        } else {
            if startsWithStr(line, ":::") {
                var kind str = "callout"
                if startsWithStr(line, ":::details") || startsWithStr(line, "::: details") {
                    kind = "details"
                }
                let end2 = scanFenceEnd(lines, count, i, ":::")
                blocks.push(PBlock(kind, joinLines(lines, i, end2), "", i, end2))
                i = end2
            } else {
                if isHrLine(line) {
                    blocks.push(PBlock("hr", line, "", i, i + 1))
                    i += 1
                } else {
                    if headingLevelOf(trimStartStr(line)) > 0 {
                        blocks.push(parseHeadingLine(line, i))
                        i += 1
                    } else {
                        if isListItemLine(line) {
                            blocks.push(parseListItemLine(line, i))
                            i += 1
                        } else {
                            if startsWithStr(line, ">") {
                                let end3 = scanQuoteEnd(lines, count, i)
                                blocks.push(PBlock("blockquote", quoteContent(lines, i, end3), "", i, end3))
                                i = end3
                            } else {
                                if trimStr(line) == "" {
                                    i += 1
                                } else {
                                    let end4 = scanParagraphEnd(lines, count, i)
                                    let split = extractAnchor(joinLines(lines, i, end4))
                                    blocks.push(PBlock("paragraph", split.content, split.id, i, end4))
                                    i = end4
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return blocks
}

fn isListItemLine(line str) bool {
    let t = trimStartStr(line)
    if startsWithStr(t, "- [ ] ") { return true }
    if startsWithStr(t, "- [x] ") { return true }
    if startsWithStr(t, "- [X] ") { return true }
    if startsWithStr(t, "- ") { return true }
    if orderedPrefixLen(t) > 0 { return true }
    return false
}

fn scanFenceEnd(lines List<str>, count int, start int, fence str) int {
    var end int = start + 1
    while end < count {
        if startsWithStr(trimStartStr(lines[end]), fence) {
            end += 1
            return end
        }
        end += 1
    }
    return end
}

fn scanQuoteEnd(lines List<str>, count int, start int) int {
    var end int = start
    while end < count {
        if startsWithStr(lines[end], ">") {
            end += 1
        } else {
            break
        }
    }
    return end
}

fn quoteContent(lines List<str>, start int, end int) str {
    var out str = ""
    var i int = start
    while i < end {
        if i > start { out = out + "\n" }
        if startsWithStr(lines[i], "> ") {
            out = out + lines[i].slice(2)
        } else {
            out = out + lines[i].slice(1)
        }
        i += 1
    }
    return out
}

fn scanParagraphEnd(lines List<str>, count int, start int) int {
    var end int = start
    while end < count {
        if trimStr(lines[end]) == "" { break }
        if isBlockStartLine(lines[end]) { break }
        end += 1
    }
    return end
}

// ------------------------------------------------------------ frontmatter

pub type FrontSplit {
    yaml str
    body str
    hasMarker bool
}

pub fn splitFrontmatterScan(text str) FrontSplit {
    let trimmed = trimStartStr(text)
    if !startsWithStr(trimmed, "---") {
        return FrontSplit("", text, false)
    }
    let rest = trimmed.slice(3)
    let end = findStr(rest, "\n---")
    if end < 0 {
        return FrontSplit("", text, false)
    }
    return FrontSplit(rest.slice(0, end), trimStartStr(rest.slice(end + 4)), true)
}

// ------------------------------------------------------------ properties

pub type PropPair {
    key str
    value str
}

/// Mirror of ID_PROPERTY_RE: `id:: <uuid v4 shape>` after leading whitespace.
pub fn findIdPropertyLine(line str) str {
    let t = trimStartStr(line)
    if !startsWithStr(t, "id::") { return "" }
    let v = trimEndStr(trimStartStr(t.slice(4)))
    if !isUuid36(v) { return "" }
    return v
}

fn isHexChar(c int) bool {
    if c >= 48 && c <= 57 { return true }
    if c >= 65 && c <= 70 { return true }
    if c >= 97 && c <= 102 { return true }
    return false
}

fn isUuid36(s str) bool {
    if s.length.to(int) != 36 { return false }
    var i int = 0
    while i < 36 {
        let c = s.char_at(i)
        if i == 8 || i == 13 || i == 18 || i == 23 {
            if c != 45 { return false }
        } else {
            if !isHexChar(c) { return false }
        }
        i += 1
    }
    return true
}

fn isKeyStartChar(c int) bool {
    if c >= 65 && c <= 90 { return true }
    if c >= 97 && c <= 122 { return true }
    if c == 95 { return true }
    return false
}

fn isKeyChar(c int) bool {
    if isKeyStartChar(c) { return true }
    if c >= 48 && c <= 57 { return true }
    if c == 45 { return true }
    return false
}

/// Mirror of PROPERTY_RE: `key:: value` after leading whitespace.
pub fn parsePropertyLine(line str) PropPair {
    let t = trimStartStr(line)
    let n = t.length.to(int)
    if n < 3 { return PropPair("", "") }
    if !isKeyStartChar(t.char_at(0)) { return PropPair("", "") }
    var e int = 1
    while e < n {
        let c = t.char_at(e)
        if isKeyChar(c) {
            e += 1
        } else {
            break
        }
    }
    if !startsWithStr(t.slice(e), "::") { return PropPair("", "") }
    let key = t.slice(0, e)
    let value = trimStartStr(t.slice(e + 2))
    return PropPair(key, value)
}

pub fn parseBlockPropertiesLines(lines List<str>) List<PropPair> {
    var out List<PropPair> = []
    var i int = 0
    while i < lines.length.to(int) {
        let pair = parsePropertyLine(lines[i])
        if pair.key != "" {
            out.push(pair)
        }
        i += 1
    }
    return out
}
