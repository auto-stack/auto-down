// jade-garden back search — workspace text search over indexed rows.
//
// Plan 022 Phase 2 slice 5: single-source port of Index::search
// (back/server/src/index.rs, SQLite FTS5), a2r-clean subset (char-scan,
// no RegExp). The shell keeps storage (row loading), HTTP and the str
// constants of the highlight contract; this module owns matching,
// snippet building, ranking and truncation.
//
// Semantics contract (FTS5 → char-scan deltas documented on purpose):
// - needle = trim(query), ASCII-case-folded; empty needle or limit <= 0
//   → no results (shell clamps the HTTP limit to 1..100 before us).
// - matching is case-insensitive SUBSTRING (non-overlapping, leftmost
//   scan). FTS5 unicode61 tokenization is dropped: better for CJK
//   (unicode61 never matched inside a CJK run), slightly more permissive
//   for Latin ("foo" finds "foobar"). The query is LITERAL — FTS5 query
//   syntax and the quote-escaping shim are gone.
// - fold is ASCII-only (accepted in query.at already: corpus is zh/en
//   BMP text, char_at/length parity holds there).
// - page hit = title OR frontmatter matches; snippet comes from the
//   title when it matches, else the frontmatter (FTS5 always took the
//   frontmatter column, even for title-only matches — delta is a UX fix).
// - snippet = window around the FIRST match: 60 chars left snapped
//   forward to a word start, 120 chars right snapped back to a word end,
//   ellipsis prefix/suffix on each clip; every fully-in-window occurrence
//   is wrapped in openMark…closeMark (frontend maps them to <mark>).
//   FTS5's 32-token window is approximated by the char window.
// - order: pages before blocks, occurrence count desc, then path asc,
//   uuid asc, blockId asc (deterministic; FTS5 bm25 rank replaced by
//   count — no test pinned bm25). Truncation: up to `limit` pages plus
//   up to `limit` blocks, then cut to `limit` (pages eat the budget
//   first, like the old two-LIMIT-then-truncate flow).
//
// Shell-injected constants: openMark/closeMark/ellipsis arrive as
// parameters — string-literal escapes (\u0001) are NOT interpreted by
// either emitter (probe-verified), so the highlight contract lives in
// the shell ("\u{0001}" on the Rust side) instead of this file.

pub type SrPage {
    path str
    title str
    frontmatter str
}

pub type SrBlock {
    uuid str
    pagePath str
    blockId str
    content str
}

// one search result; "" marks unused fields (a2r-clean rows carry no
// Option — the shell maps blockId/snippet "" back to None)
pub type SrHit {
    isPage bool
    path str
    title str
    uuid str
    blockId str
    content str
    snippet str
}

// ------------------------------------------------------ str vocabulary
// (query.at precedents: isWs/asciiLower/trim/findStr — copied, not
// imported, to keep each .at module self-contained for the emitters)

fn isWs(c int) bool {
    if c == 32 { return true }
    if c == 9 { return true }
    if c == 10 { return true }
    if c == 13 { return true }
    if c == 11 { return true }
    if c == 12 { return true }
    return false
}

fn asciiLower(s str) str {
    var out str = ""
    let lower = "abcdefghijklmnopqrstuvwxyz"
    var i int = 0
    while i < s.length.to(int) {
        let c = s.char_at(i)
        if c >= 65 && c <= 90 {
            out = out + lower.slice(c - 65, c - 64)
        } else {
            out = out + s.slice(i, i + 1)
        }
        i += 1
    }
    return out
}

fn trimWs(s str) str {
    var p int = 0
    while p < s.length.to(int) {
        if !isWs(s.char_at(p)) { break }
        p += 1
    }
    var end int = s.length.to(int)
    while end > p {
        if !isWs(s.char_at(end - 1)) { break }
        end -= 1
    }
    return s.slice(p, end)
}

// first index of needle in hay at or after `from`, else -1; empty needle
// never matches (guards the count/snippet loops below)
fn findFrom(hay str, needle str, from int) int {
    let nLen int = needle.length.to(int)
    let sLen int = hay.length.to(int)
    if nLen == 0 { return -1 }
    var i int = from
    while i + nLen <= sLen {
        if hay.slice(i, i + nLen) == needle { return i }
        i += 1
    }
    return -1
}

fn countOccurrences(hay str, needle str) int {
    var count int = 0
    var pos int = findFrom(hay, needle, 0)
    while pos >= 0 {
        count += 1
        pos = findFrom(hay, needle, pos + needle.length.to(int))
    }
    return count
}

// ------------------------------------------------------ snippet

// window around the FIRST occurrence, word-snapped both sides
fn buildSnippet(text str, needle str, openMark str, closeMark str, ellipsis str) str {
    let n int = text.length.to(int)
    let nLen int = needle.length.to(int)
    let lowerText = asciiLower(text)
    let first int = findFrom(lowerText, needle, 0)
    if first < 0 { return "" }

    // left: 60 chars back, then forward past the partial word + gap
    var start int = first - 60
    if start < 0 { start = 0 }
    if start > 0 {
        while start < first {
            if isWs(text.char_at(start)) { break }
            start += 1
        }
        while start < first {
            if !isWs(text.char_at(start)) { break }
            start += 1
        }
    }

    // right: 120 chars past the match, then back to the word end
    let matchEnd int = first + nLen
    var end int = matchEnd + 120
    if end > n { end = n }
    if end < n {
        while end > matchEnd {
            if isWs(text.char_at(end)) { break }
            end -= 1
        }
        while end > matchEnd {
            if !isWs(text.char_at(end - 1)) { break }
            end -= 1
        }
    }

    // assemble: ellipsis, matches wrapped, tail, ellipsis
    var out str = ""
    if start > 0 { out = out + ellipsis }
    var i int = start
    while i < end {
        let m int = findFrom(lowerText, needle, i)
        if m < 0 { break }
        let mEnd = m + nLen
        if mEnd > end { break }
        out = out + text.slice(i, m) + openMark + text.slice(m, mEnd) + closeMark
        i = mEnd
    }
    out = out + text.slice(i, end)
    if end < n { out = out + ellipsis }
    return out
}

// ------------------------------------------------------ search

pub fn searchAll(pages List<SrPage>, blocks List<SrBlock>, rawQuery str, limit int, openMark str, closeMark str, ellipsis str) List<SrHit> {
    var emptyOut List<SrHit> = []
    let needle = asciiLower(trimWs(rawQuery))
    if needle.length.to(int) == 0 { return emptyOut }
    if limit <= 0 { return emptyOut }

    var hits List<SrHit> = []
    var counts List<int> = []

    var pi int = 0
    while pi < pages.length.to(int) {
        let pg = pages[pi]
        let ct = countOccurrences(asciiLower(pg.title), needle)
        let cf = countOccurrences(asciiLower(pg.frontmatter), needle)
        if ct + cf > 0 {
            var snip str = ""
            if ct > 0 {
                snip = buildSnippet(pg.title, needle, openMark, closeMark, ellipsis)
            } else {
                snip = buildSnippet(pg.frontmatter, needle, openMark, closeMark, ellipsis)
            }
            hits.push(SrHit(true, pg.path, pg.title, "", "", "", snip))
            counts.push(ct + cf)
        }
        pi += 1
    }

    var bi int = 0
    while bi < blocks.length.to(int) {
        let bl = blocks[bi]
        let cc = countOccurrences(asciiLower(bl.content), needle)
        if cc > 0 {
            let snip = buildSnippet(bl.content, needle, openMark, closeMark, ellipsis)
            hits.push(SrHit(false, bl.pagePath, "", bl.uuid, bl.blockId, bl.content, snip))
            counts.push(cc)
        }
        bi += 1
    }

    // deterministic order (see header): pages first, count desc, path asc,
    // uuid asc, blockId asc. Selection into a new list — the used-index
    // list avoids in-place flag mutation (emitter-safe, agenda precedent).
    let total = hits.length.to(int)
    var out List<SrHit> = []
    var used List<int> = []
    while out.length.to(int) < total {
        var best int = -1
        var i int = 0
        while i < total {
            var taken bool = false
            var u int = 0
            while u < used.length.to(int) {
                if used[u] == i { taken = true }
                u += 1
            }
            if !taken {
                var take bool = false
                if best == -1 {
                    take = true
                } else {
                    let cand = hits[i]
                    let cur = hits[best]
                    if cand.isPage != cur.isPage {
                        if cand.isPage { take = true }
                    }
                    if cand.isPage == cur.isPage {
                        if counts[i] > counts[best] { take = true }
                        if counts[i] == counts[best] {
                            if cand.path < cur.path { take = true }
                            if cand.path == cur.path {
                                if cand.uuid < cur.uuid { take = true }
                                if cand.uuid == cur.uuid {
                                    if cand.blockId < cur.blockId { take = true }
                                }
                            }
                        }
                    }
                }
                if take { best = i }
            }
            i += 1
        }
        out.push(hits[best])
        used.push(best)
    }

    // pages eat the budget first, blocks fill the rest (old two-LIMIT flow)
    var cut int = limit
    if cut > total { cut = total }
    var picked List<SrHit> = []
    var k int = 0
    while k < cut {
        picked.push(out[k])
        k += 1
    }
    return picked
}
