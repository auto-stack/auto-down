// jade-garden back srs — spaced-repetition pure logic (cards / cloze QA /
// block properties / OF matrix / scheduling / review property surgery).
//
// Plan 022 Phase 2 slice 4: single-source port of the pure logic in
// back/server/src/srs.rs, a2r-clean subset (char-scan, no RegExp). The
// shell keeps: axum handlers, walkdir scans, file I/O, wall clock (chrono),
// and ALL string<->float parsing/formatting (a2r cannot lower to(float)/
// toFixed for the rust target) — floats cross this module's boundary as
// plain values, arithmetic only.
//
// Semantics contract (mirrors the retired Rust):
// - card tag: "#card" NOT followed by [A-Za-z0-9_] (EOF ok), or the literal
//   "[[card]]" (CARD_TAG_RE).
// - cloze: `{{cloze A \ B}}` (CLOZE_RE `\{\{cloze\s+(.*?)\s*\\\s*(.*?)\}\}`,
//   both captures trimmed): >=1 whitespace after "{{cloze", A = run up to
//   the FIRST backslash (trailing ws of A is absorbed by `\s*` — equivalent
//   to trim), then optional ws, B = run up to the FIRST "}}" (again
//   trimmed). No backslash / no "}}" anywhere ahead → no match at any later
//   start either. buildQa replaces EVERY occurrence of each full match:
//   question gets "{{hint}}", answer gets "**answer**"; then all card tags
//   are stripped and the results trimmed.
// - property line: ^ws key "::" ws value (PROPERTY_RE, key = [A-Za-z_][A-
//   Za-z0-9_-]*); value trimmed on both ends. Later duplicates WIN (the
//   Rust folded into a HashMap).
// - property region: [lineStart, min(lineEnd, len)) plus the continuation
//   from max(lineEnd, lineStart+1): consume lines while non-blank AND
//   indented deeper than the block line; stop at the first failure
//   (properties written below single-line blocks by review_card).
// - matrix (OF): factor(repetition.min 4, (grade saturating_sub 1).min 4)
//   with 2.5 for every missing slot incl. the empty matrix; update() pads
//   rows to 5-wide 2.5 defaults, target cell = clamp(current + (requested -
//   current)*0.1 + modifier, 1.3, 3.0), modifier = -0.30/-0.15/0.0/+0.10
//   for grade 1/2/3/4 (else 0).
// - schedule: grade clamped 1..4; grade 1 → repeats 0, interval 0; else
//   repeats+1 with interval 1.0 / 6.0 for the first two steps and
//   (interval * factor).max(ease) after; EF = max(ef + 0.1 - q*(0.08 +
//   q*0.02), 1.3) with q = 5 - grade; the matrix update runs with the NEW
//   (repeats, interval). Value semantics — a NEW matrix is returned.
// - review surgery: find the block line by "^id" suffix (trimEnd + ends
//   with); drop property lines for the updated keys within the property
//   region, then insert the new "{indent}{key}:: {value}" lines (indent =
//   block indent + 2 spaces) sorted as STRINGS right after the block line.

pub type PropPair {
    key str
    value str
}

pub type Qa {
    question str
    answer str
}

pub type SrsBlock {
    blockId str
    uuid str
    content str
    lineStart int
    lineEnd int
}

// All fields are strings — numeric card fields (ease/repeats/interval/
// lastScore) keep their RAW property text here; the shell parses them
// ("" or unparsable → the Rust defaults).
pub type SrsCardRaw {
    pagePath str
    blockId str
    uuid str
    raw str
    question str
    answer str
    deck str
    easeFactor str
    repeats str
    lastInterval str
    nextSchedule str
    lastScore str
    lastReviewed str
}

pub type SchedOut {
    easeFactor float
    repeats int
    lastInterval float
    matrix List<List<float>>
}

// ------------------------------------------------------ str vocabulary copy

fn startsWithStr(s str, prefix str) bool {
    if s.length.to(int) < prefix.length.to(int) { return false }
    return s.slice(0, prefix.length.to(int)) == prefix
}

fn trimStr(s str) str {
    return trimStartStr(trimEndStr(s))
}

fn isWs(c int) bool {
    if c == 32 { return true }
    if c == 9 { return true }
    if c == 10 { return true }
    if c == 13 { return true }
    if c == 11 { return true }
    if c == 12 { return true }
    return false
}

fn trimStartStr(s str) str {
    var p int = 0
    while p < s.length.to(int) {
        if !isWs(s.char_at(p)) { break }
        p += 1
    }
    if p == 0 { return s }
    return s.slice(p)
}

fn trimEndStr(s str) str {
    var end int = s.length.to(int)
    while end > 0 {
        if !isWs(s.char_at(end - 1)) { break }
        end -= 1
    }
    if end == s.length.to(int) { return s }
    return s.slice(0, end)
}

fn indentWidth(line str) int {
    var p int = 0
    while p < line.length.to(int) {
        if !isWs(line.char_at(p)) { break }
        p += 1
    }
    return p
}

fn isWordChar(c int) bool {
    if c >= 65 && c <= 90 { return true }
    if c >= 97 && c <= 122 { return true }
    if c >= 48 && c <= 57 { return true }
    if c == 95 { return true }
    return false
}

fn minInt(a int, b int) int {
    if a < b { return a }
    return b
}

// Float max/min via comparison — `.max()/.min()` methods exist on Rust f64
// but not on TS `number`, so the method form is not dual-portable.
fn fmax(a float, b float) float {
    if a > b { return a }
    return b
}

fn fmin(a float, b float) float {
    if a < b { return a }
    return b
}

fn repeatSpaces(n int) str {
    var out str = ""
    var i int = 0
    while i < n {
        out = out + " "
        i += 1
    }
    return out
}

// s.slice(from) == prefix without slicing (bounds-safe for from > len).
fn startsWithFrom(s str, from int, prefix str) bool {
    if s.length.to(int) - from < prefix.length.to(int) { return false }
    return s.slice(from, from + prefix.length.to(int)) == prefix
}

// ------------------------------------------------------ card tag

fn hasCardTag(content str) bool {
    let n = content.length.to(int)
    var i int = 0
    while i < n {
        if startsWithFrom(content, i, "#card") {
            if i + 5 >= n { return true }
            if !isWordChar(content.char_at(i + 5)) { return true }
        }
        if startsWithFrom(content, i, "[[card]]") { return true }
        i += 1
    }
    return false
}

fn stripCardTags(s str) str {
    let n = s.length.to(int)
    var out str = ""
    var i int = 0
    while i < n {
        if startsWithFrom(s, i, "#card") {
            if i + 5 >= n || !isWordChar(s.char_at(i + 5)) {
                i += 5
            } else {
                out = out + s.slice(i, i + 1)
                i += 1
            }
        } else {
            if startsWithFrom(s, i, "[[card]]") {
                i += 8
            } else {
                out = out + s.slice(i, i + 1)
                i += 1
            }
        }
    }
    return trimStr(out)
}

// ------------------------------------------------------ cloze

fn findClozeStart(s str, from int) int {
    let n = s.length.to(int)
    var i int = from
    while i < n {
        if startsWithFrom(s, i, "{{cloze") { return i }
        i += 1
    }
    return -1
}

fn findStrFrom(s str, needle str, from int) int {
    let n = s.length.to(int)
    var i int = from
    while i < n {
        if startsWithFrom(s, i, needle) { return i }
        i += 1
    }
    return -1
}

// One validated cloze occurrence at/after `from`: end is EXCLUSIVE (just
// past "}}"); end < 0 = none anywhere (see the header for why a failed
// start rules out all later starts).
fn nextCloze(s str, from int) List<int> {
    // out = [start, end, answerStart, answerEnd, hintStart, hintEnd] or []
    var n int = s.length.to(int)
    var at int = findClozeStart(s, from)
    while at >= 0 {
        var i int = at + 7
        if i >= n { return [] }
        if !isWs(s.char_at(i)) {
            at = findClozeStart(s, at + 1)
        } else {
            while i < n && isWs(s.char_at(i)) {
                i += 1
            }
            var bs int = i
            while bs < n {
                if s.char_at(bs) == 92 { break }
                bs += 1
            }
            if bs >= n { return [] }
            var j int = bs + 1
            while j < n && isWs(s.char_at(j)) {
                j += 1
            }
            var close int = findStrFrom(s, "}}", j)
            if close < 0 { return [] }
            var out List<int> = []
            out.push(at)
            out.push(close + 2)
            out.push(i)
            out.push(bs)
            out.push(j)
            out.push(close)
            return out
        }
    }
    return []
}

fn replaceAllStr(s str, find str, repl str) str {
    if find == "" { return s }
    let n = s.length.to(int)
    var out str = ""
    var i int = 0
    while i < n {
        if startsWithFrom(s, i, find) {
            out = out + repl
            i += find.length.to(int)
        } else {
            out = out + s.slice(i, i + 1)
            i += 1
        }
    }
    return out
}

pub fn hasCloze(content str) bool {
    let hit = nextCloze(content, 0)
    return hit.length.to(int) > 0
}

pub fn buildQa(content str) Qa {
    var question str = content
    var answer str = content
    var from int = 0
    var hit List<int> = nextCloze(content, from)
    while hit.length.to(int) > 0 {
        let start = hit[0]
        let end = hit[1]
        let answerText = trimStr(content.slice(hit[2], hit[3]))
        let hint = trimStr(content.slice(hit[4], hit[5]))
        let full = content.slice(start, end)
        question = replaceAllStr(question, full, "{{" + hint + "}}")
        answer = replaceAllStr(answer, full, "**" + answerText + "**")
        from = end
        hit = nextCloze(content, from)
    }
    return Qa(stripCardTags(question), stripCardTags(answer))
}

// ------------------------------------------------------ property lines

// PROPERTY_RE on one line; key "" = no match.
pub fn matchPropLine(line str) PropPair {
    let n = line.length.to(int)
    var i int = 0
    while i < n {
        if !isWs(line.char_at(i)) { break }
        i += 1
    }
    let c0 = line.char_at(i)
    var keyOk bool = false
    if c0 >= 65 && c0 <= 90 { keyOk = true }
    if c0 >= 97 && c0 <= 122 { keyOk = true }
    if c0 == 95 { keyOk = true }
    if !keyOk { return PropPair("", "") }
    var end int = i + 1
    while end < n {
        let c = line.char_at(end)
        var ok bool = false
        if c >= 65 && c <= 90 { ok = true }
        if c >= 97 && c <= 122 { ok = true }
        if c >= 48 && c <= 57 { ok = true }
        if c == 95 { ok = true }
        if c == 45 { ok = true }
        if !ok { break }
        end += 1
    }
    if !startsWithFrom(line, end, "::") { return PropPair("", "") }
    var v int = end + 2
    while v < n {
        if !isWs(line.char_at(v)) { break }
        v += 1
    }
    return PropPair(line.slice(i, end), trimStr(line.slice(v)))
}

// Block property region (see header). Duplicate keys keep the LAST value.
pub fn parseBlockProps(lines List<str>, lineStart int, lineEnd int) List<PropPair> {
    var out List<PropPair> = []
    let count = lines.length.to(int)
    var hardEnd int = lineEnd
    if hardEnd > count { hardEnd = count }
    var i int = lineStart
    while i < hardEnd {
        let p = matchPropLine(lines[i])
        if p.key != "" {
            var replaced bool = false
            var q int = 0
            while q < out.length.to(int) {
                if out[q].key == p.key {
                    out[q] = PropPair(p.key, p.value)
                    replaced = true
                }
                q += 1
            }
            if !replaced { out.push(p) }
        }
        i += 1
    }
    // continuation: deeper-indented lines below the block (review_card shape)
    if lineStart < count {
        let blockIndent = indentWidth(lines[lineStart])
        var j int = lineEnd
        if j < lineStart + 1 { j = lineStart + 1 }
        while j < count {
            let line = lines[j]
            if trimStr(line) == "" { break }
            if indentWidth(line) <= blockIndent { break }
            let p = matchPropLine(line)
            if p.key != "" {
                var replaced bool = false
                var q int = 0
                while q < out.length.to(int) {
                    if out[q].key == p.key {
                        out[q] = PropPair(p.key, p.value)
                        replaced = true
                    }
                    q += 1
                }
                if !replaced { out.push(p) }
            }
            j += 1
        }
    }
    return out
}

fn propAt(props List<PropPair>, key str) str {
    var val str = ""
    var q int = 0
    while q < props.length.to(int) {
        if props[q].key == key { val = props[q].value }
        q += 1
    }
    return val
}

// ------------------------------------------------------ card extraction

pub fn extractCards(pagePath str, lines List<str>, blocks List<SrsBlock>) List<SrsCardRaw> {
    var out List<SrsCardRaw> = []
    let count = blocks.length.to(int)
    var i int = 0
    while i < count {
        let b = blocks[i]
        if b.blockId == "" {
            i += 1
        } else {
            if hasCardTag(b.content) || hasCloze(b.content) {
                let qa = buildQa(b.content)
                let props = parseBlockProps(lines, b.lineStart, b.lineEnd)
                out.push(SrsCardRaw(
                    pagePath,
                    b.blockId,
                    b.uuid,
                    b.content,
                    qa.question,
                    qa.answer,
                    propAt(props, "deck"),
                    propAt(props, "card-ease-factor"),
                    propAt(props, "card-repeats"),
                    propAt(props, "card-last-interval"),
                    propAt(props, "card-next-schedule"),
                    propAt(props, "card-last-score"),
                    propAt(props, "card-last-reviewed"),
                ))
            }
            i += 1
        }
    }
    return out
}

// ------------------------------------------------------ OF matrix

pub fn matrixFactor(matrix List<List<float>>, repetition int, grade int) float {
    if matrix.length.to(int) == 0 { return 2.5 }
    let r = minInt(repetition, 4)
    if r < 0 { return 2.5 }
    if r >= matrix.length.to(int) { return 2.5 }
    let row = matrix[r]
    var g int = 0
    if grade > 1 { g = minInt(grade - 1, 4) }
    if g >= row.length.to(int) { return 2.5 }
    return row[g]
}

fn fiveRow() List<float> {
    var row List<float> = []
    row.push(2.5)
    row.push(2.5)
    row.push(2.5)
    row.push(2.5)
    row.push(2.5)
    return row
}

fn copyFloatRow(row List<float>) List<float> {
    var out List<float> = []
    var i int = 0
    while i < row.length.to(int) {
        out.push(row[i])
        i += 1
    }
    return out
}

pub fn matrixUpdate(matrix List<List<float>>, repetition int, grade int, requested float) List<List<float>> {
    let r = minInt(repetition, 4)
    var g int = 0
    if grade > 1 { g = minInt(grade - 1, 4) }
    var out List<List<float>> = []
    // Rust: an EMPTY matrix is first replaced by the full 5x5 default, so
    // the seeded width is 5 rows (not r+1); padding to r+1 only applies to
    // non-empty matrices.
    var total int = matrix.length.to(int)
    if total == 0 { total = 5 }
    if total <= r { total = r + 1 }
    var idx int = 0
    while idx < total {
        var row List<float> = []
        if matrix.length.to(int) == 0 {
            row = fiveRow()
        } else {
            if idx < matrix.length.to(int) {
                row = copyFloatRow(matrix[idx])
            } else {
                row = fiveRow()
            }
        }
        if idx == r {
            while row.length.to(int) <= g {
                row.push(2.5)
            }
            let current = row[g]
            var modifier float = 0.0
            if grade == 1 { modifier = -0.30 }
            if grade == 2 { modifier = -0.15 }
            if grade == 3 { modifier = 0.0 }
            if grade == 4 { modifier = 0.10 }
            // let-bound subexpression: parenthesized binary operands are
            // dropped by the emitter (DEBTS 013 residue)
            let diff = requested - current
            let delta = diff * 0.1
            let change = delta + modifier
            let bumped = current + change
            let lo = fmax(bumped, 1.3)
            row[g] = fmin(lo, 3.0)
        }
        out.push(row)
        idx += 1
    }
    return out
}

// ------------------------------------------------------ scheduling

pub fn scheduleWith(easeFactor float, repeats int, lastInterval float, grade int, matrix List<List<float>>) SchedOut {
    var g int = grade
    if g < 1 { g = 1 }
    if g > 4 { g = 4 }
    var reps int = repeats
    var interval float = lastInterval
    var ef float = easeFactor
    if g == 1 {
        reps = 0
        interval = 0.0
    } else {
        reps = reps + 1
        if reps == 1 {
            interval = 1.0
        } else {
            if reps == 2 {
                interval = 6.0
            } else {
                let factor = matrixFactor(matrix, minInt(reps, 4), g)
                let prod = interval * factor
                interval = fmax(prod, ef)
            }
        }
    }
    let q = 5.0 - g.to(float)
    let inner = 0.08 + q * 0.02
    let adjust = 0.1 - q * inner
    let bumped = ef + adjust
    ef = fmax(bumped, 1.3)
    let nextMatrix = matrixUpdate(matrix, minInt(reps, 4), g, interval)
    return SchedOut(ef, reps, interval, nextMatrix)
}

// ------------------------------------------------------ review surgery

// First line whose trimEnd ends with `anchor` (e.g. "^c1"); -1 = none.
pub fn findAnchorLine(lines List<str>, anchor str) int {
    let count = lines.length.to(int)
    var i int = 0
    while i < count {
        let line = lines[i]
        let trimmed = trimEndStr(line)
        if trimmed.length.to(int) >= anchor.length.to(int) {
            let tail = trimmed.length.to(int) - anchor.length.to(int)
            if trimmed.slice(tail) == anchor { return i }
        }
        i += 1
    }
    return -1
}

// Rewrite: drop property lines for the updated keys inside the block's
// property region, then insert the new lines (indent+2, string-sorted)
// right after the block line. Value semantics — returns a new list.
pub fn applyReviewProps(lines List<str>, blockLine int, newProps List<PropPair>) List<str> {
    let count = lines.length.to(int)
    let blockIndent = indentWidth(lines[blockLine])
    var endLine int = count
    var i int = blockLine + 1
    while i < count {
        let line = lines[i]
        if trimStr(line) == "" { endLine = i }
        if indentWidth(line) <= blockIndent { endLine = i }
        if endLine != count { break }
        i += 1
    }
    // sorted insert lines: selection over the FORMATTED strings (ascending,
    // index-order tiebreak — mirrors Vec::sort stability); index-based so
    // duplicate keys cannot stall the pick
    var picked List<str> = []
    var used List<int> = []
    let indent = repeatSpaces(blockIndent + 2)
    while used.length.to(int) < newProps.length.to(int) {
        var best str = ""
        var bestIdx int = -1
        var j int = 0
        while j < newProps.length.to(int) {
            var alreadyUsed bool = false
            var u int = 0
            while u < used.length.to(int) {
                if used[u] == j { alreadyUsed = true }
                u += 1
            }
            if !alreadyUsed {
                let cand = indent + newProps[j].key + ":: " + newProps[j].value
                if bestIdx < 0 || cand < best {
                    best = cand
                    bestIdx = j
                }
            }
            j += 1
        }
        used.push(bestIdx)
        picked.push(best)
    }
    // rebuild
    var out List<str> = []
    var k int = 0
    while k < count {
        if k == blockLine {
            out.push(lines[k])
            var p int = 0
            while p < picked.length.to(int) {
                out.push(picked[p])
                p += 1
            }
        } else {
            var drop bool = false
            if k > blockLine && k < endLine {
                let pr = matchPropLine(lines[k])
                if pr.key != "" {
                    var q int = 0
                    while q < newProps.length.to(int) {
                        if newProps[q].key == pr.key { drop = true }
                        q += 1
                    }
                }
            }
            if !drop { out.push(lines[k]) }
        }
        k += 1
    }
    return out
}
