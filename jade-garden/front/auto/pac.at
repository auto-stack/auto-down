name: "jade-garden-front-auto"
version: "0.1.0"
scene: "ui"
render: "vue"
# PLAN-013 T5:桌面 daemon 链（auto-os apps.manifest daemon 字段配对）——
# 端口 = auto-os 伞形 17xxx 带预留（17300/17301）;daemon 值 = manifest id,
# 桌面 launch 前置 ensure ping :17301（/api/health）→ 发现序 spawn
# back/server/target/release/jade-garden-back（JADE_GARDEN_PORT 端口覆盖）。
front_port: 17300
back_port: 17301
daemon: jade-garden
shadcn: off
default_classes: off
npm_deps: {
  "cytoscape": "^3.34.0"
  "cytoscape-fcose": "^2.2.0"
  "@autodown/engine": "link:D:/autostack/auto-down/autodown/packages/engine"
}
