name: "jade-garden-front-auto"
title: "Jade Garden"
title_zh: "玉圃"
version: "0.1.0"
scene: "ui"
render: "vue"
# PLAN-013 T5:桌面 daemon 链（auto-os apps.manifest daemon 字段配对）——
# 端口 = auto-os 伞形 17xxx 带预留（17300/17301）;daemon 值 = manifest id,
# 桌面 launch 前置 ensure ping :17301（/api/health）→ 发现序 spawn
# back/server/target/release/jade-garden-back（JADE_GARDEN_PORT 端口覆盖）。
front_port: 17300
back_port: 17301
daemon: "jade-garden"
shadcn: off
default_classes: off
npm_deps: {
  "cytoscape": "^3.34.0"
  "cytoscape-fcose": "^2.2.0"
  "@autodown/engine": "link:D:/autostack/auto-down/autodown/packages/engine"
}

// PLAN-070 T-06：jade web 命令系统声明入口（bp-edit 见 app-config.at）。
ui_config: "app-config.at"

// auto-os/PLAN-061 T-03：官方主题包正式接入——`vendor/themes` 为 UI 管理渠道
// 发布的**固定版本快照**（themes 0.2.0，内容 digest
// 9fa07742dc68aa5377ae06cb2d966386002063f184c515b6c5dddf8a6bef838e，
// per-file sha256 与源包逐文件校验同律；不可二次编辑、非第二权威源）。
// 部署形态 = 构建链投影：app 根 use 官方树 → 生成 index.css 四块
// （light/dark core+sidebar 官方值）→ 部署面 front/src 消费；自有 CSS 策略
// （.dark 类 + .theme-<accent> 品牌 overlay + 主题 popover 业务）保留。
// 主合同反链见 README。
dep themes {
    path: "vendor/themes"
}
