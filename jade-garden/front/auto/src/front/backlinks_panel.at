// backlinks_panel.at — BacklinksPanel widget (Auto language source).
//
// Auto-generated replacement for the hand-written
// front/src/components/BacklinksPanel.vue (plan 011 Phase 5.1). Regenerate:
//
//   cd jade-garden/front/auto
//   D:/autostack/.wt/down-074/auto-lang/target/debug/auto.exe build -d .
//   sed -e 's|@/ext/src/front/utils/backlinks_panel_ext|../../auto/src/front/utils/backlinks_panel_ext|g' \
//       -e 's|@/lib/api|../../auto/src/front/utils/backlinks_panel_ext|g' \
//     gen/front/vue/src/components/BacklinksPanel.vue > ../src/components/BacklinksPanel.vue
//
// PLAN-074 T-02 sink: the ext's data orchestration moved INTO the DSL —
// tab_file_stem is a module fn below, and the fetch orchestration is the
// watch block's own try/catch/finally around the `use back.api:` contract
// call (compiler ≥ c5b5fecf). The ext keeps only the facade re-export and
// the get_backlinks contract alias (web deploy: the sed rewrites the
// emitted '@/lib/api' import onto that shim; VM track: the same name
// resolves to the #[api] fn in the desktop contract copy). Mode doc:
// docs/plans/attachments/074-sink-mode.md.
//
// Idioms (see autodown editor src/auto/README):
// - ul/li are not in the DSL element table (they fall back to <div>), so
//   the list renders via dyn with string tags — <component :is="'ul'">
//   renders a real <ul>.
// - The original's v-if / v-else-if / v-else chain becomes three exclusive
//   named-boolean computeds (same rendered branch in every state).
// - The original's try { } catch { silent-empty } finally { loading=false }
//   maps 1:1 onto the DSL's try/catch/finally in the watch below.
// - The original's watch(currentTitle, fetch, { immediate: true }) maps to
//   the watch block's .immediate modifier on the current_title computed;
//   computed refs are auto-unwrapped in handler bodies too (compiler ≥
//   Plan 408 P4, 7bd6d4e3).
// - Module fn locals must not shadow widget model/computed names (the
//   state-ref rewrite would emit `local.value` — PLAN-074 probe P-5).

// Contract channel: web = ext-shim alias of the hand-written client (deploy
// sed), VM = #[api] get_backlinks (desktop/src/back/api.at, 340 rewrite).
use back.api: get_backlinks

// Sunk from ext tabFileStem (PLAN-074 T-02). Last path segment via find +
// recursion (vue track: indexOf/substring; no char-index arithmetic — VM
// find/slice are byte-based on non-ASCII, PLAN-074 probe P-6), extension
// strip after. Locals avoid model/computed names (probe P-5).
fn last_segment(path str) str {
    let sep = path.find("/")
    if sep == -1 {
        return path
    }
    return last_segment(path.slice(sep + 1, path.length.to(int)))
}

fn stem_of_path(path str) str {
    let name = last_segment(path)
    let dot = name.find(".")
    if dot > 0 {
        return name.slice(0, dot)
    }
    return name
}

fn tab_file_stem(tab) str {
    if tab == null {
        return ""
    }
    return stem_of_path(tab.path)
}

widget BacklinksPanel {
    use {
        composable: useTabsStore from "src/front/utils/backlinks_panel_ext.ts"
    }

    msg Msg { OpenSource }

    model {
        var links []str = []
        var loading bool = false
    }

    computed {
        // Original: computed(() => tabs.activeTab?.path ? fileStem : '').
        current_title => tab_file_stem(.tabsStore.activeTab)
        // The three mutually exclusive view states (the original's
        // v-if / v-else-if / v-else chain). Model vars are auto-unwrapped
        // in computeds.
        show_loading => .loading
        show_list => !.loading && .links.length > 0
        show_empty => !.loading && .links.length == 0
        // Native tags the DSL maps to div (ul/li are not in its element
        // table) are rendered via dyn with a string tag.
        ul_tag => "ul"
        li_tag => "li"
    }

    view {
        div {
            class: "rounded-lg border bg-background/50 p-2.5",
            h4 { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground", text "Backlinks" }
            if .show_loading {
                p { class: "text-xs text-muted-foreground", text "Loading…" }
            }
            if .show_list {
                dyn (.ul_tag) {
                    class: "space-y-0.5",
                    // NOTE: the loop variable cannot be named `link` —
                    // `link` is a DSL element keyword (router-link mapping)
                    // and mis-parses ("Expected term, got RBrace").
                    for bl in .links {
                        dyn (.li_tag) {
                            key: bl.source_path,
                            class: "cursor-pointer truncate rounded px-1.5 py-0.5 text-xs text-foreground/80 transition-colors hover:bg-accent hover:text-foreground",
                            title: bl.context,
                            onclick: .OpenSource(bl),
                            text bl.source_title
                        }
                    }
                }
            }
            if .show_empty {
                p { class: "text-xs text-muted-foreground", text "No backlinks." }
            }
        }
    }

    watch {
        // Original: watch(currentTitle, fetchBacklinks, { immediate: true }).
        // PLAN-074 T-02: the fetchBacklinksSafe ext wrapper sank here —
        // try/catch carries the original's catch branch (silently clear the
        // list), finally carries loading=false (the wrapper's "never
        // rejects" single-.then form is obsolete now that the DSL has
        // try/catch/finally).
        .current_title.immediate -> {
            // Original: if (!currentTitle.value) { backlinks.value = []; return }
            if .current_title == "" {
                .links = []
            }
            if .current_title != "" {
                .loading = true
                try {
                    let res = get_backlinks(.current_title)
                    .links = res.links
                } catch (e) {
                    .links = []
                } finally {
                    .loading = false
                }
            }
        }
    }

    on {
        // Original: function openSource(link) { tabs.open(...) }
        .OpenSource(bl) -> {
            .tabsStore.open(bl.source_path, bl.source_title)
        }
    }
}
