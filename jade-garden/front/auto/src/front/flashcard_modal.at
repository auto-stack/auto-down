// flashcard_modal.at — FlashcardModal widget (Auto language source).
//
// Auto-generated replacement for the hand-written
// front/src/components/FlashcardModal.vue (plan 011 Phase 5.2).
//
// PLAN-077 T-03 sink (mode doc §6.6): the ext's orchestration moved INTO
// the DSL — the .Init/.is_open-watch/.Rate bodies run the get_due_cards/
// review_card contract calls in try/catch/finally directly (the safe
// wrappers' never-reject semantics fold into catch = error set, finally =
// loading reset; error message extraction via the ext's errorMessage strict
// bridge — 076 search_panel precedent), and card_at/card_question/
// card_answer/counter_text are the module fns below. The ext keeps exactly:
// the Brain re-export, the errorMessage strict bridge, and the
// get_due_cards/review_card contract aliases.
//
// Regenerate:
//
//   cd jade-garden/front/auto
//   D:/autostack/auto-lang/target/debug/auto.exe build -d .
//   sed -e 's|@/ext/src/front/utils/flashcard_modal_ext|../../auto/src/front/utils/flashcard_modal_ext|g' \
//       -e 's|@/lib/api|../../auto/src/front/utils/flashcard_modal_ext|g' \
//     gen/front/vue/src/components/FlashcardModal.vue > ../src/components/FlashcardModal.vue
//
// Idioms forced by DSL codegen gaps (see README's gap list):
// - The v-model:open contract is the 034-vmodel child pattern: an `open`
//   prop + a QUOTED msg variant `"update:open"(bool)` whose empty handler
//   auto-appends emit('update:open', v). The overlay's click.self wires the
//   variant with a literal `false` arg (the original's close() =
//   `open.value = false`).
// - load()'s try/catch/finally folds into a one-callback .then over the
//   extension's never-rejecting getDueCardsSafe (search_panel precedent);
//   the same body appears in .Init (the original onMounted's
//   `if (open) load()`), the is_open watch (the original watch(open)), and
//   the .Rate reload branch — the DSL has no handler-to-handler calls.
// - The v-if / v-else-if / v-else chain (loading / error / empty / cards)
//   becomes four exclusive named-boolean computeds; error is a plain str
//   model var, "" = the original's null (search_panel precedent).
// - current / question / answer / the index+1 counter are extension Calls
//   (no optional chaining or view-text arithmetic in the DSL).

// Contract channel: web = ext-shim alias of the hand-written client (deploy
// sed rewrites the emitted '@/lib/api' import), VM = #[api] get_due_cards /
// review_card (desktop/src/back/api.at:370/386, back/auto/api.at:366/382).
use back.api: get_due_cards, review_card

// Sunk from ext cardAt (PLAN-077 T-03): `cards[index] || null` as a
// counting walk — no indexed access (dual-track safe), out-of-range and
// empty-deck both land on null (the original's `?? null` arm).
fn card_at(cards_in, index_in) {
    var out = null
    var i = 0
    for c in cards_in {
        if i == index_in && out == null {
            out = c
        }
        i = i + 1
    }
    return out
}

// Sunk from ext cardQuestion/cardAnswer (PLAN-077 T-03): the original's
// `card?.question || card?.raw || ''` chain as explicit guards — the ||
// falls through on null AND empty string, so both are checked; a null raw
// leaves "" (the chain's terminal).
fn card_question(card_in) str {
    var out = ""
    if card_in != null {
        var q = card_in.question
        var r = card_in.raw
        if q != null && q != "" {
            out = q
        }
        if q == null || q == "" {
            if r != null {
                out = r
            }
        }
    }
    return out
}

fn card_answer(card_in) str {
    var out = ""
    if card_in != null {
        var a = card_in.answer
        var r = card_in.raw
        if a != null && a != "" {
            out = a
        }
        if a == null || a == "" {
            if r != null {
                out = r
            }
        }
    }
    return out
}

// Sunk from ext counterText (PLAN-077 T-03): the `{{ index + 1 }} /
// {{ cards.length }}` header — f-string math interpolation (P-3 domain).
// NB: fn name is counter_label, NOT counter_text — the widget already has a
// computed of that name and the two would collide in the emitted script
// (G-1 fn-name arm).
fn counter_label(index_in, count_in) str {
    return f"${index_in + 1} / ${count_in}"
}

widget FlashcardModal(open: bool) {
    use {
        fn: Brain, errorMessage from "src/front/utils/flashcard_modal_ext.ts"
    }

    msg Msg { Init, Reveal, Rate, "update:open"(bool) }

    model {
        var cards Array<str> = []
        var loading bool = false
        var index int = 0
        var show_answer bool = false
        // "" = no error (has_error checks != "").
        var error str = ""
    }

    computed {
        is_open => .open
        current => card_at(.cards, .index)
        counter_text => counter_label(.index, .cards.length)
        question_text => card_question(.current)
        answer_text => card_answer(.current)
        has_error => .error != ""
        show_loading => .loading
        show_error => !.loading && .has_error
        show_empty => !.loading && !.has_error && .cards.length == 0
        show_cards => !.loading && !.has_error && .cards.length > 0
    }

    view {
        if .is_open {
            div {
                class: "fixed inset-0 z-[70] flex items-center justify-center bg-black/50 p-4",
                onclick.self: ."update:open",
                div {
                    class: "w-full max-w-lg overflow-hidden rounded-lg border bg-card shadow-xl",
                    div {
                        class: "flex items-center gap-2 border-b px-4 py-3",
                        dyn (.Brain) { class: "h-5 w-5 text-primary" }
                        span { class: "font-semibold", text "Flashcards" }
                        span { class: "ml-auto text-xs text-muted-foreground", text .counter_text }
                    }
                    div {
                        class: "min-h-[200px] p-6",
                        if .show_loading {
                            div { class: "flex h-40 items-center justify-center text-sm text-muted-foreground", text "Loading cards…" }
                        }
                        if .show_error {
                            div { class: "text-sm text-destructive", text .error }
                        }
                        if .show_empty {
                            div {
                                class: "flex h-40 flex-col items-center justify-center gap-2 text-muted-foreground",
                                dyn (.Brain) { class: "h-8 w-8 opacity-50" }
                                span { text "No cards due for review" }
                            }
                        }
                        if .show_cards {
                            div { class: "mb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground", text "Question" }
                            div { class: "mb-6 whitespace-pre-wrap text-base leading-relaxed", text .question_text }
                            if .show_answer {
                                div { class: "mb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground", text "Answer" }
                                div { class: "mb-6 whitespace-pre-wrap text-base leading-relaxed", text .answer_text }
                            }
                            if !.show_answer {
                                div {
                                    class: "flex justify-center",
                                    button (type: "button") {
                                        class: "rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90",
                                        onclick: .Reveal,
                                        text "Show answer"
                                    }
                                }
                            }
                            if .show_answer {
                                div {
                                    class: "grid grid-cols-4 gap-2",
                                    button (type: "button") {
                                        class: "rounded-md bg-destructive/10 px-2 py-2 text-xs font-semibold text-destructive hover:bg-destructive/20",
                                        onclick: .Rate(1),
                                        text "Again"
                                    }
                                    button (type: "button") {
                                        class: "rounded-md bg-amber-500/10 px-2 py-2 text-xs font-semibold text-amber-600 hover:bg-amber-500/20",
                                        onclick: .Rate(2),
                                        text "Hard"
                                    }
                                    button (type: "button") {
                                        class: "rounded-md bg-primary/10 px-2 py-2 text-xs font-semibold text-primary hover:bg-primary/20",
                                        onclick: .Rate(3),
                                        text "Good"
                                    }
                                    button (type: "button") {
                                        class: "rounded-md bg-emerald-500/10 px-2 py-2 text-xs font-semibold text-emerald-600 hover:bg-emerald-500/20",
                                        onclick: .Rate(4),
                                        text "Easy"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    watch {
        // Original: watch(open, (isOpen) => { if (isOpen) load() }) — load()
        // = getDueCards(50) with catch coming back as { cards: [], error }
        // data (PLAN-077 sink: the safe-wrapper fold puts the success arm in
        // try, the error arm in catch — cards untouched on error, exactly
        // the original .then's error branch — and loading reset in finally).
        .is_open -> {
            if .is_open {
                .loading = true
                .error = ""
                try {
                    let res = get_due_cards(50)
                    .cards = res.cards
                    .index = 0
                    .show_answer = false
                } catch (e) {
                    .error = errorMessage(e)
                } finally {
                    .loading = false
                }
            }
        }
    }

    on {
        // Original: onMounted(() => { if (open.value) load() }) — same
        // safe-wrapper fold as the watch (no handler-to-handler calls in
        // the DSL, so the load body stays duplicated here, .Rate reload
        // and watch).
        .Init -> {
            if .open {
                .loading = true
                .error = ""
                try {
                    let res = get_due_cards(50)
                    .cards = res.cards
                    .index = 0
                    .show_answer = false
                } catch (e) {
                    .error = errorMessage(e)
                } finally {
                    .loading = false
                }
            }
        }
        // Original: function reveal() { showAnswer.value = true }.
        .Reveal -> {
            .show_answer = true
        }
        // Original rate(grade): await reviewCard; on success index + 1,
        // hide the answer, and reload when the deck is exhausted; on error
        // only the error message is set (index stays). PLAN-077 sink: the
        // review_card contract call runs in try/catch (rejection = the old
        // safe wrapper's error mapping via errorMessage), the reload is the
        // load body inlined with its own try/catch/finally (nested try is
        // probe-verified both tracks — mode doc §6.0 P-10).
        .Rate(grade) -> {
            var card = .current
            if card != null {
                try {
                    review_card(card.page_path, card.block_id, grade)
                    .index = .index + 1
                    .show_answer = false
                    if .index >= .cards.length {
                        .loading = true
                        .error = ""
                        try {
                            let res2 = get_due_cards(50)
                            .cards = res2.cards
                            .index = 0
                            .show_answer = false
                        } catch (e2) {
                            .error = errorMessage(e2)
                        } finally {
                            .loading = false
                        }
                    }
                } catch (e) {
                    .error = errorMessage(e)
                }
            }
        }
        // The v-model:open write-up: the view wires this quoted variant with
        // a literal false; the auto-emit appends emit('update:open', v).
        ."update:open"(v) -> { v = false }
    }
}
