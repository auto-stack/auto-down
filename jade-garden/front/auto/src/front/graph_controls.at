// graph_controls.at — GraphControls widget (Auto language source).
//
// Auto-generated replacement for the hand-written
// front/src/components/GraphControls.vue (plan 011 Phase 5.2; PLAN-078
// T-02 sink: labels + settings write channel moved into module fns here).
// Regenerate:
//
//   cd jade-garden/front/auto
//   D:/autostack/auto-lang/target/debug/auto.exe build -d .
//   sed -e 's|@/ext/src/front/utils/graph_controls_ext|../../auto/src/front/utils/graph_controls_ext|g' \
//       -e 's|@/lib/api|../../auto/src/front/utils/graph_controls_ext|g' \
//     gen/front/vue/src/components/GraphControls.vue > ../src/components/GraphControls.vue
//   # The DSL emits an empty <style> block — the original's scoped styles
//   # are appended verbatim (they style the same class hooks):
//   cat src/front/graph_controls.styleblock >> ../src/components/GraphControls.vue
//
// Idioms forced by DSL codegen gaps (see README's gap list):
// - PLAN-078 T-02: centerLabel (regex `.ad$`) is the strip_ext discipline
//   form (length+slice+tail-compare, tabs_store.at:47 shape — ASCII
//   dual-track green; CJK paths degrade verbatim on VM per G-2, the
//   control label is a vue execution face); opacityLabel uses the
//   `math.round` dual-track word (074-sink-mode §7.0 P-14); eventValue is
//   dissolved into the handler (`e.target.value`, 077 properties
//   precedent). The nested settings writes go through module fns
//   (gc_set_setting bracket write / gc_reset_settings dot writes — the
//   P-11-safe form; `$patch` and a `$`-named method have no DSL word, the
//   per-field reset is observably equivalent: same defaults + saveSettings,
//   and GraphView's deep settings watch fires on both shapes).
// - The v-model fold only fires for plain model vars, and these inputs
//   bind nested facade paths (graph.settings.*) — so every input uses an
//   explicit :value/:checked + @input/@change pair (exactly what v-model
//   compiles to) with the write-back in the handler/extension.
//   v-model.number's numeric coercion is the extension's eventNumber.
// - The original's scoped <style> block cannot be emitted by the codegen
//   (it always appends an empty <style>) — kept verbatim in
//   graph_controls.styleblock and appended by the regen flow above.

// Sunk from graph_controls_ext.ts centerLabel (PLAN-078 T-02): the
// `centerPath.replace(/\.ad$/, '')` regex has no DSL word — strip_ext
// discipline form (ASCII dual-track; CJK degrades verbatim on VM, G-2).
fn gc_center_label(path_in) str {
    var ext = ".ad"
    var n = path_in.length
    var m = ext.length
    if n >= m {
        var tail = path_in.slice(n - m, n)
        if tail == ext {
            return path_in.slice(0, n - m)
        }
    }
    return path_in
}

// Sunk from graph_controls_ext.ts opacityLabel (PLAN-078 T-02): the
// `Math.round(textOpacity * 100) + '%'` interpolation via the math.round
// dual-track word (P-14).
fn gc_opacity_label(opacity_in) str {
    return f"${math.round(opacity_in * 100)}%"
}

// Sunk write channel (PLAN-078 T-02, Q-3 ruling): the nested
// `graph.settings.<key> = value` bracket write as a module fn over the
// store facade (vue execution face — P-11: the VM bracket write aborts
// handlers, the twin drives projections instead; VM fix handoff in
// 078-vm-map-write-repro). Setters take the facade explicitly.
fn gc_set_setting(graph_store, key_in, value_in) {
    graph_store.settings[key_in] = value_in
}

// Sunk from graph_controls_ext.ts resetGraphSettings (PLAN-078 T-02): the
// reset button's $patch(defaults) + saveSettings — per-field dot writes
// (P-11-safe form) replace the `$patch` object swap, observably
// equivalent (same defaults, same save, deep watch fires on both).
fn gc_reset_settings(graph_store) {
    graph_store.settings.showOrphans = true
    graph_store.settings.showMissing = false
    graph_store.settings.nodeSize = 12
    graph_store.settings.textOpacity = 0.85
    graph_store.settings.edgeWidth = 1
    graph_store.settings.showArrows = false
    graph_store.settings.gravity = 0.05
    graph_store.settings.repulsion = 4500
    graph_store.settings.attraction = 0.05
    graph_store.settings.linkLength = 120
    graph_store.saveSettings()
}

widget GraphControls {
    use {
        composable: useGraphStore from "src/front/utils/graph_controls_ext.ts"
        fn: eventNumber, eventChecked, Search, SlidersHorizontal, Palette, Magnet, Focus from "src/front/utils/graph_controls_ext.ts"
        component: RangeInput from "src/front/utils/graph_controls_ext.ts"
    }

    msg Msg { SearchInput, SliderChanged, DepthChanged, FlagChanged, ShowGlobal, Reset }

    computed {
        center_label => gc_center_label(.graphStore.centerPath)
        opacity_label => gc_opacity_label(.graphStore.settings.textOpacity)
    }

    view {
        div {
            class: "graph-controls flex flex-col gap-4 p-3 text-sm",
            div {
                class: "section",
                div {
                    class: "section-title",
                    dyn (.Search) { class: "h-3.5 w-3.5" }
                    span { text "搜索" }
                }
                input (type: "text") {
                    value: .graphStore.searchQuery,
                    oninput: .SearchInput($event),
                    placeholder: "搜索节点…",
                    class: "graph-input"
                }
            }
            if .graphStore.centerPath {
                div {
                    class: "section",
                    div {
                        class: "section-title",
                        dyn (.Focus) { class: "h-3.5 w-3.5" }
                        span { text "局部图谱" }
                    }
                    div {
                        class: "text-xs text-muted-foreground truncate",
                        text f"中心：${.center_label}"
                    }
                    label {
                        class: "slider-row",
                        span { text "深度" }
                        RangeInput (value: .graphStore.depth, oninput: .DepthChanged($event), min: "1", max: "3", step: "1")
                        span { class: "value", text .graphStore.depth }
                    }
                    button {
                        class: "graph-btn",
                        onclick: .ShowGlobal,
                        text "返回全局"
                    }
                }
            }
            div {
                class: "section",
                div {
                    class: "section-title",
                    dyn (.SlidersHorizontal) { class: "h-3.5 w-3.5" }
                    span { text "筛选" }
                }
                label {
                    class: "control-row",
                    span { text "显示孤立文件" }
                    input (type: "checkbox") {
                        checked: .graphStore.settings.showOrphans,
                        onchange: .FlagChanged("showOrphans", $event),
                        class: "toggle"
                    }
                }
                label {
                    class: "control-row",
                    span { text "显示缺失页面" }
                    input (type: "checkbox") {
                        checked: .graphStore.settings.showMissing,
                        onchange: .FlagChanged("showMissing", $event),
                        class: "toggle"
                    }
                }
            }
            div {
                class: "section",
                div {
                    class: "section-title",
                    dyn (.Palette) { class: "h-3.5 w-3.5" }
                    span { text "外观" }
                }
                label {
                    class: "slider-row",
                    span { text "节点大小" }
                    RangeInput (value: .graphStore.settings.nodeSize, oninput: .SliderChanged("nodeSize", $event), min: "4", max: "40", step: "1")
                    span { class: "value", text .graphStore.settings.nodeSize }
                }
                label {
                    class: "slider-row",
                    span { text "文本透明度" }
                    RangeInput (value: .graphStore.settings.textOpacity, oninput: .SliderChanged("textOpacity", $event), min: "0", max: "1", step: "0.05")
                    span { class: "value", text .opacity_label }
                }
                label {
                    class: "slider-row",
                    span { text "连线粗细" }
                    RangeInput (value: .graphStore.settings.edgeWidth, oninput: .SliderChanged("edgeWidth", $event), min: "0.5", max: "5", step: "0.5")
                    span { class: "value", text .graphStore.settings.edgeWidth }
                }
                label {
                    class: "control-row",
                    span { text "显示箭头" }
                    input (type: "checkbox") {
                        checked: .graphStore.settings.showArrows,
                        onchange: .FlagChanged("showArrows", $event),
                        class: "toggle"
                    }
                }
            }
            div {
                class: "section",
                div {
                    class: "section-title",
                    dyn (.Magnet) { class: "h-3.5 w-3.5" }
                    span { text "力度" }
                }
                label {
                    class: "slider-row",
                    span { text "图谱向心力" }
                    RangeInput (value: .graphStore.settings.gravity, oninput: .SliderChanged("gravity", $event), min: "0", max: "0.5", step: "0.01")
                    span { class: "value", text .graphStore.settings.gravity }
                }
                label {
                    class: "slider-row",
                    span { text "节点排斥力" }
                    RangeInput (value: .graphStore.settings.repulsion, oninput: .SliderChanged("repulsion", $event), min: "1000", max: "20000", step: "500")
                    span { class: "value", text .graphStore.settings.repulsion }
                }
                label {
                    class: "slider-row",
                    span { text "相连节点吸引力" }
                    RangeInput (value: .graphStore.settings.attraction, oninput: .SliderChanged("attraction", $event), min: "0.001", max: "0.5", step: "0.001")
                    span { class: "value", text .graphStore.settings.attraction }
                }
                label {
                    class: "slider-row",
                    span { text "连线长度" }
                    RangeInput (value: .graphStore.settings.linkLength, oninput: .SliderChanged("linkLength", $event), min: "30", max: "300", step: "10")
                    span { class: "value", text .graphStore.settings.linkLength }
                }
            }
            button {
                class: "graph-btn",
                onclick: .Reset,
                text "重置设置"
            }
        }
    }

    on {
        // Original: v-model="graph.searchQuery" write-back (eventValue
        // dissolved — 077 properties precedent).
        .SearchInput(e) -> {
            .graphStore.searchQuery = e.target.value
        }
        // Original: v-model.number="graph.settings.<key>" + @input="update"
        // (update = graph.saveSettings()) — write channel via gc_set_setting.
        .SliderChanged(key, evt) -> {
            gc_set_setting(.graphStore, key, eventNumber(evt))
            .graphStore.saveSettings()
        }
        // Original: v-model.number="graph.depth" (no saveSettings on depth).
        .DepthChanged(e) -> {
            .graphStore.depth = eventNumber(e)
        }
        // Original: v-model="graph.settings.<key>" checkbox + @change="update".
        .FlagChanged(key, evt) -> {
            gc_set_setting(.graphStore, key, eventChecked(evt))
            .graphStore.saveSettings()
        }
        // Original: @click="graph.showGlobal()".
        .ShowGlobal -> {
            .graphStore.showGlobal()
        }
        // Original: reset() = $patch(defaults) + saveSettings() — via
        // gc_reset_settings (per-field dot writes).
        .Reset -> {
            gc_reset_settings(.graphStore)
        }
    }
}
