// outgoing_links_panel.at — OutgoingLinksPanel widget (Auto language
// source). Auto-generated replacement for the hand-written
// front/src/components/OutgoingLinksPanel.vue (plan 011 Phase 5.1).
// Regenerate:
//
//   cd jade-garden/front/auto
//   D:/autostack/.wt/down-074/auto-lang/target/debug/auto.exe build -d .
//   sed -e 's|@/ext/src/front/utils/outgoing_links_panel_ext|../../auto/src/front/utils/outgoing_links_panel_ext|g' \
//       -e 's|@/lib/api|../../auto/src/front/utils/outgoing_links_panel_ext|g' \
//     gen/front/vue/src/components/OutgoingLinksPanel.vue > ../src/components/OutgoingLinksPanel.vue
//
// PLAN-074 T-03 sink (backlinks_panel.at T-02 mode): tab_file_stem is a
// module fn below and the fetch orchestration is the watch block's
// try/catch/finally around the `use back.api:` contract call. The ext
// keeps the facade re-export, the get_outlinks contract alias, and the
// openTarget host flow (confirm + sequential awaits — DOM/store face,
// not expressible). Mode doc: docs/plans/attachments/074-sink-mode.md.
//
// Idioms (see backlinks_panel.at header and autodown editor src/auto/README):
// - ul/li render via dyn with string tags (not in the DSL element table).
// - The loop variable cannot be named `link` (a DSL element keyword).
// - The v-if / v-else-if / v-else chain becomes exclusive boolean computeds.
// - The success/destructive dot class is a real dynamic `class:` ternary
//   (compiler ≥ 24f0dd16, gap 20 fix) — the original's exact binding.
// - Module fn locals must not shadow widget model/computed names (probe P-5).

// Contract channel: web = ext-shim alias (deploy sed), VM = #[api] fn.
use back.api: get_outlinks

// Sunk from ext tabFileStem (PLAN-074 T-03; duplicated per file — the DSL
// has no cross-file imports, mode doc G-3). find+recursion form, see
// backlinks_panel.at P-6/P-5 notes.
fn last_segment(path str) str {
    let sep = path.find("/")
    if sep == -1 {
        return path
    }
    return last_segment(path.slice(sep + 1, path.length.to(int)))
}

fn stem_of_path(path str) str {
    let name = last_segment(path)
    let dot = name.find(".")
    if dot > 0 {
        return name.slice(0, dot)
    }
    return name
}

fn tab_file_stem(tab) str {
    if tab == null {
        return ""
    }
    return stem_of_path(tab.path)
}

widget OutgoingLinksPanel {
    use {
        composable: useTabsStore from "src/front/utils/outgoing_links_panel_ext.ts"
        fn: openOutlinkTarget from "src/front/utils/outgoing_links_panel_ext.ts"
    }

    msg Msg { OpenTarget }

    model {
        var links []str = []
        var loading bool = false
    }

    computed {
        current_title => tab_file_stem(.tabsStore.activeTab)
        show_loading => .loading
        show_list => !.loading && .links.length > 0
        show_empty => !.loading && .links.length == 0
        ul_tag => "ul"
        li_tag => "li"
    }

    view {
        div {
            class: "rounded-lg border bg-background/50 p-2.5",
            h4 { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground", text "Outgoing links" }
            if .show_loading {
                p { class: "text-xs text-muted-foreground", text "Loading…" }
            }
            if .show_list {
                dyn (.ul_tag) {
                    class: "space-y-0.5",
                    for ol in .links {
                        dyn (.li_tag) {
                            key: ol.target_path,
                            class: "flex cursor-pointer items-center gap-1.5 truncate rounded px-1.5 py-0.5 text-xs text-foreground/80 transition-colors hover:bg-accent hover:text-foreground",
                            onclick: .OpenTarget(ol),
                            span {
                                class: ol.exists ? "h-1.5 w-1.5 rounded-full shrink-0 bg-[hsl(var(--af-success))]" : "h-1.5 w-1.5 rounded-full shrink-0 bg-destructive"
                            }
                            span { class: "truncate", text ol.target_title }
                            if ol.block_id {
                                span { class: "text-[10px] text-muted-foreground", text f"#${ol.block_id}" }
                            }
                        }
                    }
                }
            }
            if .show_empty {
                p { class: "text-xs text-muted-foreground", text "No outgoing links." }
            }
        }
    }

    watch {
        // Original: watch(currentTitle, fetchOutlinks, { immediate: true }).
        // PLAN-074 T-03: fetchOutlinksSafe's orchestration sank here (see
        // backlinks_panel.at T-02 watch for the shape rationale).
        .current_title.immediate -> {
            if .current_title == "" {
                .links = []
            }
            if .current_title != "" {
                .loading = true
                try {
                    let res = get_outlinks(.current_title)
                    .links = res.links
                } catch (e) {
                    .links = []
                } finally {
                    .loading = false
                }
            }
        }
    }

    on {
        // Original: async function openTarget(link) { ... } — the whole
        // flow lives in the extension (no async/await in the DSL).
        .OpenTarget(ol) -> {
            openOutlinkTarget(ol)
        }
    }
}
