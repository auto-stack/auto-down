// outline_panel.at — OutlinePanel widget (Auto language source).
// Auto-generated replacement for the hand-written
// front/src/components/OutlinePanel.vue (plan 011 Phase 5.1). Regenerate:
//
//   cd jade-garden/front/auto
//   D:/autostack/auto-lang/target/debug/auto.exe build -d .
//   sed 's|@/ext/src/front/utils/outline_panel_ext|../../auto/src/front/utils/outline_panel_ext|g' \
//     gen/front/vue/src/components/OutlinePanel.vue > ../src/components/OutlinePanel.vue
//
// NOTE: the panel is pinned EMPTY at runtime (the app never calls
// blocks.parse, so blocks.activeBlocks is always [] and the panel renders
// "No headings." — the e2e baseline depends on this). The heading-list
// code path is translated faithfully anyway; it is simply never taken.
//
// Idioms forced by DSL codegen gaps (see backlinks_panel.at header):
// - ul/li render via dyn with string tags (not in the DSL element table).
// - The per-heading paddingLeft math is precomputed by the extension
//   (no `??` in view bindings; expression parentheses are dropped).
// - The scroll-to-heading CustomEvent dispatch lives in the extension
//   (`new CustomEvent` is not expressible).

widget OutlinePanel {
    use {
        composable: useBlocksStore, useTabsStore from "src/front/utils/outline_panel_ext.ts"
        fn: outlineHeadings, dispatchScrollToHeading from "src/front/utils/outline_panel_ext.ts"
    }

    msg Msg { ScrollTo }

    computed {
        // Original: computed(() => blocks.activeBlocks.filter(heading)),
        // with the paddingLeft style precomputed per heading.
        headings => outlineHeadings(.blocksStore.activeBlocks)
        show_list => .headings.length > 0
        show_empty => .headings.length == 0
        ul_tag => "ul"
        li_tag => "li"
    }

    view {
        div {
            class: "rounded-lg border bg-background/50 p-2.5",
            h4 { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground", text "Outline" }
            if .show_list {
                dyn (.ul_tag) {
                    class: "space-y-0.5",
                    for h in .headings {
                        dyn (.li_tag) {
                            key: h.content,
                            class: "cursor-pointer truncate rounded px-1.5 py-0.5 text-xs text-foreground/80 transition-colors hover:bg-accent hover:text-foreground",
                            style_obj: { paddingLeft: h.pad },
                            title: h.content,
                            onclick: .ScrollTo(h.content),
                            text h.content
                        }
                    }
                }
            }
            if .show_empty {
                p { class: "text-xs text-muted-foreground", text "No headings." }
            }
        }
    }

    on {
        // Original: function scrollToHeading(content) { ... dispatch ... }
        .ScrollTo(content) -> {
            dispatchScrollToHeading(content)
        }
    }
}
