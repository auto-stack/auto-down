// search_panel.at — SearchPanel widget (Auto language source).
//
// Auto-generated replacement for the hand-written
// front/src/components/SearchPanel.vue (plan 011 Phase 5.1 batch 2).
// Regenerate:
//
//   cd jade-garden/front/auto
//   D:/autostack/.wt/down-076/auto-lang/target/debug/auto.exe build -d .
//   sed -e 's|@/ext/src/front/utils/search_panel_ext|../../auto/src/front/utils/search_panel_ext|g' \
//       -e 's|@/lib/api|../../auto/src/front/utils/search_panel_ext|g' \
//     gen/front/vue/src/components/SearchPanel.vue > ../src/components/SearchPanel.vue
//
// PLAN-076 T-02 sink (mode doc §5.1): the ext's data orchestration moved INTO
// the DSL — searchSafe's try/catch/finally mapping is the debounced run
// closure's own try/catch/finally around the `use back.api: search_pages`
// contract call (compiler ≥ c5b5fecf; error message extraction via the ext's
// errorMessage bridge — strict TS unknown-catch domain), and
// withSearchDisplay's row construction is the with_search_display module fn
// below (snippet_html stays an ext bridge call per row — regex literals have
// no DSL word, unlinked highlight_context precedent). The ext keeps exactly:
// the re-exports, snippetHtml, scheduleScrollToBlock, and the two contract/
// strict bridges.
//
// Idioms forced by DSL codegen gaps (see backlinks_panel.at header + README):
// - The search input uses real v-model: `value: .query` (plain model var)
//   PLUS an `oninput:` handler folds into `v-model="query"` and drops the
//   explicit @input (CodeBlockMenu note 3; the QueryInput handler is
//   emitted but never called — kept as the fold's write-back target with
//   the original's write-back body).
// - The 250ms debounce is the original's useDebounceFn (re-exported via
//   the extension): .Init builds the debounced closure (its body is the
//   original debouncedSearch verbatim — the empty-query early return
//   becomes exclusive if guards, and the PLAN-076 sink folds the old
//   searchSafe wrapper's try/catch data mapping straight into the closure
//   body: no promise, no .then) and stores it in a model var; the query
//   watch let-binds it and calls the local (TableMenu/NodeView let-bind
//   precedent).
// - The v-else-if chain (loading / error / results / hasQuery / hint)
//   becomes five exclusive named-boolean computeds; error is a plain str
//   model var ("" = no error), checked with `!= ""`.
// - ul/li render via dyn with string tags (backlinks precedent).
// - The per-result icon branch / title ternary / snippet v-html are
//   precomputed by with_search_display (no Call/ternary bindings in the
//   view); the v-html itself is the DSL's native `html:` prop on plain
//   elements (compiler c7034bf5, gap 22 closed).
// - The Block branch's `tabs.open(...).then(setTimeout dispatch)` maps to
//   a one-callback .then whose body calls the extension's
//   scheduleScrollToBlock (setTimeout + CustomEvent).
// - Module fn locals AND params avoid widget model/computed names (probe
//   P-5/G-1: a param named like a model field gets state-ref-rewritten).

// Contract channel: web = ext-shim alias of the hand-written client (deploy
// sed rewrites the emitted '@/lib/api' import), VM = #[api] search_pages
// (desktop/src/back/api.at:287, back/auto/api.at:283).
use back.api: search_pages

// Sunk from ext withSearchDisplay (PLAN-076 T-02): per-result display
// fields — the type ternary (is_page/is_block), title_text with explicit
// null guards (P618 two-step assignment), has_snippet plain boolean, and
// snippet_html via the ext bridge (regex \u0001/\u0002 → <mark>, no DSL
// word — unlinked_references highlight_context precedent).
fn with_search_display(rows_in) List {
    var out List = []
    for r in rows_in {
        var tt = ""
        if r.type == "Page" {
            if r.title != null {
                tt = r.title
            }
        }
        if r.type != "Page" {
            if r.page_path != null {
                tt = r.page_path
            }
        }
        var sn_html = ""
        var sn_has = false
        if r.snippet != null {
            sn_html = snippetHtml(r.snippet)
            sn_has = true
        }
        out.push({
            type: r.type,
            path: r.path,
            title: r.title,
            uuid: r.uuid,
            page_path: r.page_path,
            block_id: r.block_id,
            content: r.content,
            snippet: r.snippet,
            is_page: r.type == "Page",
            is_block: r.type != "Page",
            title_text: tt,
            has_snippet: sn_has,
            snippet_html: sn_html,
        })
    }
    return out
}

widget SearchPanel {
    use {
        composable: useTabsStore from "src/front/utils/search_panel_ext.ts"
        fn: useDebounceFn, snippetHtml, scheduleScrollToBlock, errorMessage, Search, FileText, Box from "src/front/utils/search_panel_ext.ts"
    }

    msg Msg { Init, QueryInput, OpenResult }

    model {
        var query str = ""
        var results []str = []
        var loading bool = false
        var error str = ""
        // The debounced search closure, built in .Init (Array<str> = any).
        var debounced_search Array<str> = null
    }

    computed {
        display_results => with_search_display(.results)
        has_query => .query.trim().length > 0
        has_error => .error != ""
        show_loading => .loading
        show_error => !.loading && .has_error
        show_results => !.loading && !.has_error && .results.length > 0
        show_no_results => !.loading && !.has_error && .results.length == 0 && .has_query
        show_hint => !.loading && !.has_error && .results.length == 0 && !.has_query
        ul_tag => "ul"
        li_tag => "li"
    }

    view {
        div {
            class: "flex h-full flex-col p-3",
            div {
                class: "flex items-center gap-2 rounded-md border bg-background px-2 py-1.5",
                dyn (.Search) { class: "h-4 w-4 text-muted-foreground" }
                input (type: "text") {
                    value: .query,
                    oninput: .QueryInput($event),
                    placeholder: "Search pages and blocks...",
                    class: "flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground"
                }
            }
            if .show_loading {
                div { class: "mt-4 text-center text-xs text-muted-foreground", text "Searching…" }
            }
            if .show_error {
                div { class: "mt-4 text-center text-xs text-destructive", text .error }
            }
            if .show_results {
                dyn (.ul_tag) {
                    class: "mt-2 flex-1 space-y-1 overflow-y-auto",
                    for r in .display_results {
                        dyn (.li_tag) {
                            key: r.page_path,
                            class: "cursor-pointer rounded px-2 py-1.5 text-sm hover:bg-accent",
                            onclick: .OpenResult(r),
                            div {
                                class: "flex items-center gap-1.5",
                                if r.is_page {
                                    dyn (.FileText) { class: "h-3.5 w-3.5 text-muted-foreground" }
                                }
                                if r.is_block {
                                    dyn (.Box) { class: "h-3.5 w-3.5 text-muted-foreground" }
                                }
                                span { class: "truncate font-medium", text r.title_text }
                            }
                            if r.has_snippet {
                                div (class: "mt-0.5 pl-5 text-xs text-muted-foreground", html: r.snippet_html)
                            }
                        }
                    }
                }
            }
            if .show_no_results {
                p { class: "mt-4 text-center text-xs text-muted-foreground", text "No results" }
            }
            if .show_hint {
                p { class: "mt-4 text-center text-xs text-muted-foreground", text "Type to search pages and blocks" }
            }
        }
    }

    watch {
        // Original: watch(query, debouncedSearch).
        .query -> {
            let f = .debounced_search
            f()
        }
    }

    on {
        // Builds the debounced search closure (the original's
        // useDebounceFn(async () => { ... }, 250) body verbatim; the
        // PLAN-076 sink folds the old searchSafe wrapper's catch-mapping
        // and the finally's loading reset into the closure body itself —
        // try carries success, catch maps failure to the empty list plus
        // the message, finally resets loading on both paths):
        // - empty query: clear results and return (error/loading untouched),
        // - otherwise: loading + clear error, fetch, apply.
        .Init -> {
            let run = () => {
                var q = .query.trim()
                if q != "" {
                    .loading = true
                    .error = ""
                    try {
                        let res = search_pages(q, 30)
                        .results = res.results
                        .error = ""
                    } catch (e) {
                        .results = []
                        .error = errorMessage(e)
                    } finally {
                        .loading = false
                    }
                }
                if q == "" {
                    .results = []
                }
            }
            let f = useDebounceFn(run, 250)
            .debounced_search = f
        }
        // Emitted but never called — the value/oninput pair folds into
        // v-model (see header); the body keeps the fold's write-back shape.
        .QueryInput(e) -> {
            .query = e.target.value
        }
        // Original: function openResult(r) { Page → open(path, title);
        // Block → open(page_path).then(scroll-to-block after 150ms) }.
        .OpenResult(r) -> {
            if r.type == "Page" && r.path != null {
                .tabsStore.open(r.path, r.title)
            }
            if r.type == "Block" && r.page_path != null {
                let p = .tabsStore.open(r.page_path)
                p.then(() => {
                    if r.block_id != null {
                        scheduleScrollToBlock(r.page_path, r.block_id)
                    }
                })
            }
        }
    }
}
