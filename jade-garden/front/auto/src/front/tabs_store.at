// tabs_store.at — TabsStore: the dirty/save tab state machine.
// Pinia → Auto store pilot (plan 011 Phase 5.1), port of the original
// hand-written front/src/stores/tabs.ts.
//
// All external functions come through `use back.api:` — the ONLY import
// channel the store codegen supports. It emits
// `import { ... } from '@/lib/api'`, which the Regenerate flow sed-rewrites
// to utils/tabs_store_ext.ts when copying into front/src/ (the gen project
// resolves it to the stubs/gen_lib_api.ts mirror instead).
// Save uses REAL try/catch/finally (compiler >= c5b5fecf, gap 4 resolved):
// writeWiki is the RAW api call (rejects), the catch rethrows via the ext
// `rethrow` helper so the rejection propagates like the original Pinia
// store; finally keeps tab.saving accurate on both paths. Load keeps its
// original catch behavior via readWikiSafe's null return.
use back.api: readWikiSafe, writeWiki, rethrow, ensureBlockAnchors, recordRecent, stripExt, confirmClose, adoptSaveResult

store Tabs {
    model {
        // Tab objects (Array<str> = any; the Tab interface lives in the
        // hand-written facade front/src/stores/tabs.ts).
        var tabs Array<str> = []
        // null = no active tab (None -> null).
        var active_path ?str = None
    }

    // msg payloads are SINGLE-typed only (compiler limitation), so the
    // multi-arg actions take one map argument: Open({ path, title }).
    msg Msg { Open(map), OpenGraph(map), OpenWhiteboard(map), Close(str),
              Load(str), SetBody(map), Save(str) }

    computed {
        active_tab => .tabs.find(t => t.path == .active_path)
    }

    on {
        .Open(args) -> {
            var path = args.path
            var title = args.title
            var existing = .tabs.find(t => t.path == path)
            if existing != null {
                .active_path = path
                if !existing.loaded && !existing.isGraph {
                    var doc2 = readWikiSafe(path)
                    // Post-await re-check: a slow read must not overwrite a
                    // tab that loaded (or went dirty) meanwhile — Open and
                    // Load both read the doc on open; on the VM backend the
                    // two round-trips land in arbitrary order and a late
                    // disk echo silently reverted user edits (plan 022
                    // Phase 3, e2e 11-properties).
                    if doc2 != null && existing.loaded == false {
                        existing.body = doc2.body
                        existing.originalBody = doc2.body
                        existing.frontmatter = doc2.frontmatter || {}
                        existing.title = doc2.frontmatter && doc2.frontmatter.title || existing.title
                        existing.dirty = false
                        existing.loaded = true
                    }
                    if doc2 == null {
                        existing.loaded = true
                        existing.originalBody = existing.body
                        existing.dirty = false
                    }
                }
            }
            if existing == null {
                var t2 = title
                if t2 == "" {
                    t2 = stripExt(path, ".ad")
                }
                .tabs.push({ path: path, title: t2, body: "", originalBody: "", frontmatter: {}, dirty: false, loaded: false, saving: false })
                .active_path = path
                var doc = readWikiSafe(path)
                var tab = .tabs.find(t => t.path == path)
                // Post-await re-check (same double-reader race as above):
                // Load may have populated the tab while this read was in
                // flight — first response wins, the late one stands down.
                if tab != null && doc != null && tab.loaded == false {
                    tab.body = doc.body
                    tab.originalBody = doc.body
                    tab.frontmatter = doc.frontmatter || {}
                    tab.title = doc.frontmatter && doc.frontmatter.title || tab.title
                    tab.dirty = false
                    tab.loaded = true
                }
                if tab != null && doc == null {
                    tab.loaded = true
                    tab.originalBody = tab.body
                    tab.dirty = false
                }
                recordRecent(path, t2)
            }
        }

        .OpenGraph(args) -> {
            // center: "" sentinel = global graph (facade maps null -> "").
            var center = args.center
            var depth = args.depth
            var path = "__graph__"
            var title = "全局图谱"
            if center != "" {
                path = f"__graph__:${center}"
                title = f"局部图谱：${stripExt(center, ".ad")}"
            }
            var existing = .tabs.find(t => t.path == path)
            if existing != null {
                .active_path = path
            }
            if existing == null {
                .tabs.push({ path: path, title: title, body: "", originalBody: "", frontmatter: {}, dirty: false, loaded: true, saving: false, isGraph: true, graphCenterPath: center || None, graphDepth: depth })
                .active_path = path
            }
        }

        .OpenWhiteboard(args) -> {
            var path = args.path
            var title = args.title
            var existing = .tabs.find(t => t.path == path)
            if existing != null {
                .active_path = path
            }
            if existing == null {
                var t2 = title
                if t2 == "" {
                    t2 = stripExt(path, ".canvas")
                }
                .tabs.push({ path: path, title: t2, body: "", originalBody: "", frontmatter: {}, dirty: false, loaded: true, saving: false, isWhiteboard: true })
                .active_path = path
            }
        }

        .Load(path) -> {
            var tab = .tabs.find(t => t.path == path)
            if tab != null && !tab.loaded {
                var doc = readWikiSafe(path)
                // Post-await re-check (double-reader race, plan 022
                // Phase 3): a concurrent Open/Load that finished first
                // owns the tab; this late echo must not clobber it.
                if doc != null && tab.loaded == false {
                    tab.body = doc.body
                    tab.originalBody = doc.body
                    tab.frontmatter = doc.frontmatter || {}
                    tab.title = doc.frontmatter && doc.frontmatter.title || tab.title
                    tab.dirty = false
                    tab.loaded = true
                }
                if doc == null {
                    tab.loaded = true
                    tab.originalBody = tab.body
                    tab.dirty = false
                }
            }
        }

        .Close(path) -> {
            var idx = .tabs.findIndex(t => t.path == path)
            if idx != -1 {
                var tab = .tabs[idx]
                var ok = true
                if tab.dirty && !tab.isGraph {
                    ok = confirmClose(tab.title)
                }
                if ok {
                    .tabs.splice(idx, 1)
                    if .active_path == path {
                        if .tabs.len() > 0 {
                            var idx2 = Math.min(idx, .tabs.len() - 1)
                            .active_path = .tabs[idx2].path
                        }
                        if .tabs.len() == 0 {
                            .active_path = None
                        }
                    }
                }
            }
        }

        .SetBody(args) -> {
            var path = args.path
            var body = args.body
            var tab = .tabs.find(t => t.path == path)
            if tab != null && tab.body != body {
                tab.body = body
                tab.dirty = tab.body != tab.originalBody
            }
        }

        .Save(path) -> {
            var tab = .tabs.find(t => t.path == path)
            if tab != null && tab.loaded {
                tab.saving = true
                try {
                    var body2 = ensureBlockAnchors(tab.body, tab.originalBody)
                    // Capture what we send: adoptSaveResult compares against
                    // the live tab to keep user edits that committed while the
                    // save round-tripped (stale-echo revert fix, plan 022
                    // Phase 3 — see tabs_store_ext.adoptSaveResult).
                    var sentFm = tab.frontmatter
                    var saved = writeWiki(path, { frontmatter: sentFm, body: body2 })
                    adoptSaveResult(tab, sentFm, body2, saved)
                    tab.dirty = false
                } catch (e) {
                    // Original save() had no catch — the rejection propagated
                    // (after finally). The DSL has no throw statement, so the
                    // ext `rethrow` helper re-throws; the emitted JS runs
                    // finally first, then the rejection leaves the async
                    // handler and reaches facade callers.
                    rethrow(e)
                } finally {
                    tab.saving = false
                }
            }
        }
    }
}
