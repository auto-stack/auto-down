// unlinked_references_panel.at — UnlinkedReferencesPanel widget (Auto
// language source). Auto-generated replacement for the hand-written
// front/src/components/UnlinkedReferencesPanel.vue (plan 011 Phase 5.1).
// Regenerate:
//
//   cd jade-garden/front/auto
//   D:/autostack/.wt/down-074/auto-lang/target/debug/auto.exe build -d .
//   sed -e 's|@/ext/src/front/utils/unlinked_references_panel_ext|../../auto/src/front/utils/unlinked_references_panel_ext|g' \
//       -e 's|@/lib/api|../../auto/src/front/utils/unlinked_references_panel_ext|g' \
//     gen/front/vue/src/components/UnlinkedReferencesPanel.vue > ../src/components/UnlinkedReferencesPanel.vue
//
// PLAN-074 T-03 sink (backlinks_panel.at T-02 mode): tab_title/tab_path are
// module fns below and the fetch orchestration is the watch block's
// try/catch/finally around the `use back.api:` call — with the row
// construction loop in the watch (html field precomputed per row via the
// ext highlight_context; regex has no DSL word, mode doc §1.4). The ext
// keeps the facade re-export, the get_unlinked_refs contract alias, and
// the regex highlighter.
//
// Idioms (see backlinks_panel.at header):
// - ul/li render via dyn with string tags (not in the DSL element table).
// - The v-if / v-else-if / v-else chain becomes exclusive boolean computeds.
// - The original's v-html highlight div uses the DSL's native `html:` prop
//   on plain elements (compiler c7034bf5, gap 22 closed): `div (class:
//   "...", html: r.html)` emits v-html; the highlight HTML is precomputed
//   per row by the watch below (regex stays in the ext).
// - The original watches tabs.activeTab?.path but loads by
//   tabs.activeTab?.title — the watch source is the watch_key computed
//   (module fn tab_path), the load title comes from module fn tab_title.

// Contract channel: web = ext-shim alias (deploy sed), VM = #[api] fn.
use back.api: get_unlinked_refs

// Sunk from ext tabTitle/tabPath (PLAN-074 T-03): trivial null→"" accessors.
fn tab_title(tab) str {
    if tab == null {
        return ""
    }
    return tab.title
}

fn tab_path(tab) str {
    if tab == null {
        return ""
    }
    return tab.path
}

widget UnlinkedReferencesPanel {
    use {
        composable: useTabsStore from "src/front/utils/unlinked_references_panel_ext.ts"
        fn: highlight_context from "src/front/utils/unlinked_references_panel_ext.ts"
    }

    msg Msg { OpenRef }

    model {
        var refs []str = []
        var loading bool = false
    }

    computed {
        // Original watch source: () => tabs.activeTab?.path.
        watch_key => tab_path(.tabsStore.activeTab)
        show_loading => .loading
        show_list => !.loading && .refs.length > 0
        show_empty => !.loading && .refs.length == 0
        ul_tag => "ul"
        li_tag => "li"
    }

    view {
        div {
            class: "rounded-lg border bg-background/50 p-2.5",
            h4 { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground", text "Unlinked References" }
            if .show_loading {
                div { class: "text-xs text-muted-foreground", text "Loading…" }
            }
            if .show_list {
                dyn (.ul_tag) {
                    class: "space-y-1",
                    for r in .refs {
                        dyn (.li_tag) {
                            key: r.page_path,
                            class: "cursor-pointer rounded px-1.5 py-1 text-xs hover:bg-accent",
                            onclick: .OpenRef(r),
                            div { class: "mb-0.5 truncate text-[10px] text-muted-foreground", text r.page_path }
                            div (class: "text-foreground/80", html: r.html)
                        }
                    }
                }
            }
            if .show_empty {
                p { class: "text-xs text-muted-foreground", text "No unlinked references." }
            }
        }
    }

    watch {
        // Original: watch(() => tabs.activeTab?.path, load, { immediate: true }).
        // PLAN-074 T-03: fetchUnlinkedSafe's orchestration + row construction
        // sank here; the regex highlight stays an ext call (mode doc §1.4).
        .watch_key.immediate -> {
            // Original load(): const title = tabs.activeTab?.title.
            let title = tab_title(.tabsStore.activeTab)
            if title == "" {
                .refs = []
            }
            if title != "" {
                .loading = true
                try {
                    let res = get_unlinked_refs(title)
                    var rows = []
                    for r in res.refs {
                        rows.push({ page_path: r.page_path, html: highlight_context(r.context, r.matched_text) })
                    }
                    .refs = rows
                } catch (e) {
                    .refs = []
                } finally {
                    .loading = false
                }
            }
        }
    }

    on {
        // Original: function openRef(r) { tabs.open(r.page_path) }
        .OpenRef(r) -> {
            .tabsStore.open(r.page_path)
        }
    }
}
