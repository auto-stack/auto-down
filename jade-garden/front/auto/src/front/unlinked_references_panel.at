// unlinked_references_panel.at — UnlinkedReferencesPanel widget (Auto
// language source). Auto-generated replacement for the hand-written
// front/src/components/UnlinkedReferencesPanel.vue (plan 011 Phase 5.1).
// Regenerate:
//
//   cd jade-garden/front/auto
//   D:/autostack/auto-lang/target/debug/auto.exe build -d .
//   sed 's|@/ext/src/front/utils/unlinked_references_panel_ext|../../auto/src/front/utils/unlinked_references_panel_ext|g' \
//     gen/front/vue/src/components/UnlinkedReferencesPanel.vue > ../src/components/UnlinkedReferencesPanel.vue
//
// Idioms forced by DSL codegen gaps (see backlinks_panel.at header):
// - ul/li render via dyn with string tags (not in the DSL element table).
// - The v-if / v-else-if / v-else chain becomes exclusive boolean computeds.
// - The original's v-html highlight div uses the DSL's native `html:` prop
//   on plain elements (compiler c7034bf5, gap 22 closed): `div (class:
//   "...", html: r.html)` emits v-html; the highlight regex is precomputed
//   per item by the extension.
// - The original watches tabs.activeTab?.path but loads by
//   tabs.activeTab?.title — the watch source is the watch_key computed
//   (ext tabPath), the load title comes from ext tabTitle.

widget UnlinkedReferencesPanel {
    use {
        composable: useTabsStore from "src/front/utils/unlinked_references_panel_ext.ts"
        fn: tabTitle, tabPath, fetchUnlinkedSafe from "src/front/utils/unlinked_references_panel_ext.ts"
    }

    msg Msg { OpenRef }

    model {
        var refs []str = []
        var loading bool = false
    }

    computed {
        // Original watch source: () => tabs.activeTab?.path.
        watch_key => tabPath(.tabsStore.activeTab)
        show_loading => .loading
        show_list => !.loading && .refs.length > 0
        show_empty => !.loading && .refs.length == 0
        ul_tag => "ul"
        li_tag => "li"
    }

    view {
        div {
            class: "rounded-lg border bg-background/50 p-2.5",
            h4 { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground", text "Unlinked References" }
            if .show_loading {
                div { class: "text-xs text-muted-foreground", text "Loading…" }
            }
            if .show_list {
                dyn (.ul_tag) {
                    class: "space-y-1",
                    for r in .refs {
                        dyn (.li_tag) {
                            class: "cursor-pointer rounded px-1.5 py-1 text-xs hover:bg-accent",
                            onclick: .OpenRef(r),
                            div { class: "mb-0.5 truncate text-[10px] text-muted-foreground", text r.page_path }
                            div (class: "text-foreground/80", html: r.html)
                        }
                    }
                }
            }
            if .show_empty {
                p { class: "text-xs text-muted-foreground", text "No unlinked references." }
            }
        }
    }

    watch {
        // Original: watch(() => tabs.activeTab?.path, load, { immediate: true }).
        .watch_key.immediate -> {
            // Original load(): const title = tabs.activeTab?.title.
            let title = tabTitle(.tabsStore.activeTab)
            if title == "" {
                .refs = []
            }
            if title != "" {
                .loading = true
                let p = fetchUnlinkedSafe(title)
                p.then(res => {
                    .refs = res
                    .loading = false
                })
            }
        }
    }

    on {
        // Original: function openRef(r) { tabs.open(r.page_path) }
        .OpenRef(r) -> {
            .tabsStore.open(r.page_path)
        }
    }
}
