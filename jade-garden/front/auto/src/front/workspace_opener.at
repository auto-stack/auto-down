// workspace_opener.at — WorkspaceOpener widget (Auto language source).
//
// Auto-generated replacement for the hand-written
// front/src/components/WorkspaceOpener.vue (plan 011 Phase 5.1 batch 3).
// Regenerate:
//
//   cd jade-garden/front/auto
//   D:/autostack/auto-lang/target/debug/auto.exe build -d .
//   sed 's|@/ext/src/front/utils/workspace_opener_ext|../../auto/src/front/utils/workspace_opener_ext|g' \
//     gen/front/vue/src/components/WorkspaceOpener.vue > ../src/components/WorkspaceOpener.vue
//
// Idioms forced by DSL codegen gaps (see backlinks_panel.at header + README):
// - The input uses real v-model: `value: .path` + `oninput: .PathInput($event)`
//   folds into v-model="path" (search_panel precedent; the PathInput handler
//   is emitted but never called).
// - open()'s try/finally (busy=true ... finally busy=false, rejection
//   propagating) has no async-handler equivalent: the handler sets busy,
//   then .finally() on the extension's promise clears it — the rejection
//   still propagates to the click handler, identical to the original.
// - workspace.error = null goes through the extension's clearWorkspaceError
//   (assignment to a composable/facade property is not a DSL lvalue).
// - chooseDirectory (window.showDirectoryPicker, try/catch, template-ref
//   focus/select) lives in the extension; the path write-back arrives via a
//   closure argument (search_panel let-closure precedent). The focus target
//   is found by placeholder attribute — the DSL has no template refs.
// - The inline SVG logo renders via the extension's WorkspaceLogo functional
//   component (the DSL has no svg element; ul/li-style component :is would
//   not carry the inner paths).
// - The error paragraph's v-if/text go through the error_text computed (a
//   Call body emits computed<any>; a bare dot-ref body would be mis-typed by
//   the name heuristic — README gap 28).
// - The placeholder's literal DOUBLE backslashes of the original template
//   (placeholder="...D:\\wiki\\demo" is raw attribute text in the SFC) need
//   quadruple backslashes in the .at string (the DSL unescapes \\ -> \).
// - NO commas between sibling view children — a trailing comma emits a junk
//   <div /> spacer (commas belong between props only).

widget WorkspaceOpener {
    use {
        composable: useWorkspaceStore, useFileTreeStore from "src/front/utils/workspace_opener_ext.ts"
        fn: openWorkspaceFlow, chooseWorkspaceDir, clearWorkspaceError, workspaceErrorText, WorkspaceLogo, FolderOpen, Info from "src/front/utils/workspace_opener_ext.ts"
    }

    msg Msg { Open, PathInput, ChooseDir }

    model {
        var path str = ""
        var busy bool = false
    }

    computed {
        // Original: workspace.error displayed as-is (null -> hidden by v-if).
        error_text => workspaceErrorText(.workspaceStore)
    }

    view {
        div {
            class: "flex h-full items-center justify-center bg-background p-6",
            div {
                class: "w-full max-w-md rounded-xl border bg-card p-8 shadow-sm",
                div {
                    class: "mb-6 text-center",
                    div {
                        class: "mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary",
                        dyn (.WorkspaceLogo) { }
                    }
                    h1 { class: "text-2xl font-bold tracking-tight text-foreground", text "Jade Garden" }
                    p { class: "mt-1 text-sm text-muted-foreground", text "A clean knowledge base editor for AutoDown" }
                }
                div {
                    class: "flex gap-2",
                    button (type: "button") {
                        title: "选择文件夹",
                        class: "flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border bg-background text-muted-foreground transition-colors hover:bg-accent hover:text-foreground",
                        onclick: .ChooseDir,
                        dyn (.FolderOpen) { class: "h-5 w-5" }
                    }
                    input (type: "text") {
                        value: .path,
                        oninput: .PathInput($event),
                        placeholder: "粘贴完整目录路径，例如 D:\\\\wiki\\\\demo",
                        class: "flex-1 rounded-lg border bg-background px-3 py-2 text-sm outline-none ring-primary/30 transition-shadow focus:ring-2",
                        onkeydown.enter: .Open
                    }
                    button {
                        class: "rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90 disabled:opacity-50",
                        disabled: .busy,
                        onclick: .Open,
                        text "Open"
                    }
                }
                if .error_text != "" {
                    p { class: "mt-3 text-center text-xs text-destructive", text .error_text }
                }
                div {
                    class: "mt-4 flex items-start gap-2 rounded-lg border bg-muted/30 p-3 text-xs text-muted-foreground",
                    dyn (.Info) { class: "mt-0.5 h-3.5 w-3.5 shrink-0" }
                    div { class: "leading-relaxed", text "浏览器安全限制下无法直接获取本地文件夹的绝对路径。建议直接在上面的输入框中粘贴完整的工程目录路径；点击文件夹图标可浏览并自动填充目录名，随后请补全完整路径。" }
                }
            }
        }
    }

    on {
        // Original: async function open() { if (!path.value.trim()) return;
        // busy=true; workspace.error=null; try { await workspace.open(trimmed);
        // await fileTree.load() } finally { busy=false } }.
        .Open -> {
            var p = .path.trim()
            if p != "" {
                .busy = true
                clearWorkspaceError(.workspaceStore)
                let pr = openWorkspaceFlow(.workspaceStore, .fileTreeStore, p)
                pr.finally(() => {
                    .busy = false
                })
            }
        }
        // Emitted but never called — the value/oninput pair folds into
        // v-model (see header); the body keeps the fold's write-back shape.
        .PathInput(e) -> {
            .path = e.target.value
        }
        // Original: async function chooseDirectory() — picker + focus/select
        // fallback in the extension; the handle name arrives via set_path.
        .ChooseDir -> {
            let set_path = v => {
                .path = v
            }
            chooseWorkspaceDir(set_path)
        }
    }
}
