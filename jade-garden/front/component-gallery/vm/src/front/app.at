// app.at — component gallery VM 臂根（PLAN-072 T-01 骨架 / T-03 四单元）。
//
// 隔离面原则：无 jade app 全局态、无后端依赖；数据 = root model 内
// fixture（.Init 播种，双轨同构：VM boot 自动派发 Init / vue onMounted，
// flashcard_modal.at 头注同款语义）。
//
// 单元形态（Q-3 已答——T-01/T-02 实测，README F-1..F-4）：VM 断言走
// root 投影字段 + root 内联/行结构（子件子树对 MCP 快照不可见）。
// status_bar 为子件挂载形态样版（视觉归 vue 臂截图）；outline/
// tab_strip/backlinks 为 root 内联 twin（derived 探针工件，非生产件）。
use pages.status_bar_page: StatusBarPage

// —— quick_switcher twin 模块 fn（derived 副本，derived-from
// front/auto/src/front/quick_switcher.at 模块 fn——G-3 无跨文件导入故随
// twin 各持一份；PLAN-076 T-01。VM 臂执行与 vue 轨同形的递归 walk +
// CJK 过滤链（P-7/P-8 域），Init 对 fixture 树跑真过滤）。
fn qs_collect(nodes, out) List {
    for nd in nodes {
        if nd.is_dir {
            if nd.children != null {
                qs_collect(nd.children, out)
            }
        }
        if !nd.is_dir {
            out.push({ path: nd.path, name: nd.name })
        }
    }
    return out
}

fn qs_filter(files, qstr) List {
    var rows List = []
    let needle = qstr.trim().to_lower()
    var kept = 0
    for f in files {
        if kept >= 12 {
            break
        }
        if needle == "" {
            rows.push({ path: f.path, name: f.name, idx: kept })
            kept = kept + 1
        }
        if needle != "" {
            var hay_name = f.name.to_lower()
            var hay_path = f.path.to_lower()
            if hay_name.contains(needle) || hay_path.contains(needle) {
                rows.push({ path: f.path, name: f.name, idx: kept })
                kept = kept + 1
            }
        }
    }
    return rows
}

// —— command_palette twin 模块 fn（derived 副本，derived-from
// front/auto/src/front/command_palette.at 的 filter_palette——G-3 各持
// 一份；PLAN-076 T-03 转正。title/subtitle 双 contains 布尔或 + cap 20 +
// idx/has_subtitle 行构造，与 vue 轨同形；Init 对 command×9+recent×2 混合
// fixture 真跑 CJK 查询 "引"——英文命令全落、CJK recent 两行命中）。
fn cp_filter(items, qstr) List {
    var rows List = []
    let needle = qstr.trim().to_lower()
    var kept = 0
    for it in items {
        if kept >= 20 {
            break
        }
        var sub_text = ""
        if it.subtitle != null {
            sub_text = it.subtitle
        }
        if needle != "" {
            var hay_title = it.title.to_lower()
            var hay_sub = sub_text.to_lower()
            if hay_title.contains(needle) || hay_sub.contains(needle) {
                rows.push({ title: it.title, subtitle: sub_text, kind: it.type, idx: kept })
                kept = kept + 1
            }
        }
    }
    return rows
}

// —— theme_popover twin 模块 fn（derived 副本，derived-from
// front/auto/src/front/theme_popover.at 的 theme_accents——G-3 各持一份；
// PLAN-077 T-01。静态五 accent Obj 字面量列表 return——Q-4 探针同形，
// VM Obj 全键形状锁定域实证面）。
fn tp_theme_accents() List {
    return [
        { key: "indigo", label: "Indigo", color: "hsl(238 55% 58%)" },
        { key: "emerald", label: "Emerald", color: "hsl(160 60% 38%)" },
        { key: "rose", label: "Rose", color: "hsl(350 70% 55%)" },
        { key: "amber", label: "Amber", color: "hsl(38 90% 50%)" },
        { key: "slate", label: "Slate", color: "hsl(220 10% 45%)" },
    ]
}

// —— agenda twin 模块 fn（derived 副本，derived-from
// front/auto/src/front/agenda_panel.at 的 agenda_display——G-3 各持一份；
// PLAN-077 T-02。markerClass switch → to_upper 互斥布尔 if 链（P-7 对称
// 词位 VM 面）+ `title || page_path` 显式双守卫；formatted_date 属 ext
// formatDate 桥（Q-3 TS 域）——twin 以 date raw 投影，不镜像格式化）。
fn ag_display_probe(groups_in) List {
    var out List = []
    for g in groups_in {
        var tasks List = []
        for tk in g.tasks {
            var mu = tk.marker.to_upper()
            var muted = false
            var primary = false
            var done = false
            if mu == "DOING" || mu == "NOW" {
                primary = true
            }
            if mu == "DONE" {
                done = true
            }
            if mu != "DOING" && mu != "NOW" && mu != "DONE" {
                muted = true
            }
            var line = tk.page_path
            if tk.title != null && tk.title != "" {
                line = tk.title
            }
            tasks.push({
                page_path: tk.page_path,
                marker: tk.marker,
                priority: tk.priority,
                content: tk.content,
                marker_muted: muted,
                marker_primary: primary,
                marker_done: done,
                line: line,
            })
        }
        out.push({ date: g.date, tasks: tasks })
    }
    return out
}

