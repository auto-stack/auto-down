// app.at — component gallery VM 臂根（PLAN-072 T-01 骨架 / T-03 四单元）。
//
// 隔离面原则：无 jade app 全局态、无后端依赖；数据 = root model 内
// fixture（.Init 播种，双轨同构：VM boot 自动派发 Init / vue onMounted，
// flashcard_modal.at 头注同款语义）。
//
// 单元形态（Q-3 已答——T-01/T-02 实测，README F-1..F-4）：VM 断言走
// root 投影字段 + root 内联/行结构（子件子树对 MCP 快照不可见）。
// status_bar 为子件挂载形态样版（视觉归 vue 臂截图）；outline/
// tab_strip/backlinks 为 root 内联 twin（derived 探针工件，非生产件）。
use pages.status_bar_page: StatusBarPage

widget App {
    msg Msg { Select(str), TsSwitch(str) }

    model {
        var unit str = "status_bar"
        // —— fixture：status_bar 面 ——
        var sb_status str = "ready"
        var sb_root str = "wiki-demo"
        var sb_bl int = 12
        var sb_ol int = 7
        // —— fixture：outline 面（行 = {content, pad}，形态沿 outline_panel.at
        // 的 headings 投影；pad 预计算——该件「表达式括号丢弃」纪律）——
        var ol_rows = []
        // VM 实测（T-01）：computed 字段不入 autoui_state，且 f-string 内插
        // computed 不解析（${ol_count} 原样出现）——计数/标记全部落 model
        // 字段，Init 维护（sb_marker 同款：model 字段内插已证可行）。
        var ol_count int = 0
        // VM 实测（T-01）：computed 数值比较（>）作 if 条件不进入分支
        // （== 计算字段正常）——行分支开关用 bool model 字段。
        var ol_has bool = false
        // —— fixture：tab_strip 面（交互样板：行按钮 = 标签，按下即切换）——
        var ts_tabs = []
        var ts_active str = ""
        // —— fixture：backlinks 面（数据绑定样板：行 + 计数投影）——
        var bl_rows = []
        var bl_count int = 0
        // —— fixture：menubar+toolbar 面（①-3/①-4：ui_config 合成面 twin，
        // PLAN-073 T-02——web 子集动作集结构镜像；命令面交互行为归 app 层
        // 24-menubar e2e，gallery=结构锁，故无点击断言）——
        var mb_menus int = 0
        var mb_actions int = 0
        var mb_toolbar int = 0
        // —— fixture：filetree 行家族面（①-5：flatten_tree 渲染语义 twin，
        // PLAN-073 T-03——行解剖 guides/chevron/icon/label 镜像 desktop
        // app.at ft_rows；展开交互走 label 钮（web 行点击同款），子行经
        // 条件分支渲染（desktop `if r.open` 双分支同款，避开 splice 面）——
        var ft_rows = []
        var ft_open_dir str = ""
        var ft_count int = 0
        var ft_sel str = ""
        // —— fixture：outgoing_links 面（PLAN-074 T-03 twin：exists 双态行）
        // VM 实测（T-01 同款纪律）：数值/布尔分支开关全落 model 字段。
        var olp_rows = []
        var olp_count int = 0
        var olp_exists int = 0
        var olp_has bool = false
        // —— fixture：unlinked_references 面（PLAN-074 T-03 twin：page_path
        // + context 文本行；html 高亮属 vue 显示面，twin 不镜像）——
        var ul_rows = []
        var ul_count int = 0
        var ul_has bool = false
    }

    computed {
        show_status_bar => .unit == "status_bar"
        show_outline => .unit == "outline"
        show_tab_strip => .unit == "tab_strip"
        show_backlinks => .unit == "backlinks"
        show_menubar => .unit == "menubar"
        show_filetree => .unit == "filetree"
        show_outgoing_links => .unit == "outgoing_links"
        show_unlinked_references => .unit == "unlinked_references"
        sb_marker => f"unit=status_bar status:${.sb_status} bl:${.sb_bl} ol:${.sb_ol}"
        ol_marker => f"unit=outline rows:${.ol_count}"
        ts_marker => f"unit=tab_strip active:${.ts_active}"
        bl_marker => f"unit=backlinks count:${.bl_count}"
        mb_marker => f"unit=menubar menus:${.mb_menus} actions:${.mb_actions} toolbar:${.mb_toolbar}"
        ft_marker => f"unit=filetree rows:${.ft_count} open:${.ft_open_dir} sel:${.ft_sel}"
        olp_marker => f"unit=outgoing_links rows:${.olp_count} exists:${.olp_exists}"
        ul_marker => f"unit=unlinked_references rows:${.ul_count}"
        // dyn 标签经 computed（outline_panel.at 同款：view 内字面量标签
        // 走 dyn(.tag) 形态）
        ul_tag => "ul"
        li_tag => "li"
    }

    view {
        col (class: "h-screen w-full flex-col bg-white text-zinc-900") {
            row (class: "h-9 shrink-0 items-center gap-2 border-b border-zinc-200 px-3") {
                text "component-gallery" { class: "text-xs font-semibold text-zinc-700" }
                button (text: "status_bar", variant: "text") {
                    onclick: .Select("status_bar")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "outline", variant: "text") {
                    onclick: .Select("outline")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "tab_strip", variant: "text") {
                    onclick: .Select("tab_strip")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "backlinks", variant: "text") {
                    onclick: .Select("backlinks")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "menubar", variant: "text") {
                    onclick: .Select("menubar")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "filetree", variant: "text") {
                    onclick: .Select("filetree")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "outgoing_links", variant: "text") {
                    onclick: .Select("outgoing_links")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "unlinked_references", variant: "text") {
                    onclick: .Select("unlinked_references")
                    class: "text-[11px] text-zinc-600"
                }
                text .unit { class: "ml-auto text-[11px] text-zinc-400" }
            }
            if .show_status_bar {
                col (class: "flex-col") {
                    StatusBarPage (status: .sb_status, root_path: .sb_root, bl: .sb_bl, ol: .sb_ol) {}
                    text .sb_marker { class: "px-3 pt-2 text-[11px] text-zinc-400" }
                }
            }
            if .show_outline {
                col (class: "flex-col p-3") {
                    col (class: "w-72 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Outline" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        if .ol_has {
                            dyn (.ul_tag) {
                                class: "space-y-0.5",
                                for h in .ol_rows {
                                    dyn (.li_tag) {
                                        key: h.content,
                                        class: "cursor-pointer truncate rounded px-1.5 py-0.5 text-xs text-zinc-800",
                                        title: h.content,
                                        text h.content
                                    }
                                }
                            }
                        }
                        text .ol_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_tab_strip {
                col (class: "flex-col p-3") {
                    row (class: "items-center gap-1 border-b border-zinc-200 px-2") {
                        for t in .ts_tabs {
                            button (text: t.title, variant: "text") {
                                onclick: .TsSwitch(t.path)
                                class: "rounded px-2 text-xs text-zinc-600"
                            }
                        }
                    }
                    text .ts_marker { class: "px-3 pt-2 text-[11px] text-zinc-400" }
                }
            }
            if .show_backlinks {
                col (class: "flex-col p-3") {
                    col (class: "w-72 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Backlinks" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        dyn (.ul_tag) {
                            class: "space-y-0.5",
                            for b in .bl_rows {
                                dyn (.li_tag) {
                                    key: b.source_path,
                                    class: "cursor-pointer truncate rounded px-1.5 py-0.5 text-xs text-zinc-800",
                                    title: b.context,
                                    text b.source_title
                                }
                            }
                        }
                        text .bl_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_menubar {
                col (class: "flex-col p-3") {
                    // 结构镜像（MenuBar.vue 渲染面 / desktop app.at L326-353
                    // 同款组件族）：菜单 web 子集（PLAN-071 裁定）+ toolbar
                    // 3 按钮（icon 在 VM 臂以文本 title 呈现）。VM=Popover
                    // lowering，内容态可见性归运行时，快照按树结构断言。
                    row (class: "items-center gap-2") {
                        menubar (class: "items-center") {
                            menubar-menu (value: "file") {
                                menubar-trigger "文件"
                                menubar-content {
                                    menubar-item (title: "打开工作区") {}
                                    menubar-item (title: "保存") {}
                                    menubar-item (title: "关闭标签") {}
                                }
                            }
                            menubar-menu (value: "view") {
                                menubar-trigger "查看"
                                menubar-content {
                                    menubar-item (title: "重载文件列表") {}
                                    menubar-item (title: "打开图谱") {}
                                }
                            }
                        }
                        row (class: "items-center gap-1 px-2 py-1") {
                            button (text: "保存", variant: "text") {
                                class: "h-7 w-7 px-0 py-0"
                            }
                            button (text: "关闭标签", variant: "text") {
                                class: "h-7 w-7 px-0 py-0"
                            }
                            button (text: "重载文件列表", variant: "text") {
                                class: "h-7 w-7 px-0 py-0"
                            }
                        }
                    }
                    text .mb_marker { class: "px-3 pt-2 text-[11px] text-zinc-400" }
                }
            }
            if .show_filetree {
                col (class: "flex-col p-3") {
                    col (class: "w-72 shrink-0 gap-1 border-r pr-2") {
                        text "Files" { class: "text-xs font-semibold uppercase tracking-wider text-muted-foreground" }
                        for r in .ft_rows {
                            row (class: "items-center") {
                                for g in r.guides {
                                    if g == "l" {
                                        div (class: "w-4 h-6 flex items-center justify-center") {
                                            div (class: "w-px h-6 bg-border") {}
                                        }
                                    }
                                    if g != "l" {
                                        div (class: "w-4 h-6") {}
                                    }
                                }
                                // chevron（desktop mouse-area 的 gate 可驱动
                                // 等价：label 钮双分支，文案 ▾/▸ 随开合翻转）
                                if r.has_kids {
                                    if .ft_open_dir == r.id {
                                        button (text: "▾", variant: "text") {
                                            onclick: .FtToggle(r.id)
                                            class: "w-5 h-5 px-0"
                                        }
                                    }
                                    if .ft_open_dir != r.id {
                                        button (text: "▸", variant: "text") {
                                            onclick: .FtToggle(r.id)
                                            class: "w-5 h-5 px-0"
                                        }
                                    }
                                }
                                if !r.has_kids {
                                    div (class: "w-5 shrink-0") {}
                                }
                                // icon（bps TreeIcon 无 dep 通道——pac.at 自包含
                                // 裁定——twin 以内置 icon 名替代：dir=folder /
                                // file=file-text；语义对齐 desktop r.icon）
                                if r.is_dir {
                                    icon (name: "folder", class: "w-4 h-4 text-muted-foreground") {}
                                }
                                if !r.is_dir {
                                    icon (name: "file-text", class: "w-4 h-4 text-muted-foreground") {}
                                }
                                if r.has_kids {
                                    button (text: r.label, variant: "text") {
                                        onclick: .FtToggle(r.id)
                                        class: "flex-1 px-1 text-left text-sm"
                                    }
                                }
                                if !r.has_kids {
                                    button (text: r.label, variant: "text") {
                                        onclick: .FtOpen(r.id)
                                        class: "flex-1 px-1 text-left text-sm"
                                    }
                                }
                            }
                            // 展开子行（flatten_tree 展开臂渲染语义：子行随
                            // open 出现，guides +1 层）
                            if .ft_open_dir == r.id {
                                row (class: "items-center") {
                                    div (class: "w-4 h-6 flex items-center justify-center") {
                                        div (class: "w-px h-6 bg-border") {}
                                    }
                                    button (text: "探针.ad", variant: "text") {
                                        onclick: .FtOpen("wiki/方法/探针.ad")
                                        class: "flex-1 px-1 text-left text-sm"
                                    }
                                }
                            }
                        }
                    }
                    text .ft_marker { class: "px-3 pt-2 text-[11px] text-zinc-400" }
                }
            }
            if .show_outgoing_links {
                col (class: "flex-col p-3") {
                    col (class: "w-72 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Outgoing links" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        if .olp_has {
                            dyn (.ul_tag) {
                                class: "space-y-0.5",
                                for o in .olp_rows {
                                    dyn (.li_tag) {
                                        key: o.target_title,
                                        class: "cursor-pointer truncate rounded px-1.5 py-0.5 text-xs text-zinc-800",
                                        text o.target_title
                                    }
                                }
                            }
                        }
                        text .olp_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_unlinked_references {
                col (class: "flex-col p-3") {
                    col (class: "w-72 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Unlinked References" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        if .ul_has {
                            dyn (.ul_tag) {
                                class: "space-y-1",
                                for r in .ul_rows {
                                    dyn (.li_tag) {
                                        key: r.page_path,
                                        class: "cursor-pointer rounded px-1.5 py-1 text-xs text-zinc-800",
                                        text r.page_path
                                        text r.context
                                    }
                                }
                            }
                        }
                        text .ul_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            .ol_rows.push({ content: "引言", pad: "0px" })
            .ol_rows.push({ content: "方法", pad: "12px" })
            .ol_rows.push({ content: "方法 > 探针", pad: "24px" })
            .ol_count = 3
            .ol_has = true
            .ts_tabs.push({ title: "引言", path: "wiki/引言.ad" })
            .ts_tabs.push({ title: "方法", path: "wiki/方法.ad" })
            .ts_active = "wiki/引言.ad"
            .bl_rows.push({ source_title: "另页", source_path: "wiki/另页.ad", context: "链接到 fixture 页" })
            .bl_count = 1
            .mb_menus = 2
            .mb_actions = 5
            .mb_toolbar = 3
            .ft_rows.push({ label: "引言.ad", guides: [], has_kids: false, open: false, is_dir: false, id: "wiki/引言.ad" })
            .ft_rows.push({ label: "方法", guides: [], has_kids: true, open: false, is_dir: true, id: "wiki/方法" })
            .ft_rows.push({ label: "另页.ad", guides: [], has_kids: false, open: false, is_dir: false, id: "wiki/另页.ad" })
            .ft_count = 3
        }

        .Select(u) -> {
            .unit = u
        }

        .TsSwitch(path) -> {
            .ts_active = path
        }

        .FtToggle(id) -> {
            // 先算布尔再双分支（desktop .CloseTab was_dirty 同款）——两个
            // 条件 if 顺序执行，第一个分支改状态后第二个不得再进。
            var will_open = .ft_open_dir != id
            if will_open {
                .ft_open_dir = id
                .ft_count = 4
            .olp_rows.push({ target_title: "方法", target_path: "wiki/方法.ad", exists: true })
            .olp_rows.push({ target_title: "缺失页", target_path: "", exists: false })
            .olp_count = 2
            .olp_exists = 1
            .olp_has = true
            .ul_rows.push({ page_path: "wiki/另页.ad", context: "这一段提到 引言 的概念但从未写成链接" })
            .ul_count = 1
            .ul_has = true
            }
            if !will_open {
                .ft_open_dir = ""
                .ft_count = 3
            }
        }

        .FtOpen(id) -> {
            .ft_sel = id
        }
    }
}
