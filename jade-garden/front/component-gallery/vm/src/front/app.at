                    onclick: .Select("quick_switcher")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "search_panel", variant: "text") {
                    onclick: .Select("search_panel")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "command_palette", variant: "text") {
                    onclick: .Select("command_palette")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "create_page_prompt", variant: "text") {
                    onclick: .Select("create_page_prompt")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "theme_popover", variant: "text") {
                    onclick: .Select("theme_popover")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "recent_files", variant: "text") {
                    onclick: .Select("recent_files")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "agenda", variant: "text") {
                    onclick: .Select("agenda")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "flashcard_modal", variant: "text") {
                    onclick: .Select("flashcard_modal")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "workspace_opener", variant: "text") {
                    onclick: .Select("workspace_opener")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "properties_panel", variant: "text") {
                    onclick: .Select("properties_panel")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "graph_sidebar", variant: "text") {
                    onclick: .Select("graph_sidebar")
                    class: "text-[11px] text-zinc-600"
                }
                button (text: "graph_controls", variant: "text") {
                    onclick: .Select("graph_controls")
                    class: "text-[11px] text-zinc-600"
                }
                text .unit { class: "ml-auto text-[11px] text-zinc-400" }
            }
            if .show_status_bar {
                col (class: "flex-col") {
                    StatusBarPage (status: .sb_status, root_path: .sb_root, bl: .sb_bl, ol: .sb_ol) {}
                    text .sb_marker { class: "px-3 pt-2 text-[11px] text-zinc-400" }
                }
            }
            if .show_outline {
                col (class: "flex-col p-3") {
                    col (class: "w-72 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Outline" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        if .ol_has {
                            dyn (.ul_tag) {
                                class: "space-y-0.5",
                                for h in .ol_rows {
                                    dyn (.li_tag) {
                                        key: h.content,
                                        class: "cursor-pointer truncate rounded px-1.5 py-0.5 text-xs text-zinc-800",
                                        title: h.content,
                                        text h.content
                                    }
                                }
                            }
                        }
                        text .ol_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_tab_strip {
                col (class: "flex-col p-3") {
                    row (class: "items-center gap-1 border-b border-zinc-200 px-2") {
                        for t in .ts_tabs {
                            button (text: t.title, variant: "text") {
                                onclick: .TsSwitch(t.path)
                                class: "rounded px-2 text-xs text-zinc-600"
                            }
                        }
                    }
                    text .ts_marker { class: "px-3 pt-2 text-[11px] text-zinc-400" }
                }
            }
            if .show_backlinks {
                col (class: "flex-col p-3") {
                    col (class: "w-72 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Backlinks" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        dyn (.ul_tag) {
                            class: "space-y-0.5",
                            for b in .bl_rows {
                                dyn (.li_tag) {
                                    key: b.source_path,
                                    class: "cursor-pointer truncate rounded px-1.5 py-0.5 text-xs text-zinc-800",
                                    title: b.context,
                                    text b.source_title
                                }
                            }
                        }
                        text .bl_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_menubar {
                col (class: "flex-col p-3") {
                    // 结构镜像（MenuBar.vue 渲染面 / desktop app.at L326-353
                    // 同款组件族）：菜单 web 子集（PLAN-071 裁定）+ toolbar
                    // 3 按钮（icon 在 VM 臂以文本 title 呈现）。VM=Popover
                    // lowering，内容态可见性归运行时，快照按树结构断言。
                    row (class: "items-center gap-2") {
                        menubar (class: "items-center") {
                            menubar-menu (value: "file") {
                                menubar-trigger "文件"
                                menubar-content {
                                    menubar-item (title: "打开工作区") {}
                                    menubar-item (title: "保存") {}
                                    menubar-item (title: "关闭标签") {}
                                }
                            }
                            menubar-menu (value: "view") {
                                menubar-trigger "查看"
                                menubar-content {
                                    menubar-item (title: "重载文件列表") {}
                                    menubar-item (title: "打开图谱") {}
                                }
                            }
                        }
                        row (class: "items-center gap-1 px-2 py-1") {
                            button (text: "保存", variant: "text") {
                                class: "h-7 w-7 px-0 py-0"
                            }
                            button (text: "关闭标签", variant: "text") {
                                class: "h-7 w-7 px-0 py-0"
                            }
                            button (text: "重载文件列表", variant: "text") {
                                class: "h-7 w-7 px-0 py-0"
                            }
                        }
                    }
                    text .mb_marker { class: "px-3 pt-2 text-[11px] text-zinc-400" }
                }
            }
            if .show_filetree {
                col (class: "flex-col p-3") {
                    col (class: "w-72 shrink-0 gap-1 border-r pr-2") {
                        text "Files" { class: "text-xs font-semibold uppercase tracking-wider text-muted-foreground" }
                        for r in .ft_rows {
                            row (class: "items-center") {
                                for g in r.guides {
                                    if g == "l" {
                                        div (class: "w-4 h-6 flex items-center justify-center") {
                                            div (class: "w-px h-6 bg-border") {}
                                        }
                                    }
                                    if g != "l" {
                                        div (class: "w-4 h-6") {}
                                    }
                                }
                                // chevron（desktop mouse-area 的 gate 可驱动
                                // 等价：label 钮双分支，文案 ▾/▸ 随开合翻转）
                                if r.has_kids {
                                    if .ft_open_dir == r.id {
                                        button (text: "▾", variant: "text") {
                                            onclick: .FtToggle(r.id)
                                            class: "w-5 h-5 px-0"
                                        }
                                    }
                                    if .ft_open_dir != r.id {
                                        button (text: "▸", variant: "text") {
                                            onclick: .FtToggle(r.id)
                                            class: "w-5 h-5 px-0"
                                        }
                                    }
                                }
                                if !r.has_kids {
                                    div (class: "w-5 shrink-0") {}
                                }
                                // icon（bps TreeIcon 无 dep 通道——pac.at 自包含
                                // 裁定——twin 以内置 icon 名替代：dir=folder /
                                // file=file-text；语义对齐 desktop r.icon）
                                if r.is_dir {
                                    icon (name: "folder", class: "w-4 h-4 text-muted-foreground") {}
                                }
                                if !r.is_dir {
                                    icon (name: "file-text", class: "w-4 h-4 text-muted-foreground") {}
                                }
                                if r.has_kids {
                                    button (text: r.label, variant: "text") {
                                        onclick: .FtToggle(r.id)
                                        class: "flex-1 px-1 text-left text-sm"
                                    }
                                }
                                if !r.has_kids {
                                    button (text: r.label, variant: "text") {
                                        onclick: .FtOpen(r.id)
                                        class: "flex-1 px-1 text-left text-sm"
                                    }
                                }
                            }
                            // 展开子行（flatten_tree 展开臂渲染语义：子行随
                            // open 出现，guides +1 层）
                            if .ft_open_dir == r.id {
                                row (class: "items-center") {
                                    div (class: "w-4 h-6 flex items-center justify-center") {
                                        div (class: "w-px h-6 bg-border") {}
                                    }
                                    button (text: "探针.ad", variant: "text") {
                                        onclick: .FtOpen("wiki/方法/探针.ad")
                                        class: "flex-1 px-1 text-left text-sm"
                                    }
                                }
                            }
                        }
                    }
                    text .ft_marker { class: "px-3 pt-2 text-[11px] text-zinc-400" }
                }
            }
            if .show_outgoing_links {
                col (class: "flex-col p-3") {
                    col (class: "w-72 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Outgoing links" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        if .olp_has {
                            dyn (.ul_tag) {
                                class: "space-y-0.5",
                                for o in .olp_rows {
                                    dyn (.li_tag) {
                                        key: o.target_title,
                                        class: "cursor-pointer truncate rounded px-1.5 py-0.5 text-xs text-zinc-800",
                                        text o.target_title
                                    }
                                }
                            }
                        }
                        text .olp_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_unlinked_references {
                col (class: "flex-col p-3") {
                    col (class: "w-72 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Unlinked References" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        if .ul_has {
                            dyn (.ul_tag) {
                                class: "space-y-1",
                                for r in .ul_rows {
                                    dyn (.li_tag) {
                                        key: r.page_path,
                                        class: "cursor-pointer rounded px-1.5 py-1 text-xs text-zinc-800",
                                        text r.page_path
                                        text r.context
                                    }
                                }
                            }
                        }
                        text .ul_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_quick_switcher {
                col (class: "flex-col p-3") {
                    col (class: "w-80 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Quick Switcher" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        // 查询输入面（twin 只投影 CJK 查询 "引"；键盘/焦点
                        // = window 级 DOM 必留 ext 域，不镜像）
                        row (class: "items-center gap-2 border-b border-zinc-200 px-2 pb-2") {
                            text "引" { class: "text-sm text-zinc-700" }
                            text "Ctrl+O" { class: "text-[10px] text-zinc-400" }
                        }
                        if .qs_has {
                            dyn (.ul_tag) {
                                class: "space-y-0.5",
                                for f in .qs_rows {
                                    dyn (.li_tag) {
                                        key: f.path,
                                        class: f.idx == .qs_selected ? "cursor-pointer rounded px-1.5 py-1 text-xs bg-accent text-zinc-900" : "cursor-pointer rounded px-1.5 py-1 text-xs text-zinc-800",
                                        text f.name
                                        text f.path
                                    }
                                }
                            }
                        }
                        row (class: "gap-1 pt-2") {
                            button (text: "qs_next", variant: "text") {
                                onclick: .QsNext
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                            button (text: "qs_prev", variant: "text") {
                                onclick: .QsPrev
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                        }
                        text .qs_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_search_panel {
                col (class: "flex-col p-3") {
                    col (class: "w-80 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Search" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        // 查询输入面投影（vue 臂 fill 门同款查询"引言"）
                        row (class: "items-center gap-2 rounded-md border border-zinc-200 bg-white px-2 py-1.5") {
                            text "引言" { class: "flex-1 text-sm text-zinc-700" }
                        }
                        if .sp_has {
                            dyn (.ul_tag) {
                                class: "space-y-1",
                                for r in .sp_rows {
                                    dyn (.li_tag) {
                                        key: r.title_text,
                                        class: "cursor-pointer rounded px-2 py-1.5 text-xs text-zinc-800",
                                        text r.title_text
                                        if r.has_snippet {
                                            text r.snippet_plain
                                        }
                                    }
                                }
                            }
                        }
                        text .sp_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_command_palette {
                col (class: "flex-col p-3") {
                    col (class: "w-96 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Command Palette" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        // 查询输入面投影（vue 臂 fill 门同款查询"引言"域）
                        row (class: "items-center gap-2 border-b border-zinc-200 px-2 pb-2") {
                            text "⌘/Ctrl+P" { class: "text-[10px] text-zinc-400" }
                            text "引" { class: "flex-1 text-sm text-zinc-700" }
                        }
                        if .cp_has {
                            dyn (.ul_tag) {
                                class: "space-y-0.5",
                                for r in .cp_rows {
                                    dyn (.li_tag) {
                                        key: r.idx,
                                        class: r.idx == .cp_selected ? "cursor-pointer rounded px-2 py-1 text-xs bg-accent text-zinc-900" : "cursor-pointer rounded px-2 py-1 text-xs text-zinc-800",
                                        text r.title
                                        text r.subtitle
                                    }
                                }
                            }
                        }
                        row (class: "gap-1 pt-2") {
                            button (text: "cp_next", variant: "text") {
                                onclick: .CpNext
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                            button (text: "cp_prev", variant: "text") {
                                onclick: .CpPrev
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                        }
                        text .cp_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_create_page_prompt {
                col (class: "flex-col p-3") {
                    col (class: "w-96 rounded-lg border border-zinc-200 bg-zinc-50 p-3") {
                        text "Create missing page?" { class: "text-sm font-semibold text-zinc-800" }
                        row (class: "items-center gap-1 pt-2") {
                            text f"[[${.cpp_title}]]" { class: "text-xs text-zinc-600" }
                            text "does not exist yet." { class: "text-xs text-zinc-500" }
                        }
                        row (class: "items-center gap-1 pt-1") {
                            text "Will be created as" { class: "text-xs text-zinc-500" }
                            text .cpp_path { class: "rounded bg-zinc-200 px-1 py-0.5 text-xs text-zinc-800" }
                        }
                        row (class: "justify-end gap-1 pt-2") {
                            button (text: "Cancel", variant: "text") {
                                onclick: .CppCancel
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-xs text-zinc-600"
                            }
                            button (text: "Create", variant: "text") {
                                onclick: .CppCreate
                                class: "rounded border border-zinc-300 bg-zinc-800 px-2 py-0.5 text-xs text-white"
                            }
                        }
                        text .cpp_marker { class: "pt-2 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_theme_popover {
                col (class: "flex-col p-3") {
                    col (class: "w-56 rounded-xl border border-zinc-200 bg-zinc-50 p-3") {
                        text "Appearance" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        row (class: "items-center gap-1") {
                            button (text: "SetLight", variant: "text") {
                                onclick: .TpSetLight
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                            button (text: "SetDark", variant: "text") {
                                onclick: .TpSetDark
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                        }
                        text "Accent" { class: "mb-1 mt-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        if .tp_has {
                            dyn (.ul_tag) {
                                class: "grid grid-cols-1 gap-1",
                                for a in .tp_accents {
                                    dyn (.li_tag) {
                                        key: a.key,
                                        class: "flex items-center gap-1 text-xs text-zinc-700",
                                        text a.label
                                        text a.color
                                    }
                                }
                            }
                        }
                        text .tp_marker { class: "pt-2 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_recent_files {
                col (class: "flex-col p-3") {
                    col (class: "w-80 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Recent" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        if .rf_has {
                            dyn (.ul_tag) {
                                class: "space-y-0.5",
                                for rf in .rf_rows {
                                    dyn (.li_tag) {
                                        key: rf.path,
                                        class: "cursor-pointer rounded px-2 py-1.5 text-xs text-zinc-800",
                                        text rf.title
                                        text rf.path
                                        text rf.time
                                    }
                                }
                            }
                        }
                        row (class: "gap-1 pt-2") {
                            button (text: "rf_remove", variant: "text") {
                                onclick: .RfRemove
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                            button (text: "rf_clear", variant: "text") {
                                onclick: .RfClear
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                        }
                        text .rf_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_agenda {
                col (class: "flex-col p-3") {
                    col (class: "w-80 rounded-md border border-zinc-200 bg-zinc-50 p-2") {
                        text "Agenda" { class: "mb-2 text-xs font-semibold uppercase tracking-wider text-zinc-500" }
                        if .ag_has {
                            for g in .ag_groups {
                                col (class: "flex-col gap-1 pb-2") {
                                    text g.date { class: "text-[11px] font-medium text-zinc-500" }
                                    dyn (.ul_tag) {
                                        class: "space-y-1",
                                        for tk in g.tasks {
                                            dyn (.li_tag) {
                                                key: tk.page_path,
                                                class: "cursor-pointer rounded px-2 py-1 text-xs text-zinc-800",
                                                text tk.marker
                                                text f"[#${tk.priority}]"
                                                text tk.content
                                                text tk.line
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        text .ag_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_flashcard_modal {
                col (class: "flex-col p-3") {
                    col (class: "w-96 rounded-lg border border-zinc-200 bg-zinc-50 p-3") {
                        row (class: "items-center gap-2 border-b border-zinc-200 pb-2") {
                            text "Flashcards" { class: "text-sm font-semibold text-zinc-800" }
                            text .fm_counter { class: "ml-auto text-xs text-zinc-500" }
                        }
                        col (class: "flex-col pt-2") {
                            text .fm_question { class: "text-sm text-zinc-800" }
                            if .fm_show_answer {
                                text .fm_answer { class: "pt-1 text-sm text-emerald-700" }
                            }
                        }
                        row (class: "gap-1 pt-2") {
                            button (text: "fm_reveal", variant: "text") {
                                onclick: .FmReveal
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                            button (text: "fm_rate", variant: "text") {
                                onclick: .FmRate
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                        }
                        text .fm_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_workspace_opener {
                col (class: "flex-col p-3") {
                    col (class: "w-96 items-center rounded-xl border border-zinc-200 bg-zinc-50 p-4") {
                        text "Jade Garden" { class: "text-lg font-bold text-zinc-800" }
                        // path 输入投影 + Open 流（picker 按钮 = window 级
                        // DOM，不进 twin 断言域——Q-1/F-1）
                        row (class: "items-center gap-1 pt-2") {
                            text .wo_path { class: "flex-1 rounded border border-zinc-200 bg-white px-2 py-1 text-xs text-zinc-700" }
                            button (text: "Open", variant: "text") {
                                onclick: .WoOpen
                                class: "rounded bg-zinc-800 px-2 py-0.5 text-xs text-white"
                            }
                        }
                        if .wo_error != "" {
                            text .wo_error { class: "pt-1 text-xs text-red-600" }
                        }
                        text .wo_root { class: "pt-1 text-xs text-zinc-500" }
                        text .wo_marker { class: "pt-2 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_properties_panel {
                col (class: "flex-col p-3") {
                    col (class: "w-80 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Properties" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        if .pp_has {
                            dyn (.ul_tag) {
                                class: "space-y-1",
                                for r in .pp_rows {
                                    dyn (.li_tag) {
                                        key: r.key,
                                        class: "flex items-center gap-1 text-xs text-zinc-800",
                                        text r.key
                                        text r.type
                                    }
                                }
                            }
                        }
                        text .pp_bool_label { class: "pt-1 text-xs text-emerald-700" }
                        row (class: "gap-1 pt-2") {
                            button (text: "pp_toggle", variant: "text") {
                                onclick: .PpToggle
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                            button (text: "pp_add", variant: "text") {
                                onclick: .PpAdd
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                        }
                        text .pp_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_graph_sidebar {
                col (class: "flex-col p-3") {
                    col (class: "w-80 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "图谱" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        row (class: "grid grid-cols-2 gap-2 text-xs") {
                            text .gs_stat_total { class: "rounded border border-zinc-200 bg-white p-1.5 text-zinc-800" }
                            text .gs_stat_edges { class: "rounded border border-zinc-200 bg-white p-1.5 text-zinc-800" }
                            text .gs_stat_missing { class: "rounded border border-zinc-200 bg-white p-1.5 text-zinc-800" }
                            text .gs_stat_orphan { class: "rounded border border-zinc-200 bg-white p-1.5 text-zinc-800" }
                        }
                        text "连接最多的页面" { class: "pt-3 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        if .gs_has {
                            dyn (.ul_tag) {
                                class: "space-y-1",
                                for r in .gs_rows {
                                    dyn (.li_tag) {
                                        key: r.id,
                                        class: "cursor-pointer truncate rounded px-2 py-1 text-xs text-zinc-800",
                                        title: r.display,
                                        text r.display
                                    }
                                }
                            }
                        }
                        button (text: "gs_open_引言", variant: "text") {
                            onclick: .GsbOpen("wiki/引言.ad")
                            class: "mt-2 w-fit rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                        }
                        text .gs_opened { class: "pt-1 text-[10px] text-emerald-700" }
                        text .gs_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_graph_controls {
                col (class: "flex-col p-3") {
                    col (class: "w-80 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "图谱设置" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        text .gcc_center { class: "text-xs text-zinc-800" }
                        text .gcc_opacity { class: "text-xs text-zinc-800" }
                        row (class: "items-center gap-2") {
                            checkbox { checked: .gcc_flag, label: "showOrphans", onclick: .GccToggleFlag }
                            text .gcc_flag_label { class: "text-xs text-zinc-600" }
                        }
                        button (text: "gc_reset", variant: "text") {
                            onclick: .GccReset
                            class: "mt-2 w-fit rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                        }
                        text .gcc_marker_line { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            .ol_rows.push({ content: "引言", pad: "0px" })
            .ol_rows.push({ content: "方法", pad: "12px" })
            .ol_rows.push({ content: "方法 > 探针", pad: "24px" })
            .ol_count = 3
            .ol_has = true
            .ts_tabs.push({ title: "引言", path: "wiki/引言.ad" })
            .ts_tabs.push({ title: "方法", path: "wiki/方法.ad" })
            .ts_active = "wiki/引言.ad"
            .bl_rows.push({ source_title: "另页", source_path: "wiki/另页.ad", context: "链接到 fixture 页" })
            .bl_count = 1
            .mb_menus = 2
            .mb_actions = 5
            .mb_toolbar = 3
            .ft_rows.push({ label: "引言.ad", guides: [], has_kids: false, open: false, is_dir: false, id: "wiki/引言.ad" })
            .ft_rows.push({ label: "方法", guides: [], has_kids: true, open: false, is_dir: true, id: "wiki/方法" })
            .ft_rows.push({ label: "另页.ad", guides: [], has_kids: false, open: false, is_dir: false, id: "wiki/另页.ad" })
            .ft_count = 3
            .olp_rows.push({ target_title: "方法", target_path: "wiki/方法.ad", exists: true })
            .olp_rows.push({ target_title: "缺失页", target_path: "", exists: false })
            .olp_count = 2
            .olp_exists = 1
            .olp_has = true
            .ul_rows.push({ page_path: "wiki/另页.ad", context: "这一段提到 引言 的概念但从未写成链接" })
            .ul_count = 1
            .ul_has = true
            // quick_switcher：对 fixture 树真跑下沉同形 fn（qs_collect 递归
            // walk → qs_filter CJK 查询 "引"——P-7/P-8 VM 侧实证面）
            var qs_tree = [
                { is_dir: true, name: "wiki", children: [
                    { is_dir: false, name: "引言.ad", children: [] },
                    { is_dir: true, name: "方法", children: [
                        { is_dir: false, name: "引子.ad", children: [] },
                        { is_dir: false, name: "探针.ad", children: [] },
                    ] },
                ] },
                { is_dir: false, name: "另页.ad", children: [] },
            ]
            var qs_files = qs_collect(qs_tree, [])
            .qs_rows = qs_filter(qs_files, "引")
            .qs_count = .qs_rows.len()
            .qs_selected = 0
            if .qs_count > 0 {
                .qs_has = true
            }
            // search_panel：Init 播种行投影（vue 臂 shim 应答同构；Page 行
            // has_snippet=true + 纯文本摘要，Block 行 title_text=page_path）
            .sp_rows.push({ title_text: "引言", has_snippet: true, snippet_plain: "正文提到 引言 的概念，见首章" })
            .sp_rows.push({ title_text: "wiki/方法.ad", has_snippet: false, snippet_plain: "" })
            .sp_count = 2
            .sp_has = true
            // command_palette：command×9（英文，与 buildCommands 面同构的
            // title 域）+ recent×2（CJK）混合 fixture，cp_filter 真跑 "引"
            var cp_items = [
                { type: "command", title: "Open today's note", subtitle: "Create or open the daily journal entry" },
                { type: "command", title: "Open global graph", subtitle: "Show the workspace graph view" },
                { type: "command", title: "Toggle theme", subtitle: "Current: light" },
                { type: "command", title: "Toggle left sidebar", subtitle: "Show" },
                { type: "command", title: "Toggle right sidebar", subtitle: "Hide" },
                { type: "command", title: "Open file search", subtitle: "Quick switcher (Ctrl+O)" },
                { type: "command", title: "Review flashcards", subtitle: "SRS due cards" },
                { type: "command", title: "Export Markdown", subtitle: "Download workspace as zip of .md files" },
                { type: "command", title: "Import Markdown", subtitle: "Upload a zip of .md files" },
                { type: "file", title: "引言", subtitle: "wiki/引言.ad" },
                { type: "file", title: "引子", subtitle: "wiki/方法/引子.ad" },
            ]
            .cp_rows = cp_filter(cp_items, "引")
            .cp_count = .cp_rows.len()
            .cp_selected = 0
            if .cp_count > 0 {
                .cp_has = true
            }
            // create_page_prompt：cpp_path derived 值播种（wikiTitleToPath
            // "引言" → "引言.ad"——regex 桥 TS 域，twin 播种等价投影）
            .cpp_title = "引言"
            .cpp_path = "引言.ad"
            .cpp_choice = ""
            // theme_popover：字面量列表真跑（Q-4 实证面）
            .tp_accents = tp_theme_accents()
            .tp_count = .tp_accents.len()
            if .tp_count > 0 {
                .tp_has = true
            }
            // recent_files：播种两行（time raw——formatTime 桥 TS 域）
            .rf_rows.push({ path: "wiki/引言.ad", title: "引言", time: "09:41" })
            .rf_rows.push({ path: "wiki/另页.ad", title: "另页", time: "08:15" })
            .rf_count = .rf_rows.len()
            if .rf_count > 0 {
                .rf_has = true
            }
            // agenda：fixture 组经 ag_display_probe 真跑（行构造 + marker
            // 旗标 + title 守卫同形），任务总数投影
            var ag_fixture = [
                { date: "2026-09-19", tasks: [
                    { page_path: "wiki/引言.ad", title: "", marker: "TODO", priority: null, content: "写引言草稿" },
                    { page_path: "wiki/方法.ad", title: "小节题", marker: "DONE", priority: "2", content: "方法验证" },
                ] },
                { date: "2026-09-20", tasks: [
                    { page_path: "wiki/另页.ad", title: "", marker: "DOING", priority: null, content: "另页任务" },
                ] },
            ]
            .ag_groups = ag_display_probe(ag_fixture)
            .ag_count = 0
            for gg in .ag_groups {
                .ag_count = .ag_count + gg.tasks.len()
            }
            if .ag_count > 0 {
                .ag_has = true
            }
            // flashcard_modal：播种两卡（第二卡 q/a 空串——raw 回落同构），
            // counter/question 经 fm_card_at 走查投影（.Init 语义 =
            // onMounted load 成功臂）
            .fm_cards.push({ page_path: "wiki/引言.ad", block_id: "blk-1", raw: "引言原始文本", question: "写引言草稿", answer: "引言已成稿" })
            .fm_cards.push({ page_path: "wiki/方法.ad", block_id: "blk-2", raw: "方法原始文本", question: "", answer: "" })
            .fm_index = 0
            .fm_show_answer = false
            var c0 = fm_card_at(.fm_cards, .fm_index)
            if c0 != null {
                if c0.question != null && c0.question != "" {
                    .fm_question = c0.question
                }
                if c0.question == null || c0.question == "" {
                    .fm_question = c0.raw
                }
            }
            .fm_counter = f"${.fm_index + 1} / ${.fm_cards.len()}"
            // workspace_opener：path 播种 + 预置 error（清位臂验证面）
            .wo_path = "D:/tmp/wiki-demo"
            .wo_busy = false
            .wo_error = "boom"
            .wo_root = ""
            // properties_panel：行以派定型 fixture 播种（inferType 分派
            // 已定——TS 域不入 twin），布尔行翻转/增行由按钮驱动
            .pp_rows.push({ key: "title", value: "引言", type: "text" })
            .pp_rows.push({ key: "published", value: true, type: "boolean" })
            .pp_rows.push({ key: "tags", value: "a, b", type: "list" })
            .pp_count = .pp_rows.len()
            if .pp_count > 0 {
                .pp_has = true
            }
            // graph_sidebar：四节点三边播种 → gs_graph_stats/gs_top_degree
            // 真跑（下沉同形 derived 副本——T-00 探针①⑤同形 VM 面）；
            // 空 label 节点 b 走 display 回落 id（`label || id` 显式 if 面）
            .gsb_nodes = [
                { id: "a", label: "引言", path: "wiki/引言.ad", exists: true, degree: 3 },
                { id: "b", label: "", path: "wiki/方法.ad", exists: true, degree: 1 },
                { id: "c", label: "缺失页", path: "", exists: false, degree: 2 },
                { id: "d", label: "孤儿页", path: "wiki/孤儿.ad", exists: true, degree: 0 },
            ]
            .gsb_edges = [
                { source: "a", target: "b" },
                { source: "a", target: "c" },
                { source: "c", target: "b" },
            ]
            var gs_st = gs_graph_stats(.gsb_nodes, .gsb_edges)
            .gs_total = gs_st.total
            .gs_missing = gs_st.missing
            .gs_orphan = gs_st.orphan
            .gs_edges = gs_st.edges
            .gs_rows = gs_top_degree(.gsb_nodes)
            .gs_count = .gs_rows.len()
            for r in .gs_rows {
                if r.id == "b" {
                    .gs_id_fallback = f"${r.display}"
                }
            }
            if .gs_count > 0 {
                .gs_has = true
            }
            // graph_controls：ASCII 中心路径剥除（G-2——CJK 臂不镜像）+
            // opacity 40% 偏离默认（重置可断言）
            .gcc_center = gc_center_label("wiki/Intro.ad")
            .gcc_opacity = gc_opacity_label(0.4)
        }

        .Select(u) -> {
            .unit = u
        }

        // graph_sidebar 行 click 形状镜像（OpenNode → tabs.open：twin 以
        // gs_opened 投影承载——无 tabs store，F-1 口径）
        .GsbOpen(path) -> {
            .gs_opened = path
        }

        // graph_controls 重置形状镜像（gc_reset_settings：默认值回置 +
        // showOrphans→true 旗标翻转；opacity 40%→85%）
        .GccReset -> {
            .gcc_opacity = gc_opacity_label(0.85)
            .gcc_flag = true
            .gcc_flag_label = "true"
            .gcc_resets = .gcc_resets + 1
        }

        .GccToggleFlag -> {
            .gcc_flag = !.gcc_flag
            if .gcc_flag {
                .gcc_flag_label = "true"
            }
            if !.gcc_flag {
                .gcc_flag_label = "false"
            }
        }

        .TsSwitch(path) -> {
            .ts_active = path
        }

        .FtToggle(id) -> {
            // 先算布尔再双分支（desktop .CloseTab was_dirty 同款）——两个
            // 条件 if 顺序执行，第一个分支改状态后第二个不得再进。
            var will_open = .ft_open_dir != id
            if will_open {
                .ft_open_dir = id
                .ft_count = 4
            }
            if !will_open {
                .ft_open_dir = ""
                .ft_count = 3
            }
        }

        .FtOpen(id) -> {
            .ft_sel = id
        }

        .QsNext -> {
            // 与下沉 fn next_index 同形的环绕模运算（quick_switcher.at）
            .qs_selected = (.qs_selected + 1) % .qs_count
        }

        .QsPrev -> {
            .qs_selected = (.qs_selected - 1 + .qs_count) % .qs_count
        }

        .CpNext -> {
            // 与下沉 fn next_index 同形的环绕模运算（command_palette.at）
            .cp_selected = (.cp_selected + 1) % .cp_count
        }

        .CpPrev -> {
            .cp_selected = (.cp_selected - 1 + .cp_count) % .cp_count
        }

        .CppCreate -> {
            .cpp_choice = "create"
        }

        .CppCancel -> {
            .cpp_choice = "cancel"
        }

        .TpSetLight -> {
            .tp_mode = "light"
        }

        .TpSetDark -> {
            .tp_mode = "dark"
        }

        .RfRemove -> {
            // 重建去首行（避 .remove → .splice 误射域，074 removeRecent
            // 注记同款）
            var rest List = []
            var i = 0
            for r in .rf_rows {
                if i > 0 {
                    rest.push(r)
                }
                i = i + 1
            }
            .rf_rows = rest
            .rf_count = .rf_rows.len()
        }

        .RfClear -> {
            .rf_rows = []
            .rf_count = 0
        }

        .FmReveal -> {
            // 下沉 .Reveal 直写（show_answer = true）
            .fm_show_answer = true
            var c = fm_card_at(.fm_cards, .fm_index)
            if c != null {
                if c.answer != null && c.answer != "" {
                    .fm_answer = c.answer
                }
                if c.answer == null || c.answer == "" {
                    .fm_answer = c.raw
                }
            }
        }

        .FmRate -> {
            // 下沉 .Rate 成功臂形状（契约调用面归 vue 臂 shim，twin 不
            // 镜像——F-1）：index 前移 + 隐藏答案 + exhaustion 重载形状
            // （末卡后 index 归零 + 第二卡 raw 投影 = 重载面等价投影）
            .fm_index = .fm_index + 1
            .fm_show_answer = false
            .fm_counter = f"${.fm_index + 1} / ${.fm_cards.len()}"
            var c = fm_card_at(.fm_cards, .fm_index)
            if c != null {
                if c.question != null && c.question != "" {
                    .fm_question = c.question
                }
                if c.question == null || c.question == "" {
                    .fm_question = c.raw
                }
            }
            if c == null {
                .fm_index = 0
                .fm_counter = f"${.fm_index + 1} / ${.fm_cards.len()}"
                .fm_question = "(reloaded) 写引言草稿"
            }
        }

        .WoOpen -> {
            // 下沉 .Open 编排形状（契约调用面归 vue 臂 shim——twin 以
            // 同步应答播种流完成态）：busy 置位 → error 清位 → root 投影
            // → busy 复位（.finally 臂）
            var p = .wo_path.trim()
            if p != "" {
                .wo_busy = true
                .wo_error = ""
                .wo_root = p
                .wo_busy = false
            }
        }

        .PpToggle -> {
            // 下沉 .ToggleBool 直写臂形状（entry.value = !entry.value →
            // bool_label 翻转投影）
            .pp_bool_val = !.pp_bool_val
            if .pp_bool_val == true {
                .pp_bool_label = "true"
            }
            if .pp_bool_val != true {
                .pp_bool_label = "false"
            }
        }

        .PpAdd -> {
            // 下沉 .AddProperty/try_add_property 成功臂形状（push + 计数）
            .pp_rows.push({ key: "extra", value: "", type: "text" })
            .pp_count = .pp_rows.len()
        }
    }
}
