        var qs_has bool = false
        // —— fixture：search_panel 面（PLAN-076 T-02 twin：Init 播种行
        // 投影——vue 臂 shim 应答同构两行：Page 行 title_text=引言 带
        // snippet、Block 行 title_text=page_path 无 snippet；snippet 高亮
        // html 属 vue 显示面（regex ext 桥），twin 以 has_snippet 投影）——
