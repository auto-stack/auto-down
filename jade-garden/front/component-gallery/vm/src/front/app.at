                            button (text: "保存", variant: "text") {
                                class: "h-7 w-7 px-0 py-0"
                            }
                            button (text: "关闭标签", variant: "text") {
                                class: "h-7 w-7 px-0 py-0"
                            }
                            button (text: "重载文件列表", variant: "text") {
                                class: "h-7 w-7 px-0 py-0"
                            }
                        }
                    }
                    text .mb_marker { class: "px-3 pt-2 text-[11px] text-zinc-400" }
                }
            }
            if .show_filetree {
                col (class: "flex-col p-3") {
                    col (class: "w-72 shrink-0 gap-1 border-r pr-2") {
                        text "Files" { class: "text-xs font-semibold uppercase tracking-wider text-muted-foreground" }
                        for r in .ft_rows {
                            row (class: "items-center") {
                                for g in r.guides {
                                    if g == "l" {
                                        div (class: "w-4 h-6 flex items-center justify-center") {
                                            div (class: "w-px h-6 bg-border") {}
                                        }
                                    }
                                    if g != "l" {
                                        div (class: "w-4 h-6") {}
                                    }
                                }
                                // chevron（desktop mouse-area 的 gate 可驱动
                                // 等价：label 钮双分支，文案 ▾/▸ 随开合翻转）
                                if r.has_kids {
                                    if .ft_open_dir == r.id {
                                        button (text: "▾", variant: "text") {
                                            onclick: .FtToggle(r.id)
                                            class: "w-5 h-5 px-0"
                                        }
                                    }
                                    if .ft_open_dir != r.id {
                                        button (text: "▸", variant: "text") {
                                            onclick: .FtToggle(r.id)
                                            class: "w-5 h-5 px-0"
                                        }
                                    }
                                }
                                if !r.has_kids {
                                    div (class: "w-5 shrink-0") {}
                                }
                                // icon（bps TreeIcon 无 dep 通道——pac.at 自包含
                                // 裁定——twin 以内置 icon 名替代：dir=folder /
                                // file=file-text；语义对齐 desktop r.icon）
                                if r.is_dir {
                                    icon (name: "folder", class: "w-4 h-4 text-muted-foreground") {}
                                }
                                if !r.is_dir {
                                    icon (name: "file-text", class: "w-4 h-4 text-muted-foreground") {}
                                }
                                if r.has_kids {
                                    button (text: r.label, variant: "text") {
                                        onclick: .FtToggle(r.id)
                                        class: "flex-1 px-1 text-left text-sm"
                                    }
                                }
                                if !r.has_kids {
                                    button (text: r.label, variant: "text") {
                                        onclick: .FtOpen(r.id)
                                        class: "flex-1 px-1 text-left text-sm"
                                    }
                                }
                            }
                            // 展开子行（flatten_tree 展开臂渲染语义：子行随
                            // open 出现，guides +1 层）
                            if .ft_open_dir == r.id {
                                row (class: "items-center") {
                                    div (class: "w-4 h-6 flex items-center justify-center") {
                                        div (class: "w-px h-6 bg-border") {}
                                    }
                                    button (text: "探针.ad", variant: "text") {
                                        onclick: .FtOpen("wiki/方法/探针.ad")
                                        class: "flex-1 px-1 text-left text-sm"
                                    }
                                }
                            }
                        }
                    }
                    text .ft_marker { class: "px-3 pt-2 text-[11px] text-zinc-400" }
                }
            }
            if .show_outgoing_links {
                col (class: "flex-col p-3") {
                    col (class: "w-72 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Outgoing links" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        if .olp_has {
                            dyn (.ul_tag) {
                                class: "space-y-0.5",
                                for o in .olp_rows {
                                    dyn (.li_tag) {
                                        key: o.target_title,
                                        class: "cursor-pointer truncate rounded px-1.5 py-0.5 text-xs text-zinc-800",
                                        text o.target_title
                                    }
                                }
                            }
                        }
                        text .olp_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_unlinked_references {
                col (class: "flex-col p-3") {
                    col (class: "w-72 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Unlinked References" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        if .ul_has {
                            dyn (.ul_tag) {
                                class: "space-y-1",
                                for r in .ul_rows {
                                    dyn (.li_tag) {
                                        key: r.page_path,
                                        class: "cursor-pointer rounded px-1.5 py-1 text-xs text-zinc-800",
                                        text r.page_path
                                        text r.context
                                    }
                                }
                            }
                        }
                        text .ul_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_quick_switcher {
                col (class: "flex-col p-3") {
                    col (class: "w-80 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Quick Switcher" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        // 查询输入面（twin 只投影 CJK 查询 "引"；键盘/焦点
                        // = window 级 DOM 必留 ext 域，不镜像）
                        row (class: "items-center gap-2 border-b border-zinc-200 px-2 pb-2") {
                            text "引" { class: "text-sm text-zinc-700" }
                            text "Ctrl+O" { class: "text-[10px] text-zinc-400" }
                        }
                        if .qs_has {
                            dyn (.ul_tag) {
                                class: "space-y-0.5",
                                for f in .qs_rows {
                                    dyn (.li_tag) {
                                        key: f.path,
                                        class: f.idx == .qs_selected ? "cursor-pointer rounded px-1.5 py-1 text-xs bg-accent text-zinc-900" : "cursor-pointer rounded px-1.5 py-1 text-xs text-zinc-800",
                                        text f.name
                                        text f.path
                                    }
                                }
                            }
                        }
                        row (class: "gap-1 pt-2") {
                            button (text: "qs_next", variant: "text") {
                                onclick: .QsNext
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                            button (text: "qs_prev", variant: "text") {
                                onclick: .QsPrev
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                        }
                        text .qs_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_search_panel {
                col (class: "flex-col p-3") {
                    col (class: "w-80 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Search" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        // 查询输入面投影（vue 臂 fill 门同款查询"引言"）
                        row (class: "items-center gap-2 rounded-md border border-zinc-200 bg-white px-2 py-1.5") {
                            text "引言" { class: "flex-1 text-sm text-zinc-700" }
                        }
                        if .sp_has {
                            dyn (.ul_tag) {
                                class: "space-y-1",
                                for r in .sp_rows {
                                    dyn (.li_tag) {
                                        key: r.title_text,
                                        class: "cursor-pointer rounded px-2 py-1.5 text-xs text-zinc-800",
                                        text r.title_text
                                        if r.has_snippet {
                                            text r.snippet_plain
                                        }
                                    }
                                }
                            }
                        }
                        text .sp_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_command_palette {
                col (class: "flex-col p-3") {
                    col (class: "w-96 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Command Palette" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        // 查询输入面投影（vue 臂 fill 门同款查询"引言"域）
                        row (class: "items-center gap-2 border-b border-zinc-200 px-2 pb-2") {
                            text "⌘/Ctrl+P" { class: "text-[10px] text-zinc-400" }
                            text "引" { class: "flex-1 text-sm text-zinc-700" }
                        }
                        if .cp_has {
                            dyn (.ul_tag) {
                                class: "space-y-0.5",
                                for r in .cp_rows {
                                    dyn (.li_tag) {
                                        key: r.idx,
                                        class: r.idx == .cp_selected ? "cursor-pointer rounded px-2 py-1 text-xs bg-accent text-zinc-900" : "cursor-pointer rounded px-2 py-1 text-xs text-zinc-800",
                                        text r.title
                                        text r.subtitle
                                    }
                                }
                            }
                        }
                        row (class: "gap-1 pt-2") {
                            button (text: "cp_next", variant: "text") {
                                onclick: .CpNext
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                            button (text: "cp_prev", variant: "text") {
                                onclick: .CpPrev
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                        }
                        text .cp_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_create_page_prompt {
                col (class: "flex-col p-3") {
                    col (class: "w-96 rounded-lg border border-zinc-200 bg-zinc-50 p-3") {
                        text "Create missing page?" { class: "text-sm font-semibold text-zinc-800" }
                        row (class: "items-center gap-1 pt-2") {
                            text f"[[${.cpp_title}]]" { class: "text-xs text-zinc-600" }
                            text "does not exist yet." { class: "text-xs text-zinc-500" }
                        }
                        row (class: "items-center gap-1 pt-1") {
                            text "Will be created as" { class: "text-xs text-zinc-500" }
                            text .cpp_path { class: "rounded bg-zinc-200 px-1 py-0.5 text-xs text-zinc-800" }
                        }
                        row (class: "justify-end gap-1 pt-2") {
                            button (text: "Cancel", variant: "text") {
                                onclick: .CppCancel
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-xs text-zinc-600"
                            }
                            button (text: "Create", variant: "text") {
                                onclick: .CppCreate
                                class: "rounded border border-zinc-300 bg-zinc-800 px-2 py-0.5 text-xs text-white"
                            }
                        }
                        text .cpp_marker { class: "pt-2 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_theme_popover {
                col (class: "flex-col p-3") {
                    col (class: "w-56 rounded-xl border border-zinc-200 bg-zinc-50 p-3") {
                        text "Appearance" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        row (class: "items-center gap-1") {
                            button (text: "SetLight", variant: "text") {
                                onclick: .TpSetLight
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                            button (text: "SetDark", variant: "text") {
                                onclick: .TpSetDark
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                        }
                        text "Accent" { class: "mb-1 mt-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        if .tp_has {
                            dyn (.ul_tag) {
                                class: "grid grid-cols-1 gap-1",
                                for a in .tp_accents {
                                    dyn (.li_tag) {
                                        key: a.key,
                                        class: "flex items-center gap-1 text-xs text-zinc-700",
                                        text a.label
                                        text a.color
                                    }
                                }
                            }
                        }
                        text .tp_marker { class: "pt-2 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_recent_files {
                col (class: "flex-col p-3") {
                    col (class: "w-80 rounded-lg border border-zinc-200 bg-zinc-50 p-2.5") {
                        text "Recent" { class: "mb-2 text-[11px] font-semibold uppercase tracking-wider text-zinc-500" }
                        if .rf_has {
                            dyn (.ul_tag) {
                                class: "space-y-0.5",
                                for rf in .rf_rows {
                                    dyn (.li_tag) {
                                        key: rf.path,
                                        class: "cursor-pointer rounded px-2 py-1.5 text-xs text-zinc-800",
                                        text rf.title
                                        text rf.path
                                        text rf.time
                                    }
                                }
                            }
                        }
                        row (class: "gap-1 pt-2") {
                            button (text: "rf_remove", variant: "text") {
                                onclick: .RfRemove
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                            button (text: "rf_clear", variant: "text") {
                                onclick: .RfClear
                                class: "rounded border border-zinc-200 px-2 py-0.5 text-[10px] text-zinc-600"
                            }
                        }
                        text .rf_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
            if .show_agenda {
                col (class: "flex-col p-3") {
                    col (class: "w-80 rounded-md border border-zinc-200 bg-zinc-50 p-2") {
                        text "Agenda" { class: "mb-2 text-xs font-semibold uppercase tracking-wider text-zinc-500" }
                        if .ag_has {
                            for g in .ag_groups {
                                col (class: "flex-col gap-1 pb-2") {
                                    text g.date { class: "text-[11px] font-medium text-zinc-500" }
                                    dyn (.ul_tag) {
                                        class: "space-y-1",
                                        for tk in g.tasks {
                                            dyn (.li_tag) {
                                                key: tk.page_path,
                                                class: "cursor-pointer rounded px-2 py-1 text-xs text-zinc-800",
                                                text tk.marker
                                                text f"[#${tk.priority}]"
                                                text tk.content
                                                text tk.line
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        text .ag_marker { class: "pt-1 text-[10px] text-zinc-400" }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            .ol_rows.push({ content: "引言", pad: "0px" })
            .ol_rows.push({ content: "方法", pad: "12px" })
            .ol_rows.push({ content: "方法 > 探针", pad: "24px" })
            .ol_count = 3
            .ol_has = true
            .ts_tabs.push({ title: "引言", path: "wiki/引言.ad" })
            .ts_tabs.push({ title: "方法", path: "wiki/方法.ad" })
            .ts_active = "wiki/引言.ad"
            .bl_rows.push({ source_title: "另页", source_path: "wiki/另页.ad", context: "链接到 fixture 页" })
            .bl_count = 1
            .mb_menus = 2
            .mb_actions = 5
            .mb_toolbar = 3
            .ft_rows.push({ label: "引言.ad", guides: [], has_kids: false, open: false, is_dir: false, id: "wiki/引言.ad" })
            .ft_rows.push({ label: "方法", guides: [], has_kids: true, open: false, is_dir: true, id: "wiki/方法" })
            .ft_rows.push({ label: "另页.ad", guides: [], has_kids: false, open: false, is_dir: false, id: "wiki/另页.ad" })
            .ft_count = 3
            .olp_rows.push({ target_title: "方法", target_path: "wiki/方法.ad", exists: true })
            .olp_rows.push({ target_title: "缺失页", target_path: "", exists: false })
            .olp_count = 2
            .olp_exists = 1
            .olp_has = true
            .ul_rows.push({ page_path: "wiki/另页.ad", context: "这一段提到 引言 的概念但从未写成链接" })
            .ul_count = 1
            .ul_has = true
            // quick_switcher：对 fixture 树真跑下沉同形 fn（qs_collect 递归
            // walk → qs_filter CJK 查询 "引"——P-7/P-8 VM 侧实证面）
            var qs_tree = [
                { is_dir: true, name: "wiki", children: [
                    { is_dir: false, name: "引言.ad", children: [] },
                    { is_dir: true, name: "方法", children: [
                        { is_dir: false, name: "引子.ad", children: [] },
                        { is_dir: false, name: "探针.ad", children: [] },
                    ] },
                ] },
                { is_dir: false, name: "另页.ad", children: [] },
            ]
            var qs_files = qs_collect(qs_tree, [])
            .qs_rows = qs_filter(qs_files, "引")
            .qs_count = .qs_rows.len()
            .qs_selected = 0
            if .qs_count > 0 {
                .qs_has = true
            }
            // search_panel：Init 播种行投影（vue 臂 shim 应答同构；Page 行
            // has_snippet=true + 纯文本摘要，Block 行 title_text=page_path）
            .sp_rows.push({ title_text: "引言", has_snippet: true, snippet_plain: "正文提到 引言 的概念，见首章" })
            .sp_rows.push({ title_text: "wiki/方法.ad", has_snippet: false, snippet_plain: "" })
            .sp_count = 2
            .sp_has = true
            // command_palette：command×9（英文，与 buildCommands 面同构的
            // title 域）+ recent×2（CJK）混合 fixture，cp_filter 真跑 "引"
            var cp_items = [
                { type: "command", title: "Open today's note", subtitle: "Create or open the daily journal entry" },
                { type: "command", title: "Open global graph", subtitle: "Show the workspace graph view" },
                { type: "command", title: "Toggle theme", subtitle: "Current: light" },
                { type: "command", title: "Toggle left sidebar", subtitle: "Show" },
                { type: "command", title: "Toggle right sidebar", subtitle: "Hide" },
                { type: "command", title: "Open file search", subtitle: "Quick switcher (Ctrl+O)" },
                { type: "command", title: "Review flashcards", subtitle: "SRS due cards" },
                { type: "command", title: "Export Markdown", subtitle: "Download workspace as zip of .md files" },
                { type: "command", title: "Import Markdown", subtitle: "Upload a zip of .md files" },
                { type: "file", title: "引言", subtitle: "wiki/引言.ad" },
                { type: "file", title: "引子", subtitle: "wiki/方法/引子.ad" },
            ]
            .cp_rows = cp_filter(cp_items, "引")
            .cp_count = .cp_rows.len()
            .cp_selected = 0
            if .cp_count > 0 {
                .cp_has = true
            }
            // create_page_prompt：cpp_path derived 值播种（wikiTitleToPath
            // "引言" → "引言.ad"——regex 桥 TS 域，twin 播种等价投影）
            .cpp_title = "引言"
            .cpp_path = "引言.ad"
            .cpp_choice = ""
            // theme_popover：字面量列表真跑（Q-4 实证面）
            .tp_accents = tp_theme_accents()
            .tp_count = .tp_accents.len()
            if .tp_count > 0 {
                .tp_has = true
            }
            // recent_files：播种两行（time raw——formatTime 桥 TS 域）
            .rf_rows.push({ path: "wiki/引言.ad", title: "引言", time: "09:41" })
            .rf_rows.push({ path: "wiki/另页.ad", title: "另页", time: "08:15" })
            .rf_count = .rf_rows.len()
            if .rf_count > 0 {
                .rf_has = true
            }
            // agenda：fixture 组经 ag_display_probe 真跑（行构造 + marker
            // 旗标 + title 守卫同形），任务总数投影
            var ag_fixture = [
                { date: "2026-09-19", tasks: [
                    { page_path: "wiki/引言.ad", title: "", marker: "TODO", priority: null, content: "写引言草稿" },
                    { page_path: "wiki/方法.ad", title: "小节题", marker: "DONE", priority: "2", content: "方法验证" },
                ] },
                { date: "2026-09-20", tasks: [
                    { page_path: "wiki/另页.ad", title: "", marker: "DOING", priority: null, content: "另页任务" },
                ] },
            ]
            .ag_groups = ag_display_probe(ag_fixture)
            .ag_count = 0
            for gg in .ag_groups {
                .ag_count = .ag_count + gg.tasks.len()
            }
            if .ag_count > 0 {
                .ag_has = true
            }
        }

        .Select(u) -> {
            .unit = u
        }

        .TsSwitch(path) -> {
            .ts_active = path
        }

        .FtToggle(id) -> {
            // 先算布尔再双分支（desktop .CloseTab was_dirty 同款）——两个
            // 条件 if 顺序执行，第一个分支改状态后第二个不得再进。
            var will_open = .ft_open_dir != id
            if will_open {
                .ft_open_dir = id
                .ft_count = 4
            }
            if !will_open {
                .ft_open_dir = ""
                .ft_count = 3
            }
        }

        .FtOpen(id) -> {
            .ft_sel = id
        }

        .QsNext -> {
            // 与下沉 fn next_index 同形的环绕模运算（quick_switcher.at）
            .qs_selected = (.qs_selected + 1) % .qs_count
        }

        .QsPrev -> {
            .qs_selected = (.qs_selected - 1 + .qs_count) % .qs_count
        }

        .CpNext -> {
            // 与下沉 fn next_index 同形的环绕模运算（command_palette.at）
            .cp_selected = (.cp_selected + 1) % .cp_count
        }

        .CpPrev -> {
            .cp_selected = (.cp_selected - 1 + .cp_count) % .cp_count
        }

        .CppCreate -> {
            .cpp_choice = "create"
        }

        .CppCancel -> {
            .cpp_choice = "cancel"
        }

        .TpSetLight -> {
            .tp_mode = "light"
        }

        .TpSetDark -> {
            .tp_mode = "dark"
        }

        .RfRemove -> {
            // 重建去首行（避 .remove → .splice 误射域，074 removeRecent
            // 注记同款）
            var rest List = []
            var i = 0
            for r in .rf_rows {
                if i > 0 {
                    rest.push(r)
                }
                i = i + 1
            }
            .rf_rows = rest
            .rf_count = .rf_rows.len()
        }

        .RfClear -> {
            .rf_rows = []
            .rf_count = 0
        }
    }
}
