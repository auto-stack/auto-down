        var ol_rows = []
        // VM 实测（T-01）：computed 字段不入 autoui_state，且 f-string 内插
        // computed 不解析（${ol_count} 原样出现）——计数/标记全部落 model
        // 字段，Init 维护（sb_marker 同款：model 字段内插已证可行）。
        var ol_count int = 0
