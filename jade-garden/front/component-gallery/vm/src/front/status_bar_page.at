// status_bar_page.at — 单元页：status_bar 面（PLAN-072 T-01 样板①纯展示）。
//
// harness twin（derived 探针工件，非生产件）：derived-from
// jade-garden/front/desktop/src/front/status_bar.at（041 值 props 形态，
// PLAN-067 T-05 VM 实证）与 web status_bar.at 的行结构。fixture 经值
// props 从 root 注入（app.at）——组件子树对 MCP 快照不可见（041 README
// 「vm 组件边界」②），故结构断言在 root 投影（sb_marker），视觉断言走
// vue 截图基线。
//
// class: 而非 style:：双轨同构（demo 双轨语料主导形态；VM 经 tailwind
// parser 消费，desktop README §1「widget DSL → iced」行）。
//
// PLAN-073 T-01 随 desktop/src/front/status_bar.at 配方化同步（derived
// 镜像纪律）：text-[11px] → text-xs，zinc-700/500 → 语义 token
// text-foreground/text-muted-foreground（双端对照修复，AC-02）。
widget StatusBarPage (status: str = "", root_path: str = "", bl: int = 0, ol: int = 0) {
    view {
        col (class: "w-full shrink-0") {
            col (class: "h-px w-full bg-zinc-200")
            row (class: "h-6 items-center bg-zinc-100 shrink-0 w-full gap-3 px-2") {
                text .status { class: "text-xs text-foreground" }
                text .root_path { class: "text-xs text-muted-foreground" }
                text f"bl:${.bl}" { class: "text-xs text-muted-foreground ml-auto" }
                text f"ol:${.ol}" { class: "text-xs text-muted-foreground" }
            }
        }
    }
}
