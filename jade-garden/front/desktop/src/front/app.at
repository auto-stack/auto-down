// app.at — jade-garden 桌面（tabs_store facade 回归形态，PLAN-622 清偿后）。
//
// 六流面板保持 slice 5 形态（open-ws/文件树/反链出链/闪卡/图谱/搜索/导入
// 导出）；编辑区为 tabs_store facade：tab 状态权威在 store（desktop/src/
// front/tabs_store.at，与 web 轨逐字共享 + Close 索引狩猎 delta），widget
// 只持视图投影镜像（view_title/view_body/view_dirty/view_note，每次
// store 派发后从 store 状态重同步）。vm-smoke tabs 臂五断言面不变。
//
// 形态历史：T-05 曾因 store facade VM 缺口簇（README §8 提案⑥）退绕行
// 形态（widget 状态机等价实现）；PLAN-622 修复可复现项（splice/闭包捕获）
// 并实证其余消费位健康后，本文件回归 `use store: Tabs` facade 形态。
//
// 登记偏差（沿 064 处置表，实现在 desktop/src/back/api.at 助手层）：
// confirm 模态缺席 → confirmClose 默认确认即弃（状态行 discarded-dirty
// 登记）；ensureBlockAnchors = identity（保存不注入 ^锚点）；recordRecent
// = no-op；rethrow = 吞错。反链/出链 source_path 归一（补 .ad 后缀）沿用
// T-05 形态。auto-lang 登记项沿用：混合 search 的 .type 撞名 → v1 用
// search_pages。

use store: Tabs
use back.api: open_workspace, list_files, read_wiki, write_wiki, get_due_cards, review_card, get_backlinks, get_outlinks, get_graph, search_pages
use auto.http

widget App {
    msg { Init, OpenWs, LoadFiles, OpenFile(str), Edit, Save, CloseTab, SwitchTab(str), LoadCards, Grade(str, str, int), QChanged, DoSearch, LoadGraph, ExportWs, ImportZip }

    model {
        var status str = "boot"
        var root str = ""
        var files = []
        // —— 视图投影镜像（状态权威在 Tabs store，派发后重同步）——
        // 命名用 view_* 前缀：与 store 模型字段（tabs/active_path）保持
        // 全局不撞名——跨状态对象同名合并在 VM 侧按位对齐会错读
        //（首跑实证：active_title 读出 store tab.loaded 的 true）。
        var view_title str = ""
        var view_body str = ""
        var view_dirty bool = false
        var view_note str = ""
        var cards = []
        var review_note str = ""
        var backlinks = []
        var outlinks = []
        var bl_count int = 0
        var ol_count int = 0
        var search_q str = ""
        var search_rows = []
        var hit_count int = 0
        var graph_rows = []
        var graph_edges int = 0
        var io_note str = ""
    }

    on {
        .Init -> {
            .status = "ready"
        }

        .OpenWs -> {
            var res = open_workspace("D:/autostack/auto-down/tmp/wiki-demo")
            .root = res.root
            .files = list_files("", false)
            .status = "ws-open"
        }

        .LoadFiles -> {
            .files = list_files("", false)
            .status = "files-reloaded"
        }

        // 反链/出链源的 source_path 实为页标题（无 .ad 后缀）——补后缀归一
        // 到真实文档路径。开/激活语义在 store（Open = 激活已载 tab 或新读，
        // 022 Phase 3 双读竞争防护在 store handler 内）。
        .OpenFile(path) -> {
            var parts = path.split(".ad")
            var seg_count = parts.len()
            if seg_count == 1 {
                path = f"${path}.ad"
            }
            Tabs.Open({ path: path, title: "" })
            var t = .tabs.find(tt => tt.path == path)
            if t != null {
                .view_title = t.title
                .view_body = t.body
                .view_dirty = t.dirty
            }
            var bl = get_backlinks(.view_title)
            var blLinks = bl.links
            .backlinks = blLinks
            .bl_count = blLinks.length
            var ol = get_outlinks(.view_title)
            var olLinks = ol.links
            .outlinks = olLinks
            .ol_count = olLinks.length
            .status = "opened"
        }

        // 切换 = store Open 的激活臂（已 loaded 不重读磁盘）。
        .SwitchTab(path) -> {
            Tabs.Open({ path: path, title: "" })
            var t = .tabs.find(tt => tt.path == path)
            if t != null {
                .view_title = t.title
                .view_body = t.body
                .view_dirty = t.dirty
            }
            .status = "switched"
        }

        // 关闭：脏态由 store confirmClose 偏差默认确认即弃（P022-6 保形），
        // 状态行登记处置结果。派发前预读脏/标题供状态行。
        .CloseTab -> {
            var was_dirty = false
            var closed_title str = ""
            var has_active = .active_path != ""
            if has_active {
                var t = .tabs.find(tt => tt.path == .active_path)
                if t != null {
                    was_dirty = t.dirty
                    closed_title = t.title
                }
                Tabs.Close(.active_path)
                var t2 = .tabs.find(tt => tt.path == .active_path)
                if t2 != null {
                    .view_title = t2.title
                    .view_body = t2.body
                    .view_dirty = t2.dirty
                }
                if t2 == null {
                    .view_title = ""
                    .view_body = ""
                    .view_dirty = false
                }
            }
            if was_dirty {
                .status = f"discarded-dirty:${closed_title}"
            }
            if !was_dirty {
                if has_active {
                    .status = f"closed:${closed_title}"
                }
            }
        }

        // 键入：textarea 双向绑定写 .view_body（视图投影面），oninput
        // 经 SetBody 落入 store tab（dirty 由 store 按 original_body 判定）。
        .Edit -> {
            Tabs.SetBody({ path: .active_path, body: .view_body })
            var t = .tabs.find(tt => tt.path == .active_path)
            if t != null {
                .view_dirty = t.dirty
            }
        }

        .QChanged -> {
            .status = "typing"
        }

        // 保存：store Save 面（write_wiki 经 #[api] → 340 HTTP；回声
        // 采纳 adopt_save_result 防在途编辑被回声覆盖——022 Phase 3 语义）。
        .Save -> {
            Tabs.Save(.active_path)
            var t = .tabs.find(tt => tt.path == .active_path)
            if t != null {
                .view_body = t.body
                .view_dirty = t.dirty
            }
            .view_note = "saved"
            .status = "saved"
        }

        .LoadCards -> {
            var res = get_due_cards(20)
            .cards = res.cards
            .status = "cards-loaded"
        }

        .Grade(page_path, block_id, grade) -> {
            var res = review_card(page_path, block_id, grade)
            .review_note = "graded:" + res.card.block_id
            var res2 = get_due_cards(20)
            .cards = res2.cards
            .status = "graded"
        }

        .DoSearch -> {
            var res = search_pages(.search_q, 20)
            var hits = res.results
            .hit_count = hits.length
            .search_rows = []
            for h in hits {
                .search_rows.push({ label: h.title, target: h.path })
            }
            .status = "searched"
        }

        // 导入导出（D4 裁定：原生直连，不经 #[api] JSON 改写）。v1 导出/
        // 导入路径为探针常量——目录/文件选择器宿主能力就位后替换（README §7.1）。
        // （PLAN-064 T-03：旧 .worktree/plan-022 路径随归档失效，改 tmp/jade-probe。）
        .ExportWs -> {
            let res = http.request("GET", "http://127.0.0.1:8199/api/export/markdown").send()
            let n = res.body_to_file("D:/autostack/auto-down/tmp/jade-probe/desktop-export.zip")
            .io_note = "exported"
            .status = "exported"
        }

        .ImportZip -> {
            let rb0 = http.request("POST", "http://127.0.0.1:8199/api/import/markdown")
            let rb = rb0.multipart_file("archive", "D:/autostack/auto-down/tmp/jade-probe/desktop-import.zip")
            let res = rb.send()
            .io_note = res.body()
            .status = "imported"
        }

        .LoadGraph -> {
            var g = get_graph()
            var nodes = g.nodes
            var edges = g.edges
            .graph_edges = edges.length
            .graph_rows = []
            for n in nodes {
                .graph_rows.push({ label: n.label, target: n.path })
            }
            .status = "graph-loaded"
        }
    }

    view {
        col {
            class: "flex h-full flex-col gap-2 p-3 bg-background text-foreground",
            row {
                class: "flex items-center gap-2",
                button "open-ws" { onclick: .OpenWs }
                button "reload-files" { onclick: .LoadFiles }
                button "save" { onclick: .Save }
                button "close-tab" { onclick: .CloseTab }
                button "cards" { onclick: .LoadCards }
                button "graph" { onclick: .LoadGraph }
                button "export-ws" { onclick: .ExportWs }
                button "import-zip" { onclick: .ImportZip }
                text .status
                text .io_note
                if .view_dirty {
                    text "● unsaved"
                }
            }
            row {
                class: "flex flex-1 gap-3 overflow-hidden",
                col {
                    class: "w-44 shrink-0 gap-1 overflow-auto border-r pr-2",
                    for f in .files {
                        button (text: f.name) {
                            onclick: .OpenFile(f.path)
                        }
                    }
                }
                col {
                    class: "flex flex-1 flex-col gap-2",
                    row {
                        class: "flex flex-wrap gap-1",
                        for t in .tabs {
                            button (text: t.title) {
                                onclick: .SwitchTab(t.path)
                            }
                        }
                    }
                    if .view_title != "" {
                        textarea (value: .view_body, placeholder: "edit markdown here") {
                            oninput: .Edit
                        }
                    }
                    text .view_note
                }
                col {
                    class: "w-56 shrink-0 gap-1 overflow-auto border-l pl-2",
                    row {
                        class: "gap-1",
                        text "backlinks"
                        text .bl_count
                    }
                    for b in .backlinks {
                        button (text: b.source_title) {
                            onclick: .OpenFile(b.source_path)
                        }
                    }
                    row {
                        class: "gap-1",
                        text "outlinks"
                        text .ol_count
                    }
                    for o in .outlinks {
                        if o.exists {
                            button (text: o.target_title) {
                                onclick: .OpenFile(o.target_path)
                            }
                        }
                        if !o.exists {
                            text o.target_title
                        }
                    }
                    text "due cards"
                    text .review_note
                    for c in .cards {
                        col {
                            class: "gap-1 border-b pb-1",
                            text c.question
                            row {
                                class: "gap-1",
                                button "again" { onclick: .Grade(c.page_path, c.block_id, 1) }
                                button "good" { onclick: .Grade(c.page_path, c.block_id, 3) }
                            }
                        }
                    }
                }
            }
            row {
                class: "flex items-center gap-2 border-t pt-2",
                input (value: .search_q, placeholder: "search") {
                    oninput: .QChanged
                }
                button "search" { onclick: .DoSearch }
                text .hit_count
                text "graph-edges"
                text .graph_edges
            }
            row {
                class: "flex flex-wrap gap-1 overflow-auto",
                for r in .search_rows {
                    button (text: r.label) {
                        onclick: .OpenFile(r.target)
                    }
                }
                for n in .graph_rows {
                    button (text: n.label) {
                        onclick: .OpenFile(n.target)
                    }
                }
            }
        }
    }
}
