// app.at — jade-garden 桌面（tabs_store facade 回归形态，PLAN-622 清偿后；
// PLAN-067 T-01：投影镜像改名 view_* → active_*，与 vm-smoke 契约字段对齐）。
//
// 六流面板保持 slice 5 形态（open-ws/文件树/反链出链/闪卡/图谱/搜索/导入
// 导出）；编辑区为 tabs_store facade：tab 状态权威在 store（desktop/src/
// front/tabs_store.at，与 web 轨逐字共享 + Close 索引狩猎 delta），widget
// 只持视图投影镜像（active_title/active_body/active_dirty/save_note，每次
// store 派发后从 store 状态重同步）。vm-smoke tabs 臂五断言面不变。
//
// 撞名裁定（PLAN-067 T-01，接 622 时代 view_* 改名）：彼次因"跨状态同名
// 按位对齐错读"退避 view_* 前缀（首跑实证 active_title 读出 store tab
// 的 loaded）；其撞名对象是 store 侧同名声明——现 store 仅声明 tabs/
// active_path（tabs_store.at model），active_title/active_body/active_dirty
// 三名 store 无声明、无撞名，改名安全由 vm-smoke 全臂回归背书。active_path
// 保持 store 独有（App 不声明，跨状态只读）。
//
// 形态历史：T-05 曾因 store facade VM 缺口簇（README §8 提案⑥）退绕行
// 形态（widget 状态机等价实现）；PLAN-622 修复可复现项（splice/闭包捕获）
// 并实证其余消费位健康后，本文件回归 `use store: Tabs` facade 形态。
//
// 登记偏差（沿 064 处置表，实现在 desktop/src/back/api.at 助手层）：
// confirm 模态缺席 → confirmClose 默认确认即弃（状态行 discarded-dirty
// 登记）；ensureBlockAnchors = identity（保存不注入 ^锚点）；recordRecent
// = no-op；rethrow = 吞错。反链/出链 source_path 归一（补 .ad 后缀）沿用
// T-05 形态。auto-lang 登记项沿用：混合 search 的 .type 撞名 → v1 用
// search_pages。

use store: Tabs
use status_bar: StatusBar
use bps.navigation.filetree.tree_util: flatten_tree, toggle_id
use bps.navigation.filetree.tree_icon: TreeIcon
// PLAN-079 T-01 批 A 装配：下沉 fn 部署副本（β 内联消费裁定，模式文档
// §2/§3——tab_file_stem/backlinks·outgoing 双登记、tab_title/tab_path/
// unlinked、ol_headings/outline 等价推导）。
use panels_a_fns: tab_file_stem, tab_title, tab_path, ol_headings
// PLAN-079 T-02 批 B 装配：sw_collect/sw_filter（quick_switcher 下沉 fn，
// 入参形状适配 ft_nodes）+ pal_match（palette filter 链 title 臂语义）。
use panels_b_fns: sw_collect, sw_filter, pal_match
// PLAN-079 T-03 批 C 装配：ag_display（agenda_display 副本·date raw）/
// rf_rows（recent_files_with_time 副本·无 time 列差异）/theme_accents
//（逐字副本）。
use panels_c_fns: ag_display, rf_rows, theme_accents
use back.api: open_workspace, list_files, read_wiki, write_wiki, get_due_cards, review_card, get_backlinks, get_outlinks, get_unlinked_refs, get_graph, search_pages, get_agenda, create_file
use auto.http

// FileNode（wire：name/path/is_dir/children）→ tree_util 节点 schema
//（components/tree_util.at 头注形态：id/label/children/kind/icon/is_leaf/
// badge 全键必填——VM Obj 字面量形状锁定，缺键访问=硬错）。
// VM 遍历纪律：参数列表一律 while+索引（P614：for-in 对参数列表零次
// 迭代）；children 递归经 P618 探针验证可用。
fn to_fs_nodes(nodes List) List {
    var out List = []
    var i int = 0
    while i < nodes.len() {
        var nd = nodes[i]
        var kids List = []
        var kind str = "file"
        var is_leaf bool = true
        if nd.is_dir == true {
            kids = to_fs_nodes(nd.children)
            kind = "dir"
            is_leaf = false
        }
        out.push({ id: nd.path, label: nd.name, children: kids, kind: kind, icon: "", is_leaf: is_leaf, badge: "" })
        i = i + 1
    }
    return out
}

widget App {

    msg { Init, OpenWs, LoadFiles, OpenFile(str), Edit(str), Save, CloseTab, SwitchTab(str), LoadCards, Grade(str, str, int), QChanged, DoSearch, LoadGraph, ExportWs, ImportZip, FtToggle(str), OpenPalette, ClosePalette, PaletteQuery, OpenSwitcher, CloseSwitcher, SwitcherQuery, LoadAgenda, OpenCpp, CppQuery, CppCreate, CppCancel, ThemeOpen, ThemeClose, SetThemeMode(str), SetAccent(str) }

    model {
        var status str = "boot"
        var root str = ""
        // —— FileTree（PLAN-067 T-03）：fs 形态节点 + 展开态 + 选中态，
        // 行派生 computed ft_rows（flatten_tree 纯函数），树行在根视图渲染。 ——
        var ft_nodes = []
        var ft_expanded = []
        var ft_sel str = ""
        // —— 视图投影镜像（状态权威在 Tabs store，派发后重同步）——
        // 命名裁定见文件头注（store 仅声明 tabs/active_path，active_*
        // 三名无撞名；active_path 保持 store 独有，App 跨状态只读）。
        var active_title str = ""
        var active_body str = ""
        var active_dirty bool = false
        var save_note str = ""
        var cards = []
        var review_note str = ""
        var backlinks = []
        var outlinks = []
        var bl_count int = 0
        var ol_count int = 0
        // —— PLAN-079 T-01 批 A 装配：unlinked 行 + outline 行（右栏根视图
        // 行渲染，F-1 口径；计数 = vm-smoke 断言锚。outline_count 独立命名
        // ——ol_count 为 outlinks 计数既有 smoke 锚，不复用）。 ——
        // —— PLAN-079 T-02 批 B 装配：palette/switcher 自持面板态。 ——
        var palette_open bool = false
        var palette_q str = ""
        var switcher_open bool = false
        var switcher_q str = ""
        var unlinked_rows = []
        var ul_count int = 0
        var outline_rows = []
        var outline_count int = 0
        // —— PLAN-079 T-03 批 C 装配：agenda 行（全局日程，视图菜单装载）/
        // recent 会话记账（desktop 无 recentFiles store——recordRecent no-op
        // 登记偏差，会话内 OpenFile 自记账 + rf_rows 行构造）/ cpp 建页确认
        // / theme 面板态（应用通道 = AUTO_UI_THEME env 域，运行时应用差异
        // 登记）。 ——
        var agenda_rows = []
        var agenda_count int = 0
        var recent_entries = []
        var recent_rows = []
        var recent_count int = 0
        var cpp_open bool = false
        var cpp_input str = ""
        var theme_open bool = false
        var theme_mode str = "dark"
        var theme_accent str = "indigo"
        var search_q str = ""
        var search_rows = []
        var hit_count int = 0
        var graph_rows = []
        var graph_edges int = 0
        var io_note str = ""
    }

    computed {
        // 可见行序列（041 FileTree/TreeView 同款纯派生）：fs 树 × 展开态 ×
        // 选中态；directory=true → 目录/文件图标自动映射。
        ft_rows => flatten_tree(.ft_nodes, .ft_expanded, true, .ft_sel)
        // PLAN-079 T-02 批 B：switcher 行 = sw_collect × sw_filter 纯派生
        //（下沉 fn 部署副本真消费——quick_switcher 数据面同源）；palette
        // 行 = 静态绑定（命令派发无动态通道，模式文档 §2 注记）× 逐行
        // pal_match 过滤门。
        switcher_rows => sw_filter(sw_collect(.ft_nodes), .switcher_q)
        // PLAN-079 T-03 批 C：theme accent 行 = theme_accents 部署副本
        // 纯派生（静态五 accent 字面量，Q-4 域）。
        theme_rows => theme_accents()
        pal_f_open => pal_match("打开工作区", .palette_q)
        pal_f_reload => pal_match("重载文件列表", .palette_q)
        pal_f_save => pal_match("保存", .palette_q)
        pal_f_close => pal_match("关闭标签", .palette_q)
        pal_f_cards => pal_match("加载卡片", .palette_q)
        pal_f_graph => pal_match("加载图谱", .palette_q)
        pal_f_export => pal_match("导出工作区", .palette_q)
        pal_f_import => pal_match("导入归档", .palette_q)
    }

    // PLAN-067 T-02: actions 注册表（Plan 451 DSL）——六流 action 化。
    // 三源绑定：shortcut（键盘回退层）/ menubar·toolbar 配置合成 / MCP
    // 自动化同源派发（041-auto-edit 模板形态）。enabled_if 对合并根 state
    // 求值（.active_title 无前缀）。handler 在解析期校验命中 on{} 事件。
    actions {
        action (id: "ws.open",      handler: .OpenWs,    title: "打开工作区", icon: "folder-open", shortcut: "Ctrl+O")
        action (id: "files.reload", handler: .LoadFiles, title: "重载文件列表", icon: "refresh-cw", shortcut: "F5")
        action (id: "file.save",    handler: .Save,      title: "保存",   icon: "save",  shortcut: "Ctrl+S",
                enabled_if: ".active_title != ''")
        action (id: "tab.close",    handler: .CloseTab,  title: "关闭标签", icon: "x", shortcut: "Ctrl+W")
        action (id: "cards.load",   handler: .LoadCards, title: "加载卡片", icon: "layers")
        action (id: "graph.load",   handler: .LoadGraph, title: "加载图谱", icon: "share-2")
        action (id: "ws.export",    handler: .ExportWs,  title: "导出工作区", icon: "download")
        action (id: "ws.import",    handler: .ImportZip, title: "导入归档", icon: "upload")
        // PLAN-079 T-02 批 B：palette/switcher 面板入口（命令清单 = 本
        // actions 注册表 ui_config 单源重建——076 §4.1 裁定；热键 desktop
        // 自持：Ctrl+P 命令面板 + Ctrl+K 快速切换，web 的 Ctrl+O 与
        // ws.open 冲突维持差异）。
        action (id: "palette.open", handler: .OpenPalette, title: "命令面板", icon: "command", shortcut: "Ctrl+P")
        action (id: "quick.switch", handler: .OpenSwitcher, title: "快速切换", icon: "search", shortcut: "Ctrl+K")

        // 高频件收编（PLAN-067 §5.2）：open/save/close/reload 进工具栏；
        // cards/graph/export/import 走菜单。
        toolbar {
            item (action: "ws.open")
            item (action: "file.save")
            item (action: "tab.close")
            item (action: "files.reload")
        }
    }

    on {
        .Init -> {
            .status = "ready"
        }

        .OpenWs -> {
            var res = open_workspace("D:/autostack/auto-down/tmp/wiki-demo")
            .root = res.root
            .ft_nodes = to_fs_nodes(list_files("", true))
            .status = "ws-open"
        }

        .LoadFiles -> {
            .ft_nodes = to_fs_nodes(list_files("", true))
            .status = "files-reloaded"
        }

        // 目录展开/折叠（受控展开态，toggle_id 纯函数返回新 List）。
        .FtToggle(id) -> {
            .ft_expanded = toggle_id(.ft_expanded, id)
        }

        // 反链/出链源的 source_path 实为页标题（无 .ad 后缀）——补后缀归一
        // 到真实文档路径。开/激活语义在 store（Open = 激活已载 tab 或新读，
        // 022 Phase 3 双读竞争防护在 store handler 内）。
        .OpenFile(path) -> {
            var parts = path.split(".ad")
            var seg_count = parts.len()
            if seg_count == 1 {
                path = f"${path}.ad"
            }
            // 批 B/C 面板随开页关闭（自持弹层面板语义 + 后续臂输入定位卫生：
            // 面板开着会占据快照首 input 位；theme 无 input 不涉定位，保留
            // 用户显式关闭语义）。互斥：三面板 Open* 各自闭另两面。
            .palette_open = false
            .switcher_open = false
            .cpp_open = false
            .ft_sel = path
            Tabs.Open({ path: path, title: "" })
            var t = .tabs.find(tt => tt.path == path)
            if t != null {
                .active_title = t.title
                .active_body = t.body
                .active_dirty = t.dirty
            }
            // 批 C recent 会话记账：去重前插 + cap 10（desktop 无
            // recentFiles store——recordRecent no-op 登记偏差的装配侧
            // 补偿；rf_rows 副本行构造，时间列 TS 域差异）。.len() 走
            // 局部副本（模型字段直读 .len() 无先例——to_fs_nodes 参数
            // 形态纪律）。
            var prev_recents = .recent_entries
            // typed List 声明纪律：裸 `var x = []` 在 VM 轨静默坏列表
            //（076 TS7034 坑的 VM 变体——本轮实录，模式文档 §4 增记）。
            var fresh List = []
            fresh.push({ path: path, title: .active_title })
            var ri int = 0
            while ri < prev_recents.len() {
                var re = prev_recents[ri]
                if re.path != path {
                    if fresh.len() < 10 {
                        fresh.push(re)
                    }
                }
                ri = ri + 1
            }
            .recent_entries = fresh
            .recent_rows = rf_rows(fresh)
            .recent_count = fresh.len()
            // 编辑器播种裁定（T-04 实机）：content: 绑定每帧外部 diff 回写
            // + key 变即重挂载 = 播种通道；显式 code_editor_set_text 需编辑器
            // 已注册（首次打开该 key 未挂载即 RuntimeError "no editor
            // registered"，本仓实机复现）——041 仅对已存在 tab 清空时调用。
            //
            // PLAN-079 T-01 批 A 装配：标题语义收敛 web 单源（tab_file_stem
            // 部署副本——path 末段去扩展；G-2 安全形态：find/slice 仅 ASCII
            // 分隔符边界）。doc_title 空 = web 面板同款清列语义（backlinks_
            // panel.at watch current_title == "" 臂）。
            var doc_title = tab_file_stem(t)
            if doc_title != "" {
                var bl = get_backlinks(doc_title)
                var blLinks = bl.links
                .backlinks = blLinks
                .bl_count = blLinks.length
                var ol = get_outlinks(doc_title)
                var olLinks = ol.links
                .outlinks = olLinks
                .ol_count = olLinks.length
                var ur = get_unlinked_refs(doc_title)
                var urRefs = ur.refs
                .unlinked_rows = []
                for r in urRefs {
                    .unlinked_rows.push({ label: r.page_path, target: r.page_path })
                }
                .ul_count = urRefs.length
            }
            if doc_title == "" {
                .backlinks = []
                .bl_count = 0
                .outlinks = []
                .ol_count = 0
                .unlinked_rows = []
                .ul_count = 0
            }
            // outline 行（ol_headings 等价推导：# 级别 + 围栏守卫 + 锚点/
            // 块 id 后缀剥除——blocks 源不可达，模式文档 §2 outline 行差异
            // 登记；body 取激活 tab 正文）。
            var hrows = ol_headings(.active_body)
            .outline_rows = hrows
            .outline_count = hrows.len()
            .status = "opened"
        }

        // 切换 = store Open 的激活臂（已 loaded 不重读磁盘）。键变重挂载
        // 读 content:（播种裁定见 .OpenFile 注）。PLAN-079 T-01：右栏面板
        // 随切换刷新（web 面板 watch activeTab 语义的装配对齐——此前切换后
        // 反链/出链停旧 tab 数据；handler 无自派发通道，刷新块与 .OpenFile
        // 重复一段 = G-3 同族约束注记）。
        .SwitchTab(path) -> {
            Tabs.Open({ path: path, title: "" })
            var t = .tabs.find(tt => tt.path == path)
            if t != null {
                .active_title = t.title
                .active_body = t.body
                .active_dirty = t.dirty
            }
            var doc_title = tab_file_stem(t)
            if doc_title != "" {
                var bl = get_backlinks(doc_title)
                var blLinks = bl.links
                .backlinks = blLinks
                .bl_count = blLinks.length
                var ol = get_outlinks(doc_title)
                var olLinks = ol.links
                .outlinks = olLinks
                .ol_count = olLinks.length
                var ur = get_unlinked_refs(doc_title)
                var urRefs = ur.refs
                .unlinked_rows = []
                for r in urRefs {
                    .unlinked_rows.push({ label: r.page_path, target: r.page_path })
                }
                .ul_count = urRefs.length
            }
            if doc_title == "" {
                .backlinks = []
                .bl_count = 0
                .outlinks = []
                .ol_count = 0
                .unlinked_rows = []
                .ul_count = 0
            }
            var hrows = ol_headings(.active_body)
            .outline_rows = hrows
            .outline_count = hrows.len()
            .status = "switched"
        }

        // 关闭：脏态由 store confirmClose 偏差默认确认即弃（P022-6 保形），
        // 状态行登记处置结果。派发前预读脏/标题供状态行。
        .CloseTab -> {
            var was_dirty = false
            var closed_title str = ""
            var has_active = .active_path != ""
            if has_active {
                var t = .tabs.find(tt => tt.path == .active_path)
                if t != null {
                    was_dirty = t.dirty
                    closed_title = t.title
                }
                Tabs.Close(.active_path)
                var t2 = .tabs.find(tt => tt.path == .active_path)
                if t2 != null {
                    .active_title = t2.title
                    .active_body = t2.body
                    .active_dirty = t2.dirty
                }
                if t2 == null {
                    .active_title = ""
                    .active_body = ""
                    .active_dirty = false
                }
            }
            if was_dirty {
                .status = f"discarded-dirty:${closed_title}"
            }
            if !was_dirty {
                if has_active {
                    .status = f"closed:${closed_title}"
                }
            }
        }

        // 键入：autodown_editor（PLAN-068 T-02，原 code_editor）的 content:
        // 绑定仅作初值/外部 diff 回写（单向，041 editor_store 同款），正文经
        // oninput 首参到达——真实键盘事件由渲染器发布携带全文的 input_value
        // （PLAN-057/PLAN-013 W2 通道），MCP type_text 经 INPUT_TEXT 注入首
        // 参（单参 handler + 空实参 + 通道非空；INPUT_TEXT 通道与 code_editor
        // 同约定，demo vm-smoke 实证）。oninput 落 store（dirty 由 store 按
        // original_body 判定）+ 镜像重同步；无 tab 时空文守卫（SetBody no-op
        // 面）。
        .Edit(text) -> {
            if .active_path != "" {
                .active_body = text
                Tabs.SetBody({ path: .active_path, body: text })
                var t = .tabs.find(tt => tt.path == .active_path)
                if t != null {
                    .active_dirty = t.dirty
                }
            }
        }

        .QChanged -> {
            .status = "typing"
        }

        // —— PLAN-079 T-02 批 B：palette/switcher 自持面板 handler ——
        // 命令行 = ui_config(actions) 重建清单（pal_match 过滤门 × 静态行
        // 绑定）；查询串经 value: 绑定自动回写，handler 仅打状态标。
        .OpenPalette -> {
            .palette_q = ""
            .palette_open = true
            .switcher_open = false
            .theme_open = false
            .status = "palette"
        }

        .ClosePalette -> {
            .palette_open = false
            .status = "palette-closed"
        }

        .PaletteQuery -> {
            .status = "palette-typing"
        }

        .OpenSwitcher -> {
            .switcher_q = ""
            .switcher_open = true
            .palette_open = false
            .theme_open = false
            .status = "switcher"
        }

        .CloseSwitcher -> {
            .switcher_open = false
            .status = "switcher-closed"
        }

        .SwitcherQuery -> {
            .status = "switcher-typing"
        }

        // —— PLAN-079 T-03 批 C：agenda/cpp/recent/theme 装配 handler ——
        // agenda = 全局日程（get_agenda(14) 默认窗口 = 后端 default_days），
        // ag_display 副本行构造（date raw 直下）+ 平铺行模型（右栏行渲染）。
        .LoadAgenda -> {
            var res = get_agenda(14)
            var groups = res.groups
            var rows = ag_display(groups)
            var flat List = []
            var gi int = 0
            while gi < rows.len() {
                var g = rows[gi]
                var ti int = 0
                while ti < g.tasks.len() {
                    flat.push(g.tasks[ti])
                    ti = ti + 1
                }
                gi = gi + 1
            }
            .agenda_rows = flat
            .agenda_count = flat.len()
            .status = "agenda-loaded"
        }

        // cpp 建页确认（web create_page_prompt 对位——**孤儿组件无消费者**
        // 在案 077 §6.3：后端 outlinks 的 exists 恒真（linkgraph targetPage
        // 永为非空裸标题 → is_some 恒 true，本轮 API 实勘），缺失出链分支
        // 双端皆死路——desktop 装配走自持入口：文件菜单「新建页面」→
        // 面板（标题输入 + Create/Cancel）。wikiTitleToPath regex 桥不镜像
        // ——desktop 直拼 ${title}.ad，fixture 域等价，差异登记模式文档
        // §2 批 C 表）。
        .OpenCpp -> {
            .cpp_input = ""
            .cpp_open = true
            .status = "cpp-open"
        }

        .CppQuery -> {
            .status = "cpp-typing"
        }

        .CppCreate -> {
            if .cpp_input == "" {
                .status = "cpp-empty"
            }
            if .cpp_input != "" {
                var new_path = f"${.cpp_input}.ad"
                create_file(new_path, false)
                .ft_nodes = to_fs_nodes(list_files("", true))
                .cpp_open = false
                Tabs.Open({ path: new_path, title: "" })
                var t = .tabs.find(tt => tt.path == new_path)
                if t != null {
                    .active_title = t.title
                    .active_body = t.body
                    .active_dirty = t.dirty
                }
                .status = "cpp-created"
            }
        }

        .CppCancel -> {
            .cpp_open = false
            .status = "cpp-cancelled"
        }

        // theme 面板（web theme_popover 对位；应用通道差异：web =
        // documentElement.classList，desktop = AUTO_UI_THEME env 域——
        // 渲染器启动时消费，运行时应用为壳层后续面；状态单源在本 model，
        // desktop README §2 matchMedia 裁定同族口径）。
        .ThemeOpen -> {
            .theme_open = true
            .palette_open = false
            .switcher_open = false
            .status = "theme-open"
        }

        .ThemeClose -> {
            .theme_open = false
            .status = "theme-closed"
        }

        .SetThemeMode(mode) -> {
            .theme_mode = mode
            .status = f"theme-${mode}"
        }

        .SetAccent(key) -> {
            .theme_accent = key
            .status = f"accent-${key}"
        }

        // 保存：store Save 面（write_wiki 经 #[api] → 340 HTTP；回声
        // 采纳 adopt_save_result 防在途编辑被回声覆盖——022 Phase 3 语义）。
        .Save -> {
            Tabs.Save(.active_path)
            var t = .tabs.find(tt => tt.path == .active_path)
            if t != null {
                .active_body = t.body
                .active_dirty = t.dirty
            }
            .save_note = "saved"
            .status = "saved"
        }

        .LoadCards -> {
            var res = get_due_cards(20)
            .cards = res.cards
            .status = "cards-loaded"
        }

        .Grade(page_path, block_id, grade) -> {
            var res = review_card(page_path, block_id, grade)
            .review_note = "graded:" + res.card.block_id
            var res2 = get_due_cards(20)
            .cards = res2.cards
            .status = "graded"
        }

        .DoSearch -> {
            var res = search_pages(.search_q, 20)
            var hits = res.results
            .hit_count = hits.length
            .search_rows = []
            for h in hits {
                .search_rows.push({ label: h.title, target: h.path })
            }
            .status = "searched"
        }

        // 导入导出（D4 裁定：原生直连，不经 #[api] JSON 改写）。v1 导出/
        // 导入路径为探针常量——目录/文件选择器宿主能力就位后替换（README §7.1）。
        // （PLAN-064 T-03：旧 .worktree/plan-022 路径随归档失效，改 tmp/jade-probe。）
        .ExportWs -> {
            let res = http.request("GET", "http://127.0.0.1:8199/api/export/markdown").send()
            let n = res.body_to_file("D:/autostack/auto-down/tmp/jade-probe/desktop-export.zip")
            .io_note = "exported"
            .status = "exported"
        }

        .ImportZip -> {
            let rb0 = http.request("POST", "http://127.0.0.1:8199/api/import/markdown")
            let rb = rb0.multipart_file("archive", "D:/autostack/auto-down/tmp/jade-probe/desktop-import.zip")
            let res = rb.send()
            .io_note = res.body()
            .status = "imported"
        }

        .LoadGraph -> {
            var g = get_graph()
            var nodes = g.nodes
            var edges = g.edges
            .graph_edges = edges.length
            .graph_rows = []
            for n in nodes {
                .graph_rows.push({ label: n.label, target: n.path })
            }
            .status = "graph-loaded"
        }
    }

    view {
        col {
            class: "flex h-full flex-col gap-2 p-3 bg-background text-foreground",
            // PLAN-067 T-02: menubar 三菜单（Plan 630 组件族，VM=Popover
            // lowering）+ toolbar 空标签 = actions DSL 配置合成（041 同款）。
            // 菜单分面（§5.2）：文件=open/save/close；视图=reload（console
            // 位预留）；卡片=cards/graph/export/import。状态行/脏标留顶排。
            row {
                class: "flex items-center gap-2",
                menubar (class: "items-center") {
                    menubar-menu (value: "file") {
                        menubar-trigger "文件"
                        menubar-content {
                            menubar-item (title: "打开工作区", icon: "folder-open", shortcut: "Ctrl+O") { onclick: .OpenWs }
                            // PLAN-079 T-03 批 C：cpp 建页面板入口（自持——
                            // 孤儿组件/exists 恒真死路面注记见 .OpenCpp）。
                            menubar-item (title: "新建页面", icon: "file-plus") { onclick: .OpenCpp }
                            menubar-item (title: "保存", icon: "save", shortcut: "Ctrl+S", enabled: .active_title != "") { onclick: .Save }
                            menubar-item (title: "关闭标签", icon: "x", shortcut: "Ctrl+W") { onclick: .CloseTab }
                        }
                    }
                    menubar-menu (value: "view") {
                        menubar-trigger "视图"
                        menubar-content {
                            menubar-item (title: "重载文件列表", icon: "refresh-cw", shortcut: "F5") { onclick: .LoadFiles }
                            menubar-item (title: "命令面板", icon: "command", shortcut: "Ctrl+P") { onclick: .OpenPalette }
                            menubar-item (title: "快速切换", icon: "search", shortcut: "Ctrl+K") { onclick: .OpenSwitcher }
                            // PLAN-079 T-03 批 C：agenda 装载 + theme 面板入口。
                            menubar-item (title: "日程", icon: "calendar-days") { onclick: .LoadAgenda }
                            menubar-item (title: "主题", icon: "palette") { onclick: .ThemeOpen }
                            // console 位预留（041 同款；jade v1 无 console 面板）
                        }
                    }
                    menubar-menu (value: "cards") {
                        menubar-trigger "卡片"
                        menubar-content {
                            menubar-item (title: "加载卡片", icon: "layers") { onclick: .LoadCards }
                            menubar-item (title: "加载图谱", icon: "share-2") { onclick: .LoadGraph }
                            menubar-separator
                            menubar-item (title: "导出工作区", icon: "download") { onclick: .ExportWs }
                            menubar-item (title: "导入归档", icon: "upload") { onclick: .ImportZip }
                        }
                    }
                }
                toolbar (class: "ml-auto") {}
                text .io_note
                if .active_dirty {
                    text "● unsaved"
                }
            }
            row {
                class: "flex flex-1 gap-3 overflow-hidden",
                col {
                    class: "w-44 shrink-0 gap-1 overflow-auto border-r pr-2",
                    // PLAN-067 T-03: FileTree 树行（041 components/filetree.at
                    // 同款行结构）在根视图直接渲染——vm 组件子树对 MCP 快照
                    // 不可见（041 README「vm 组件边界」②）且 MCP press 组件行
                    // 在 VM 轨静默崩溃（auto-lang P614-C1 在册债务，P618-D4
                    // 家族），smoke 定位/驱动的文件导航留根（PLAN-067 §2 约束
                    // ②）；行派生/图标复用移植件 flatten_tree/TreeIcon。
                    for r in .ft_rows {
                        row {
                            class: "items-center",
                            for g in r.guides {
                                if g == "l" {
                                    div (style: "w-4 h-6 flex items-center justify-center") {
                                        div (style: "w-px h-6 bg-border") {}
                                    }
                                } else {
                                    div (style: "w-4 h-6") {}
                                }
                            }
                            if r.has_kids {
                                mouse-area (onclick: .FtToggle(r.id), style: "w-5 h-5 shrink-0 items-center justify-center cursor-pointer") {
                                    if r.open {
                                        icon (name: "chevron-down", style: "w-3.5 h-3.5 text-muted-foreground") {}
                                    } else {
                                        icon (name: "chevron-right", style: "w-3.5 h-3.5 text-muted-foreground") {}
                                    }
                                }
                            } else {
                                div (style: "w-5 shrink-0") {}
                            }
                            TreeIcon (name: r.icon) {}
                            button (text: r.label, variant: "text") {
                                onclick: .OpenFile(r.id)
                                style: "flex-1 px-1 text-left text-sm"
                            }
                        }
                    }
                }
                col {
                    class: "flex flex-1 flex-col gap-2",
                    // —— PLAN-079 T-02 批 B：命令面板（静态命令行 × pal_match
                    // 过滤门；命令清单 = actions 注册表 ui_config 单源重建，
                    // 076 §4.1 裁定；Enter/方向键 = window 级键盘域不装配，
                    // 差异登记模式文档 §2）。 ——
                    if .palette_open {
                        col {
                            class: "border rounded p-2 gap-1 bg-muted/20",
                            row {
                                class: "gap-2 items-center",
                                input (value: .palette_q, placeholder: "命令…") {
                                    oninput: .PaletteQuery
                                }
                                button "关闭" { onclick: .ClosePalette }
                            }
                            if .pal_f_open { button (text: "打开工作区") { onclick: .OpenWs } }
                            if .pal_f_reload { button (text: "重载文件列表") { onclick: .LoadFiles } }
                            if .pal_f_save { button (text: "保存") { onclick: .Save } }
                            if .pal_f_close { button (text: "关闭标签") { onclick: .CloseTab } }
                            if .pal_f_cards { button (text: "加载卡片") { onclick: .LoadCards } }
                            if .pal_f_graph { button (text: "加载图谱") { onclick: .LoadGraph } }
                            if .pal_f_export { button (text: "导出工作区") { onclick: .ExportWs } }
                            if .pal_f_import { button (text: "导入归档") { onclick: .ImportZip } }
                        }
                    }
                    // —— 快速切换器（sw_collect×sw_filter 下沉 fn 真消费，
                    // 行点击 = .OpenFile 开页）。 ——
                    if .switcher_open {
                        col {
                            class: "border rounded p-2 gap-1 bg-muted/20",
                            row {
                                class: "gap-2 items-center",
                                input (value: .switcher_q, placeholder: "切换到文件…") {
                                    oninput: .SwitcherQuery
                                }
                                button "关闭" { onclick: .CloseSwitcher }
                            }
                            for f in .switcher_rows {
                                button (text: f.name) {
                                    onclick: .OpenFile(f.id)
                                    style: "text-left text-[12px] text-zinc-300"
                                }
                            }
                        }
                    }
                    // —— 批 C：cpp 建页面板（web create_page_prompt 对位
                    //——自持入口：文件菜单「新建页面」；标题输入 + Create/
                    // Cancel；exists 恒真死路面注记见 .OpenCpp）。 ——
                    if .cpp_open {
                        col {
                            class: "border rounded p-2 gap-1 bg-muted/20",
                            text "Create missing page?" { style: "text-[12px] text-zinc-300" }
                            row {
                                class: "gap-2 items-center",
                                input (value: .cpp_input, placeholder: "页面标题…") {
                                    oninput: .CppQuery
                                }
                                button "Create" { onclick: .CppCreate }
                                button "Cancel" { onclick: .CppCancel }
                            }
                        }
                    }
                    // —— 批 C：theme 面板（web theme_popover 对位——Light/
                    // Dark 模式 + theme_accents 副本五 accent 行；运行时应用
                    // 差异登记，见 .ThemeOpen 注）。 ——
                    if .theme_open {
                        col {
                            class: "border rounded p-2 gap-1 bg-muted/20",
                            row {
                                class: "gap-2 items-center",
                                text "theme" { style: "text-[11px] text-zinc-500 tracking-wider" }
                                button "Light" { onclick: .SetThemeMode("light") }
                                button "Dark" { onclick: .SetThemeMode("dark") }
                                button "关闭" { onclick: .ThemeClose }
                            }
                            row {
                                class: "gap-1 flex-wrap",
                                for a in .theme_rows {
                                    button (text: a.label) {
                                        onclick: .SetAccent(a.key)
                                        style: "text-[11px] text-zinc-400"
                                    }
                                }
                            }
                        }
                    }
                    // PLAN-068 T-01: tab 条 041 化（041 app.at 同款双分支——
                    // Plan 449：view fn 片段参数化条件不求值，激活/非激活须
                    // 双分支）。x 钮 = 零参 .CloseTab（活动 tab 语义，x 只在
                    // 激活行在场）；041 的 "+" 新建钮不移植（六流无新建流，
                    // PLAN-068 §5.1 裁定）。smoke 定位锚不变：tab 按钮仍
                    // ownText = title（x 为 icon 钮无文本）。
                    row {
                        class: "h-8 items-center bg-muted/30 shrink-0 w-full gap-0",
                        for t in .tabs {
                            if t.path == .active_path {
                                // 括号 style: 形式（041 同款）——class 括号形
                                // 式遇 bg-[#1C1D24] 任意值会整串丢弃（T-01
                                // 实机快照实证），故内层行走 style:。
                                row (style: "items-center bg-[#1C1D24]") {
                                    button (text: t.title, variant: "text") {
                                        onclick: .SwitchTab(t.path)
                                        style: "h-8 px-3 text-[12px] text-zinc-200 font-medium"
                                    }
                                    if t.dirty {
                                        text "*" { style: "text-[12px] text-amber-400 mr-1" }
                                    }
                                    button (variant: "text") {
                                        icon (name: "x", style: "h-3 w-3 text-zinc-500") {}
                                        onclick: .CloseTab
                                        style: "h-7 w-6 px-0 py-0 mr-2"
                                    }
                                }
                            }
                            if t.path != .active_path {
                                row (style: "items-center") {
                                    button (text: t.title, variant: "text") {
                                        onclick: .SwitchTab(t.path)
                                        style: "h-8 px-3 text-[12px] text-zinc-500"
                                    }
                                    if t.dirty {
                                        text "*" { style: "text-[12px] text-amber-400 mr-1" }
                                    }
                                }
                            }
                        }
                    }
                    col (class: "h-px w-full bg-border shrink-0") {}
                    if .active_title != "" {
                        // PLAN-068 T-02: 正文 = autodown_editor（AutoDown 块
                        // 编辑器，PLAN-066 NativeWidgetRegistry 原生外部件；
                        // 形态模板 = autodown/demo/auto 左栏）。key 按 tab
                        // path 注册——key 变即重挂载读 content:（播种通道，
                        // README §9.2 口径标签无关平移）；oninput: .Edit 单参
                        // 全文回写（INPUT_TEXT 通道与 code_editor 同约定，
                        // demo vm-smoke 实证）。final: true = 文档恒终态（无
                        // 流式语义）。不调用任何 autodown_* 内建（041④ 坏字
                        // 节码红线，读路径由 .Edit 载荷覆盖）。
                        autodown_editor (key: .active_path, final: true, style: "flex-1 w-full") {
                            content: .active_body
                            oninput: .Edit
                        }
                    } else {
                        // 空态定位锚（041 同款形态；smoke/人工导航锚点）。
                        col (style: "flex-1 w-full items-center justify-center") {
                            text "没有打开的文档 — 从左侧文件树打开" {
                                style: "text-[13px] text-zinc-500"
                            }
                        }
                    }
                    text .save_note
                }
                col {
                    class: "w-56 shrink-0 gap-1 overflow-auto border-l pl-2",
                    // —— 反链/出链面板（PLAN-067 T-05 整形：结构/handler
                    // 不动，标准 col/row/class + 计数徽标文本）——
                    row {
                        class: "gap-1 items-center",
                        text "backlinks" { style: "text-[11px] text-zinc-500 tracking-wider" }
                        text .bl_count { style: "text-[11px] text-zinc-500" }
                    }
                    for b in .backlinks {
                        button (text: b.source_title) {
                            onclick: .OpenFile(b.source_path)
                        }
                    }
                    row {
                        class: "gap-1 items-center",
                        text "outlinks" { style: "text-[11px] text-zinc-500 tracking-wider" }
                        text .ol_count { style: "text-[11px] text-zinc-500" }
                    }
                    for o in .outlinks {
                        if o.exists {
                            button (text: o.target_title) {
                                onclick: .OpenFile(o.target_path)
                            }
                        }
                        // 缺失目标行维持非交互 text：后端 outlinks exists 恒真
                        //（linkgraph targetPage 裸标题 → is_some 恒 true，
                        // T-03 实勘），该分支为 web 同款死路面——cpp 建页
                        // 走文件菜单自持入口（.OpenCpp 注记）。
                        if !o.exists {
                            text o.target_title
                        }
                    }
                    // —— PLAN-079 T-01 批 A 装配：outline 行（ol_headings
                    // 等价推导产物，级别缩进行）+ unlinked 行（契约直拉，
                    // 高亮 html = vue 显示面不镜像——模式文档 §2）。 ——
                    row {
                        class: "gap-1 items-center",
                        text "outline" { style: "text-[11px] text-zinc-500 tracking-wider" }
                        text .outline_count { style: "text-[11px] text-zinc-500" }
                    }
                    for h in .outline_rows {
                        // 行非交互：web 的 dispatchScrollToHeading = window
                        // 级 ext 桥（VM 无 scroll_to 通道，desktop README §2
                        // dom-walk 滚动定位候选）——点击面不装配，差异登记。
                        text h.content { style: h.rowstyle }
                    }
                    row {
                        class: "gap-1 items-center",
                        text "unlinked" { style: "text-[11px] text-zinc-500 tracking-wider" }
                        text .ul_count { style: "text-[11px] text-zinc-500" }
                    }
                    for u in .unlinked_rows {
                        button (text: u.label) {
                            onclick: .OpenFile(u.target)
                        }
                    }
                    row {
                        class: "gap-1 items-center",
                        text "due cards" { style: "text-[11px] text-zinc-500 tracking-wider" }
                        text .review_note { style: "text-[11px] text-zinc-500" }
                    }
                    for c in .cards {
                        col {
                            class: "gap-1 border-b pb-1",
                            text c.question
                            row {
                                class: "gap-1",
                                button "again" { onclick: .Grade(c.page_path, c.block_id, 1) }
                                button "good" { onclick: .Grade(c.page_path, c.block_id, 3) }
                            }
                        }
                    }
                    // —— 批 C：agenda 行（视图菜单装载，ag_display 副本；
                    // date raw 直下——formatDate Q-3 桥差异）+ recent 会话
                    // 行（rf_rows 副本）。 ——
                    row {
                        class: "gap-1 items-center",
                        text "agenda" { style: "text-[11px] text-zinc-500 tracking-wider" }
                        text .agenda_count { style: "text-[11px] text-zinc-500" }
                    }
                    for a in .agenda_rows {
                        row {
                            class: "gap-1 items-center",
                            text a.marker { style: "text-[10px] text-amber-400" }
                            text a.line { style: "text-[12px] text-zinc-300" }
                            text a.date { style: "text-[10px] text-zinc-600" }
                        }
                    }
                    row {
                        class: "gap-1 items-center",
                        text "recent" { style: "text-[11px] text-zinc-500 tracking-wider" }
                        text .recent_count { style: "text-[11px] text-zinc-500" }
                    }
                    for rc in .recent_rows {
                        button (text: rc.label) {
                            onclick: .OpenFile(rc.target)
                        }
                    }
                }
            }
            row {
                class: "flex items-center gap-2 border-t pt-2",
                input (value: .search_q, placeholder: "search") {
                    oninput: .QChanged
                }
                button "search" { onclick: .DoSearch }
                text .hit_count
                text "graph-edges"
                text .graph_edges
            }
            row {
                class: "flex flex-wrap gap-1 overflow-auto",
                for r in .search_rows {
                    button (text: r.label) {
                        onclick: .OpenFile(r.target)
                    }
                }
                for n in .graph_rows {
                    button (text: n.label) {
                        onclick: .OpenFile(n.target)
                    }
                }
            }
            // PLAN-067 T-05: StatusBar 组件（值 props——组件子树快照不可见，
            // smoke 断言走根态字段；prop 名与模型字段错开防 P320 撞名面）。
            StatusBar (status_text: .status, root_path: .root, bl: .bl_count, ol: .ol_count) {}
        }
    }
}
