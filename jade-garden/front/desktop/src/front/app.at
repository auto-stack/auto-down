// app.at — jade-garden 桌面（PLAN-064 T-05：tabs 编辑器流 VM 化）。
//
// 六流面板保持 slice 5 形态（open-ws/文件树/反链出链/闪卡/图谱/搜索/导入
// 导出）；编辑区升级为多 tab 流：打开/切换/关闭/保存/脏守卫五断言语义
// （022 Phase 3 双读竞争防护同款）。
//
// 实现形态裁定（T-05 执行期实证，2026-09-14）：tabs_store.at facade 的
// VM 面存在缺口簇——①widget handler 内读 store 字段失效（Edit/Save 的
// 参数表达式得 0/""）；②视图对 store 字段不响应式回读（初始 "" 后冻结）；
// ③store 模块内 #[api] 调用未走 340 HTTP 改写（静默执行契约 stub
// return None——read/write 均不落盘）。派发（带字面参数）、two-way 写入、
// autoui_state 桥反而可用。据此 tabs 流 v1 = widget 状态机等价实现（全部
// 骨架已证面）；store facade 迁移前置 = auto-lang 修复（README §8 提案⑥），
// tabs_store.at 仍是 web 轨状态机（T-04 收缩面不变）。
// 确认语义登记偏差：VM 无 confirm 模态，脏态关闭默认确认即弃（P022-6
// 既定保形），状态行 discarded-dirty 登记。
// VM lambda 捕获面（T-05 实测）：捕获 msg 参数可用；捕获 handler 本地
// 变量 = undefined variable 编译错——归一化值经参数重赋值承载。
//
// auto-lang 登记项沿用（slice 3/5）：self 字段链 .field.length 在 handler
// 中求值异常 → 长度经本地变量取；混合 search 的 .type 撞名 → v1 用
// search_pages。

use back.api: open_workspace, list_files, read_wiki, write_wiki, get_due_cards, review_card, get_backlinks, get_outlinks, get_graph, search_pages
use auto.http

widget App {
    msg { Init, OpenWs, LoadFiles, OpenFile(str), Edit, Save, CloseTab, SwitchTab(str), LoadCards, Grade(str, str, int), QChanged, DoSearch, LoadGraph, ExportWs, ImportZip }

    model {
        var status str = "boot"
        var root str = ""
        var files = []
        // —— tabs 状态机（widget 本地；022 Phase 3 语义的字段级移植）——
        var open_maps = []
        var active_path str = ""
        var active_title str = ""
        var active_body str = ""
        var active_dirty bool = false
        var save_note str = ""
        var cards = []
        var review_note str = ""
        var backlinks = []
        var outlinks = []
        var bl_count int = 0
        var ol_count int = 0
        var search_q str = ""
        var search_rows = []
        var hit_count int = 0
        var graph_rows = []
        var graph_edges int = 0
        var io_note str = ""
    }

    on {
        .Init -> {
            .status = "ready"
        }

        .OpenWs -> {
            var res = open_workspace("D:/autostack/auto-down/tmp/wiki-demo")
            .root = res.root
            .files = list_files("", false)
            .status = "ws-open"
        }

        .LoadFiles -> {
            .files = list_files("", false)
            .status = "files-reloaded"
        }

        // 归一化：反链/出链源的 source_path 实为页标题（无 .ad 后缀，
        // T-05 实测）——补后缀归一到真实文档路径，避免同一文档建出第二个
        // tab（标题路径 tab 的正文读数会得 nil）。归一值经参数重赋值承载
        // （lambda 捕获本地变量 = 编译错，见头注）。
        .OpenFile(path) -> {
            var parts = path.split(".ad")
            var seg_count = parts.len()
            if seg_count == 1 {
                path = f"${path}.ad"
            }
            // ⑤ 双读竞争防护（022 Phase 3）：已 loaded 且未关闭的 tab 重复
            // Open 只激活不重读——在途编辑不被磁盘回读覆盖。closed 行视同
            // 不存在（for+双条件守卫；find 的 lambda 无法表达合取）。
            var open_path str = ""
            var open_body str = ""
            var open_dirty = false
            for t in .open_maps {
                if t.path == path && t.closed != true {
                    open_path = t.path
                    open_body = t.body
                    open_dirty = t.dirty
                }
            }
            if open_path != "" {
                .active_path = open_path
                var parts = path.split(".ad")
                .active_title = parts[0]
                .active_body = open_body
                .active_dirty = open_dirty
            }
            if open_path == "" {
                var doc = None
                try {
                    doc = read_wiki(path)
                } catch (e) {
                    doc = None
                }
                var parts = path.split(".ad")
                .open_maps.push({ path: path, title: parts[0], body: "", original_body: "", frontmatter: {}, dirty: false, loaded: false, closed: false })
                for t in .open_maps {
                    if t.path == path && t.closed != true {
                        if doc != null {
                            t.body = doc.body
                            t.original_body = doc.body
                            t.frontmatter = doc.frontmatter
                            t.loaded = true
                        }
                        if doc == null {
                            t.loaded = true
                            t.original_body = t.body
                        }
                        open_body = t.body
                    }
                }
                .active_path = path
                .active_title = parts[0]
                .active_body = open_body
                .active_dirty = false
            }
            var bl = get_backlinks(.active_title)
            var blLinks = bl.links
            .backlinks = blLinks
            .bl_count = blLinks.length
            var ol = get_outlinks(.active_title)
            var olLinks = ol.links
            .outlinks = olLinks
            .ol_count = olLinks.length
            .status = "opened"
        }

        // ② 切换：从 tab 状态回读正文（不重读磁盘——已 loaded 语义）
        .SwitchTab(path) -> {
            var t = .open_maps.find(tt => tt.path == path)
            if t != null {
                .active_path = path
                var parts = path.split(".ad")
                .active_title = parts[0]
                .active_body = t.body
                .active_dirty = t.dirty
                .status = "switched"
            }
        }

        // ③ 关闭活动 tab：VM 无 confirm 模态（偏差登记）——脏态默认确认
        // 即弃，状态行登记处置结果。邻居激活规则同 022（Math.min 邻位）。
        .CloseTab -> {
            // 标记删除：VM 对 widget 模型数组的 splice 静默失效（T-05 实测），
            // 改写 closed 标志；视图过滤 closed 行，OpenFile 视已关闭为不存在。
            var closed_path str = ""
            var closed_title str = ""
            var was_dirty = false
            for t in .open_maps {
                if t.path == .active_path {
                    t.closed = true
                    was_dirty = t.dirty
                    closed_path = t.path
                    closed_title = t.title
                }
            }
            if closed_path != "" {
                if was_dirty {
                    .status = f"discarded-dirty:${closed_title}"
                }
                if !was_dirty {
                    .status = f"closed:${closed_title}"
                }
                var last_open str = ""
                for t in .open_maps {
                    if t.closed != true {
                        last_open = t.path
                    }
                }
                if last_open != "" {
                    .active_path = last_open
                    var parts = last_open.split(".ad")
                    .active_title = parts[0]
                    for t in .open_maps {
                        if t.path == last_open {
                            .active_body = t.body
                            .active_dirty = t.dirty
                        }
                    }
                }
                if last_open == "" {
                    .active_path = ""
                    .active_title = ""
                    .active_body = ""
                    .active_dirty = false
                }
            }
        }

        // 键入：textarea 双向绑定写 .active_body；oninput 同步进 tab 状态
        .Edit -> {
            for t in .open_maps {
                if t.path == .active_path && t.closed != true {
                    t.body = .active_body
                    t.dirty = t.body != t.original_body
                }
            }
            .active_dirty = true
        }

        .QChanged -> {
            .status = "typing"
        }

        // ④ 保存：write_wiki 直写（#[api] → 340 HTTP）+ 回声采纳（CAS：
        // 保存往返期间用户又键入 → 回声不覆盖在途编辑）
        .Save -> {
            for t in .open_maps {
                if t.path == .active_path && t.closed != true {
                    var sent_body = .active_body
                    var saved = write_wiki(.active_path, t.frontmatter, sent_body)
                    t.original_body = sent_body
                    t.body = .active_body
                    if t.body == sent_body {
                        t.body = saved.body
                        t.original_body = saved.body
                        .active_body = saved.body
                    }
                    t.frontmatter = saved.frontmatter
                    t.dirty = false
                    .active_dirty = false
                    .save_note = "saved"
                    .status = "saved"
                }
            }
        }

        .LoadCards -> {
            var res = get_due_cards(20)
            .cards = res.cards
            .status = "cards-loaded"
        }

        .Grade(page_path, block_id, grade) -> {
            var res = review_card(page_path, block_id, grade)
            .review_note = "graded:" + res.card.block_id
            var res2 = get_due_cards(20)
            .cards = res2.cards
            .status = "graded"
        }

        .DoSearch -> {
            // v1 用页搜索（title/path 全字段在场）。混合 search 的扁平联合
            // 在 VM 侧有两组坑：`.type` 撞 DSL 元属性；缺席字段读出 0 哨兵
            // 而非 null，存在性分支不可靠——均已登记。
            var res = search_pages(.search_q, 20)
            var hits = res.results
            .hit_count = hits.length
            .search_rows = []
            for h in hits {
                .search_rows.push({ label: h.title, target: h.path })
            }
            .status = "searched"
        }

        // 导入导出（D4 裁定：原生直连，不经 #[api] JSON 改写）。v1 导出/
        // 导入路径为探针常量——目录/文件选择器宿主能力就位后替换（README §7.1）。
        // （PLAN-064 T-03：旧 .worktree/plan-022 路径随归档失效，改 tmp/jade-probe。）
        .ExportWs -> {
            let res = http.request("GET", "http://127.0.0.1:8199/api/export/markdown").send()
            let n = res.body_to_file("D:/autostack/auto-down/tmp/jade-probe/desktop-export.zip")
            .io_note = "exported"
            .status = "exported"
        }

        .ImportZip -> {
            let rb0 = http.request("POST", "http://127.0.0.1:8199/api/import/markdown")
            let rb = rb0.multipart_file("archive", "D:/autostack/auto-down/tmp/jade-probe/desktop-import.zip")
            let res = rb.send()
            .io_note = res.body()
            .status = "imported"
        }

        .LoadGraph -> {
            var g = get_graph()
            var nodes = g.nodes
            var edges = g.edges
            .graph_edges = edges.length
            .graph_rows = []
            for n in nodes {
                .graph_rows.push({ label: n.label, target: n.path })
            }
            .status = "graph-loaded"
        }
    }

    view {
        col {
            class: "flex h-full flex-col gap-2 p-3 bg-background text-foreground",
            row {
                class: "flex items-center gap-2",
                button "open-ws" { onclick: .OpenWs }
                button "reload-files" { onclick: .LoadFiles }
                button "save" { onclick: .Save }
                button "close-tab" { onclick: .CloseTab }
                button "cards" { onclick: .LoadCards }
                button "graph" { onclick: .LoadGraph }
                button "export-ws" { onclick: .ExportWs }
                button "import-zip" { onclick: .ImportZip }
                text .status
                text .io_note
                if .active_dirty {
                    text "● unsaved"
                }
            }
            row {
                class: "flex flex-1 gap-3 overflow-hidden",
                col {
                    class: "w-44 shrink-0 gap-1 overflow-auto border-r pr-2",
                    for f in .files {
                        button (text: f.name) {
                            onclick: .OpenFile(f.path)
                        }
                    }
                }
                col {
                    class: "flex flex-1 flex-col gap-2",
                    row {
                        class: "flex flex-wrap gap-1",
                        for t in .open_maps {
                            if t.closed != true {
                                button (text: t.title) {
                                    onclick: .SwitchTab(t.path)
                                }
                            }
                        }
                    }
                    if .active_path != "" {
                        textarea (value: .active_body, placeholder: "edit markdown here") {
                            oninput: .Edit
                        }
                    }
                    text .save_note
                }
                col {
                    class: "w-56 shrink-0 gap-1 overflow-auto border-l pl-2",
                    row {
                        class: "gap-1",
                        text "backlinks"
                        text .bl_count
                    }
                    for b in .backlinks {
                        button (text: b.source_title) {
                            onclick: .OpenFile(b.source_path)
                        }
                    }
                    row {
                        class: "gap-1",
                        text "outlinks"
                        text .ol_count
                    }
                    for o in .outlinks {
                        if o.exists {
                            button (text: o.target_title) {
                                onclick: .OpenFile(o.target_path)
                            }
                        }
                        if !o.exists {
                            text o.target_title
                        }
                    }
                    text "due cards"
                    text .review_note
                    for c in .cards {
                        col {
                            class: "gap-1 border-b pb-1",
                            text c.question
                            row {
                                class: "gap-1",
                                button "again" { onclick: .Grade(c.page_path, c.block_id, 1) }
                                button "good" { onclick: .Grade(c.page_path, c.block_id, 3) }
                            }
                        }
                    }
                }
            }
            row {
                class: "flex items-center gap-2 border-t pt-2",
                input (value: .search_q, placeholder: "search") {
                    oninput: .QChanged
                }
                button "search" { onclick: .DoSearch }
                text .hit_count
                text "graph-edges"
                text .graph_edges
            }
            row {
                class: "flex flex-wrap gap-1 overflow-auto",
                for r in .search_rows {
                    button (text: r.label) {
                        onclick: .OpenFile(r.target)
                    }
                }
                for n in .graph_rows {
                    button (text: n.label) {
                        onclick: .OpenFile(n.target)
                    }
                }
            }
        }
    }
}
