// panels_c_fns.at — L3 装配批 C fn 部署副本（PLAN-079 T-03）。
//
// 形态依据：docs/plans/attachments/079-l3-assembly-mode.md §2（行族 β 装配
// / 交互独立面 β 变体 desktop 自持；Q-3 桥域差异注记）。

// ag_display — derived-from front/auto/src/front/agenda_panel.at 模块 fn
// agenda_display（PLAN-077 T-02 sink）。适配两处：①for-in → while+索引
//（P614 desktop 纪律，to_fs_nodes 同款）；②formatted_date 的 ext
// formatDate 桥（Q-3 locale/Date = TS 域）→ date raw 直下（消费侧日期显示
// 走 raw 的登记表口径）。marker 三态 if 链/to_upper ASCII 域/
// `title || page_path` 显式双守卫 = 原形。
fn ag_display(groups_in) List {
    var out List = []
    var gi int = 0
    while gi < groups_in.len() {
        var g = groups_in[gi]
        var tasks List = []
        var ti int = 0
        while ti < g.tasks.len() {
            var tk = g.tasks[ti]
            var mu = tk.marker.to_upper()
            var muted = false
            var primary = false
            var done = false
            if mu == "DOING" || mu == "NOW" {
                primary = true
            }
            if mu == "DONE" {
                done = true
            }
            if mu != "DOING" && mu != "NOW" && mu != "DONE" {
                muted = true
            }
            var line = tk.page_path
            if tk.title != null && tk.title != "" {
                line = tk.title
            }
            tasks.push({
                page_path: tk.page_path,
                marker: tk.marker,
                content: tk.content,
                marker_muted: muted,
                marker_primary: primary,
                marker_done: done,
                line: line,
                date: g.date,
            })
            ti = ti + 1
        }
        out.push({ date: g.date, tasks: tasks })
        gi = gi + 1
    }
    return out
}

// rf_rows — derived-from front/auto/src/front/recent_files_panel.at 模块 fn
// recent_files_with_time（PLAN-077 T-01 sink）。适配：desktop 无
// recentFiles store（recordRecent = no-op 登记偏差）→ 会话自记账 entries
// [{path, title}]；openedAt/formatTime = Date/locale TS 域（Q-3）不入 VM，
// 行 = title/path 直下（时间列差异登记模式文档 §2 批 C 表）。
fn rf_rows(entries) List {
    var rows List = []
    var i int = 0
    while i < entries.len() {
        var e = entries[i]
        var label = e.path
        if e.title != null && e.title != "" {
            label = e.title
        }
        rows.push({ label: label, target: e.path })
        i = i + 1
    }
    return rows
}

// theme_accents — derived-from front/auto/src/front/theme_popover.at 模块
// fn theme_accents（PLAN-077 T-01 sink，Q-4 静态 Obj 字面量列表——VM 全键
// 形状锁定域实证）。逐字副本：五 accent 单源（web/desktop 各自声明，
// desktop 侧五 accent 单源 = 本副本，登记表口径）。
fn theme_accents() List {
    return [
        { key: "indigo", label: "Indigo", color: "hsl(238 55% 58%)" },
        { key: "emerald", label: "Emerald", color: "hsl(160 60% 38%)" },
        { key: "rose", label: "Rose", color: "hsl(350 70% 55%)" },
        { key: "amber", label: "Amber", color: "hsl(38 90% 50%)" },
        { key: "slate", label: "Slate", color: "hsl(220 10% 45%)" },
    ]
}
