// panels_d_fns.at — PLAN-080 T-01 批 D 装配：properties 行构造部署副本。
//
// derived-from: jade-garden/front/auto/src/front/properties_panel.at
// （sync_entries，PLAN-077 T-05 下沉 fn）——P-9 map 迭代禁面的配对通道
// 形状适配：web 侧 `for (k, raw) in fm` 在 vue 轨走 Object.entries、VM 轨
// 零迭代（077 模式注记）；desktop 以 backend frontmatter_pairs（YAML 映射
// 序，PLAN-080 T-01 加法契约）直接构造行，绕开 map 迭代。只读 v1：
// 编辑面（commitFrontmatter/setEntryType = typeof/Array.isArray 无词位的
// vue strict 域）差异登记（079 模式文档 §2 批次 2 表）。
//
// 值显示：web 输入框的 DOM 文本 = JS String(value)（list → join(",")）；
// VM 侧 f-string 插值近似，list 值的串化形态若异 = 显示级差异（断言锚 =
// 行计数 + 键名 + 标量真值，不押 list 串化逐字节）。

fn prop_value_text(v) str {
    var out str = ""
    try {
        out = f"${v}"
    } catch (e) {
        out = ""
    }
    return out
}

fn props_rows(pairs List) List {
    var out List = []
    var i int = 0
    while i < pairs.len() {
        var p = pairs[i]
        out.push({ key: p.key, value_text: prop_value_text(p.value) })
        i = i + 1
    }
    return out
}
