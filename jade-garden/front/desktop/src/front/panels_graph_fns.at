// panels_graph_fns.at — PLAN-080 T-02 批 E 装配：graph 真渲染部署副本。
//
// derived-from: auto-lang examples/capability-tests/049-canvas-graph/src/
// front/app.at（环形布局 + 三表 CSV 构造——canvas 场景契约 v2，上游布局
// R-3：.at 侧生成坐标，渲染端只收绝对坐标；详规 auto-lang docs/specs/
// auto-lang/ui/design/canvas-scene.md）。消费登记：074-sink-mode §4.3
// graph_view 划出 078 → P661-D4 交接 → 本副本承接（desktop 面 cytoscape
// 退役）。078 graph_sidebar/graph_controls 下沉 fn 副本随 T-03 扩入本档。
//
// 形态：get_graph nodes[{id,label,path,exists,degree}]/edges[{source,
// target}]（id=path、edge 端点=path——linkgraph 双端已解析页语义）→
// 环形布局（n 均分 2π，coords 500x500 逻辑域，R=190，049 SetRadius
// 同族）→ 三表。settings 消费面（T-03）：nodeSize → 节点 r；edgeWidth →
// 边宽；showOrphans=false 滤 degree==0；showMissing=false 滤 exists!=true
//（当前后端 exists 恒 true——分支为契约域预留）。力导四参（gravity/
// repulsion/attraction/linkLength）= fcose 域，v1 环形不消费（P661-D3
// 后置同族，差异登记）。
//   .graph_nodes  = ["<path>,<x>,<y>,circle,<color>,<r>", ...]   id=path（onhit 直开页）
//   .graph_edges  = ["<x1>,<y1>,<x2>,<y2>,#475569,<w>", ...]     坐标按 node 位表线性扫描派生
//   .graph_labels = ["<x>,<y+30>,<label>,#e2e8f0", ...]          CJK 直写（G-2 只禁索引算术）
// exists=false 杂色（当前后端恒 true——linkgraph 只收已解析页；分支为
// 契约域预留）。VM 纪律：typed List；float 累计器代 int 除法（049 无
// int→float 混算先例，float/float 已证域）；P614 参数列表 while+索引。

fn graph_ring_tables(nodes List, edges List, settings map) map {
    var tn List = []
    var te List = []
    var tl List = []
    var xs List = []
    var ys List = []
    var keep List = []
    var r_f float = settings.nodeSize
    var w_f float = settings.edgeWidth
    var show_orphans bool = settings.showOrphans
    var show_missing bool = settings.showMissing
    var n = nodes.len()
    var ci int = 0
    while ci < n {
        var cn = nodes[ci]
        var keep_it bool = true
        if show_orphans != true && cn.degree == 0 {
            keep_it = false
        }
        if show_missing != true && cn.exists != true {
            keep_it = false
        }
        if keep_it {
            keep.push(cn)
        }
        ci = ci + 1
    }
    var kn = keep.len()
    if kn > 0 {
        // float 累计器取 total（int→float 显式转换无先例——逐元素 +1.0）
        var total_f float = 0.0
        var fi2 int = 0
        while fi2 < kn {
            total_f = total_f + 1.0
            fi2 = fi2 + 1
        }
        var i int = 0
        while i < kn {
            var nd = keep[i]
            var fi float = i
            var fa float = 6.283185307179586 * fi / total_f
            var x float = 250.0 + 190.0 * math.cos(fa)
            var y float = 250.0 + 190.0 * math.sin(fa)
            var color str = "#3b82f6"
            if nd.exists != true {
                color = "#64748b"
            }
            tn.push(nd.path + "," + x.to_string() + "," + y.to_string() + ",circle," + color + "," + r_f.to_string())
            tl.push(x.to_string() + "," + (y + 30.0).to_string() + "," + nd.label + ",#e2e8f0")
            xs.push(x)
            ys.push(y)
            i = i + 1
        }
        // edges：坐标自 node 位表线性扫描派生（VM 无 map——O(n·e) 小域
        // 可受；双端任一不在位表 = 滤除/契约外，跳过）。
        var ei int = 0
        while ei < edges.len() {
            var ed = edges[ei]
            var x1 float = -1.0
            var y1 float = -1.0
            var x2 float = -1.0
            var y2 float = -1.0
            var si int = 0
            while si < kn {
                var snd = keep[si]
                if snd.path == ed.source {
                    x1 = xs[si]
                    y1 = ys[si]
                }
                if snd.path == ed.target {
                    x2 = xs[si]
                    y2 = ys[si]
                }
                si = si + 1
            }
            if x1 >= 0.0 && x2 >= 0.0 {
                te.push(x1.to_string() + "," + y1.to_string() + "," + x2.to_string() + "," + y2.to_string() + ",#475569," + w_f.to_string())
            }
            ei = ei + 1
        }
    }
    return { nodes: tn, edges: te, labels: tl }
}

// —— T-03 扩入：078 下沉 fn 部署副本（graph_sidebar/graph_controls 单源
// jade-garden/front/auto/src/front/graph_sidebar.at / graph_controls.at；
// VM 适配：P614 for-in 参数列表零迭代 → while+索引；copy[i]=x 索引写无
// VM 先例 → 拾取式选择 + splice 剔除[台账 tabs Close 同款已证]）。 ——

// derived-from graph_sidebar.at graph_stats（078 T-01 sink）——四计数 + 边数
// map（P614 适配：双参遍历 while+索引）。
fn graph_stats(nodes_in List, edges_in List) map {
    var total int = 0
    var existing int = 0
    var orphan int = 0
    var i int = 0
    while i < nodes_in.len() {
        var nd = nodes_in[i]
        total = total + 1
        if nd.exists == true {
            existing = existing + 1
        }
        if nd.degree == 0 {
            orphan = orphan + 1
        }
        i = i + 1
    }
    return { total: total, existing: existing, missing: total - existing, orphan: orphan, edges: edges_in.len() }
}

// derived-from graph_sidebar.at top_degree_nodes（078 T-01 sink）——度降序
// top15 + display 派生（VM 适配：拾取式选择——remaining 池反复取 max 后
// splice 剔除，无索引写）。
fn top_degree_nodes(nodes_in List) List {
    var remaining List = []
    var ci int = 0
    while ci < nodes_in.len() {
        remaining.push(nodes_in[ci])
        ci = ci + 1
    }
    var out List = []
    while out.len() < 15 {
        if remaining.len() == 0 {
            break
        }
        var max_i int = 0
        var j int = 1
        while j < remaining.len() {
            var cj = remaining[j]
            var cm = remaining[max_i]
            if cj.degree > cm.degree {
                max_i = j
            }
            j = j + 1
        }
        var nd = remaining[max_i]
        var disp = nd.id
        if nd.label != null && nd.label != "" {
            disp = nd.label
        }
        out.push({ id: nd.id, label: nd.label, path: nd.path, exists: nd.exists, degree: nd.degree, display: disp })
        remaining.splice(max_i, 1)
    }
    return out
}

// derived-from graph_controls.at gc_center_label（078 T-02 sink，逐字）——
// strip_ext 纪律形（ASCII 域；G-2 CJK 退化同源登记）。
fn gc_center_label(path_in) str {
    var ext = ".ad"
    var n = path_in.length
    var m = ext.length
    if n >= m {
        var tail = path_in.slice(n - m, n)
        if tail == ext {
            return path_in.slice(0, n - m)
        }
    }
    return path_in
}

// derived-from graph_controls.at gc_opacity_label（078 T-02 sink，逐字）——
// math.round 双轨词位（P-14）。
fn gc_opacity_label(opacity_in) str {
    return f"${math.round(opacity_in * 100)}%"
}

// derived-from graph_controls.at gc_set_setting（078 T-02 sink；VM 形状适配：
// map 入 map 出——P-11 括号写已随 661 修复[049 T4 实证]，值语义按引用或
// 按值复制两态皆正确：handler 重采纳返回值）。
fn gc_set_setting(m map, key_in str, v) map {
    m[key_in] = v
    return m
}

// derived-from graph_controls.at gc_reset_settings（078 T-02 sink；desktop
// 变体：defaults 以值返回——web 侧 $patch+saveSettings 的语义等价物，无
// 后端 saveSettings 路由[web 走 ext localStorage JSON 域]）。
fn gc_default_settings() map {
    return { showOrphans: true, showMissing: false, nodeSize: 12, textOpacity: 0.85, edgeWidth: 1, showArrows: false, gravity: 0.05, repulsion: 4500, attraction: 0.05, linkLength: 120 }
}
